 "blocks": [
  {
   "btype": "text",
   "text": "التربيع ضرب العدد في نفسه، والتكعيب ثلاث مرات، والجذر التربيعي العملية العكسية للتربيع. أمثلة محلولة:"
  },
  {
   "btype": "example",
   "text": "٦ تربيع",
   "note": "٦ × ٦ = ٣٦."
  },
  {
   "btype": "example",
   "text": "٣ تكعيب",
   "note": "٣ × ٣ × ٣ = ٢٧."
  },
  {
   "btype": "example",
   "text": "الجذر التربيعي لـ ٦٤",
   "note": "٨ × ٨ = ٦٤، فالجذر ٨."
  },
  {
   "btype": "text",
   "text": "انتقل إلى التمارين لتثبيت المهارة."
  }
 ]
}