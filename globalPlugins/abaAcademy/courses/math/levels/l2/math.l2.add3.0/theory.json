 "blocks": [
  {
   "btype": "text",
   "text": "للجمع والطرح حتى المئة نرتّب الأعداد حسب الخانات: آحاد تحت آحاد، وعشرات تحت عشرات، ونعالج كل خانة على حدة مع الحمل أو الاستلاف. إليك أمثلة محلولة خطوة بخطوة:"
  },
  {
   "btype": "example",
   "text": "٤٧ + ٢٥",
   "note": "الآحاد ٧+٥=١٢ نكتب ٢ ونحمل ١، العشرات ٤+٢+١=٧. الناتج ٧٢.",
   "steps": [
    "نبدأ من ٤٧",
    "نعدّ ٢٥ خطوات للأمام",
    "فنصل إلى ٧٢"
   ]
  },
  {
   "btype": "example",
   "text": "٦٠ − ٢٤",
   "note": "الآحاد: نستلف، ١٠−٤=٦، العشرات ٥−٢=٣. الناتج ٣٦."
  },
  {
   "btype": "example",
   "text": "٣٨ + ٣٨",
   "note": "٨+٨=١٦ نكتب ٦ ونحمل ١، ٣+٣+١=٧. الناتج ٧٦.",
   "steps": [
    "نبدأ من ٣٨",
    "نعدّ ٣٨ خطوات للأمام",
    "فنصل إلى ٧٦"
   ]
  },
  {
   "btype": "text",
   "text": "الآن انتقل إلى التمارين. لكل سؤال شرحٌ يظهر بعد إجابتك، فاقرأه سواء أصبت أم أخطأت."
  }
 ]
}