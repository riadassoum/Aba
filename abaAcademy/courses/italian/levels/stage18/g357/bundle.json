{"theory":{"blocks":[{"btype":"text","text":"الدرس 357. الكلمات الجديدة: aree، prudenza، gravi، durerà، sasso، assetato، scienziato، smette، maionese، gioventù."},{"btype":"example","text":"aree = مِسَاحَة، مِنْطَقَة","note":"صيغة من area (الجمع)"},{"btype":"example","text":"prudenza = عَقْل","note":"مثال: Guida con prudenza. — قد بحذر."},{"btype":"example","text":"gravi = جَدِّيّ","note":"صيغة من grave (الجمع)"},{"btype":"example","text":"durerà = اِسْتَمَرَّ","note":"صيغة من durare (الغائب، المستقبل)؛ مثال: Quanto durerà la tempesta? — كم ستستمر العاصفة؟"},{"btype":"example","text":"sasso = حجر","note":""},{"btype":"example","text":"assetato = عَطْشَان","note":"مثال: Sami era assetato di sangue. — كان سامي متعطّشا للدّم."},{"btype":"example","text":"scienziato = عَالِم","note":"مثال: È un grande scienziato. — إنه عالم عظيم."},{"btype":"example","text":"smette = تَوَقَّفَ","note":"صيغة من smettere (الغائب، المضارع)؛ مثال: Andiamo appena smette di piovere. — لنذهب فور ما يتوقف المطر."},{"btype":"example","text":"maionese = مَايُونِيز","note":""},{"btype":"example","text":"gioventù = شَبَاب","note":"مثال: Dobbiamo tenere in conto la sua gioventù. — علينا أن نأخذ شبابه بعين الاعتبار."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Guida con prudenza.","note":"قد بحذر."},{"btype":"example","text":"È un grande scienziato.","note":"إنه عالم عظيم."},{"btype":"example","text":"Quanto durerà la tempesta?","note":"كم ستستمر العاصفة؟"},{"btype":"example","text":"Sami era assetato di sangue.","note":"كان سامي متعطّشا للدّم."},{"btype":"example","text":"Per piacere guida con prudenza.","note":"قد بحذر من فضلك."},{"btype":"example","text":"Andiamo appena smette di piovere.","note":"لنذهب فور ما يتوقف المطر."},{"btype":"example","text":"Sì, il latte durerà fino a venerdì.","note":"نعم، سيكفي الحليب حتى يوم الجمعة."},{"btype":"example","text":"Dobbiamo tenere in conto la sua gioventù.","note":"علينا أن نأخذ شبابه بعين الاعتبار."},{"btype":"example","text":"Giochiamo a baseball quando smette di piovere.","note":"لنلعب كرة القاعدة حين يتوقف المطر."},{"btype":"example","text":"Sami ha sei cani ora.","note":"لدى سامي ستّ كلاب الآن."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Guida con prudenza.","ar":"قد بحذر."},{"t":"È un grande scienziato.","ar":"إنه عالم عظيم."},{"t":"Quanto durerà la tempesta?","ar":"كم ستستمر العاصفة؟"},{"t":"Sami era assetato di sangue.","ar":"كان سامي متعطّشا للدّم."},{"t":"Per piacere guida con prudenza.","ar":"قد بحذر من فضلك."},{"t":"Andiamo appena smette di piovere.","ar":"لنذهب فور ما يتوقف المطر."},{"t":"Sì, il latte durerà fino a venerdì.","ar":"نعم، سيكفي الحليب حتى يوم الجمعة."},{"t":"Dobbiamo tenere in conto la sua gioventù.","ar":"علينا أن نأخذ شبابه بعين الاعتبار."},{"t":"Giochiamo a baseball quando smette di piovere.","ar":"لنلعب كرة القاعدة حين يتوقف المطر."},{"t":"Sami ha sei cani ora.","ar":"لدى سامي ستّ كلاب الآن."},{"t":"Conosco questa donna.","ar":"أعرف هذه المرأة."},{"t":"Io conosco la verità.","ar":"أعرف الحقيقة."}],"focus":["aree","prudenza","gravi","durerà","sasso","assetato","scienziato","smette","maionese","gioventù"],"words":[{"word":"prudenza","topic":"L357","difficulty":5,"meaning":"عَقْل","example":"Guida con prudenza.","translation":"قد بحذر."},{"word":"sasso","topic":"L357","difficulty":5,"meaning":"حجر"},{"word":"assetato","topic":"L357","difficulty":5,"meaning":"عَطْشَان","example":"Sami era assetato di sangue.","translation":"كان سامي متعطّشا للدّم."},{"word":"scienziato","topic":"L357","difficulty":5,"meaning":"عَالِم","example":"È un grande scienziato.","translation":"إنه عالم عظيم."},{"word":"maionese","topic":"L357","difficulty":5,"meaning":"مَايُونِيز"},{"word":"gioventù","topic":"L357","difficulty":5,"meaning":"شَبَاب","example":"Dobbiamo tenere in conto la sua gioventù.","translation":"علينا أن نأخذ شبابه بعين الاعتبار."}],"difficulty":5}}