{"theory":{"blocks":[{"btype":"text","text":"الدرس 168. الكلمات الجديدة: preferisce، stavi، prendo، commento، peccato، sveglio، invitati، sposati، chiuse، miele."},{"btype":"example","text":"preferisce = فَضَّلَ","note":"صيغة من preferire (الغائب، المضارع)؛ مثال: Tom preferisce il tè al caffè. — توم يحب الشاي أكثر من القهوة."},{"btype":"example","text":"stavi = مَكَثَ","note":"صيغة من stare (المخاطب، الماضي المستمرّ)؛ مثال: Stavi dormendo? — هل كنت نائما؟"},{"btype":"example","text":"prendo = أَخَذَ","note":"صيغة من prendere (المتكلّم، المضارع)؛ مثال: Prendo in prestito libri dalla biblioteca. — أستعير كتبا من المكتبة."},{"btype":"example","text":"commento = تَعْلِيق","note":""},{"btype":"example","text":"peccato = خَطِيئَة","note":"مثال: Che peccato! — يا خسارة!"},{"btype":"example","text":"sveglio = يَقِظ","note":"مثال: Sami è sveglio. — سامي مستيقظ."},{"btype":"example","text":"invitati = ضَيْف","note":"صيغة من invitato (الجمع، المذكّر)؛ مثال: Non eravamo invitati. — لم نكن مدعوين"},{"btype":"example","text":"sposati = مُتَزَوِّج","note":"صيغة من sposato (الجمع، المذكّر)؛ مثال: Si sono sposati tre mesi fa. — تزوّجوا منذ ثلاثة أشهر."},{"btype":"example","text":"chiuse = مُغْلَق","note":"صيغة من chiuso (الجمع، المؤنث)؛ مثال: Chiuse gli occhi. — هي أغلقت عينيها."},{"btype":"example","text":"miele = عَسَل","note":"مثال: Il miele non va a male. — العسل لا يفسد."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Che peccato!","note":"يا خسارة!"},{"btype":"example","text":"Stavi dormendo?","note":"هل كنت نائما؟"},{"btype":"example","text":"Sami è sveglio.","note":"سامي مستيقظ."},{"btype":"example","text":"Chiuse gli occhi.","note":"هي أغلقت عينيها."},{"btype":"example","text":"Mi sveglio presto.","note":"أستيقظ مبكراً."},{"btype":"example","text":"Cosa stavi facendo?","note":"ماذا كنت تفعل؟"},{"btype":"example","text":"Sei ancora sveglio?","note":"هل مازلتَ مُستيقظاً؟"},{"btype":"example","text":"Non eravamo invitati.","note":"لم نكن مدعوين"},{"btype":"example","text":"Il miele non va a male.","note":"العسل لا يفسد."},{"btype":"example","text":"Si sono sposati tre mesi fa.","note":"تزوّجوا منذ ثلاثة أشهر."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Che peccato!","ar":"يا خسارة!"},{"t":"Stavi dormendo?","ar":"هل كنت نائما؟"},{"t":"Sami è sveglio.","ar":"سامي مستيقظ."},{"t":"Chiuse gli occhi.","ar":"هي أغلقت عينيها."},{"t":"Mi sveglio presto.","ar":"أستيقظ مبكراً."},{"t":"Cosa stavi facendo?","ar":"ماذا كنت تفعل؟"},{"t":"Sei ancora sveglio?","ar":"هل مازلتَ مُستيقظاً؟"},{"t":"Non eravamo invitati.","ar":"لم نكن مدعوين"},{"t":"Il miele non va a male.","ar":"العسل لا يفسد."},{"t":"Si sono sposati tre mesi fa.","ar":"تزوّجوا منذ ثلاثة أشهر."},{"t":"Le mie finestre erano chiuse.","ar":"أُغْلِقَتْ نوافِذِي."},{"t":"Tom preferisce il tè al caffè.","ar":"توم يحب الشاي أكثر من القهوة."},{"t":"Preferisce la campagna alla città.","ar":"هو يفضل الريف على البلدة."},{"t":"Stavi leggend