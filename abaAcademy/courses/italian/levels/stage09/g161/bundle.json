{"theory":{"blocks":[{"btype":"text","text":"الدرس 161. الكلمات الجديدة: notizia، dirlo، avanti، stamattina، zii، canadese، l'amore، gatta، segreto، scelta."},{"btype":"example","text":"notizia = تَارِيخ","note":"مثال: È una buona notizia. — هذه أخبار طيبة."},{"btype":"example","text":"dirlo","note":"مثال: Come puoi dirlo? — كيف لك أن تقول ذلك؟"},{"btype":"example","text":"avanti = مُهَاجِم","note":"مثال: Vieni avanti. — تعالَ إلى الأمام."},{"btype":"example","text":"stamattina = هٰذَا الصَّبَاح","note":"مثال: Fa freddo stamattina. — الجو بارد هذا الصباح."},{"btype":"example","text":"zii","note":""},{"btype":"example","text":"canadese = كَنَدِيّ","note":"مثال: Jim è canadese. — جِم مواطن كندي."},{"btype":"example","text":"l'amore","note":"مثال: L'amore è bello. — الحبّ جميل."},{"btype":"example","text":"gatta = قِطَّة","note":""},{"btype":"example","text":"segreto = سِرّ","note":"مثال: È un segreto. — إنه سر."},{"btype":"example","text":"scelta = اِخْتِيَار","note":"مثال: Non ho scelta. — لم أحصل على خيار."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Vieni avanti.","note":"تعالَ إلى الأمام."},{"btype":"example","text":"È un segreto.","note":"إنه سر."},{"btype":"example","text":"Non ho scelta.","note":"لم أحصل على خيار."},{"btype":"example","text":"Non ha scelta.","note":"ليس لديه خيار."},{"btype":"example","text":"Jim è canadese.","note":"جِم مواطن كندي."},{"btype":"example","text":"Come puoi dirlo?","note":"كيف لك أن تقول ذلك؟"},{"btype":"example","text":"L'amore è bello.","note":"الحبّ جميل."},{"btype":"example","text":"Non avevo scelta.","note":"لم يكن لديَّ خيار."},{"btype":"example","text":"L'amore è l'amore.","note":"الحبّ هو الحبّ."},{"btype":"example","text":"Qual è il segreto?","note":"ما السر؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"