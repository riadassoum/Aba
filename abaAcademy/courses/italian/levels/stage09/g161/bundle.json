izia.","ar":"انها اخبار قديمة."},{"t":"Tom sembra stanco stamattina.","ar":"يبدو توم متعبا هذا الصباح"},{"t":"L'amore è una cosa importante.","ar":"الحب شيء مهم."},{"t":"Ho guardato la televisione stamattina.","ar":"شاهدت التلفاز هذا الصباح."},{"t":"Non abbiamo mai dato una scelta a Tom.","ar":"لم نعطِ توم خيارا أبدا."},{"t":"Quello che è successo non è un segreto.","ar":"ما حدث ليس سرًّا."},{"t":"Mi sono svegliato alle cinque stamattina.","ar":"استيقظت في الخامسة هذا الصباح."},{"t":"L'amore è tutto ciò di cui si ha bisogno.","ar":"الحب هو كل ما تحتاجه ."},{"t":"Non avevo altra scelta che rimanere a letto tutto il giorno.","ar":"لم يكن لدي خيار سوی الاستلقاء علی السرير طوال اليوم."}],"focus":["notizia","dirlo","avanti","stamattina","zii","canadese","l'amore","gatta","segreto","scelta"],"words":[{"word":"notizia","topic":"L161","difficulty":2,"meaning":"تَارِيخ","example":"È una buona notizia.","translation":"هذه أخبار طيبة."},{"word":"avanti","topic":"L161","difficulty":2,"meaning":"مُهَاجِم","example":"Vieni avanti.","translation":"تعالَ إلى الأمام."},{"word":"stamattina","topic":"L161","difficulty":2,"meaning":"هٰذَا الصَّبَاح","example":"Fa freddo stamattina.","translation":"الجو بارد هذا الصباح."},{"word":"canadese","topic":"L161","difficulty":2,"meaning":"كَنَدِيّ","example":"Jim è canadese.","translation":"جِم مواطن كندي."},{"word":"gatta","topic":"L161","difficulty":2,"meaning":"قِطَّة"},{"word":"segreto","topic":"L161","difficulty":2,"meaning":"سِرّ","example":"È un segreto.","translation":"إنه سر."},{"word":"scelta","topic":"L161","difficulty":2,"meaning":"اِخْتِيَار","example":"Non ho scelta.","translation":"لم أحصل على خيار."}],"difficulty":2}}