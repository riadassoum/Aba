":"علينا الذهاب إلى هناك شئنا أم أبينا."},{"t":"Non conosco questo quartiere troppo bene.","ar":"لا أعرف هذا الحي جيدا."},{"t":"Se sei la persona più intelligente della stanza, sei nella stanza sbagliata.","ar":"إذا كنتَ أذكى شخصٍ في الغرفة، فأنتَ في الغرفةِ الخطأِ."},{"t":"Ci vogliono venti minuti per andare a piedi dalla stazione alla scuola.","ar":"يستغرق السير من المحطة إلى المدرسة عشرين دقيقة."}],"focus":["piaccia","venuti","riescono","chiedi","indossa","sbagliata","forno","carote","inutile","quartiere"],"words":[{"word":"forno","topic":"L164","difficulty":3,"meaning":"فُرْن","example":"C'è del pane nel forno.","translation":"يوجد خبز في الفرن."},{"word":"inutile","topic":"L164","difficulty":3,"meaning":"عَدِيمُ الْفَائِدَةِ"},{"word":"quartiere","topic":"L164","difficulty":3,"meaning":"حَيّ، جِوَار","example":"Non vive nel mio quartiere.","translation":"إنه لا يسكن في حيي."}],"difficulty":3}}