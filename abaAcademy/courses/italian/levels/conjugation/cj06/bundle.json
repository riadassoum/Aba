{"theory":{"blocks":[{"btype":"text","text":"المضارع (presente): iniziare (بَدَأَ)، andarsene (تَرَكَ)، saltare (قَفَزَ)، aumentare (اِزْدَاد، زَاد)، seguire (تَبِعَ، تَابَعَ)، pulire (نَظَّفَ)، insegnare (عَلَّمَ)، cominciare (بَدَأَ)، migliorare (حَسَّنَ)."},{"btype":"example","text":"iniziare","note":"io inizio، tu inizi، lui/lei inizia، noi iniziamo، voi iniziate، loro iniziano"},{"btype":"example","text":"andarsene","note":"io me ne vado، tu te ne vai، lui/lei se ne và، noi ce ne andiamo، voi ve ne andate، loro se ne vanno"},{"btype":"example","text":"saltare","note":"io salto، tu salti، lui/lei salta، noi saltiamo، voi saltate، loro saltano"},{"btype":"example","text":"aumentare","note":"io aumento، tu aumenti، lui/lei aumenta، noi aumentiamo، voi aumentate، loro aumentano"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"iniziare","meaning":"بَدَأَ","tense":"المضارع (presente)","forms":{"io":"inizio","tu":"inizi","lui/lei":"inizia","noi":"iniziamo","voi":"iniziate","loro":"iniziano"},"difficulty":2},{"infinitive":"andarsene","meaning":"تَرَكَ","tense":"المضارع (presente)","forms":{"io":"me ne vado","tu":"te ne vai","lui/lei":"se ne và","noi":"ce ne andiamo","voi":"ve ne andate","loro":"se ne vanno"},"difficulty":2},{"infinitive":"saltare","meaning":"قَفَزَ","tense":"المضارع (presente)","forms":{"io":"salto","tu":"salti","lui/lei":"salta","noi":"saltiamo","voi":"saltate","loro":"saltano"},"difficulty":2},{"infinitive":"aumentare","meaning":"اِزْدَاد، زَاد","tense":"المضارع (presente)","forms":{"io":"aumento","tu":"aumenti","lui/lei":"aumenta","noi":"aumentiamo","voi":"aumentate","loro":"aumentano"},"difficulty":2},{"infinitive":"seguire","mea