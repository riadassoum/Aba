{"theory":{"blocks":[{"btype":"text","text":"الشرطي (condizionale): scappare (هَرَبَ)، sembrare (بَدَا)، crescere (نَمَى)، dovere (وَجَبَ، لَابُدَّ)، vivere (حَيِيَ)، usare (اِسْتَعْمَلَ)، uscire (خَرَجَ)، piacere (مُتْعَة)، muovere (تَحَرَّكَ)، parere (فِكْرَة)."},{"btype":"example","text":"scappare","note":"io scapperei، tu scapperesti، lui/lei scapperebbe، noi scapperemmo، voi scappereste، loro scapperebbero"},{"btype":"example","text":"sembrare","note":"io sembrerei، tu sembreresti، lui/lei sembrerebbe، noi sembreremmo، voi sembrereste، loro sembrerebbero"},{"btype":"example","text":"crescere","note":"io crescerei، tu cresceresti، lui/lei crescerebbe، noi cresceremmo، voi crescereste، loro crescerebbero"},{"btype":"example","text":"dovere","note":"io dovrei، tu dovresti، lui/lei dovrebbe، noi dovremmo، voi dovreste، loro dovrebbero"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"scappare","meaning":"هَرَبَ","tense":"الشرطي (condizionale)","forms":{"io":"scapperei","tu":"scapperesti","lui/lei":"scapperebbe","noi":"scapperemmo","voi":"scappereste","loro":"scapperebbero"},"difficulty":2},{"infinitive":"sembrare","meaning":"بَدَا","tense":"الشرطي (condizionale)","forms":{"io":"sembrerei","tu":"sembreresti","lui/lei":"sembrerebbe","noi":"sembreremmo","voi":"sembrereste","loro":"sembrerebbero"},"difficulty":2},{"infinitive":"crescere","meaning":"نَمَى","tense":"الشرطي (condizionale)","forms":{"io":"crescerei","tu":"cresceresti","lui/lei":"crescerebbe","noi":"cresceremmo","voi":"crescereste","loro":"crescerebbero"},"difficulty":2},{"infinitive":"dovere","meaning":"وَجَبَ، لَابُدَّ","tense":"الشرطي (condizionale)","forms":{"io":"dovrei","tu":"dovrest