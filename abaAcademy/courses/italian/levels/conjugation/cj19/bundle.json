{"theory":{"blocks":[{"btype":"text","text":"الشرطي (condizionale): essere (يكون)، costruire (يبني)، fare (يفعل، يصنع)، dire (أَخْبَرَ)، esistere (وُجِدَ)، rallentare (أَبْطَأَ)، sapere (عَلِمَ)، volare (طَارَ)، cadere (وَقَعَ، سَقَطَ)، stare (مَكَثَ)."},{"btype":"example","text":"essere","note":"io sarei، tu saresti، lui/lei sarebbe، noi saremmo، voi sareste، loro sarebbero"},{"btype":"example","text":"costruire","note":"io costruirei، tu costruiresti، lui/lei costruirebbe، noi costruiremmo، voi costruireste، loro costruirebbero"},{"btype":"example","text":"fare","note":"io farei، tu faresti، lui/lei farebbe، noi faremmo، voi fareste، loro farebbero"},{"btype":"example","text":"dire","note":"io direi، tu diresti، lui/lei direbbe، noi diremmo، voi direste، loro direbbero"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"essere","meaning":"يكون","tense":"الشرطي (condizionale)","forms":{"io":"sarei","tu":"saresti","lui/lei":"sarebbe","noi":"saremmo","voi":"sareste","loro":"sarebbero"},"difficulty":2},{"infinitive":"costruire","meaning":"يبني","tense":"الشرطي (condizionale)","forms":{"io":"costruirei","tu":"costruiresti","lui/lei":"costruirebbe","noi":"costruiremmo","voi":"costruireste","loro":"costruirebbero"},"difficulty":2},{"infinitive":"fare","meaning":"يفعل، يصنع","tense":"الشرطي (condizionale)","forms":{"io":"farei","tu":"faresti","lui/lei":"farebbe","noi":"faremmo","voi":"fareste","loro":"farebbero"},"difficulty":2},{"infinitive":"dire","meaning":"أَخْبَرَ","tense":"الشرطي (condizionale)","forms":{"io":"direi","tu":"diresti","lui/lei":"direbbe","noi":"diremmo","voi":"direste","loro":"direbbero"},"difficulty":2},{"infinitive":"esistere","meanin