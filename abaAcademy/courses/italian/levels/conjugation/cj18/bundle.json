{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futuro): iniziare (بَدَأَ)، andarsene (تَرَكَ)، saltare (قَفَزَ)، aumentare (اِزْدَاد، زَاد)، seguire (تَبِعَ، تَابَعَ)، pulire (نَظَّفَ)، insegnare (عَلَّمَ)، cominciare (بَدَأَ)، migliorare (حَسَّنَ)."},{"btype":"example","text":"iniziare","note":"io inizierò، tu inizierai، lui/lei inizierà، noi inizieremo، voi inizierete، loro inizieranno"},{"btype":"example","text":"andarsene","note":"io me ne andrò، tu te ne andrai، lui/lei se ne andrà، noi ce ne andremo، voi ve ne andrete، loro se ne andranno"},{"btype":"example","text":"saltare","note":"io salterò، tu salterai، lui/lei salterà، noi salteremo، voi salterete، loro salteranno"},{"btype":"example","text":"aumentare","note":"io aumenterò، tu aumenterai، lui/lei aumenterà، noi aumenteremo، voi aumenterete، loro aumenteranno"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"iniziare","meaning":"بَدَأَ","tense":"المستقبل (futuro)","forms":{"io":"inizierò","tu":"inizierai","lui/lei":"inizierà","noi":"inizieremo","voi":"inizierete","loro":"inizieranno"},"difficulty":2},{"infinitive":"andarsene","meaning":"تَرَكَ","tense":"المستقبل (futuro)","forms":{"io":"me ne andrò","tu":"te ne andrai","lui/lei":"se ne andrà","noi":"ce ne andremo","voi":"ve ne andrete","loro":"se ne andranno"},"difficulty":2},{"infinitive":"saltare","meaning":"قَفَزَ","tense":"المستقبل (futuro)","forms":{"io":"salterò","tu":"salterai","lui/lei":"salterà","noi":"salteremo","voi":"salterete","loro":"salteranno"},"difficulty":2},{"infinitive":"aumentare","meaning":"اِزْدَاد، زَاد","tense":"المستقبل (futuro)","forms":{"io":"aumenterò","tu":"aumenterai","lui/lei":"aumenterà","noi":"a