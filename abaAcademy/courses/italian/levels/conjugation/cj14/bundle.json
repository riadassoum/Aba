{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futuro): passare (قَضَى)، piovere (أَمْطَرَ)، potere (قَدَرَ، اِسْتَطَاعَ)، andare (يذهب)، prendere (أَخَذَ)، volere (أَرَادَ)، fallire (أَخْفَقَ)، partire (تَرَكَ)، finire (اِنْتَهَى، أَنْهَى)، nevicare (أَثْلَجَ)."},{"btype":"example","text":"passare","note":"io passerò، tu passerai، lui/lei passerà، noi passeremo، voi passerete، loro passeranno"},{"btype":"example","text":"piovere","note":"io pioverò، tu pioverai، lui/lei pioverà، noi pioveremo، voi pioverete، loro pioveranno"},{"btype":"example","text":"potere","note":"io potrò، tu potrai، lui/lei potrà، noi potremo، voi potrete، loro potranno"},{"btype":"example","text":"andare","note":"io andrò، tu andrai، lui/lei andrà، noi andremo، voi andrete، loro andranno"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"passare","meaning":"قَضَى","tense":"المستقبل (futuro)","forms":{"io":"passerò","tu":"passerai","lui/lei":"passerà","noi":"passeremo","voi":"passerete","loro":"passeranno"},"difficulty":2},{"infinitive":"piovere","meaning":"أَمْطَرَ","tense":"المستقبل (futuro)","forms":{"io":"pioverò","tu":"pioverai","lui/lei":"pioverà","noi":"pioveremo","voi":"pioverete","loro":"pioveranno"},"difficulty":2},{"infinitive":"potere","meaning":"قَدَرَ، اِسْتَطَاعَ","tense":"المستقبل (futuro)","forms":{"io":"potrò","tu":"potrai","lui/lei":"potrà","noi":"potremo","voi":"potrete","loro":"potranno"},"difficulty":2},{"infinitive":"andare","meaning":"يذهب","tense":"المستقبل (futuro)","forms":{"io":"andrò","tu":"andrai","lui/lei":"andrà","noi":"andremo","voi":"andrete","loro":"andranno"},"difficulty":2},{"infinitive":"prendere","meaning":"أَخَذَ","tense":"المست