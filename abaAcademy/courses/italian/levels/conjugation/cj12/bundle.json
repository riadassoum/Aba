{"theory":{"blocks":[{"btype":"text","text":"الماضي المستمرّ (imperfetto): iniziare (بَدَأَ)، andarsene (تَرَكَ)، saltare (قَفَزَ)، aumentare (اِزْدَاد، زَاد)، seguire (تَبِعَ، تَابَعَ)، pulire (نَظَّفَ)، insegnare (عَلَّمَ)، cominciare (بَدَأَ)، migliorare (حَسَّنَ)."},{"btype":"example","text":"iniziare","note":"io iniziavo، tu iniziavi، lui/lei iniziava، noi iniziavamo، voi iniziavate، loro iniziavano"},{"btype":"example","text":"andarsene","note":"io me ne andavo، tu te ne andavi، lui/lei se ne andava، noi ce ne andavamo، voi ve ne andavate، loro se ne andavano"},{"btype":"example","text":"saltare","note":"io saltavo، tu saltavi، lui/lei saltava، noi saltavamo، voi saltavate، loro saltavano"},{"btype":"example","text":"aumentare","note":"io aumentavo، tu aumentavi، lui/lei aumentava، noi aumentavamo، voi aumentavate، loro aumentavano"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"iniziare","meaning":"بَدَأَ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"iniziavo","tu":"iniziavi","lui/lei":"iniziava","noi":"iniziavamo","voi":"iniziavate","loro":"iniziavano"},"difficulty":2},{"infinitive":"andarsene","meaning":"تَرَكَ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"me ne andavo","tu":"te ne andavi","lui/lei":"se ne andava","noi":"ce ne andavamo","voi":"ve ne andavate","loro":"se ne andavano"},"difficulty":2},{"infinitive":"saltare","meaning":"قَفَزَ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"saltavo","tu":"saltavi","lui/lei":"saltava","noi":"saltavamo","voi":"saltavate","loro":"saltavano"},"difficulty":2},{"infinitive":"aumentare","meaning":"اِزْدَاد، زَاد","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"aument