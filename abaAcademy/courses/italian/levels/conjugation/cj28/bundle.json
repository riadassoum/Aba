{"theory":{"blocks":[{"btype":"text","text":"صيغة الالتماس (congiuntivo): scappare (هَرَبَ)، sembrare (بَدَا)، crescere (نَمَى)، dovere (وَجَبَ، لَابُدَّ)، vivere (حَيِيَ)، usare (اِسْتَعْمَلَ)، uscire (خَرَجَ)، piacere (مُتْعَة)، muovere (تَحَرَّكَ)، parere (فِكْرَة)."},{"btype":"example","text":"scappare","note":"io scappi، tu scappi، lui/lei scappi، noi scappiamo، voi scappiate، loro scappino"},{"btype":"example","text":"sembrare","note":"io sembri، tu sembri، lui/lei sembri، noi sembriamo، voi sembriate، loro sembrino"},{"btype":"example","text":"crescere","note":"io cresca، tu cresca، lui/lei cresca، noi cresciamo، voi cresciate، loro crescano"},{"btype":"example","text":"dovere","note":"io debba، tu debba، lui/lei debba، noi dobbiamo، voi dobbiate، loro debbano"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"scappare","meaning":"هَرَبَ","tense":"صيغة الالتماس (congiuntivo)","forms":{"io":"scappi","tu":"scappi","lui/lei":"scappi","noi":"scappiamo","voi":"scappiate","loro":"scappino"},"difficulty":2},{"infinitive":"sembrare","meaning":"بَدَا","tense":"صيغة الالتماس (congiuntivo)","forms":{"io":"sembri","tu":"sembri","lui/lei":"sembri","noi":"sembriamo","voi":"sembriate","loro":"sembrino"},"difficulty":2},{"infinitive":"crescere","meaning":"نَمَى","tense":"صيغة الالتماس (congiuntivo)","forms":{"io":"cresca","tu":"cresca","lui/lei":"cresca","noi":"cresciamo","voi":"cresciate","loro":"crescano"},"difficulty":2},{"infinitive":"dovere","meaning":"وَجَبَ، لَابُدَّ","tense":"صيغة الالتماس (congiuntivo)","forms":{"io":"debba","tu":"debba","lui/lei":"debba","noi":"dobbiamo","voi":"dobbiate","loro":"debbano"},"difficulty":2},{"infinitive":"vivere","mea