{"theory":{"blocks":[{"btype":"text","text":"الشرطي (condizionale): passare (قَضَى)، piovere (أَمْطَرَ)، potere (قَدَرَ، اِسْتَطَاعَ)، andare (يذهب)، prendere (أَخَذَ)، volere (أَرَادَ)، fallire (أَخْفَقَ)، partire (تَرَكَ)، finire (اِنْتَهَى، أَنْهَى)، nevicare (أَثْلَجَ)."},{"btype":"example","text":"passare","note":"io passerei، tu passeresti، lui/lei passerebbe، noi passeremmo، voi passereste، loro passerebbero"},{"btype":"example","text":"piovere","note":"io pioverei، tu pioveresti، lui/lei pioverebbe، noi pioveremmo، voi piovereste، loro pioverebbero"},{"btype":"example","text":"potere","note":"io potrei، tu potresti، lui/lei potrebbe، noi potremmo، voi potreste، loro potrebbero"},{"btype":"example","text":"andare","note":"io andrei، tu andresti، lui/lei andrebbe، noi andremmo، voi andreste، loro andrebbero"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"passare","meaning":"قَضَى","tense":"الشرطي (condizionale)","forms":{"io":"passerei","tu":"passeresti","lui/lei":"passerebbe","noi":"passeremmo","voi":"passereste","loro":"passerebbero"},"difficulty":2},{"infinitive":"piovere","meaning":"أَمْطَرَ","tense":"الشرطي (condizionale)","forms":{"io":"pioverei","tu":"pioveresti","lui/lei":"pioverebbe","noi":"pioveremmo","voi":"piovereste","loro":"pioverebbero"},"difficulty":2},{"infinitive":"potere","meaning":"قَدَرَ، اِسْتَطَاعَ","tense":"الشرطي (condizionale)","forms":{"io":"potrei","tu":"potresti","lui/lei":"potrebbe","noi":"potremmo","voi":"potreste","loro":"potrebbero"},"difficulty":2},{"infinitive":"andare","meaning":"يذهب","tense":"الشرطي (condizionale)","forms":{"io":"andrei","tu":"andresti","lui/lei":"andrebbe","noi":"andremmo","voi":"andre