{"theory":{"blocks":[{"btype":"text","text":"المضارع (presente): salire (نَهَضَ)، correre (رَكَضَ)، scendere (نَزَلَ)، cambiare (تَغَيَّرَƒ، غَيَّرَ)، fuggire (هَرَبَ)، sedere (جَلَسَ)، rimanere (بَقِيَ)، servire (خَدَمَ، قَدَّمَ)، succedere (حَدَثَ)، continuare (تَابَعَ)."},{"btype":"example","text":"salire","note":"io salgo، tu sali، lui/lei sale، noi saliamo، voi salite، loro salgono"},{"btype":"example","text":"correre","note":"io corro، tu corri، lui/lei corre، noi corriamo، voi correte، loro corrono"},{"btype":"example","text":"scendere","note":"io scendo، tu scendi، lui/lei scende، noi scendiamo، voi scendete، loro scendono"},{"btype":"example","text":"cambiare","note":"io cambio، tu cambi، lui/lei cambia، noi cambiamo، voi cambiate، loro cambiano"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"salire","meaning":"نَهَضَ","tense":"المضارع (presente)","forms":{"io":"salgo","tu":"sali","lui/lei":"sale","noi":"saliamo","voi":"salite","loro":"salgono"},"difficulty":2},{"infinitive":"correre","meaning":"رَكَضَ","tense":"المضارع (presente)","forms":{"io":"corro","tu":"corri","lui/lei":"corre","noi":"corriamo","voi":"correte","loro":"corrono"},"difficulty":2},{"infinitive":"scendere","meaning":"نَزَلَ","tense":"المضارع (presente)","forms":{"io":"scendo","tu":"scendi","lui/lei":"scende","noi":"scendiamo","voi":"scendete","loro":"scendono"},"difficulty":2},{"infinitive":"cambiare","meaning":"تَغَيَّرَƒ، غَيَّرَ","tense":"المضارع (presente)","forms":{"io":"cambio","tu":"cambi","lui/lei":"cambia","noi":"cambiamo","voi":"cambiate","loro":"cambiano"},"difficulty":2},{"infinitive":"fuggire","meaning":"هَرَبَ","tense":"المضارع (presente)","forms":{"io":"f