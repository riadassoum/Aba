{"theory":{"blocks":[{"btype":"text","text":"الشرطي (condizionale): salire (نَهَضَ)، correre (رَكَضَ)، scendere (نَزَلَ)، cambiare (تَغَيَّرَƒ، غَيَّرَ)، fuggire (هَرَبَ)، sedere (جَلَسَ)، rimanere (بَقِيَ)، servire (خَدَمَ، قَدَّمَ)، succedere (حَدَثَ)، continuare (تَابَعَ)."},{"btype":"example","text":"salire","note":"io salirei، tu saliresti، lui/lei salirebbe، noi saliremmo، voi salireste، loro salirebbero"},{"btype":"example","text":"correre","note":"io correrei، tu correresti، lui/lei correrebbe، noi correremmo، voi correreste، loro correrebbero"},{"btype":"example","text":"scendere","note":"io scenderei، tu scenderesti، lui/lei scenderebbe، noi scenderemmo، voi scendereste، loro scenderebbero"},{"btype":"example","text":"cambiare","note":"io cambierei، tu cambieresti، lui/lei cambierebbe، noi cambieremmo، voi cambiereste، loro cambierebbero"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"salire","meaning":"نَهَضَ","tense":"الشرطي (condizionale)","forms":{"io":"salirei","tu":"saliresti","lui/lei":"salirebbe","noi":"saliremmo","voi":"salireste","loro":"salirebbero"},"difficulty":2},{"infinitive":"correre","meaning":"رَكَضَ","tense":"الشرطي (condizionale)","forms":{"io":"correrei","tu":"correresti","lui/lei":"correrebbe","noi":"correremmo","voi":"correreste","loro":"correrebbero"},"difficulty":2},{"infinitive":"scendere","meaning":"نَزَلَ","tense":"الشرطي (condizionale)","forms":{"io":"scenderei","tu":"scenderesti","lui/lei":"scenderebbe","noi":"scenderemmo","voi":"scendereste","loro":"scenderebbero"},"difficulty":2},{"infinitive":"cambiare","meaning":"تَغَيَّرَƒ، غَيَّرَ","tense":"الشرطي (condizionale)","forms":{"io":"cambierei","tu":"cambie