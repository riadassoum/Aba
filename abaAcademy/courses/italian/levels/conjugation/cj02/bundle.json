{"theory":{"blocks":[{"btype":"text","text":"المضارع (presente): passare (قَضَى)، piovere (أَمْطَرَ)، potere (قَدَرَ، اِسْتَطَاعَ)، andare (يذهب)، prendere (أَخَذَ)، volere (أَرَادَ)، fallire (أَخْفَقَ)، partire (تَرَكَ)، finire (اِنْتَهَى، أَنْهَى)، nevicare (أَثْلَجَ)."},{"btype":"example","text":"passare","note":"io passo، tu passi، lui/lei passa، noi passiamo، voi passate، loro passano"},{"btype":"example","text":"piovere","note":"io piovo، tu piovi، lui/lei piove، noi pioviamo، voi piovete، loro piovono"},{"btype":"example","text":"potere","note":"io posso، tu puoi، lui/lei può، noi possiamo، voi potete، loro possono"},{"btype":"example","text":"andare","note":"io vado، tu vai، lui/lei và، noi andiamo، voi andate، loro vanno"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"passare","meaning":"قَضَى","tense":"المضارع (presente)","forms":{"io":"passo","tu":"passi","lui/lei":"passa","noi":"passiamo","voi":"passate","loro":"passano"},"difficulty":2},{"infinitive":"piovere","meaning":"أَمْطَرَ","tense":"المضارع (presente)","forms":{"io":"piovo","tu":"piovi","lui/lei":"piove","noi":"pioviamo","voi":"piovete","loro":"piovono"},"difficulty":2},{"infinitive":"potere","meaning":"قَدَرَ، اِسْتَطَاعَ","tense":"المضارع (presente)","forms":{"io":"posso","tu":"puoi","lui/lei":"può","noi":"possiamo","voi":"potete","loro":"possono"},"difficulty":2},{"infinitive":"andare","meaning":"يذهب","tense":"المضارع (presente)","forms":{"io":"vado","tu":"vai","lui/lei":"và","noi":"andiamo","voi":"andate","loro":"vanno"},"difficulty":2},{"infinitive":"prendere","meaning":"أَخَذَ","tense":"المضارع (presente)","forms":{"io":"prendo","tu":"prendi","lui/lei":"prende","noi":"p