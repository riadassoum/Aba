{"theory":{"blocks":[{"btype":"text","text":"المضارع (presente): scappare (هَرَبَ)، sembrare (بَدَا)، crescere (نَمَى)، dovere (وَجَبَ، لَابُدَّ)، vivere (حَيِيَ)، usare (اِسْتَعْمَلَ)، uscire (خَرَجَ)، piacere (مُتْعَة)، muovere (تَحَرَّكَ)، parere (فِكْرَة)."},{"btype":"example","text":"scappare","note":"io scappo، tu scappi، lui/lei scappa، noi scappiamo، voi scappate، loro scappano"},{"btype":"example","text":"sembrare","note":"io sembro، tu sembri، lui/lei sembra، noi sembriamo، voi sembrate، loro sembrano"},{"btype":"example","text":"crescere","note":"io cresco، tu cresci، lui/lei cresce، noi cresciamo، voi crescete، loro crescono"},{"btype":"example","text":"dovere","note":"io devo، tu devi، lui/lei deve، noi dobbiamo، voi dovete، loro devono"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"scappare","meaning":"هَرَبَ","tense":"المضارع (presente)","forms":{"io":"scappo","tu":"scappi","lui/lei":"scappa","noi":"scappiamo","voi":"scappate","loro":"scappano"},"difficulty":2},{"infinitive":"sembrare","meaning":"بَدَا","tense":"المضارع (presente)","forms":{"io":"sembro","tu":"sembri","lui/lei":"sembra","noi":"sembriamo","voi":"sembrate","loro":"sembrano"},"difficulty":2},{"infinitive":"crescere","meaning":"نَمَى","tense":"المضارع (presente)","forms":{"io":"cresco","tu":"cresci","lui/lei":"cresce","noi":"cresciamo","voi":"crescete","loro":"crescono"},"difficulty":2},{"infinitive":"dovere","meaning":"وَجَبَ، لَابُدَّ","tense":"المضارع (presente)","forms":{"io":"devo","tu":"devi","lui/lei":"deve","noi":"dobbiamo","voi":"dovete","loro":"devono"},"difficulty":2},{"infinitive":"vivere","meaning":"حَيِيَ","tense":"المضارع (presente)","forms":{"io":"vivo