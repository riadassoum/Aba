{"theory":{"blocks":[{"btype":"text","text":"الماضي المستمرّ (imperfetto): essere (يكون)، costruire (يبني)، fare (يفعل، يصنع)، dire (أَخْبَرَ)، esistere (وُجِدَ)، rallentare (أَبْطَأَ)، sapere (عَلِمَ)، volare (طَارَ)، cadere (وَقَعَ، سَقَطَ)، stare (مَكَثَ)."},{"btype":"example","text":"essere","note":"io ero، tu eri، lui/lei era، noi eravamo، voi eravate، loro erano"},{"btype":"example","text":"costruire","note":"io costruivo، tu costruivi، lui/lei costruiva، noi costruivamo، voi costruivate، loro costruivano"},{"btype":"example","text":"fare","note":"io facevo، tu facevi، lui/lei faceva، noi facevamo، voi facevate، loro facevano"},{"btype":"example","text":"dire","note":"io dicevo، tu dicevi، lui/lei diceva، noi dicevamo، voi dicevate، loro dicevano"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"essere","meaning":"يكون","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"ero","tu":"eri","lui/lei":"era","noi":"eravamo","voi":"eravate","loro":"erano"},"difficulty":2},{"infinitive":"costruire","meaning":"يبني","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"costruivo","tu":"costruivi","lui/lei":"costruiva","noi":"costruivamo","voi":"costruivate","loro":"costruivano"},"difficulty":2},{"infinitive":"fare","meaning":"يفعل، يصنع","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"facevo","tu":"facevi","lui/lei":"faceva","noi":"facevamo","voi":"facevate","loro":"facevano"},"difficulty":2},{"infinitive":"dire","meaning":"أَخْبَرَ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"dicevo","tu":"dicevi","lui/lei":"diceva","noi":"dicevamo","voi":"dicevate","loro":"dicevano"},"difficulty":2},{"infinitive":"esistere","meaning":"وُجِدَ","tens