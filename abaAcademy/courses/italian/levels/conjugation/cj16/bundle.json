{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futuro): scappare (هَرَبَ)، sembrare (بَدَا)، crescere (نَمَى)، dovere (وَجَبَ، لَابُدَّ)، vivere (حَيِيَ)، usare (اِسْتَعْمَلَ)، uscire (خَرَجَ)، piacere (مُتْعَة)، muovere (تَحَرَّكَ)، parere (فِكْرَة)."},{"btype":"example","text":"scappare","note":"io scapperò، tu scapperai، lui/lei scapperà، noi scapperemo، voi scapperete، loro scapperanno"},{"btype":"example","text":"sembrare","note":"io sembrerò، tu sembrerai، lui/lei sembrerà، noi sembreremo، voi sembrerete، loro sembreranno"},{"btype":"example","text":"crescere","note":"io crescerò، tu crescerai، lui/lei crescerà، noi cresceremo، voi crescerete، loro cresceranno"},{"btype":"example","text":"dovere","note":"io dovrò، tu dovrai، lui/lei dovrà، noi dovremo، voi dovrete، loro dovranno"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"scappare","meaning":"هَرَبَ","tense":"المستقبل (futuro)","forms":{"io":"scapperò","tu":"scapperai","lui/lei":"scapperà","noi":"scapperemo","voi":"scapperete","loro":"scapperanno"},"difficulty":2},{"infinitive":"sembrare","meaning":"بَدَا","tense":"المستقبل (futuro)","forms":{"io":"sembrerò","tu":"sembrerai","lui/lei":"sembrerà","noi":"sembreremo","voi":"sembrerete","loro":"sembreranno"},"difficulty":2},{"infinitive":"crescere","meaning":"نَمَى","tense":"المستقبل (futuro)","forms":{"io":"crescerò","tu":"crescerai","lui/lei":"crescerà","noi":"cresceremo","voi":"crescerete","loro":"cresceranno"},"difficulty":2},{"infinitive":"dovere","meaning":"وَجَبَ، لَابُدَّ","tense":"المستقبل (futuro)","forms":{"io":"dovrò","tu":"dovrai","lui/lei":"dovrà","noi":"dovremo","voi":"dovrete","loro":"dovranno"},"difficulty":2},{"inf