{"theory":{"blocks":[{"btype":"text","text":"الشرطي (condizionale): venire (جَاءَ)، morire (مَاتَ)، suonare (عَزَفَ)، arrivare (قَدِمَ)، capitare (حَدَثَ)، diventare (صَارَ)، entrare (دَخَلَ)، mancare (أَخْطَأَ، فَاتَ)، restare (مَكَثَ)، tornare (رَجَعَ)."},{"btype":"example","text":"venire","note":"io verrei، tu verresti، lui/lei verrebbe، noi verremmo، voi verreste، loro verrebbero"},{"btype":"example","text":"morire","note":"io morirei، tu moriresti، lui/lei morirebbe، noi moriremmo، voi morireste، loro morirebbero"},{"btype":"example","text":"suonare","note":"io suonerei، tu suoneresti، lui/lei suonerebbe، noi suoneremmo، voi suonereste، loro suonerebbero"},{"btype":"example","text":"arrivare","note":"io arriverei، tu arriveresti، lui/lei arriverebbe، noi arriveremmo، voi arrivereste، loro arriverebbero"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"venire","meaning":"جَاءَ","tense":"الشرطي (condizionale)","forms":{"io":"verrei","tu":"verresti","lui/lei":"verrebbe","noi":"verremmo","voi":"verreste","loro":"verrebbero"},"difficulty":2},{"infinitive":"morire","meaning":"مَاتَ","tense":"الشرطي (condizionale)","forms":{"io":"morirei","tu":"moriresti","lui/lei":"morirebbe","noi":"moriremmo","voi":"morireste","loro":"morirebbero"},"difficulty":2},{"infinitive":"suonare","meaning":"عَزَفَ","tense":"الشرطي (condizionale)","forms":{"io":"suonerei","tu":"suoneresti","lui/lei":"suonerebbe","noi":"suoneremmo","voi":"suonereste","loro":"suonerebbero"},"difficulty":2},{"infinitive":"arrivare","meaning":"قَدِمَ","tense":"الشرطي (condizionale)","forms":{"io":"arriverei","tu":"arriveresti","lui/lei":"arriverebbe","noi":"arriveremmo","voi":"arrivereste","loro