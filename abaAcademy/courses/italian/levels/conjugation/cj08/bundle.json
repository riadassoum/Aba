{"theory":{"blocks":[{"btype":"text","text":"الماضي المستمرّ (imperfetto): passare (قَضَى)، piovere (أَمْطَرَ)، potere (قَدَرَ، اِسْتَطَاعَ)، andare (يذهب)، prendere (أَخَذَ)، volere (أَرَادَ)، fallire (أَخْفَقَ)، partire (تَرَكَ)، finire (اِنْتَهَى، أَنْهَى)، nevicare (أَثْلَجَ)."},{"btype":"example","text":"passare","note":"io passavo، tu passavi، lui/lei passava، noi passavamo، voi passavate، loro passavano"},{"btype":"example","text":"piovere","note":"io piovevo، tu piovevi، lui/lei pioveva، noi piovevamo، voi piovevate، loro piovevano"},{"btype":"example","text":"potere","note":"io potevo، tu potevi، lui/lei poteva، noi potevamo، voi potevate، loro potevano"},{"btype":"example","text":"andare","note":"io andavo، tu andavi، lui/lei andava، noi andavamo، voi andavate، loro andavano"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"passare","meaning":"قَضَى","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"passavo","tu":"passavi","lui/lei":"passava","noi":"passavamo","voi":"passavate","loro":"passavano"},"difficulty":2},{"infinitive":"piovere","meaning":"أَمْطَرَ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"piovevo","tu":"piovevi","lui/lei":"pioveva","noi":"piovevamo","voi":"piovevate","loro":"piovevano"},"difficulty":2},{"infinitive":"potere","meaning":"قَدَرَ، اِسْتَطَاعَ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"potevo","tu":"potevi","lui/lei":"poteva","noi":"potevamo","voi":"potevate","loro":"potevano"},"difficulty":2},{"infinitive":"andare","meaning":"يذهب","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"andavo","tu":"andavi","lui/lei":"andava","noi":"andavamo","voi":"andavate","loro":"andavano"},"difficulty