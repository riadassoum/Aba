{"theory":{"blocks":[{"btype":"text","text":"الماضي المستمرّ (imperfetto): scappare (هَرَبَ)، sembrare (بَدَا)، crescere (نَمَى)، dovere (وَجَبَ، لَابُدَّ)، vivere (حَيِيَ)، usare (اِسْتَعْمَلَ)، uscire (خَرَجَ)، piacere (مُتْعَة)، muovere (تَحَرَّكَ)، parere (فِكْرَة)."},{"btype":"example","text":"scappare","note":"io scappavo، tu scappavi، lui/lei scappava، noi scappavamo، voi scappavate، loro scappavano"},{"btype":"example","text":"sembrare","note":"io sembravo، tu sembravi، lui/lei sembrava، noi sembravamo، voi sembravate، loro sembravano"},{"btype":"example","text":"crescere","note":"io crescevo، tu crescevi، lui/lei cresceva، noi crescevamo، voi crescevate، loro crescevano"},{"btype":"example","text":"dovere","note":"io dovevo، tu dovevi، lui/lei doveva، noi dovevamo، voi dovevate، loro dovevano"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","verbs":[{"infinitive":"scappare","meaning":"هَرَبَ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"scappavo","tu":"scappavi","lui/lei":"scappava","noi":"scappavamo","voi":"scappavate","loro":"scappavano"},"difficulty":2},{"infinitive":"sembrare","meaning":"بَدَا","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"sembravo","tu":"sembravi","lui/lei":"sembrava","noi":"sembravamo","voi":"sembravate","loro":"sembravano"},"difficulty":2},{"infinitive":"crescere","meaning":"نَمَى","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"crescevo","tu":"crescevi","lui/lei":"cresceva","noi":"crescevamo","voi":"crescevate","loro":"crescevano"},"difficulty":2},{"infinitive":"dovere","meaning":"وَجَبَ، لَابُدَّ","tense":"الماضي المستمرّ (imperfetto)","forms":{"io":"dovevo","tu":"dovevi","lui/lei":"doveva","noi":"dovevamo","voi":