{"theory":{"blocks":[{"btype":"text","text":"الدرس 215. الكلمات الجديدة: sfortunatamente، coperto، lavo، pensiamo، desidero، nascose، guadagna، cambierà، credevo، visitatori."},{"btype":"example","text":"sfortunatamente = لِلْأَسَف","note":"مثال: È sfortunatamente vero. — للأسف ذلك صحيح."},{"btype":"example","text":"coperto = مُغَطًّى","note":"مثال: Ha coperto la macchina. — غطت السيارة."},{"btype":"example","text":"lavo = غَسَلَ","note":"صيغة من lavare (المتكلّم، المضارع)؛ مثال: Lavo i piatti. — أنا أغسل الأواني."},{"btype":"example","text":"pensiamo = فَكَرَ، فَكَّرَ","note":"صيغة من pensare (الجمع، المتكلّم، صيغة الالتماس (الشرطية))؛ مثال: Pensiamo, quindi siamo. — نفكر، إذن نحن موجودون."},{"btype":"example","text":"desidero = تَمَنَّى","note":"صيغة من desiderare (المتكلّم، المضارع)"},{"btype":"example","text":"nascose = أَخْفَى","note":"صيغة من nascondere (الغائب، الماضي)"},{"btype":"example","text":"guadagna = كَسَبَ","note":"صيغة من guadagnare (الغائب، المضارع)؛ مثال: Guadagna tre volte più di me. — انه يكسب ثلاثة أضعاف أكثر مني ."},{"btype":"example","text":"cambierà = تَغَيَّرَƒ، غَيَّرَ","note":"صيغة من cambiare (الغائب، المستقبل)؛ مثال: Cambierà tutto. — كل شيئ سيتغير."},{"btype":"example","text":"credevo = ظَنَّ","note":"صيغة من credere (المتكلّم، الماضي المستمرّ)؛ مثال: Credevo fosse vero. — ظننته صحيحًا."},{"btype":"example","text":"visitatori = زَائِر","note":"صيغة من visitatore (الجمع)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Lavo i piatti.","note":"أنا أغسل الأواني."},{"btype":"example","text":"Cambierà tutto.","note":"كل شيئ سيتغير."},{"btype":"example","text":"L'Algeria cambierà?","note":"هل ستتغيّر الجزائر؟"},{"btype":"example","text":"Credevo fosse vero.","note":"ظننته صحيحًا."},{"btype":"example","text":"Non cambierà niente.","note":"لن يُغَيِّرَ ذلك شيئًا."},{"btype":"example","text":"È sfortunatamente vero.","note":"للأسف ذلك صحيح."},{"btype":"example","text":"Ha coperto la macchina.","note":"غطت السيارة."},{"btype":"example","text":"Pensiamo, quindi siamo.","note":"نفكر، إذن نحن موجودون."},{"btype":"example","text":"Yanni non cambierà idea.","note":"لن يغير ياني رأيه."},{"btype":"example","text":"Solitamente lavo i piatti.","note":"عادة ما أغسل الصحون."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Lavo i piatti.","ar":"أنا أغسل الأواني."},{"t":"Cambierà tutto.","ar":"كل شيئ سيتغير."},{"t":"L'Algeria cambierà?","ar":"هل ستتغيّر الجزائر؟"},{"t":"Credevo fosse vero.","ar":"ظننته صحيحًا."},{"t":"Non cambierà niente.","ar":"لن يُغَيِّرَ ذلك شيئًا."},{"t":"È sfortunatamente vero.","ar":"للأسف ذلك صحيح."},{"t":"Ha coperto la macchina.","ar":"غطت السيارة."},{"t":"Pensiamo, quindi siamo.","ar":"نفكر، إذن نحن موجودون."},{"t":"Yanni non cambierà idea.","ar":"لن يغير ياني رأيه."},{"t":"Solitamente lavo i piatti.","ar":"عادة ما أغسل الصحون."},{"t":"Guadagna tre volte più di me.","ar":"انه يكسب ثلاثة أضعاف أكثر مني ."},{"t":"Sami cambierà la vita di Layla.","ar":"سيغيّر سامي حياة ليلى."},{"t":"Sfortunatamente, non ha piovuto.","ar":"لسوء الحظ، لم تمطر."},{"t":"Lui guadagna tre volte più di me.","ar":"انه يكسب ثلاثة أضعاف أكثر مما افعل انا ."},{"t":"Tom non cambierà la sua opinione.","ar":"توم لن يغير رأيه."},{"t":"Il Monte Fuji era coperto di neve.","ar":"كان جبل فوجي مغطى بالثلج."},{"t":"Sfortunatamente non ho soldi con me.","ar":"للأسف ليس لدي أي مال معي."},{"t":"Mi lavo i denti due volte al giorno.","ar":"أنظّف أسناني مرّتين يوميّا."},{"t":"Il Monte Fuji è coperto di neve d'inverno.","ar":"يصبح جبل فوجي مغطًى بالثلج في الشتاء."},{"t":"Ieri ho letto un libro che, sfortunatamente, era molto noioso.","ar":"بالأمس قرأت كتاباً للأسف كان مُملاً جداً."}],"focus":["sfortunatamente","coperto","lavo","pensiamo","desidero","nascose","guadagna","cambierà","credevo","visitatori"],"words":[{"word":"sfortunatamente","topic":"L215","difficulty":2,"meaning":"لِلْأَسَف","example":"È sfortunatamente vero.","translation":"للأسف ذلك صحيح."},{"word":"coperto","topic":"L215","difficulty":2,"meaning":"مُغَطًّى","example":"Ha coperto la macchina.","translation":"غطت السيارة."}],"difficulty":2}}