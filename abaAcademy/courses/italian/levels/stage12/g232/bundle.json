ro.","ar":"إشتريتُ مزهريةً زجاجيةً."},{"t":"Gli ho causato molti problemi.","ar":"لقد سببت له الكثير من المتاعب."},{"t":"Chi ha tradotto questa lettera?","ar":"من ترجم هذه الرسالة؟"},{"t":"\"Pioverà domani?\" \"Spero di no.\"","ar":"هل ستمطر غدا؟ لا أتمني ذلك"},{"t":"Lo ha tradotto parola per parola.","ar":"ترجمت النص حرفياً."},{"t":"Non mi è mai piaciuta la biologia.","ar":"لم أحب مادة الأحياء قط."},{"t":"Ma c'è un altro lato della storia.","ar":"لكن للقصّة جانب آخر."},{"t":"Mary non ha ancora tradotto il libro.","ar":"لم تترجم ماري الكتاب بعد."},{"t":"Tom non ha ancora tradotto l'articolo.","ar":"لم يترجم توم المقال بعد."},{"t":"Ci siamo divertiti a giocare a scacchi.","ar":"أمضينا وقتاً ممتعاً و نحن نلعب الشطرنج."},{"t":"Tom e Mary si sono divertiti alla festa.","ar":"لم يفوت توم وماري على أنفسهما الاستمتاع بالحفلة."},{"t":"Non penso che pioverà questo pomeriggio.","ar":"لا أظن أنها ستمطر بعد الظهر."},{"t":"Il Corano è stato tradotto in molte lingue.","ar":"القرآن تُرجم إلى لغات عديدة."},{"t":"Marika ha tradotto il mio libro in tedesco.","ar":"ترجمت ماريكا كتابي إلى الألمانية."},{"t":"Il romanzo è stato tradotto in molte lingue.","ar":"ترجمت الرواية إلى العديد من اللغات."},{"t":"Per quel che so, il romanzo non è stato tradotto in giapponese.","ar":"حسب علمي، لم تترجم الرواية إلى اليابانية."}],"focus":["biologia","causato","vaso","benzina","divertiti","pioverà","tradotto","rose","deliziosa","lato"],"words":[{"word":"biologia","topic":"L232","difficulty":3,"meaning":"عِلْم اَلْأَحْيَاء","example":"Non mi è mai piaciuta la biologia.","translation":"لم أحب مادة الأحياء قط."},{"word":"vaso","topic":"L232","difficulty":3,"meaning":"زَهْرِيَّة","example":"Chi ha rotto il vaso?","translation":"من كسر المزهرية؟"},{"word":"benzina","topic":"L232","difficulty":3,"meaning":"بَنْزِين","example":"Abbiamo finito la benzina.","translation":"لقد نفذ ما لدينا من الغاز ."},{"word":"divertiti","topic":"L232","difficulty":3,"meaning":"اِسْتَمْتِعْ","example":"Divertiti!","translation