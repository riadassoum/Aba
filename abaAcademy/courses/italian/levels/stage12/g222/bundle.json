{"theory":{"blocks":[{"btype":"text","text":"الدرس 222. الكلمات الجديدة: profonda، fisico، studiano، troveremo، amavo، ultimo، gennaio، promesse، insegnando، dovevi."},{"btype":"example","text":"profonda = عميق","note":"صيغة من profondo (المؤنث)؛ مثال: L'acqua era profonda. — كان الماء عميقا."},{"btype":"example","text":"fisico = مَادِّيّ","note":""},{"btype":"example","text":"studiano = ذَاكَرَ، دَرَسَ","note":"صيغة من studiare (الجمع، الغائب، المضارع)؛ مثال: Gli studenti studiano a scuola. — التلاميذ يدرسون في المدرسة."},{"btype":"example","text":"troveremo = وَجَدَ","note":"صيغة من trovare (الجمع، المتكلّم، المستقبل)"},{"btype":"example","text":"amavo = أَحَبَّ","note":"صيغة من amare (المتكلّم، الماضي المستمرّ)؛ مثال: Amavo il berbero. — كنت أحب الأمازيغية."},{"btype":"example","text":"ultimo = آخِر","note":""},{"btype":"example","text":"gennaio = يَنَايِر","note":""},{"btype":"example","text":"promesse = وَعْد","note":"صيغة من promessa (الجمع)"},{"btype":"example","text":"insegnando = عَلَّمَ","note":"صيغة من insegnare (صيغة المصدر الجاري)؛ مثال: Stai insegnando spagnolo? — هل تدرّس الإسبانية؟"},{"btype":"example","text":"dovevi = وَجَبَ، لَابُدَّ","note":"صيغة من dovere (المخاطب، الماضي المستمرّ)؛ مثال: Non dovevi essere dei nostri? — ألم يكن من المفترض أن تكون واحدا منا؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Amavo il berbero.","note":"كنت أحب الأمازيغية."},{"btype":"example","text":"L'acqua era profonda.","note":"كان الماء عميقا."},{"btype":"example","text":"Amavo parlare in berbero.","note":"كنت أحب التكلم بالأمازيغية."},{"btype":"example","text":"Stai insegnando spagnolo?","note":"هل تدرّس الإسبانية؟"},{"btype":"example","text":"È quello che amavo di Tom.","note":"هذا ما أحببته بشأن \"توم\""},{"btype":"example","text":"Non dovevi essere dei nostri?","note":"ألم يكن من المفترض أن تكون واحدا منا؟"},{"btype":"example","text":"Sto insegnando loro a nuotare.","note":"أنا أعلّمهم السباحة."},{"btype":"example","text":"Gli studenti studiano a scuola.","note":"التلاميذ يدرسون في المدرسة."},{"btype":"example","text":"Qualcuno ti sta insegnando il francese?","note":"هل يوجد شخص ما يعلمكَ الفرنسية؟"},{"btype":"example","text":"Sta insegnando il Corano ai suoi figli.","note":"هو يعلم القرآن لأولاده."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Amavo il berbero.","ar":"كنت أحب الأمازيغية."},{"t":"L'acqua era profonda.","ar":"كان الماء عميقا."},{"t":"Amavo parlare in berbero.","ar":"كنت أحب التكلم بالأمازيغية."},{"t":"Stai insegnando spagnolo?","ar":"هل تدرّس الإسبانية؟"},{"t":"È quello che amavo di Tom.","ar":"هذا ما أحببته بشأن \"توم\""},{"t":"Non dovevi essere dei nostri?","ar":"ألم يكن من المفترض أن تكون واحدا منا؟"},{"t":"Sto insegnando loro a nuotare.","ar":"أنا أعلّمهم السباحة."},{"t":"Gli studenti studiano a scuola.","ar":"التلاميذ يدرسون في المدرسة."},{"t":"Qualcuno ti sta insegnando il francese?","ar":"هل يوجد شخص ما يعلمكَ الفرنسية؟"},{"t":"Sta insegn