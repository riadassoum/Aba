 حصانا لدى توم؟"},{"t":"Dove ha preso quel maglione?","ar":"من أين حصل على هذه الكنزة؟"},{"t":"Ordini sempre la stessa cosa.","ar":"أنت دائما تطلب نفس الشيء."},{"t":"Ziri possiede questo ristorante.","ar":"زيري هو صاحب هذا المطعم."},{"t":"Sono raramente invitato alle feste.","ar":"نادرًا ما أُدعى إلى الحفلات."},{"t":"Abbiamo raggiunto Londra a mezzanotte.","ar":"وصلنا إلى لندن عند منتصف الليل."},{"t":"Il signor Ford possiede questo terreno.","ar":"السيد فورد يملك هذه الأرض."},{"t":"Tom chiede sempre la mia opinione.","ar":"يسأل توم دائما لرأيي."},{"t":"Una parte di questo terreno è mia.","ar":"جزء من هذه الأرض ملك لي."},{"t":"Sami ha guidato fino alla moschea.","ar":"ذهب سامي بسيّارته إلى المسجد."},{"t":"Per favore, non fate fotografie qui.","ar":"رجاءً لا تصور هنا."},{"t":"Sami era il mio insegnante di arabo.","ar":"كان سامي مدرّسي للعربيّة."},{"t":"Un frigorifero tiene la carne fresca.","ar":"تبقي الثلاجة اللحم طازجا."},{"t":"La bandiera francese è blu, bianca e rossa.","ar":"العلم الفرنسي ازرق و ابيض و احمر."},{"t":"L'Algeria non ha mai cambiato la sua bandiera.","ar":"الجزائر لم تغير علمها أبدا."}],"focus":["possiede","fallito","immaginare","credeva","maglione","fallimento","feste","bei","mezzanotte","ordini"],"words":[{"word":"fallito","topic":"L226","difficulty":3,"meaning":"مُفْلِس","example":"Yanni ha fallito.","translation":"أخفق يانّي."},{"word":"immaginare","topic":"L226","difficulty":3,"meaning":"اِفْتَرَضَ"},{"word":"maglione","topic":"L226","difficulty":3,"meaning":"سْوِيتَر","example":"Dove ha preso quel maglione?","translation":"من أين حصل على هذه الكنزة؟"},{"word":"fallimento","topic":"L226","difficulty":3,"meaning":"فَشَل"},{"word":"mezzanotte","topic":"L226","difficulty":3,"meaning":"مُنْتَصَف لَيْل، مُنْتَصَف اَللَّيْل","example":"Abbiamo raggiunto Londra a mezzanotte.","translation":"وصلنا إلى لندن عند منتصف الليل."}],"difficulty":3}}