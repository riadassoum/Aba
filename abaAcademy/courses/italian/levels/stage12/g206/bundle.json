{"theory":{"blocks":[{"btype":"text","text":"الدرس 206. الكلمات الجديدة: mancava، credono، corte، taglia، single، artificiale، povera، forchetta، coperta، gruppi."},{"btype":"example","text":"mancava = أَخْطَأَ، فَاتَ","note":"صيغة من mancare (الغائب، الماضي المستمرّ)؛ مثال: A Sami mancava Layla. — افتقد سامي ليلى."},{"btype":"example","text":"credono = ظَنَّ","note":"صيغة من credere (الجمع، الغائب، المضارع)؛ مثال: Loro ci credono. — هم يصدقونه."},{"btype":"example","text":"corte = مَحْكَمَة","note":"مثال: Tutte le frasi di Tom sono corte. — كل جمل توم قصيرة."},{"btype":"example","text":"taglia = قَطَعَ، جَرَحَ","note":"صيغة من tagliare (الغائب، المضارع)؛ مثال: Taglia le patate. — قطع البطاطا."},{"btype":"example","text":"single = أَعْزَب","note":"مثال: Sami è ancora single. — لا يزال سامي عازبا."},{"btype":"example","text":"artificiale = مُتَصَنَّع","note":"مثال: È artificiale. — إنه صناعي."},{"btype":"example","text":"povera = فَقِير، مِسْكِين","note":"صيغة من povero؛ مثال: È povera ma felice. — هي فقيرة، لكن سعيدة."},{"btype":"example","text":"forchetta = شَوْكَة","note":"مثال: Manca una forchetta. — هناك شوكة ناقصة."},{"btype":"example","text":"coperta = لِحَاف","note":"مثال: Hanno solo una coperta. — لديهم بطانية واحدة فقط."},{"btype":"example","text":"gruppi = مَجْمُوعَة","note":"صيغة من gruppo (الجمع)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"È artificiale.","note":"إنه صناعي."},{"btype":"example","text":"Loro ci credono.","note":"هم يصدقونه."},{"btype":"example","text":"Taglia le patate.","note":"قطع البطاطا."},{"btype":"example","text":"È povera ma felice.","note":"هي فقيرة، لكن سعيدة."},{"btype":"example","text":"Manca una forchetta.","note":"هناك شوكة ناقصة."},{"btype":"example","text":"A Sami mancava Layla.","note":"افتقد سامي ليلى."},{"btype":"example","text":"Sami è ancora single.","note":"لا يزال سامي عازبا."},{"btype":"example","text":"Hanno solo una coperta.","note":"لديهم بطانية واحدة فقط."},{"btype":"example","text":"A Sami mancava il suo cane.","note":"افتقد سامي لكلبه."},{"btype":"example","text":"Layla era coperta di sangue.","note":"كانت ليلى مغطّاة بالدّم."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"È artificiale.","ar":"إنه صناعي."},{"t":"Loro ci credono.","ar":"هم يصدقونه."},{"t":"Taglia le patate.","ar":"قطع البطاطا."},{"t":"È povera ma felice.","ar":"هي فقيرة، لكن سعيدة."},{"t":"Manca una forchetta.","ar":"هناك شوكة ناقصة."},{"t":"A Sami mancava Layla.","ar":"افتقد سامي ليلى."},{"t":"Sami è ancora single.","ar":"لا يزال سامي عازبا."},{"t":"Hanno solo una coperta.","ar":"لديهم بطانية واحدة فقط."},{"t":"A Sami mancava il suo cane.","ar":"افتقد سامي لكلبه."},{"t":"Layla era coperta di sangue.","ar":"كانت ليلى مغطّاة بالدّم."},{"t":"Potremmo avere una forchetta?","ar":"ألنا بشوكة؟"},{"t":"Tutte le frasi di Tom sono corte.","ar":"كل جمل توم قصيرة."},{"t":"Non riesco a usare bene la forchetta.","ar":"لا اعرف كيف أستخدم الشوكة جيداً."},{