{"theory":{"blocks":[{"btype":"text","text":"الدرس 589. الكلمات الجديدة: tamburello، protocollo، bell'orologio، sedetti، ripartito، Mongolia، credente، cigni، bisognoso، guarendo."},{"btype":"example","text":"tamburello = دَفّ","note":"مثال: Ho regalato un tamburello a mio padre. — أعطيت أبي دفاً كهبة."},{"btype":"example","text":"protocollo = بْرُوتُوكُول","note":"مثال: Questa è una violazione del protocollo diplomatico. — هذا خرق للبروتوكول الدبلوماسي."},{"btype":"example","text":"bell'orologio","note":"مثال: Mio padre mi ha dato un bell'orologio. — أعطاني أبي ساعةً حلوة."},{"btype":"example","text":"sedetti","note":"مثال: Mi sedetti accanto a lui. — جلست إلى جانبه."},{"btype":"example","text":"ripartito","note":"مثال: Il motore è ripartito. — المحرك بدأ مجدداً."},{"btype":"example","text":"Mongolia = مُنْغُولِيَا","note":""},{"btype":"example","text":"credente = مُؤْمِن","note":""},{"btype":"example","text":"cigni","note":"مثال: I cigni migrano da qui alla Florida. — يهاجر البجع من هنا إلى فلوريدا."},{"btype":"example","text":"bisognoso = مِسْكِين","note":"مثال: Sono bisognoso. — أنا مسكين."},{"btype":"example","text":"guarendo","note":"مثال: La ferita sta guarendo. — الجرح يشفى."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sono bisognoso.","note":"أنا مسكين."},{"btype":"example","text":"Il motore è ripartito.","note":"المحرك بدأ مجدداً."},{"btype":"example","text":"La ferita sta guarendo.","note":"الجرح يشفى."},{"btype":"example","text":"Mi sedetti accanto a lui.","note":"جلست إلى جانبه."},{"btype":"example","text":"Le ferite stanno guarendo.","note":"الجراح تشفى."},{"btype":"example","text":"I cigni migrano da qui alla Florida.","note":"يهاجر البجع من هنا إلى فلوريدا."},{"btype":"example","text":"Ho regalato un tamburello a mio padre.","note":"أعطيت أبي دفاً كهبة."},{"btype":"example","text":"Mio padre mi ha dato un bell'orologio.","note":"أعطاني أبي ساعةً حلوة."},{"btype":"example","text":"Questa è una violazione del protocollo diplomatico.","note":"هذا خرق للبروتوكول الدبلوماسي."},{"btype":"example","text":"Non riesco a vedere niente.","note":"لا أرى شيئاً."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Sono bisognoso.","ar":"أنا مسكين."},{"t":"Il motore è ripartito.","ar":"المحرك بدأ مجدداً."},{"t":"La ferita sta guarendo.","ar":"الجرح يشفى."},{"t":"Mi sedetti accanto a lui.","ar":"جلست إلى جانبه."},{"t":"Le ferite stanno guarendo.","ar":"الجراح تشفى."},{"t":"I cigni migrano da qui alla Florida.","ar":"يهاجر البجع من هنا إلى فلوريدا."},{"t":"Ho regalato un tamburello a mio padre.","ar":"أعطيت أبي دفاً كهبة."},{"t":"Mio padre mi ha dato un bell'orologio.","ar":"أعطاني أبي ساعةً حلوة."},{"t":"Questa è una violazione del protocollo diplomatico.","ar":"هذا خرق للبروتوكول الدبلوماسي."},{"t":"Non riesco a vedere niente.","ar":"لا أرى شيئاً."},{"t":"Solo un attimo, per favore.","ar":"لحظة من فضلك."},{"t":"Quale macchina è la nostra?","ar":"أي سيارة هي سيارتنا؟"}]