o","topic":"L429","difficulty":4,"meaning":"مُمْتَاز","example":"È davvero ottimo!","translation":"ذلك رائع حقاً!"},{"word":"fede","topic":"L429","difficulty":4,"meaning":"إِيمَان","example":"Abbi fede.","translation":"كن مؤمنا."}],"difficulty":4}}