ل الذي عندي."},{"t":"Tom era molto spaventato.","ar":"كان توم خائفا جدًا."},{"t":"Sto scrivendo una lettera.","ar":"أكتب رسالة."},{"t":"Sta scrivendo una lettera.","ar":"هو يكتب رسالة."},{"t":"Stai scrivendo una lettera?","ar":"هل تكتب رسالةً؟"},{"t":"Mary sta mentendo a suo padre.","ar":"ماري تكذب على أبيها."},{"t":"Non l'abbiamo mai fatto prima.","ar":"لم يسبق لنا و أن قمنا بهذا من قبل."},{"t":"Sta scrivendo una lunga lettera.","ar":"إنه يكتب رسالة طويلة."},{"t":"Il suo nome non era nella lista.","ar":"لم يكن اسمها في القائمة."},{"t":"Sono convinto che sia innocente.","ar":"أنا مقتنع أنه بريء."},{"t":"Sua madre sta scrivendo una lettera.","ar":"تكتب أمها رسالةً."},{"t":"Mi pare che il treno sia in ritardo.","ar":"يظهر لي أن القطار متأخر."},{"t":"Perché stai scrivendo con una matita?","ar":"لماذا تكتب بقلم رصاص؟"},{"t":"Stamattina mi sono alzato alle sette.","ar":"استيقظت في السابعة هذا الصباح."},{"t":"A quanto pare, l'autobus è in ritardo.","ar":"يبدو أن الحافلة تأخرت عن الوصول."}],"focus":["tanti","scrivendo","alzato","mentendo","cercò","lista","spaventato","l'abbiamo","pare","innocente"],"words":[{"word":"lista","topic":"L147","difficulty":2,"meaning":"قَائِمَة","example":"Il suo nome non era nella lista.","translation":"لم يكن اسمها في القائمة."},{"word":"spaventato","topic":"L147","difficulty":2,"meaning":"خَائِف","example":"Mi ha spaventato.","translation":"لقد أفزعني."},{"word":"innocente","topic":"L147","difficulty":2,"meaning":"بَرِيء","example":"È molto innocente.","translation":"تبدو طيبة جدا."}],"difficulty":2}}