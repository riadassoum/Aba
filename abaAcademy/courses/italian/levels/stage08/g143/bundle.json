ne al pesce.","ar":"أفضّل اللحم على السمك."},{"t":"L'Islam mi ha portato felicità.","ar":"جلب لي الإسلام السعادة."},{"t":"Qual è il tuo animale preferito?","ar":"ما هو حيوانك المفضل؟"},{"t":"Non si può comprare la felicità.","ar":"لا يمكنك شراء السعادة."},{"t":"\"Cosa vuoi?\" \"Voglio un animale.\"","ar":"ماذا تريد؟ أنا أريد حيوان."},{"t":"Nessuno crede che tu sia colpevole.","ar":"لا أحد يصدّق أنك مذنِب."},{"t":"Il primo passo è sempre il più duro.","ar":"الخطوة الأولى دائماً ما تكون الأصعب."},{"t":"Questo animale è più grande di quello.","ar":"هذا الحيوان أكبر من ذاك."},{"t":"Preferirei stare qua che andare da Tom.","ar":"أفضل البقاء هنا على أن أذهب لتوم."},{"t":"La maggior parte delle persone pensa che io sia pazzo.","ar":"يعتقد الكثيرون أني مجنون."}],"focus":["risultato","preferirei","adoro","animale","felicità","duro","colpevole","Beh","malattia","pazzo"],"words":[{"word":"risultato","topic":"L143","difficulty":2,"meaning":"نَتِيجَة","example":"Il tuo successo è il risultato del duro lavoro.","translation":"نجاحك يعود لاجتهادك في عملك."},{"word":"animale","topic":"L143","difficulty":2,"meaning":"حَيَوَان","example":"Il cavallo è un animale.","translation":"الحصان حيوان."},{"word":"felicità","topic":"L143","difficulty":2,"meaning":"سَعَادَة","example":"Cos'è la felicità?","translation":"ما هي السعادة؟"},{"word":"duro","topic":"L143","difficulty":2,"meaning":"صَعْب، صُلْب","example":"Il tuo successo è il risultato del duro lavoro.","translation":"نجاحك يعود لاجتهادك في عملك."},{"word":"colpevole","topic":"L143","difficulty":2,"meaning":"مُذْنِب","example":"Sami era colpevole.","translation":"كان سامي مذنبا."},{"word":"Beh","topic":"L143","difficulty":2,"meaning":"طيّب","example":"Va beh.","translation":"على أية حال."},{"word":"malattia","topic":"L143","difficulty":2,"meaning":"مَرَض"},{"word":"pazzo","topic":"L143","difficulty":2,"meaning":"مَجْنُون","example":"Sei pazzo?","translation":"هل أنت غاضب؟"}],"difficulty":2}}