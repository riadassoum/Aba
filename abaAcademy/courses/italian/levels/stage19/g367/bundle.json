{"theory":{"blocks":[{"btype":"text","text":"الدرس 367. الكلمات الجديدة: gelosia، seguente، preoccupo، pago، registrato، sciopero، lascialo، magia، rilassato، miglia."},{"btype":"example","text":"gelosia = غَيْرَة","note":""},{"btype":"example","text":"seguente = بَعْدَ","note":""},{"btype":"example","text":"preoccupo = هَمَّ","note":"صيغة من preoccupare (المتكلّم، المضارع)؛ مثال: Mi preoccupo per lui. — إنني قلق عليه."},{"btype":"example","text":"pago = ثَمَن","note":"مثال: Pago io. — سأدفع أنا."},{"btype":"example","text":"registrato = سَجَّلَ","note":"صيغة من registrare (اسم المفعول (التصريف الثالث))؛ مثال: Sami ha registrato la chiamata. — سجّل سامي الاتّصال."},{"btype":"example","text":"sciopero = إِضْرَاب","note":"مثال: C'è uno sciopero. — هناك إضراب."},{"btype":"example","text":"lascialo","note":"مثال: Lascialo andare. — دَعَهُ يذهب."},{"btype":"example","text":"magia = سِحْر","note":""},{"btype":"example","text":"rilassato = اِسْتَرْخَى","note":"صيغة من rilassare (اسم المفعول (التصريف الثالث))؛ مثال: Yanni si è rilassato. — استراح ياني."},{"btype":"example","text":"miglia = مِيل","note":"صيغة من miglio (الجمع)؛ مثال: Ci rimangono ancora dieci miglia. — لا يزال أمامنا عشرة أميال."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Pago io.","note":"سأدفع أنا."},{"btype":"example","text":"Lascialo andare.","note":"دَعَهُ يذهب."},{"btype":"example","text":"C'è uno sciopero.","note":"هناك إضراب."},{"btype":"example","text":"Lascialo in pace.","note":"اتركه و شأنه."},{"btype":"example","text":"Mi preoccupo per lui.","note":"إنني قلق عليه."},{"btype":"example","text":"Yanni si è rilassato.","note":"استراح ياني."},{"btype":"example","text":"Sami ha registrato la chiamata.","note":"سجّل سامي الاتّصال."},{"btype":"example","text":"Ci rimangono ancora dieci miglia.","note":"لا يزال أمامنا عشرة أميال."},{"btype":"example","text":"Cosa devo fare ora che mi sono registrato?","note":"ما الذي عليّ فعله الآن بعد أن سجّلت؟"},{"btype":"example","text":"Ti piacciono i libri?","note":"هل تحب الكتب؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Pago io.","ar":"سأدفع أنا."},{"t":"Lascialo andare.","ar":"دَعَهُ يذهب."},{"t":"C'è uno sciopero.","ar":"هناك إضراب."},{"t":"Lascialo in pace.","ar":"اتركه و شأنه."},{"t":"Mi preoccupo per lui.","ar":"إنني قلق عليه."},{"t":"Yanni si è rilassato.","ar":"استراح ياني."},{"t":"Sami ha registrato la chiamata.","ar":"سجّل سامي الاتّصال."},{"t":"Ci rimangono ancora dieci miglia.","ar":"لا يزال أمامنا عشرة أميال."},{"t":"Cosa devo fare ora che mi sono registrato?","ar":"ما الذي عليّ فعله الآن بعد أن سجّلت؟"},{"t":"Ti piacciono i libri?","ar":"هل تحب الكتب؟"},{"t":"Quella casa è la mia.","ar":"ذاك المنزل لي."},{"t":"Non sai nuotare, vero?","ar":"لا يمكنك السباحة، صحيح؟"}],"focus":["gelosia","seguente","preoccupo","pago","registrato","sciopero","lascialo","magia","rilassato","miglia"],"words":[{"word":"gelosia","topic":"L367","difficulty":5,"meaning":"