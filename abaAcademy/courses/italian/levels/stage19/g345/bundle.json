{"theory":{"blocks":[{"btype":"text","text":"الدرس 345. الكلمات الجديدة: fuga، accendi، composta، brucia، Pacifico، tasso، prenderai، fidati، disturbare، ordinata."},{"btype":"example","text":"fuga = فِرَار","note":""},{"btype":"example","text":"accendi = أَشْعَلَ","note":"صيغة من accendere (المخاطب، المضارع)؛ مثال: Accendi le luci. — اشعل الاضاءة"},{"btype":"example","text":"composta = مُرَكَّب","note":"صيغة من composto (المؤنث)؛ مثال: Una settimana è composta da sette giorni. — الأسبوع الواحد فيه سبعة أيام."},{"btype":"example","text":"brucia = أَحْرَقَ، اِحْتَرَقَ","note":"صيغة من bruciare (الغائب، المضارع)؛ مثال: Il legno brucia. — الخشب يحترق."},{"btype":"example","text":"Pacifico = سِلْمِيّ","note":""},{"btype":"example","text":"tasso = مُعَدَّل","note":""},{"btype":"example","text":"prenderai = أَخَذَ","note":"صيغة من prendere (المخاطب، المستقبل)؛ مثال: Prenderai freddo. — ستصاب بالبرد هكذا."},{"btype":"example","text":"fidati = ثابت","note":"صيغة من fidato (الجمع، المذكّر)؛ مثال: Fidati, ma verifica. — ثق ولكن استوثق."},{"btype":"example","text":"disturbare = أزْعَجَ","note":"مثال: Smettila di disturbare tuo padre. — كف عن إزعاج والدك"},{"btype":"example","text":"ordinata = مُنَظَّم","note":"صيغة من ordinato (المؤنث)؛ مثال: Ne ha ordinata una. — لقد طلبت واحد منهم."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Accendi le luci.","note":"اشعل الاضاءة"},{"btype":"example","text":"Il legno brucia.","note":"الخشب يحترق."},{"btype":"example","text":"Prenderai freddo.","note":"ستصاب بالبرد هكذا."},{"btype":"example","text":"Ne ha ordinata una.","note":"لقد طلبت واحد منهم."},{"btype":"example","text":"Fidati, ma verifica.","note":"ثق ولكن استوثق."},{"btype":"example","text":"\"Fidati di me,\" disse.","note":"قال: ثق بي."},{"btype":"example","text":"Il legno brucia facilmente.","note":"يحترق الخشب بسهولة."},{"btype":"example","text":"Accendi la luce, per favore.","note":"أشعل الضوء من فضلك."},{"btype":"example","text":"Smettila di disturbare tuo padre.","note":"كف عن إزعاج والدك"},{"btype":"example","text":"La plastica non brucia facilmente.","note":"لا يحترق البلاستيك بسهولة."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Accendi le luci.","ar":"اشعل الاضاءة"},{"t":"Il legno brucia.","ar":"الخشب يحترق."},{"t":"Prenderai freddo.","ar":"ستصاب بالبرد هكذا."},{"t":"Ne ha ordinata una.","ar":"لقد طلبت واحد منهم."},{"t":"Fidati, ma verifica.","ar":"ثق ولكن استوثق."},{"t":"\"Fidati di me,\" disse.","ar":"قال: ثق بي."},{"t":"Il legno brucia facilmente.","ar":"يحترق الخشب بسهولة."},{"t":"Accendi la luce, per favore.","ar":"أشعل الضوء من فضلك."},{"t":"Smettila di disturbare tuo padre.","ar":"كف عن إزعاج والدك"},{"t":"La plastica non brucia facilmente.","ar":"لا يحترق البلاستيك بسهولة."},{"t":"Una settimana è composta da sette giorni.","ar":"الأسبوع الواحد فيه سبعة أيام."},{"t":"Farò del mio meglio per non disturbare il tuo studio.","ar":"سأحاول ما استطعتُ ألّا أُقاطِع مذاكرت