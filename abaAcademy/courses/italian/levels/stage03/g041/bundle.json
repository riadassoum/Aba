{"theory":{"blocks":[{"btype":"text","text":"الدرس 41. الكلمات الجديدة: dai، mattina، università، cena، andremo، tè، Ecco، sarò، edifici، prossimo."},{"btype":"example","text":"dai = أَعْطَى","note":"صيغة من dare (المخاطب، المضارع)؛ مثال: Dai, Jim. — هيّا يا جيم."},{"btype":"example","text":"mattina = صَبَاح","note":"مثال: Vado a scuola ogni mattina. — أذهب إلى المدرسة كل صباح."},{"btype":"example","text":"università = كُلِّيَّة","note":""},{"btype":"example","text":"cena = عَشَاء","note":"مثال: Cosa c'è per cena? — ماذا للعشاء؟"},{"btype":"example","text":"andremo = ذَهَبَ","note":"صيغة من andare (الجمع، المتكلّم، المستقبل)؛ مثال: Andremo. — سوف نذهب."},{"btype":"example","text":"tè = شَاي، فِنْجَان شَاي","note":"مثال: Gli piace il tè. — انه يحب الشاي."},{"btype":"example","text":"Ecco = هَا","note":"مثال: Ecco un libro. — إليك بكتاب."},{"btype":"example","text":"sarò = كَانَ، كَانَ هُوَ","note":"صيغة من essere (المتكلّم، المستقبل)؛ مثال: Sarò con voi per sempre. — سأبقى معك إلى الأبد."},{"btype":"example","text":"edifici = مَبْنَى","note":"صيغة من edificio (الجمع)"},{"btype":"example","text":"prossimo = قَادِم","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Andremo.","note":"سوف نذهب."},{"btype":"example","text":"Dai, Jim.","note":"هيّا يا جيم."},{"btype":"example","text":"Dove andremo?","note":"أين سنذهب؟"},{"btype":"example","text":"Ecco un libro.","note":"إليك بكتاب."},{"btype":"example","text":"Ecco il treno.","note":"ها قد وصل القطار."},{"btype":"example","text":"Ecco qui, Jim.","note":"تفضّل يا جيم."},{"btype":"example","text":"Quando andremo?","note":"متى علينا الذهاب؟"},{"btype":"example","text":"Gli piace il tè.","note":"انه يحب الشاي."},{"btype":"example","text":"Ecco cosa penso.","note":"هذا ما ظننته"},{"btype":"example","text":"Cosa c'è per cena?","note":"ماذا للعشاء؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count