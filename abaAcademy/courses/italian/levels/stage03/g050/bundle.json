 lingua è come un gioco.","ar":"كل لغة جديدة هي كلعبة."},{"t":"Non puoi fare due cose allo stesso tempo.","ar":"لا يمكنك أن تفعل شيئين في الوقت نفسه."},{"t":"Sami aveva un cane.","ar":"كان لدى سامي كلب."},{"t":"Hai bisogno di noi.","ar":"أنت تحتاجنا."},{"t":"Questo libro è mio.","ar":"هذا الكتاب لي."},{"t":"Il mio libro è qui.","ar":"كتابي هنا."},{"t":"Cosa sta facendo lì?","ar":"ماذا يفعل هناك؟"},{"t":"Sono davvero felice.","ar":"أنا سعيد للغاية."},{"t":"Ci sono andato ieri.","ar":"ذهبت هناك البارحة."}],"focus":["risposta","Norvegia","andò","gioco","Austria","sì","Galles","lingue","dieci","allo"],"words":[{"word":"risposta","topic":"L50","difficulty":1,"meaning":"جَوَاب","example":"Sai la risposta?","translation":"هل تعرف الإجابة؟"},{"word":"Norvegia","topic":"L50","difficulty":1,"meaning":"النُّرْوِيج"},{"word":"gioco","topic":"L50","difficulty":1,"meaning":"لَعِب","example":"Gioco con lui.","translation":"ألعب معه."},{"word":"Austria","topic":"L50","difficulty":1,"meaning":"النَّمْسَا"},{"word":"sì","topic":"L50","difficulty":1,"meaning":"نعم","example":"Sì, lo so.","translation":"نعم أنا أعلم"},{"word":"Galles","topic":"L50","difficulty":1,"meaning":"وِيلْز"},{"word":"dieci","topic":"L50","difficulty":1,"meaning":"عَشَرَة","example":"Conosce dieci lingue.","translation":"هو يعرف عشرة لغات."},{"word":"allo","topic":"L50","difficulty":1,"meaning":"فِي","example":"Tom la pensa allo stesso modo.","translation":"يفكّر توم بنفس الطريقة."}],"difficulty":1}}