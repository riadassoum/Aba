{"theory":{"blocks":[{"btype":"text","text":"الدرس 365. الكلمات الجديدة: sorge، aumenta، disonesto، qualificato، svegliarsi، becco، scavare، scivolato، tossire، fondata."},{"btype":"example","text":"sorge = نَهَضَ","note":"صيغة من sorgere (الغائب، المضارع)"},{"btype":"example","text":"aumenta = اِزْدَاد، زَاد","note":"صيغة من aumentare (الغائب، المضارع)"},{"btype":"example","text":"disonesto = مُخَادِع","note":"مثال: È stupido e disonesto. — هو غبي وغير صادق."},{"btype":"example","text":"qualificato = مُؤَهَّل","note":""},{"btype":"example","text":"svegliarsi = صَحَى","note":"مثال: È abituata a svegliarsi presto. — هي معتادة على الاستيقاظ باكرا."},{"btype":"example","text":"becco = مِنْقَار","note":""},{"btype":"example","text":"scavare = لَغَمَ","note":"مثال: Inizia a scavare. — ابدأ الحفر."},{"btype":"example","text":"scivolato = اِنْزَلَقَ","note":"صيغة من scivolare (اسم المفعول (التصريف الثالث))؛ مثال: Yanni è scivolato sul ghiaccio. — زلق ياني على الجليد."},{"btype":"example","text":"tossire = سَعَلَ","note":""},{"btype":"example","text":"fondata = دامِغ","note":"صيغة من fondato (المؤنث)؛ مثال: Quando fu fondata questa università? — متى أنشئت هذه الجامعة؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Inizia a scavare.","note":"ابدأ الحفر."},{"btype":"example","text":"Continua a scavare.","note":"واصِل الحفر."},{"btype":"example","text":"È stupido e disonesto.","note":"هو غبي وغير صادق."},{"btype":"example","text":"È abituata a svegliarsi presto.","note":"هي معتادة على الاستيقاظ باكرا."},{"btype":"example","text":"Yanni è scivolato sul ghiaccio.","note":"زلق ياني على الجليد."},{"btype":"example","text":"Buon giorno. È tempo di svegliarsi.","note":"صباح الخير. إنهُ وقت الإستيقاظ."},{"btype":"example","text":"Quando fu fondata questa università?","note":"متى أنشئت هذه الجامعة؟"},{"btype":"example","text":"Se ti trovi in un buco, smettila di scavare.","note":"إذا وجدت نفسك في حفرة، توقف عن الحفر."},{"btype":"example","text":"Perché ora stai parlando?","note":"لماذا تتكلم الآن؟"},{"btype":"example","text":"Ziri ha finito il pranzo.","note":"أنهى زيري الغذاء."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Inizia a scavare.","ar":"ابدأ الحفر."},{"t":"Continua a scavare.","ar":"واصِل الحفر."},{"t":"È stupido e disonesto.","ar":"هو غبي وغير صادق."},{"t":"È abituata a svegliarsi presto.","ar":"هي معتادة على الاستيقاظ باكرا."},{"t":"Yanni è scivolato sul ghiaccio.","ar":"زلق ياني على الجليد."},{"t":"Buon giorno. È tempo di svegliarsi.","ar":"صباح الخير. إنهُ وقت الإستيقاظ."},{"t":"Quando fu fondata questa università?","ar":"متى أنشئت هذه الجامعة؟"},{"t":"Se ti trovi in un buco, smettila di scavare.","ar":"إذا وجدت نفسك في حفرة، توقف عن الحفر."},{"t":"Perché ora stai parlando?","ar":"لماذا تتكلم الآن؟"},{"t":"Ziri ha finito il pranzo.","ar":"أنهى زيري الغذاء."},{"t":"A Tom piace davvero Mary.","ar":"توم معجب حقا بماري."},{"t":"Rima ha preso un autobus.","ar":"ركبت ريمة حا