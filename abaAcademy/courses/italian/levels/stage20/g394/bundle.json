{"theory":{"blocks":[{"btype":"text","text":"الدرس 394. الكلمات الجديدة: nevicato، tempio، maggioranza، guadagno، vicinanze، muoiono، dall'albero، balcone، bruciando، insegnerò."},{"btype":"example","text":"nevicato = أَثْلَجَ","note":"صيغة من nevicare (اسم المفعول (التصريف الثالث))؛ مثال: Ha nevicato ieri? — هل أثلجت البارحة؟"},{"btype":"example","text":"tempio = مَعْبَد","note":"مثال: Quando fu costruito questo tempio? — متى بُني هذا المعبد؟"},{"btype":"example","text":"maggioranza = غَالِبِيَّة","note":"مثال: La maggioranza delle persone pensa questo. — يعتقد الكثيرون ذلك."},{"btype":"example","text":"guadagno = كَسَبَ","note":"صيغة من guadagnare (المتكلّم، المضارع)؛ مثال: Guadagno 100 euro al giorno. — أجني مئة يورو في اليوم."},{"btype":"example","text":"vicinanze = قُرْب","note":"صيغة من vicinanza (الجمع)؛ مثال: C'è un ospedale nelle vicinanze. — هناك مستشفى بالقرب من هنا."},{"btype":"example","text":"muoiono = مَاتَ","note":"صيغة من morire (الجمع، الغائب، المضارع)؛ مثال: Muoiono tutti. — الجميع يموت."},{"btype":"example","text":"dall'albero","note":"مثال: Ziri è sceso dall'albero. — نزل زيري من الشجرة."},{"btype":"example","text":"balcone = شُرْفَة","note":""},{"btype":"example","text":"bruciando = أَحْرَقَ، اِحْتَرَقَ","note":"صيغة من bruciare (صيغة المصدر الجاري)؛ مثال: La casa sta bruciando. — المنزل يحترق."},{"btype":"example","text":"insegnerò = عَلَّمَ","note":"صيغة من insegnare (المتكلّم، المستقبل)؛ مثال: Ti insegnerò a guidare una macchina. — سأعلمك كيف تقود السيارة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Muoiono tutti.","note":"الجميع يموت."},{"btype":"example","text":"Ha nevicato ieri?","note":"هل أثلجت البارحة؟"},{"btype":"example","text":"La casa sta bruciando.","note":"المنزل يحترق."},{"btype":"example","text":"I buoni muoiono giovani.","note":"يموت الصالحون صغارًا"},{"btype":"example","text":"Ziri è sceso dall'albero.","note":"نزل زيري من الشجرة."},{"btype":"example","text":"La foresta sta bruciando.","note":"الغابة تحترق."},{"btype":"example","text":"Guadagno 100 euro al giorno.","note":"أجني مئة يورو في اليوم."},{"btype":"example","text":"I fiori muoiono senza acqua.","note":"تموت الأزهار بدون ماء."},{"btype":"example","text":"Niente dolore, niente guadagno.","note":"كل شيء وله ثمن"},{"btype":"example","text":"C'è un ospedale nelle vicinanze.","note":"هناك مستشفى بالقرب من هنا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Muoiono tutti.","ar":"الجميع يموت."},{"t":"Ha nevicato ieri?","ar":"هل أثلجت البارحة؟"},{"t":"La casa sta bruciando.","ar":"المنزل يحترق."},{"t":"I buoni muoiono giovani.","ar":"يموت الصالحون صغارًا"},{"t":"Ziri è sceso dall'albero.","ar":"نزل زيري من الشجرة."},{"t":"La foresta sta bruciando.","ar":"الغابة تحترق."},{"t":"Guadagno 100 euro al giorno.","ar":"أجني مئة يورو في اليوم."},{"t":"I fiori muoiono senza acqua.","ar":"تموت الأزهار بدون ماء."},{"t":"Niente dolore, niente guadagno.","ar":"كل شيء وله ثمن"},{"t":"C'è un ospedale nelle vicinanze.","ar":"هناك مستشفى بالقرب من هنا."},{"t":"La scimmia è caduta dall'albero.","ar":"سقط القرد من الشجرة."},{"t":"Quando fu costruito questo tempio?","ar":"متى بُني هذا المعبد؟"},{"t":"Ti insegnerò a guidare una macchina.","ar":"سأعلمك كيف تقود السيارة."},{"t":"La maggioranza delle persone pensa questo.","ar":"يعتقد الكثيرون ذلك."},{"t":"Se volete, vi insegnerò a giocare a scacchi.","ar":"إن أحببت، فسأعلمك كيف تلعب الشطرنج."}],"focus":["nevicato","tempio","maggioranza","guadagno","vicinanze","muoiono","dall'albero","balcone","bruciando","insegnerò"],"words":[{"word":"tempio","topic":"L394","difficulty":5,"meaning":"مَعْبَد","example":"Quando fu costruito questo tempio?","translation":"متى بُني هذا المعبد؟"},{"word":"maggioranza","topic":"L394","difficulty":5,"meaning":"غَالِبِيَّة","example":"La maggioranza delle persone pensa questo.","translation":"يعتقد الكثيرون ذلك."},{"word":"balcone","topic":"L394","difficulty":5,"meaning":"شُرْفَة"}],"difficulty":5}}