{"theory":{"blocks":[{"btype":"text","text":"الدرس 476. الكلمات الجديدة: vigile، sottovalutare، immortale، arcobaleno، unitevi، peste، rivali، utente، privilegio، volpi."},{"btype":"example","text":"vigile = يَقِظ","note":"مثال: Sii vigile. — توخى الحذر."},{"btype":"example","text":"sottovalutare = اِسْتَخَفَّ","note":"مثال: Mai sottovalutare Tom. — لا تستخفَّ بتوم أبداً."},{"btype":"example","text":"immortale = خَالِد","note":"مثال: L'amore è immortale. — الحب خالد"},{"btype":"example","text":"arcobaleno = قَوْس قُزَح","note":"مثال: Sole e pioggia, arcobaleno. — شمس ومطر, قوس قُزح."},{"btype":"example","text":"unitevi = دَمَجَ","note":"صيغة من unirsi (الجمع، المخاطب، الأمر)؛ مثال: Lavoratori del mondo, unitevi! — يا عمال العالم، اتحدوا!"},{"btype":"example","text":"peste = طَاعُون","note":"مثال: Sami è una piccola peste. — سامي مشاغب صغير."},{"btype":"example","text":"rivali = مُنَافِس","note":"صيغة من rivale (الجمع)؛ مثال: L'Algeria ha dei rivali. — الجزائر تملك منافسين."},{"btype":"example","text":"utente = مُسْتَخْدِم، مُسْتَعْمِل","note":""},{"btype":"example","text":"privilegio = اِمْتِيَاز","note":""},{"btype":"example","text":"volpi = ثَعْلَب","note":"صيغة من volpe (الجمع)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sii vigile.","note":"توخى الحذر."},{"btype":"example","text":"L'amore è immortale.","note":"الحب خالد"},{"btype":"example","text":"Mai sottovalutare Tom.","note":"لا تستخفَّ بتوم أبداً."},{"btype":"example","text":"L'Algeria ha dei rivali.","note":"الجزائر تملك منافسين."},{"btype":"example","text":"Sami è una piccola peste.","note":"سامي مشاغب صغير."},{"btype":"example","text":"Sole e pioggia, arcobaleno.","note":"شمس ومطر, قوس قُزح."},{"btype":"example","text":"Lavoratori del mondo, unitevi!","note":"يا عمال العالم، اتحدوا!"},{"btype":"example","text":"Non sottovalutare il mio potere.","note":"لا تستهن بقوتي."},{"btype":"example","text":"Nessuno è perfetto.","note":"لا يوجد شخص معصوم."},{"btype":"example","text":"Nessuno ha mentito.","note":"لم يكذب أحد."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Sii vigile.","ar":"توخى الحذر."},{"t":"L'amore è immortale.","ar":"الحب خالد"},{"t":"Mai sottovalutare Tom.","ar":"لا تستخفَّ بتوم أبداً."},{"t":"L'Algeria ha dei rivali.","ar":"الجزائر تملك منافسين."},{"t":"Sami è una piccola peste.","ar":"سامي مشاغب صغير."},{"t":"Sole e pioggia, arcobaleno.","ar":"شمس ومطر, قوس قُزح."},{"t":"Lavoratori del mondo, unitevi!","ar":"يا عمال العالم، اتحدوا!"},{"t":"Non sottovalutare il mio potere.","ar":"لا تستهن بقوتي."},{"t":"Nessuno è perfetto.","ar":"لا يوجد شخص معصوم."},{"t":"Nessuno ha mentito.","ar":"لم يكذب أحد."},{"t":"Mi serve del tempo.","ar":"أحتاج وقتا."},{"t":"Sono un panettiere.","ar":"أنا خباز."}],"focus":["vigile","sottovalutare","immortale","arcobaleno","unitevi","peste","rivali","utente","privilegio","volpi"],"words":[{"word":"vigile","topic":"L476","difficulty":4,"meaning":"يَقِظ","example":"Sii 