iri ama l'appartamento di Rima.","ar":"أعجب زيري بشقة ريمة."},{"t":"La nostra amicizia non è durata.","ar":"لم تدم صداقتنا."},{"t":"Tom è un conducente responsabile.","ar":"توم سائق مسؤول."},{"t":"La pioggia è durata cinque giorni.","ar":"استمر المطر خمسة أيام."},{"t":"Non voglio sedermi da solo al buio.","ar":"لا أريد الجلوس في الظلام بمفردي."},{"t":"L'appartamento di Ziri è abbandonato.","ar":"كانت شقّة زيري مهجورة."},{"t":"La polizia è arrivata sulla scena dell'incidente.","ar":"وصل الشرطة إلى مكان الحادثة."}],"focus":["traduzioni","sedermi","l'appartamento","contesto","conducente","durata","complimenti","cerchiamo","dell'incidente","cominciamo"],"words":[{"word":"contesto","topic":"L308","difficulty":4,"meaning":"سِيَاق","example":"Dipende dal contesto.","translation":"يعتمد ذلك على السياق."},{"word":"conducente","topic":"L308","difficulty":4,"meaning":"سَائِق","example":"Tom è un conducente responsabile.","translation":"توم سائق مسؤول."},{"word":"durata","topic":"L308","difficulty":4,"meaning":"مُدَّة","example":"Non è durata tanto.","translation":"لم تقاوم لوقت طويل."},{"word":"complimenti","topic":"L308","difficulty":4,"meaning":"مُبَارَك","example":"Meriti quei complimenti.","translation":"أنت تستحقّ هذا المديح."}],"difficulty":4}}