{"theory":{"blocks":[{"btype":"text","text":"الدرس 283. الكلمات الجديدة: resta، contento، mantenere، svedese، fianco، onesto، aiutarci، colpevole، malattia، innamorata."},{"btype":"example","text":"resta = سَفَاة","note":"مثال: Me ne resta solo uno. — لم يعد لدي إلا واحدة."},{"btype":"example","text":"contento = رَاضٍ","note":"مثال: Sii contento, Ziri. — كن سعيدا يا زيري."},{"btype":"example","text":"mantenere = حَافَظَ","note":"مثال: Dovresti mantenere la tua promessa. — يجب أن تفي بوعدك."},{"btype":"example","text":"svedese = سُوَيْدِيّ","note":"مثال: Voglio imparare lo svedese. — أريد تعلم السويدية."},{"btype":"example","text":"fianco = خَاصِرَة، جِنَاح","note":"مثال: Si è seduta di fianco a me. — جلست بجانبي."},{"btype":"example","text":"onesto = نَزِيه","note":"مثال: Sembri un uomo onesto. — تبدو رجلًا صدوقًا."},{"btype":"example","text":"aiutarci","note":"مثال: Venite ad aiutarci. — تعال و ساعدنا."},{"btype":"example","text":"colpevole = مُذْنِب","note":"مثال: Sami era colpevole. — كان سامي مذنبا."},{"btype":"example","text":"malattia = مَرَض","note":""},{"btype":"example","text":"innamorata = عَاشِق","note":"صيغة من innamorato (المؤنث)؛ مثال: Mi sono innamorata di una donna. — وقعت في حب امرأة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sii contento, Ziri.","note":"كن سعيدا يا زيري."},{"btype":"example","text":"Venite ad aiutarci.","note":"تعال و ساعدنا."},{"btype":"example","text":"Sami era colpevole.","note":"كان سامي مذنبا."},{"btype":"example","text":"Me ne resta solo uno.","note":"لم يعد لدي إلا واحدة."},{"btype":"example","text":"Non era mai contento.","note":"لم يكن راضيا قطّ."},{"btype":"example","text":"La porta resta aperta.","note":"يبقى الباب مفتوحا."},{"btype":"example","text":"Sembri un uomo onesto.","note":"تبدو رجلًا صدوقًا."},{"btype":"example","text":"Ziri si sentiva contento.","note":"شعر زيري بالسعادة."},{"btype":"example","text":"È chiaro che è colpevole.","note":"واضح أنه مذنب."},{"btype":"example","text":"Resta in contatto con lui.","note":"هي تبقى على إتصال معه."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Sii contento, Ziri.","ar":"كن سعيدا يا زيري."},{"t":"Venite ad aiutarci.","ar":"تعال و ساعدنا."},{"t":"Sami era colpevole.","ar":"كان سامي مذنبا."},{"t":"Me ne resta solo uno.","ar":"لم يعد لدي إلا واحدة."},{"t":"Non era mai contento.","ar":"لم يكن راضيا قطّ."},{"t":"La porta resta aperta.","ar":"يبقى الباب مفتوحا."},{"t":"Sembri un uomo onesto.","ar":"تبدو رجلًا صدوقًا."},{"t":"Ziri si sentiva contento.","ar":"شعر زيري بالسعادة."},{"t":"È chiaro che è colpevole.","ar":"واضح أنه مذنب."},{"t":"Resta in contatto con lui.","ar":"هي تبقى على إتصال معه."},{"t":"Sei colpevole di omicidio.","ar":"إنك مذنب بتهمة القتل."},{"t":"Non ti resta che aspettare.","ar":"كل ما يمكنك فعله هو الانتظار."},{"t":"Voglio imparare lo svedese.","ar":"أريد تعلم السويدية."},{"t":"Si è seduta di fianco a me.","ar":"جلست بجانبي."},{"t":"Mi sembra che tu sia onesto.","ar":"يبدو لي أنكَ أمين."},{"t":"Mi piace Tom perché è onesto.","ar":"أحب توم لأنه أمين."},{"t":"Tom si è offerto di aiutarci?","ar":"هل عرض توم مساعدتنا؟"},{"t":"Chiaramente, lui è colpevole.","ar":"واضح أنّه مذنب."},{"t":"Ero troppo contento per dormire.","ar":"لقد كنت مسرورا جدا لكى أنام."},{"t":"Mi sono innamorata di una donna.","ar":"وقعت في حب امرأة."},{"t":"Dovresti mantenere la tua promessa.","ar":"يجب أن تفي بوعدك."},{"t":"Devi mantenere le promesse che fai.","ar":"عليك أن توفي بوعودك."},{"t":"Ha una grande famiglia da mantenere.","ar":"لديه أسرة كبيرة لتتكفل به."},{"t":"C'è una chiesa di fianco a casa mia.","ar":"هناك كنيسة بالقرب من منزلي."},{"t":"Andiamo a vedere se Tom può aiutarci.","ar":"دعنا نذهب لنرى إذا كان توم يستطيع أن يساعدنا."},{"t":"Ha continuato a provare.","ar":"واصل المحاولة."},{"t":"Ho detto che mi dispiace.","ar":"لقد قلت أنا آسف"},{"t":"Sei impegnato oggi, vero?","ar":"أنت مشغول اليوم، ألست كذلك؟"},{"t":"Quando si mangia? Ho fame!","ar":"متى سنأكل اني اشعر بالجوع."},{"t":"Devi andare immediatamente.","ar":"عليك أن تذهب حالاً."}],"focus":["resta","contento","mantenere","svedese","fianco","onesto","aiutarci","colpevole","malattia","innamorata"],"words":[{"word":"resta","topic":"L283","difficulty":3,"meaning":"سَفَاة","example":"Me ne resta solo uno.","translation":"لم يعد لدي إلا واحدة."},{"word":"contento","topic":"L283","difficulty":3,"meaning":"رَاضٍ","example":"Sii contento, Ziri.","translation":"كن سعيدا يا زيري."},{"word":"mantenere","topic":"L283","difficulty":3,"meaning":"حَافَظَ","example":"Dovresti mantenere la tua promessa.","translation":"يجب أن تفي بوعدك."},{"word":"svedese","topic":"L283","difficulty":3,"meaning":"سُوَيْدِيّ","example":"Voglio imparare lo svedese.","translation":"أريد تعلم السويدية."},{"word":"fianco","topic":"L283","difficulty":3,"meaning":"خَاصِرَة، جِنَاح","example":"Si è seduta di fianco a me.","translation":"جلست بجانبي."},{"word":"onesto","topic":"L283","difficulty":3,"meaning":"نَزِيه","example":"Sembri un uomo onesto.","translation":"تبدو رجلًا صدوقًا."},{"word":"colpevole","topic":"L283","difficulty":3,"meaning":"مُذْنِب","example":"Sami era colpevole.","translation":"كان سامي مذنبا."},{"word":"malattia","topic":"L283","difficulty":3,"meaning":"مَرَض"}],"difficulty":3}}