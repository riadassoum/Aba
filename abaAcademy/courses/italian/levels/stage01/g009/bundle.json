i.","ar":"أحب أن أكون معها."},{"t":"Cosa ti piace in Germania?","ar":"ما يعجبك في ألمانيا؟"},{"t":"A Sami non piace più Facebook.","ar":"لم يعد سامي يحبّ فيسبوك."}],"focus":["chi","sia","vi","solo","quello","sempre","siete","siamo","può","posso"],"words":[{"word":"chi","topic":"L9","difficulty":1,"meaning":"مَن","example":"Chi è quello?","translation":"من هذا؟"},{"word":"sia","topic":"L9","difficulty":1,"meaning":"يكون (صيغة الالتماس)"},{"word":"vi","topic":"L9","difficulty":1,"meaning":"ـكم"},{"word":"solo","topic":"L9","difficulty":1,"meaning":"فقط؛ وحيد","example":"Sei da solo?","translation":"هل أنت وحدك؟"},{"word":"quello","topic":"L9","difficulty":1,"meaning":"ذلك","example":"Chi è quello?","translation":"من هذا؟"},{"word":"sempre","topic":"L9","difficulty":1,"meaning":"دائمًا","example":"È sempre d'accordo.","translation":"هو يوافق دائما."},{"word":"siete","topic":"L9","difficulty":1,"meaning":"تكونون","example":"Dove siete andate?","translation":"إلى أين ذهبت؟"},{"word":"siamo","topic":"L9","difficulty":1,"meaning":"نكون","example":"Dove siamo?","translation":"أين نحن؟"},{"word":"può","topic":"L9","difficulty":1,"meaning":"يستطيع","example":"Non può essere vero.","translation":"لا يمكن أن يكون ذلك صحيحاً."},{"word":"posso","topic":"L9","difficulty":1,"meaning":"أستطيع","example":"Non posso.","translation":"لا يمكنني."}],"difficulty":1}}