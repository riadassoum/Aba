{"theory":{"blocks":[{"btype":"text","text":"الدرس 133. الكلمات الجديدة: viveva، giornali، turno، amare، risolto، conoscono، diritti، dovrò، compri، porterò."},{"btype":"example","text":"viveva = حَيِيَ","note":"صيغة من vivere (الغائب، الماضي المستمرّ)؛ مثال: Tom viveva lì. — توم يعيش هناك"},{"btype":"example","text":"giornali = جَرِيدَة","note":"صيغة من giornale (الجمع)؛ مثال: Ci compra dei giornali. — هو يشتري لنا الجرائد."},{"btype":"example","text":"turno = دَوْر","note":"مثال: Era il mio turno? — هل كان دوري؟"},{"btype":"example","text":"amare = أَحَبَّ","note":"مثال: Amare è vedere lei anche nei tuoi sogni. — الحب أن تراها حتى في أحلامك."},{"btype":"example","text":"risolto = ذَابَ","note":"صيغة من risolvere (اسم المفعول (التصريف الثالث))؛ مثال: Come hai risolto il problema? — كيف تخلصت من المشكلة؟"},{"btype":"example","text":"conoscono = عَرَفَ، دَرَى","note":"صيغة من conoscere (الجمع، الغائب، المضارع)؛ مثال: Conoscono Tom. — هم يعرفون توم"},{"btype":"example","text":"diritti = حَقّ","note":"صيغة من diritto (الجمع، المذكّر)؛ مثال: Conosci i tuoi diritti. — اعرف حقوقك."},{"btype":"example","text":"dovrò = وَجَبَ، لَابُدَّ","note":"صيغة من dovere (المتكلّم، المستقبل)"},{"btype":"example","text":"compri = اِشْتَرَى","note":"صيغة من comprare (المخاطب، المضارع)"},{"btype":"example","text":"porterò = أَخَذَ","note":"صيغة من portare (المتكلّم، المستقبل)؛ مثال: Te lo porterò domani. — سأجلبها لك غدا."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Tom viveva lì.","note":"توم يعيش هناك"},{"btype":"example","text":"Conoscono Tom.","note":"هم يعرفون توم"},{"btype":"example","text":"Tom viveva qui.","note":"كان سامي يعيش هنا."},{"btype":"example","text":"Era il mio turno?","note":"هل كان دوري؟"},{"btype":"example","text":"Te lo porterò domani.","note":"سأجلبها لك غدا."},{"btype":"example","text":"Layla viveva al Cairo.","note":"كانت ليلى تعيش في القاهرة."},{"btype":"example","text":"Ci compra dei giornali.","note":"هو يشتري لنا الجرائد."},{"btype":"example","text":"Conosci i tuoi diritti.","note":"اعرف حقوقك."},{"btype":"example","text":"Viveva accanto a suo zio.","note":"كان يسكن بجانب عمه."},{"btype":"example","text":"Sami viveva su una barca.","note":"كان سامي يعيش على متن سفينة."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Tom viveva lì.","ar":"توم يعيش هناك"},{"t":"Conoscono Tom.","ar":"هم يعرفون توم"},{"t":"Tom viveva qui.","ar":"كان سامي يعيش هنا."},{"t":"Era il mio turno?","ar":"هل كان دوري؟"},{"t":"Te lo porterò domani.","ar":"سأجلبها لك غدا."},{"t":"Layla viveva al Cairo.","ar":"كانت ليلى تعيش في القاهرة."},{"t":"Ci compra dei giornali.","ar":"هو يشتري لنا الجرائد."},{"t":"Conosci i tuoi diritti.","ar":"اعرف حقوقك."},{"t":"Viveva accanto a suo zio.","ar":"كان يسكن بجانب عمه."},{"t":"Sami viveva su una barca.","ar":"كان سامي يعيش على متن سفينة."},{"t":"Yanni viveva con uno zio.","ar":"كان ياني يسكن عند أحد أعمامه."},{"t":"Gli piace leggere i giornali.","ar":"يحب قراءة الصحف."},{"t":"Come hai risolto il problema?","ar":"كيف تخلصت من المشكلة؟"},{"t":"Ti porterò a casa in macchina.","ar":"سأوصلك إلى المنزل بالسيارة."},{"t":"Da bambino, Bob viveva a Boston.","ar":"عاش بوب طفولته في بوسطن."},{"t":"Sami viveva nella stessa via di Layla.","ar":"كان سامي يسكن في نفس الشّارع الذي كانت تسكن فيه ليلى."},{"t":"Amare è vedere lei anche nei tuoi sogni.","ar":"الحب أن تراها حتى في أحلامك."},{"t":"\"Di chi sono questi giornali?\" \"Sono di mio padre.\"","ar":"\"لمن هذه الجرائد؟\" \"هي لأبي.\""}],"focus":["viveva","giornali","turno","amare","risolto","conoscono","diritti","dovrò","compri","porterò"],"words":[{"word":"turno","topic":"L133","difficulty":1,"meaning":"دَوْر","example":"Era il mio turno?","translation":"هل كان دوري؟"},{"word":"amare","topic":"L133","difficulty":1,"meaning":"أَحَبَّ","example":"Amare è vedere lei anche nei tuoi sogni.","translation":"الحب أن تراها حتى في أحلامك."}],"difficulty":1}}