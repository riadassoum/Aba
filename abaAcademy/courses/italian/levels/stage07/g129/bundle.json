i.","ar":"لا أريد البكاء أمامها."},{"t":"Sono sempre fiero della mia famiglia.","ar":"أنا دائما فخور بعائلتي."},{"t":"Devi essere molto fiero di tua figlia.","ar":"يجب أن تفخر جدا بابنتك."},{"t":"C'è un uomo strano di fronte alla casa.","ar":"هناك رجل غريب أمام المنزل."},{"t":"La casa di John è di fronte alla chiesa.","ar":"منزل جون مقابل الكنيسة."},{"t":"È la cosa più stupida che abbia mai detto.","ar":"هذا أغبى ما قُلتُه على الإطلاق."},{"t":"Dan non ha niente a che fare con quel sito.","ar":"لا علاقة لدا بهذا."},{"t":"Perché non leggi il Corano?","ar":"لماذا لا تقرأ القرآن؟"},{"t":"Sono ancora all'università.","ar":"ما زلتُ في الجامعة."},{"t":"Che lingue parlano in Belgio?","ar":"ما هي اللغات التي يتكلمها الناس في بلجيكا؟"},{"t":"Mia sorella va all'università.","ar":"ترتاد أختي الجامعة."},{"t":"Fadil è andato all'università.","ar":"ذهب فلضل إلى الجامعة."},{"t":"Aveva paura di viaggiare da sola.","ar":"إنها خائفة من السفر وحدها."},{"t":"È pericoloso guidare così veloce.","ar":"إنه خطر أن تقود بتهور."},{"t":"Non riesco a trovare la mia biro.","ar":"لا يمكنني إيجاد قلمي."}],"focus":["fronte","sito","chiaro","lavori","facilmente","danzare","contratto","stupida","fiero","piscina"],"words":[{"word":"fronte","topic":"L129","difficulty":2,"meaning":"جَبْهَة","example":"Non volevo piangere di fronte a lei.","translation":"لا أريد البكاء أمامها."},{"word":"sito","topic":"L129","difficulty":2,"meaning":"مَوْقِع وِيب","example":"Dan non ha niente a che fare con quel sito.","translation":"لا علاقة لدا بهذا."},{"word":"chiaro","topic":"L129","difficulty":2,"meaning":"وَاضِح","example":"È chiaro?","translation":"أهذا واضح؟"},{"word":"facilmente","topic":"L129","difficulty":2,"meaning":"بِسُهُولَة"},{"word":"danzare","topic":"L129","difficulty":2,"meaning":"رَقَصَ","example":"Fadil amava danzare.","translation":"كان فاضل يحبّ الرّقص."},{"word":"contratto","topic":"L129","difficulty":2,"meaning":"اِتِّفَاقِيَّة","example":"Leggi il contratto.","translation":"اقرأ العقد."},{"word":