{"theory":{"blocks":[{"btype":"text","text":"الدرس 130. الكلمات الجديدة: sorridere، signora، esami، tavola، pavimento، vorrà، aiuterò، volevamo، belli، votato."},{"btype":"example","text":"sorridere = اِبْتَسَمَ","note":"مثال: L'ho visto sorridere. — رأيته يبتسم."},{"btype":"example","text":"signora = سَيِّدَة، خَاتُون","note":"مثال: Non conosco questa signora. — لا أعرف هذه المرأة."},{"btype":"example","text":"esami = اِمْتِحَان","note":"صيغة من esame (الجمع)"},{"btype":"example","text":"tavola = طَاوِلَة","note":"مثال: Forse l'ho lasciato sulla tavola. — لربما تركتها على الطاولة."},{"btype":"example","text":"pavimento = أَرْضِيَّة","note":""},{"btype":"example","text":"vorrà = أَرَادَ","note":"صيغة من volere (الغائب، المستقبل)"},{"btype":"example","text":"aiuterò = سَاعَدَ","note":"صيغة من aiutare (المتكلّم، المستقبل)؛ مثال: Lo aiuterò domani. — سأساعده غداً."},{"btype":"example","text":"volevamo = أَرَادَ","note":"صيغة من volere (الجمع، المتكلّم، الماضي المستمرّ)؛ مثال: Lo volevamo. — كنا نريده."},{"btype":"example","text":"belli = جَمِيل","note":"صيغة من bello (الجمع، المذكّر)؛ مثال: I tuoi capelli sono belli. — شعرك جميل."},{"btype":"example","text":"votato = صَوَّتَ","note":"صيغة من votare (اسم المفعول (التصريف الثالث))؛ مثال: Ho votato Ken. — صوّتُّ لصالح كين."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Lo volevamo.","note":"كنا نريده."},{"btype":"example","text":"Ho votato Ken.","note":"صوّتُّ لصالح كين."},{"btype":"example","text":"Lo aiuterò domani.","note":"سأساعده غداً."},{"btype":"example","text":"L'ho visto sorridere.","note":"رأيته يبتسم."},{"btype":"example","text":"Volevamo delle prove.","note":"كنا نريد أدلة."},{"btype":"example","text":"Ho votato contro di te.","note":"لقد صوّتُّ ضدَّك."},{"btype":"example","text":"I tuoi capelli sono belli.","note":"شعرك جميل."},{"btype":"example","text":"Non conosco questa signora.","note":"لا أعرف هذه المرأة."},{"btype":"example","text":"Scusi, chi è questa signora?","note":"المعذرة، من هذه المرأة؟"},{"btype":"example","text":"Ci ha chiesto cosa volevamo.","note":"هو سألنا ماذا نريد."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Lo volevamo.","ar":"كنا نريده."},{"t":"Ho votato Ken.","ar":"صوّتُّ لصالح كين."},{"t":"Lo aiuterò domani.","ar":"سأساعده غداً."},{"t":"L'ho visto sorridere.","ar":"رأيته يبتسم."},{"t":"Volevamo delle prove.","ar":"كنا نريد أدلة."},{"t":"Ho votato contro di te.","ar":"لقد صوّتُّ ضدَّك."},{"t":"I tuoi capelli sono belli.","ar":"شعرك جميل."},{"t":"Non conosco questa signora.","ar":"لا أعرف هذه المرأة."},{"t":"Scusi, chi è questa signora?","ar":"المعذرة، من هذه المرأة؟"},{"t":"Ci ha chiesto cosa volevamo.","ar":"هو سألنا ماذا نريد."},{"t":"Forse l'ho lasciato sulla tavola.","ar":"لربما تركتها على الطاولة."}],"focus":["sorridere","signora","esami","tavola","pavimento","vorrà","aiuterò","volevamo","belli","votato"],"words":[{"word":"sorridere","topic":"L130","difficulty":1,"meaning":"اِبْ