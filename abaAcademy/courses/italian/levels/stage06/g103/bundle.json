ة."},{"t":"Perché dovrei fermare Tom?","ar":"لماذا يجب أن أوقف توم؟"},{"t":"Tom ha fatto fermare Mary.","ar":"أوقف توم ماري."},{"t":"Questa mela è molto rossa.","ar":"هذه التفاحة شديدة الحمرة."},{"t":"La tua casa è molto carina.","ar":"ما أروع منزلك!"},{"t":"Questo è il tuo primo esame?","ar":"أهذا أول امتحان لك؟"},{"t":"Il film comincia alle dieci.","ar":"يبدأ عرض الفلم الساعة العاشرة."},{"t":"A che ora comincia la scuola?","ar":"متى تبدأ الدراسة؟"},{"t":"Prova a migliorare il tuo inglese.","ar":"حاول أن تحسن من لغتك الإنجليزية."},{"t":"Perché avevi bisogno di un coltello?","ar":"لماذا تحتاج سكينا؟"},{"t":"Non ti piacerà quello che sto per dire.","ar":"لن يعجبك ما سأقول."},{"t":"Non avevi bisogno di comprare questo libro.","ar":"لم يكن عليك اقتناء ذلك الكتاب."}],"focus":["prenderò","avevi","rosa","migliorare","esame","piacerà","comincia","fermare","rossa","carina"],"words":[{"word":"rosa","topic":"L103","difficulty":1,"meaning":"وَرْدَة","example":"Questa rosa è bella.","translation":"هذه الوردة جميلة."},{"word":"migliorare","topic":"L103","difficulty":1,"meaning":"حَسَّنَ","example":"Prova a migliorare il tuo inglese.","translation":"حاول أن تحسن من لغتك الإنجليزية."},{"word":"esame","topic":"L103","difficulty":1,"meaning":"اِمْتِحَان","example":"Ho un esame domani.","translation":"عندي اختبار في الغد."},{"word":"fermare","topic":"L103","difficulty":1,"meaning":"أَوْقَفَ","example":"Non vuoi fermare Tom?","translation":"ألا تريد إيقاف توم؟"}],"difficulty":1}}