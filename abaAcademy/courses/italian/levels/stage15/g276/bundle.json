{"theory":{"blocks":[{"btype":"text","text":"الدرس 276. الكلمات الجديدة: guadagno، muoiono، balcone، bruciando، insegnerò، appena، passaporto، però، soltanto، piedi."},{"btype":"example","text":"guadagno = كَسَبَ","note":"صيغة من guadagnare (المتكلّم، المضارع)"},{"btype":"example","text":"muoiono = مَاتَ","note":"صيغة من morire (الجمع، الغائب، المضارع)؛ مثال: Muoiono tutti. — الجميع يموت."},{"btype":"example","text":"balcone = شُرْفَة","note":""},{"btype":"example","text":"bruciando = أَحْرَقَ، اِحْتَرَقَ","note":"صيغة من bruciare (صيغة المصدر الجاري)؛ مثال: La casa sta bruciando. — المنزل يحترق."},{"btype":"example","text":"insegnerò = عَلَّمَ","note":"صيغة من insegnare (المتكلّم، المستقبل)"},{"btype":"example","text":"appena = بِٱلْكَاد","note":"مثال: Mi sono appena alzato. — استيقظت للتوّ."},{"btype":"example","text":"passaporto = جَوَاز سَفَر","note":"مثال: Passaporto, per favore. — جواز السفر، لو سمحت."},{"btype":"example","text":"però = لٰكِن","note":"مثال: Però non ci sei. — لكنك لست هناك."},{"btype":"example","text":"soltanto = بِالْكَاد","note":"مثال: Grazie. Guardo soltanto. — شكرًا، أنا فقط أنظر."},{"btype":"example","text":"piedi = رِجْل، قَدَم","note":"صيغة من piede (الجمع)؛ مثال: Usa i tuoi piedi. — استخدم قدميك."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Muoiono tutti.","note":"الجميع يموت."},{"btype":"example","text":"Però non ci sei.","note":"لكنك لست هناك."},{"btype":"example","text":"Usa i tuoi piedi.","note":"استخدم قدميك."},{"btype":"example","text":"Sono venuto a piedi.","note":"جئت سيراً على الأقدام."},{"btype":"example","text":"Perché sei in piedi?","note":"لم أنت واقف؟"},{"btype":"example","text":"La casa sta bruciando.","note":"المنزل يحترق."},{"btype":"example","text":"Mi sono appena alzato.","note":"استيقظت للتوّ."},{"btype":"example","text":"Vado a scuola a piedi.","note":"أمشي إلى المدرسة."},{"btype":"example","text":"Passaporto, per favore.","note":"جواز السفر، لو سمحت."},{"btype":"example","text":"Di solito vado a piedi.","note":"عادةً أمشي."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Muoiono tutti.","ar":"الجميع يموت."},{"t":"Però non ci sei.","ar":"لكنك لست هناك."},{"t":"Usa i tuoi piedi.","ar":"استخدم قدميك."},{"t":"Sono venuto a piedi.","ar":"جئت سيراً على الأقدام."},{"t":"Perché sei in piedi?","ar":"لم أنت واقف؟"},{"t":"La casa sta bruciando.","ar":"المنزل يحترق."},{"t":"Mi sono appena alzato.","ar":"استيقظت للتوّ."},{"t":"Vado a scuola a piedi.","ar":"أمشي إلى المدرسة."},{"t":"Passaporto, per favore.","ar":"جواز السفر، لو سمحت."},{"t":"Di solito vado a piedi.","ar":"عادةً أمشي."},{"t":"I buoni muoiono giovani.","ar":"يموت الصالحون صغارًا"},{"t":"Però ha un odore strano.","ar":"ولكن لها رائحة غريبة."},{"t":"Grazie. Guardo soltanto.","ar":"شكرًا، أنا فقط أنظر."},{"t":"La foresta sta bruciando.","ar":"الغابة تحترق."},{"t":"Ha appena perso il treno.","ar":"لقد فوت القطار للتو."},{"t":"Abbiamo appena visto Tom.","ar":"لقد رأين