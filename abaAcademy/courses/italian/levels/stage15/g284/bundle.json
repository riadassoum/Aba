{"theory":{"blocks":[{"btype":"text","text":"الدرس 284. الكلمات الجديدة: riconoscere، profonda، chiara، fisico، studiano، troveremo، polacco، amavo، yoga، Jamal."},{"btype":"example","text":"riconoscere = تَعَرَّفَ","note":""},{"btype":"example","text":"profonda = عميق","note":"صيغة من profondo (المؤنث)؛ مثال: L'acqua era profonda. — كان الماء عميقا."},{"btype":"example","text":"chiara = غِرْقِل","note":""},{"btype":"example","text":"fisico = مَادِّيّ","note":""},{"btype":"example","text":"studiano = ذَاكَرَ، دَرَسَ","note":"صيغة من studiare (الجمع، الغائب، المضارع)"},{"btype":"example","text":"troveremo = وَجَدَ","note":"صيغة من trovare (الجمع، المتكلّم، المستقبل)"},{"btype":"example","text":"polacco = بُولَنْدِيَّة","note":""},{"btype":"example","text":"amavo = أَحَبَّ","note":"صيغة من amare (المتكلّم، الماضي المستمرّ)؛ مثال: Amavo il berbero. — كنت أحب الأمازيغية."},{"btype":"example","text":"yoga = يُوغَا","note":""},{"btype":"example","text":"Jamal","note":"مثال: Jamal è qui. — إن جمال هنا."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Jamal è qui.","note":"إن جمال هنا."},{"btype":"example","text":"È con Jamal.","note":"هي مع جمال."},{"btype":"example","text":"Andiamo, Jamal.","note":"لنذهب يا جمال."},{"btype":"example","text":"Questo è Jamal?","note":"هل هذا جمال؟"},{"btype":"example","text":"Hai visto Jamal?","note":"هل رأيت جمال؟"},{"btype":"example","text":"Amavo il berbero.","note":"كنت أحب الأمازيغية."},{"btype":"example","text":"Siamo qui, Jamal.","note":"نحن هنا يا جمال."},{"btype":"example","text":"Deve essere Jamal.","note":"لا شك أن هذا جمال."},{"btype":"example","text":"Ha ragione, Jamal.","note":"هو محق يا جمال."},{"btype":"example","text":"L'hai visto, Jamal?","note":"هل رأيت هذا يا جمال؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data