 stanza non riceve molto sole.","ar":"لا تشع الشمس على هذه الغرفة كثيراً."},{"t":"Chiudete la porta dietro di voi, per favore.","ar":"من فضلك أغلق الباب خلفك."}],"focus":["riceve","sbagli","guardiamo","incontrerò","pagherò","capisca","diamante","chiudete","aree","durerà"],"words":[{"word":"diamante","topic":"L260","difficulty":2,"meaning":"أَلْمَاس، مَاس","example":"Ha rubato il diamante.","translation":"سرق الألماس."}],"difficulty":2}}