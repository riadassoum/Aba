{"theory":{"blocks":[{"btype":"text","text":"الدرس 372. الكلمات الجديدة: avvicinato، orecchini، munto، discriminazione، contattato، perderò، dichiarazioni، rimosso، anelli، ricordano."},{"btype":"example","text":"avvicinato = قَرُبَ","note":"صيغة من avvicinare (اسم المفعول (التصريف الثالث))؛ مثال: Dan è stato avvicinato da Linda. — اقتربت ليندة من دان."},{"btype":"example","text":"orecchini = قُرْط","note":"صيغة من orecchino (الجمع)؛ مثال: Stai indossando degli orecchini costosi. — انت ترتدين أقراطا غالية."},{"btype":"example","text":"munto = حَلَبَ","note":"صيغة من mungere (اسم المفعول (التصريف الثالث))؛ مثال: Ho munto la mucca. — حلبت البقرة."},{"btype":"example","text":"discriminazione = تَمْيِيز","note":""},{"btype":"example","text":"contattato = اِتَّصَلَ","note":"صيغة من contattare (اسم المفعول (التصريف الثالث))؛ مثال: Layla ha contattato Sami. — اتّصلت ليلى بسامي."},{"btype":"example","text":"perderò = خَسِرَ، فَقَدَ","note":"صيغة من perdere (المتكلّم، المستقبل)؛ مثال: Non perderò! — لن أخسر!"},{"btype":"example","text":"dichiarazioni = دَعْوَى","note":"صيغة من dichiarazione (الجمع)"},{"btype":"example","text":"rimosso = نَقَلَ","note":"صيغة من rimuovere (اسم المفعول (التصريف الثالث))؛ مثال: Il video è stato rimosso. — مُسح الفيديو."},{"btype":"example","text":"anelli = حَلْقَة، خَاتَم","note":"صيغة من anello (الجمع)؛ مثال: Abbiamo degli anelli. — عندنا خواتم."},{"btype":"example","text":"ricordano = تَذَكَّرَ","note":"صيغة من ricordare (الجمع، الغائب، المضارع)؛ مثال: I tuoi occhi mi ricordano delle stelle. — عيناك تذكرانني بالنجوم."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Non perderò!","note":"لن أخسر!"},{"btype":"example","text":"Ho munto la mucca.","note":"حلبت البقرة."},{"btype":"example","text":"Ha munto la vacca.","note":"حلب البقرة."},{"btype":"example","text":"Hanno munto la mucca.","note":"حلبوا البقرة."},{"btype":"example","text":"Abbiamo degli anelli.","note":"عندنا خواتم."},{"btype":"example","text":"Mary ha munto la mucca.","note":"حلبت ماري البقرة."},{"btype":"example","text":"Abbiamo munto la mucca.","note":"حلبنا البقرة."},{"btype":"example","text":"Hai mai munto una mucca?","note":"هل سبق لك و أن حلبت بقرة؟"},{"btype":"example","text":"Layla ha contattato Sami.","note":"اتّصلت ليلى بسامي."},{"btype":"example","text":"Il video è stato rimosso.","note":"مُسح الفيديو."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Non perderò!","ar":"لن أخسر!"},{"t":"Ho munto la mucca.","ar":"حلبت البقرة."},{"t":"Ha munto la vacca.","ar":"حلب البقرة."},{"t":"Hanno munto la mucca.","ar":"حلبوا البقرة."},{"t":"Abbiamo degli anelli.","ar":"عندنا خواتم."},{"t":"Mary ha munto la mucca.","ar":"حلبت ماري البقرة."},{"t":"Abbiamo munto la mucca.","ar":"حلبنا البقرة."},{"t":"Hai mai munto una mucca?","ar":"هل سبق لك و أن حلبت بقرة؟"},{"t":"Layla ha contattato Sami.","ar":"اتّصلت ليلى بسامي."},{"t":"Il video è stato rimosso.","ar":"مُسح الفيديو."},{"t":"Dan è stato avvicinato da Linda.","ar":"اقتربت ليندة من دان."},{"t":"Fadil ha contattato le autorità.","ar":"اتّصل فاضل بالشّرطة."},{"t":"I tuoi occhi mi ricordano delle stelle.","ar":"عيناك تذكرانني بالنجوم."},{"t":"Stai indossando degli orecc