{"theory":{"blocks":[{"btype":"text","text":"الدرس 376. الكلمات الجديدة: perdonerò، intrappolata، piacevo، buia، abbraccia، inaspettato، mescolato، entrando، apprezziamo، accompagnò."},{"btype":"example","text":"perdonerò = سَامَحَ","note":"صيغة من perdonare (المتكلّم، المستقبل)؛ مثال: Non perdonerò Layla. — لن أغفر لليلى."},{"btype":"example","text":"intrappolata = عَالِق","note":"صيغة من intrappolato (المؤنث)؛ مثال: Layla era intrappolata. — أوقعت ليلي في فخّ."},{"btype":"example","text":"piacevo = مُتْعَة","note":"صيغة من piacere (المتكلّم، الماضي المستمرّ)؛ مثال: Piacevo agli insegnanti. — كان المدرّس يحبّني."},{"btype":"example","text":"buia = مُظْلِم","note":"صيغة من buio (المؤنث)؛ مثال: La sua casa era buia. — كان بيته مظلماً."},{"btype":"example","text":"abbraccia = عَانَقَ","note":"صيغة من abbracciare (الغائب، المضارع)؛ مثال: Tom abbraccia Mary. — توم يحتضن ماري."},{"btype":"example","text":"inaspettato = مُفَاجِئ","note":"مثال: È abbastanza inaspettato. — هذا غير متوقع إلى حد ما"},{"btype":"example","text":"mescolato = مُخْتَلِط","note":"مثال: Non ha mescolato. — لم يتحرك كليا."},{"btype":"example","text":"entrando = دَخَلَ","note":"صيغة من entrare (صيغة المصدر الجاري)؛ مثال: L'insegnante sta entrando. — المدرّس قادم."},{"btype":"example","text":"apprezziamo = قَدَّرَ","note":"صيغة من apprezzare (الجمع، المتكلّم، صيغة الالتماس (الشرطية))؛ مثال: Apprezziamo il tuo aiuto. — نُقَدِّر مساعدتك."},{"btype":"example","text":"accompagnò = رَافَقَ، صَاحَبَ","note":"صيغة من accompagnare (الغائب، الماضي)؛ مثال: Lui accompagnò i bambini a scuola. — رافَقَ الأولادَ إلى المَدرَسَةِ"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Non ha mescolato.","note":"لم يتحرك كليا."},{"btype":"example","text":"Tom abbraccia Mary.","note":"توم يحتضن ماري."},{"btype":"example","text":"Non perdonerò Layla.","note":"لن أغفر لليلى."},{"btype":"example","text":"Non ti perdonerò mai.","note":"لن أسامحك أبدا."},{"btype":"example","text":"La sua casa era buia.","note":"كان بيته مظلماً."},{"btype":"example","text":"Layla era intrappolata.","note":"أوقعت ليلي في فخّ."},{"btype":"example","text":"Piacevo agli insegnanti.","note":"كان المدرّس يحبّني."},{"btype":"example","text":"È abbastanza inaspettato.","note":"هذا غير متوقع إلى حد ما"},{"btype":"example","text":"Apprezziamo il tuo aiuto.","note":"نُقَدِّر مساعدتك."},{"btype":"example","text":"L'insegnante sta entrando.","note":"المدرّس قادم."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Non ha mescolato.","ar":"لم يتحرك كليا."},{"t":"Tom abbraccia Mary.","ar":"توم يحتضن ماري."},{"t":"Non perdonerò Layla.","ar":"لن أغفر لليلى."},{"t":"Non ti perdonerò mai.","ar":"لن أسامحك أبدا."},{"t":"La sua casa era buia.","ar":"كان بيته مظلماً."},{"t":"Layla era intrappolata.","ar":"أوقعت ليلي في فخّ."},{"t":"Piacevo agli insegnanti.","ar":"كان المدرّس يحبّني."},{"t":"È abbastanza inaspettato.","ar":"هذا غير متوقع إلى حد ما"},{"t":"Apprezziamo il tuo aiuto.","ar":"نُقَدِّر مساعدتك."},{"t":"L'insegnante sta entrando.","ar":"المدرّس قادم."},{"t":"Lui accompagnò i bambini a scuola.","ar":"رافَقَ الأولادَ إلى المَدرَسَةِ"}],"focus":["perdonerò","intrappolata","piacevo","buia","abbraccia","inaspettato","mescolato","entrando","apprezziamo","accompagnò"],"words":[{"word":"inaspettato","topic":"L376","difficulty":3,"meaning":"مُفَاجِئ","example":"È abbastanza inaspettato.","translation":"هذا غير متوقع إلى حد ما"},{"word":"mescolato","topic":"L376","difficulty":3,"meaning":"مُخْتَلِط","example":"Non ha mescolato.","translation":"لم يتحرك كليا."}],"difficulty":3}}