ato.","ar":"لم تتناول ماري غذاءه بعد."},{"t":"Ha pranzato alla sua scrivania.","ar":"أكلت غداءها على مكتبها."},{"t":"Perché odi così tanto i canadesi?","ar":"لم تكره الكنديّين إلى هذه الدّرجة؟"},{"t":"La Cina è ricca di risorse naturali.","ar":"الصين غنية بالموارد الطبيعية."},{"t":"Grazie per avermi invitato alla festa.","ar":"شكرأ على دعوتكَ لي إلى الحفلة."},{"t":"Hai portato vergogna sulla nostra famiglia.","ar":"أنتَ جلبتَ العار علىَ عائلتنا."},{"t":"Ti sono grato per avermi invitato alla festa.","ar":"أنا ممتن لك لاستضافتك إياي في الحفلة."}],"focus":["all'inizio","canadesi","invito","fida","pranzato","risorse","documento","vergogna","orribile","avermi"],"words":[{"word":"invito","topic":"L305","difficulty":3,"meaning":"دَعْوَة","example":"Ha rifiutato il suo invito.","translation":"رفضت دعوته."},{"word":"documento","topic":"L305","difficulty":3,"meaning":"وَثِيقَة"},{"word":"vergogna","topic":"L305","difficulty":3,"meaning":"خَجَل","example":"Vergogna!","translation":"عار عليك!"},{"word":"orribile","topic":"L305","difficulty":3,"meaning":"رَهِيب","example":"Tom sembra orribile.","translation":"مظهر توم فظيع."}],"difficulty":3}}