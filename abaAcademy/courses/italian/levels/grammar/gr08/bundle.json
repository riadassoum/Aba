{"theory":{"blocks":[{"btype":"text","text":"قاعدة: الماضي المستمرّ (Imperfetto)"},{"btype":"text","text":"للوصف والعادة في الماضي: parlavo، credevo، dormivo. وessere شاذّ: ero، eri، era، eravamo، eravate، erano."},{"btype":"example","text":"Era tardi.","note":"كان الوقت متأخّرًا."},{"btype":"example","text":"Da bambino giocavo a calcio.","note":"في صغري كنت ألعب كرة القدم."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Ero estasiato per le notizie.","ar":"فرحت بالخبر."},{"t":"Poiché ero stanca, mi riposai.","ar":"كما كنت متعبة، اخذت غفوة."},{"t":"La sua delusione era evidente per tutti.","ar":"خيبَةُ أملها كانت جليّة للجميع."},{"t":"Sophie era avida.","ar":"كانت صوفيا شرهة."},{"t":"Ha sposato John non perché lo amava, ma perché era un uomo ricco.","ar":"تجوزت جون ليس لأنها تحبه، بل لأنه رجل غني."},{"t":"L'acqua era blu.","ar":"كان الماء ازرقا"},{"t":"L'acqua era fredda.","ar":"كان الماء باردا"},{"t":"L'acqua era calda.","ar":"كان الماء دافئا"},{"t":"Lui era sorpreso dalla notizia.","ar":"لقد فوجئ بالأخبار."},{"t":"Quando ero all'università, mi piaceva il studiare latino.","ar":"عندما كنت في الجامعة ، استمتعت بدراسة اللغة اللاتينية."},{"t":"Il crimine era premeditato.","ar":"كانت الجريمة مع سبق الإصرار والترصد."},{"t":"Gesù era un ebreo.","ar":"كان عيسى يهوديا."},{"t":"Non ero malato.","ar":"لم أكن مريضاً."},{"t":"Non ero malata.","ar":"لم أكن مريضة."},{"t":"Non ero occupato.","ar":"لم أكن مشغولاً."},{"t":"Non ero occupata.","ar":"لم أكن مشغولة."},{"t":"Tom era triste.","ar":"كان توم حزينا."},{"t":"L'esame non era difficile.","ar":"الإمتحان لم يكن صعباً."},{"t":"L'uomo che ha commesso quel crimine era fuori di senno.","ar":"من ارتكب هذه الجريمة حتماً فقد عقله."},{"t":"Nessuno era presente.","ar":"لم يكن هناك أحد."},{"t":"Questa era la sua sola e unica speranza.","ar":"كان ذلك أمله الوحيد."},{"t":"La sua spiegazione non era soddisfacente.","ar":"شرحه لم يكن كافياً."},{"t":"Ero felice all'epoca.","ar":"كنت سعيداً يومها."},{"t":"Era un tale shock.","ar":"يا لها من صدمة."},{"t":"Il letto dove dormii la scorsa notte non era molto confortevole","ar":"السرير الذي نمت عليه بالأمس لم يكن مريحاً."},{"t":"Il dolore era atroce.","ar":"كان الألم فظيعاً."},{"t":"Bill era in Giappone.","ar":"كان بيل في اليابان."},{"t":"Era una stanza molto grande.","ar":"كانت غرفة كبيرة."},{"t":"Ero in ritardo per via della pioggia.","ar":"تأخرت بسبب المطر."},{"t":"Bob era molto felice.","ar":"كان بوب سعيداً للغاية."},{"t":"Aveva molta sete e chiese un po' d'acqua.","ar":"كان عطشاناً جداً فطلب القليل من الماء."},{"t":"Achille era un antico eroe greco.","ar":"أكيليز بطل أسطوري عند الإغريق."},{"t":"Ieri era giovedì.","ar":"البارحة كان يوم الخميس."},{"t":"La porta d'ingresso era aperta.","ar":"كان الباب مفتوحاً."},{"t":"Era un topo.","ar":"كان ذلك فأراً."},{"t":"Il cane era morto.","ar":"كان الكلب ميتاً."},{"t":"Il segnale era rosso.","ar":"كانت الإشارة حمراء."},{"t":"Era vestito di blu.","ar":"كان مرتدياً اللون الأزرق."},{"t":"Era divertente.","ar":"كان ذلك ممتعًا."},{"t":"Ero a Londra la maggior parte dell'estate.","ar":"كنت في لندن معظم الصيف."},{"t":"Era tardi.","ar":"كان الوقت متأخّرًا."},{"t":"Da bambino giocavo a calcio.","ar":"في صغري كنت ألعب كرة القدم."}]}}