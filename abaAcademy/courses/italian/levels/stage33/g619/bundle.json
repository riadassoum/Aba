{"theory":{"blocks":[{"btype":"text","text":"الدرس 619. الكلمات الجديدة: cassonetto، Erkin، rabbioso، lottiamo، scorrendo، Muhammad، assumerà، lucchetto، collassata، radiofonica."},{"btype":"example","text":"cassonetto","note":""},{"btype":"example","text":"Erkin","note":"مثال: Siamo entrati nell'ufficio e abbiamo trovato Emet ed Erkin a pulire le finestre. — دخلنا إلى المكتب فوجدنا إميت و إركين يمسحان النوافذ."},{"btype":"example","text":"rabbioso","note":"مثال: Il mare è rabbioso. — البحر غاضب."},{"btype":"example","text":"lottiamo","note":"مثال: Lottiamo in continuo. — نحن دائمًا نتشاجر."},{"btype":"example","text":"scorrendo","note":"مثال: L'acqua sta scorrendo. — الماء يجري."},{"btype":"example","text":"Muhammad","note":"مثال: Chi è Muhammad? — من هو محمد؟"},{"btype":"example","text":"assumerà","note":"مثال: Nessuno ti assumerà. — لن يوظفك أحد."},{"btype":"example","text":"lucchetto","note":"مثال: Tom sta provando a rompere il lucchetto. — يحاول توم كسر القفل."},{"btype":"example","text":"collassata","note":"مثال: La casa di Sami è collassata. — انهار منزل سامي."},{"btype":"example","text":"radiofonica","note":"مثال: Lavora in una stazione radiofonica. — هو يعمل في قناة إذاعية."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Chi è Muhammad?","note":"من هو محمد؟"},{"btype":"example","text":"Il mare è rabbioso.","note":"البحر غاضب."},{"btype":"example","text":"Nessuno ti assumerà.","note":"لن يوظفك أحد."},{"btype":"example","text":"Lottiamo in continuo.","note":"نحن دائمًا نتشاجر."},{"btype":"example","text":"L'acqua sta scorrendo.","note":"الماء يجري."},{"btype":"example","text":"Il suo nome è Muhammad.","note":"اسمه محمد."},{"btype":"example","text":"La casa di Sami è collassata.","note":"انهار منزل سامي."},{"btype":"example","text":"La casa di Ziri è collassata.","note":"انهار منزل ياني."},{"btype":"example","text":"Lavora in una stazione radiofonica.","note":"هو يعمل في قناة إذاعية."},{"btype":"example","text":"Lavorava per la stazione radiofonica.","note":"كانت تعمل في تلك المحطة الإذاعية."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"Chi è Muhammad?","ar":"من هو محمد؟"},{"t":"Il mare è rabbioso.","ar":"البحر غاضب."},{"t":"Nessuno ti assumerà.","ar":"لن يوظفك أحد."},{"t":"Lottiamo in continuo.","ar":"نحن دائمًا نتشاجر."},{"t":"L'acqua sta scorrendo.","ar":"الماء يجري."},{"t":"Il suo nome è Muhammad.","ar":"اسمه محمد."},{"t":"La casa di Sami è collassata.","ar":"انهار منزل سامي."},{"t":"La casa di Ziri è collassata.","ar":"انهار منزل ياني."},{"t":"Lavora in una stazione radiofonica.","ar":"هو يعمل في قناة إذاعية."},{"t":"Lavorava per la stazione radiofonica.","ar":"كانت تعمل في تلك المحطة الإذاعية."},{"t":"Tom sta provando a rompere il lucchetto.","ar":"يحاول توم كسر القفل."},{"t":"Siamo entrati nell'ufficio e abbiamo trovato Emet ed Erkin a pulire le finestre.","ar":"دخلنا إلى المكتب فوجدنا إميت و إركين يمسحان النوافذ."}],"focus":["cassonetto","Erkin","rabbioso","lottiamo","scorrendo","Muhammad","assumerà","lucchetto","collassata","radiofonica"],"words":[],"difficulty":5}}