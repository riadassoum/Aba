{"theory":{"blocks":[{"btype":"text","text":"الدرس 423. الكلمات الجديدة: strappare، aggiungerò، occorrono، assalito، accurato، sacra، righello، palloncini، annaffia، ameranno."},{"btype":"example","text":"strappare = مَزَّقَ","note":"مثال: L'ho visto strappare la lettera. — رأيته يقطّع الرسالة."},{"btype":"example","text":"aggiungerò = أَضَافَ","note":"صيغة من aggiungere (المتكلّم، المستقبل)؛ مثال: Lo aggiungerò alla mia lista dei desideri. — سأضيف ذلك إلى قائمة أمنياتي."},{"btype":"example","text":"occorrono = حَدَثَ","note":"صيغة من occorrere (الجمع، الغائب، المضارع)؛ مثال: In situazioni disperate occorrono rimedi disperati. — الضرورات تبيح المحظورات"},{"btype":"example","text":"assalito = هَاجَمَ","note":"صيغة من assalire (اسم المفعول (التصريف الثالث))؛ مثال: Tom ha assalito Mary. — هجم توم على ماري."},{"btype":"example","text":"accurato = دَقِيق","note":"مثال: È accurato. — هذا صحيح."},{"btype":"example","text":"sacra = مُقَدَّس","note":"صيغة من sacro (المؤنث)"},{"btype":"example","text":"righello = مِسْطَرَة","note":""},{"btype":"example","text":"palloncini = نُفَّاخَة","note":"صيغة من palloncino (الجمع)؛ مثال: Yanni vuole altri palloncini d'acqua. — يانّي يريد المزيد من البالونات المائيّة."},{"btype":"example","text":"annaffia = سَقَى","note":"صيغة من annaffiare (الغائب، المضارع)؛ مثال: Annaffia il giardino. — اسق البستان"},{"btype":"example","text":"ameranno = أَحَبَّ","note":"صيغة من amare (الجمع، الغائب، المستقبل)؛ مثال: Le persone lo ameranno. — سوف يعجب الناس."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"È accurato.","note":"هذا صحيح."},{"btype":"example","text":"Tom ha assalito Mary.","note":"هجم توم على ماري."},{"btype":"example","text":"Annaffia il giardino.","note":"اسق البستان"},{"btype":"example","text":"Sami ha assalito Layla.","note":"هاجم سامي ليلى."},{"btype":"example","text":"Le persone lo ameranno.","note":"سوف يعجب الناس."},{"btype":"example","text":"Fadil ha assalito Layla.","note":"اعتدى فاضل على ليلى."},{"btype":"example","text":"Mio padre annaffia i fiori.","note":"أبي يسقي الأزهار."},{"btype":"example","text":"L'ho visto strappare la lettera.","note":"رأيته يقطّع الرسالة."},{"btype":"example","text":"Yanni vuole altri palloncini d'acqua.","note":"يانّي يريد المزيد من البالونات المائيّة."},{"btype":"example","text":"Lo aggiungerò alla mia lista dei desideri.","note":"سأضيف ذلك إلى قائمة أمنياتي."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"it","lang_name":"الإيطالية","sentences":[{"t":"È accurato.","ar":"هذا صحيح."},{"t":"Tom ha assalito Mary.","ar":"هجم توم على ماري."},{"t":"Annaffia il giardino.","ar":"اسق البستان"},{"t":"Sami ha assalito Layla.","ar":"هاجم سامي ليلى."},{"t":"Le persone lo ameranno.","ar":"سوف يعجب الناس."},{"t":"Fadil ha assalito Layla.","ar":"اعتدى فاضل على ليلى."},{"t":"Mio padre annaffia i fiori.","ar":"أبي يسقي الأزهار."},{"t":"L'ho visto strappare la lettera.","ar":"رأيته يقطّع الرسالة."},{"t":"Yanni vuole altri palloncini d'acqua.","ar":"يانّي يريد المزيد من البالونات المائيّة."},{"t":"Lo aggiungerò alla mia lista dei desideri.","ar":"سأضيف ذلك إلى قائمة أمنياتي."},{"t":"I palloncini d'acqua sono molto economici.","ar":"البالونات المائيّة رخيصة جدّا."},{"t":"Yanni ha bisogno di altri palloncini d'acqua.","ar":"يانّي بحاجة للمزيد من البالونات المائيّة."},{"t":"In situazioni disperate occorrono rimedi disperati.","ar":"الضرورات تبيح المحظورات"}],"focus":["strappare","aggiungerò","occorrono","assalito","accurato","sacra","righello","palloncini","annaffia","ameranno"],"words":[{"word":"strappare","topic":"L423","difficulty":3,"meaning":"مَزَّقَ","example":"L'ho visto strappare la lettera.","translation":"رأيته يقطّع الرسالة."},{"word":"accurato","topic":"L423","difficulty":3,"meaning":"دَقِيق","example":"È accurato.","translation":"هذا صحيح."},{"word":"righello","topic":"L423","difficulty":3,"meaning":"مِسْطَرَة"}],"difficulty":3}}