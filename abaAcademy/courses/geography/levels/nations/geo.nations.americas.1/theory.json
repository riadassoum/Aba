{"blocks": [{"btype": "text", "text": "في قارّة الأمريكتان دولٌ كثيرة. تعرّف على بعضها وربطها بقارّتها."}, {"btype": "text", "text": "الآن نسأل في الاتجاهين: من الدولة إلى قارتها والعكس."}, {"btype": "example", "text": "أنتيغوا وباربودا", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "الأوروغواي", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "الإكوادور", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "البهاما", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "الدومينيكان", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "السلفادور", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "المكسيك", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "باراغواي", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "باربادوس", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "بليز", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "بنما", "note": "القارة: الأمريكتان"}, {"btype": "example", "text": "بوليفيا", "note": "القارة: الأمريكتان"}]}