{"blocks": [{"btype": "text", "text": "في قارّة آسيا دولٌ كثيرة. تعرّف على بعضها وربطها بقارّتها."}, {"btype": "text", "text": "الآن نسأل في الاتجاهين: من الدولة إلى قارتها والعكس."}, {"btype": "example", "text": "أذربيجان", "note": "القارة: آسيا"}, {"btype": "example", "text": "أرمينيا", "note": "القارة: آسيا"}, {"btype": "example", "text": "أوزبكستان", "note": "القارة: آسيا"}, {"btype": "example", "text": "إسرائيل", "note": "القارة: آسيا"}, {"btype": "example", "text": "المالديف", "note": "القارة: آسيا"}, {"btype": "example", "text": "بروناي", "note": "القارة: آسيا"}, {"btype": "example", "text": "بوتان", "note": "القارة: آسيا"}, {"btype": "example", "text": "تايلند", "note": "القارة: آسيا"}, {"btype": "example", "text": "تركمانستان", "note": "القارة: آسيا"}, {"btype": "example", "text": "تيمور الشرقية", "note": "القارة: آسيا"}, {"btype": "example", "text": "جورجيا", "note": "القارة: آسيا"}, {"btype": "example", "text": "سريلانكا", "note": "القارة: آسيا"}]}