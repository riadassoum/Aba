{"blocks": [{"btype": "text", "text": "في قارّة أوروبا دولٌ كثيرة. تعرّف على بعضها وربطها بقارّتها."}, {"btype": "text", "text": "في هذه المرحلة تكتب اسم القارة بنفسك من الذاكرة لترسيخ المعلومة."}, {"btype": "example", "text": "آيسلندا", "note": "القارة: أوروبا"}, {"btype": "example", "text": "ألبانيا", "note": "القارة: أوروبا"}, {"btype": "example", "text": "أندورا", "note": "القارة: أوروبا"}, {"btype": "example", "text": "أيرلندا", "note": "القارة: أوروبا"}, {"btype": "example", "text": "إستونيا", "note": "القارة: أوروبا"}, {"btype": "example", "text": "البوسنة والهرسك", "note": "القارة: أوروبا"}, {"btype": "example", "text": "التشيك", "note": "القارة: أوروبا"}, {"btype": "example", "text": "الجبل الأسود", "note": "القارة: أوروبا"}, {"btype": "example", "text": "الدنمارك", "note": "القارة: أوروبا"}, {"btype": "example", "text": "المجر", "note": "القارة: أوروبا"}, {"btype": "example", "text": "المملكة المتحدة", "note": "القارة: أوروبا"}, {"btype": "example", "text": "بلغاريا", "note": "القارة: أوروبا"}]}