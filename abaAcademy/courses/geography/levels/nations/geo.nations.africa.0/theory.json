{"blocks": [{"btype": "text", "text": "في قارّة أفريقيا دولٌ كثيرة. تعرّف على بعضها وربطها بقارّتها."}, {"btype": "text", "text": "تعرّف على دول العالم وقاراتها. الأسئلة هنا اختيار من متعدد لتثبيت التعرّف."}, {"btype": "example", "text": "أفريقيا الوسطى", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "أنغولا", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "أوغندا", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "إريتريا", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "إسواتيني", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "الرأس الأخضر", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "السنغال", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "الغابون", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "الكاميرون", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "الكونغو", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "النيجر", "note": "القارة: أفريقيا"}, {"btype": "example", "text": "بنين", "note": "القارة: أفريقيا"}]}