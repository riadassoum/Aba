{"blocks": [{"btype": "text", "text": "في قارّة أوقيانوسيا دولٌ كثيرة. تعرّف على بعضها وربطها بقارّتها."}, {"btype": "text", "text": "تعرّف على دول العالم وقاراتها. الأسئلة هنا اختيار من متعدد لتثبيت التعرّف."}, {"btype": "example", "text": "بابوا غينيا الجديدة", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "بالاو", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "توفالو", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "تونغا", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "جزر سليمان", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "جزر مارشال", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "ساموا", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "فانواتو", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "فيجي", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "كيريباتي", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "ميكرونيسيا", "note": "القارة: أوقيانوسيا"}, {"btype": "example", "text": "ناورو", "note": "القارة: أوقيانوسيا"}]}