{"blocks": [{"btype": "text", "text": "وراء كلّ اكتشاف عظيم عالِمٌ ومجالٌ من مجالات المعرفة. اربط الاكتشاف بصاحبه ومجاله."}, {"btype": "text", "text": "تعرّف على المعلومات الأساسية في هذا الموضوع. الأسئلة هنا اختيار من متعدد لتثبيت التعرّف قبل الاسترجاع."}, {"btype": "example", "text": "الجاذبية", "note": "العالم: إسحاق نيوتن، المجال: الفيزياء"}, {"btype": "example", "text": "قوانين الحركة", "note": "العالم: إسحاق نيوتن، المجال: الفيزياء"}, {"btype": "example", "text": "النظرية النسبية", "note": "العالم: ألبرت أينشتاين، المجال: الفيزياء"}, {"btype": "example", "text": "البنسلين", "note": "العالم: ألكسندر فلمنغ، المجال: الطب"}, {"btype": "example", "text": "التطعيم ضد الجدري", "note": "العالم: إدوارد جينر، المجال: الطب"}, {"btype": "example", "text": "النشاط الإشعاعي", "note": "العالم: ماري كوري، المجال: الكيمياء والفيزياء"}, {"btype": "example", "text": "دوران الأرض حول الشمس", "note": "العالم: نيكولاس كوبرنيكوس، المجال: الفلك"}, {"btype": "example", "text": "علم الجبر", "note": "العالم: الخوارزمي، المجال: الرياضيات"}]}