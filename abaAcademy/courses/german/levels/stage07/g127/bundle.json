يري يحبّ الأطفال."},{"t":"Er hasst dieses Fahrrad.","ar":"هو يكره هذه الدراجة."},{"t":"Jeder hasst die Polizei.","ar":"الكل يكره الشرطة."},{"t":"Sami hasst diesen Lehrer.","ar":"يكره سامي ذلك المدرّس."},{"t":"Fast niemand glaubte ihr.","ar":"بالكاد لم يصدّقها أحد."},{"t":"Sie hasst dich nicht, Tom.","ar":"هي لا تكرهكَ يا توم."},{"t":"Er hat mich nicht bemerkt.","ar":"هو لم يلاحظني."},{"t":"Ich habe sie auch bemerkt.","ar":"أنا أيضا لاحظتها."},{"t":"Tom hat seinen Job gemacht.","ar":"قام توم بعمله."},{"t":"Sie hat mich nicht bemerkt.","ar":"هي لم تلاحظني."},{"t":"Ich habe dich immer geliebt.","ar":"لطالما أحببتك."},{"t":"Tom hasst dich nicht, Maria.","ar":"توم لا يكرهكِ يا ماري."},{"t":"Hast du mich wirklich geliebt?","ar":"هل كنت حقا تحبني؟"},{"t":"Er hasst mich und ich hasse ihn!","ar":"هو يكرهني وأنا أكرهه!"}],"focus":["redet","Fische","Dach","Job","geliebt","hasst","glaubte","Papier","bemerkt","zieht"],"words":[{"word":"Dach","topic":"L127","difficulty":2,"meaning":"سَقْف"},{"word":"Job","topic":"L127","difficulty":2,"meaning":"عَمَل","example":"Es ist mein Job.","translation":"إن ذلك عملي."},{"word":"Papier","topic":"L127","difficulty":2,"meaning":"وَرَق، وَرَقَة","example":"Papier ist weiß.","translation":"الورق أبيض."}],"difficulty":2}}