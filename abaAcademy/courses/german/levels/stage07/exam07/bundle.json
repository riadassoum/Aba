ine Tasse Tee ein.","ar":"صبت لي كأساً من الشاي."},{"t":"Sie schließt die Tür nicht.","ar":"هي لا تغلق الباب."},{"t":"Ich kann dein Geschenk nicht annehmen.","ar":"لا يمكنني أن أقبل هديّتك."},{"t":"Er mochte die Schule nicht.","ar":"لم يكن يحب المدرسة."},{"t":"Sieh dir diese schwarzen Wolken an.","ar":"أنظر إلى تلك الغيوم السوداء."},{"t":"Layla hat mir das Leben gerettet.","ar":"أنقذت ليلى حياتي."},{"t":"Warum schließt du den Laden?","ar":"لماذا تغلق المتجر؟"},{"t":"Maria hat die Rechnung noch nicht bezahlt.","ar":"لم تسدد ماري الفاتورة بعد."},{"t":"Meinst du, dass Tom kommen wird?","ar":"هل تعتقد أن توم سيأتي؟"},{"t":"Ich bin möglicherweise dein einziger Freund.","ar":"قد أكون صديقك الوحيد."},{"t":"Eine Tür muss entweder geschlossen oder offen sein.","ar":"يجب أن يكون الباب إما مغلقا أو مفتوحا."},{"t":"Wisst ihr, wo sie jetzt ist?","ar":"هل تعرف أين هي الآن؟"},{"t":"Schließt alle Türen und Fenster.","ar":"اغلق جميع الأبواب والنوافذ."},{"t":"Ich bin Student, aber er nicht.","ar":"أنا تلميذ، ولكن هو ليس بواحد."},{"t":"Hast du mich vermisst?","ar":"هل اشتقت إليّ؟"},{"t":"Wie waren deine Ferien?","ar":"كيف كانت إجازتك؟"},{"t":"Frauen verändern die Welt.","ar":"إن النساء يغيرن العالم."},{"t":"Ich will etwas Geld.","ar":"أريد بعض المال."},{"t":"Wir geben mit unserem neuen Boot an.","ar":"نحن نتباهى بسفينتنا الجديدة."},{"t":"Würdet ihr bitte aufpassen?","ar":"هلّا أصغيتم رجاءً؟"},{"t":"Sie hat lange Arme und Beine.","ar":"ذراعيها و رجليها طوال."},{"t":"Ich fahre lieber mit dem Rad.","ar":"أفضّل ركوب الدرّاجة الهوائيّة."},{"t":"Hast du einen Stift?","ar":"ألديك قلم؟"},{"t":"Jemand ruft nach dir.","ar":"أحدهم يتصل بك."},{"t":"Tom gefiel die Arbeit hier.","ar":"استمتع توم بالعمل هنا."},{"t":"Ich mag Filme.","ar":"أحب الأفلام."},{"t":"Was hat sie dir beigebracht?","ar":"ماذا علمَتك؟"},{"t":"Wer schrie?","ar":"مَن صَرخَ؟"},{"t":"Er besuchte ihn nie.","ar":"لم يزره قطّ."},{"t":"Er ist Student.","ar":"هو طالب."},{"t":"Tom hat Kekse gemacht.","ar":"طبخ توم بسكويتات."},{"t":"Hör auf, mich zu schlagen!","ar":"توقف عن ضربي."},{"t":"Das Schwarze gehört mir.","ar":"الأسود لي."},{"t":"Gestern bin ich in den Zoo gegangen.","ar":"ذهبت إلى حديقة الحيوان البارحة."},{"t":"Ich kann mich nicht bewegen.","ar":"لا أستطيع التحرك."},{"t":"Ich bringe es dir morgen.","ar":"سأجلبها لك غدا."},{"t":"Taninna rannte.","ar":"ركضت تانينا."},{"t":"Sie mochte ihn nicht.","ar":"لم تكن تحبه."},{"t":"Ich habe einen Fernseher im Schlafzimmer.","ar":"لدي تلفاز في غرفة نومي."},{"t":"Das hätte ich nie geglaubt.","ar":"لما كنت صدقت ذلك ابدا"},{"t":"Ich sah ihn Baseball spielen.","ar":"رأيته يلعب كرة القاعدة."},{"t":"Tom gab mir einen Stift.","ar":"أعطاني توم قلماً."},{"t":"Der Regen dauerte eine Woche.","ar":"استمر المطر أسبوعاً."},{"t":"Wann schließt das Restaurant?","ar":"متى يُغلق المطعم؟"},{"t":"Ziri lachte.","ar":"كان زيري يضحك."},{"t":"Kaninchen haben große Ohren.","ar":"للأرانب آذان طويلة."},{"t":"Meinst du mich?","ar":"هل تقصدني؟"},{"t":"Der Krieg dauerte zwei Jahre.","ar":"دامت الحرب سنتين."},{"t":"Die Welt ändert sich von Minute zu Minute.","ar":"يتغير العالم كل دقيقة."},{"t":"Halt das bitte!","ar":"هلا أمسكت بهذا من فضلك؟"},{"t":"Liebst du ihn noch?","ar":"أمازلتِ تُحبّينه؟"},{"t":"Ist in deinem Schlafzimmer ein Fernseher?","ar":"هل يوجد تلفاز في غرفة نومك؟"},{"t":"Ich habe zwei Tee und drei Kaffee bestellt.","ar":"لقد طلبت اثنين شاي وثلاثة قهوة."},{"t":"Ich habe mir nicht die Haare gewaschen.","ar":"انا لم اغسل شعري ."},{"t":"Im Garten gab es keine Rosen.","ar":"الحديقة كانت خالية من الورود."},{"t":"Ich habe dich so vermisst!","ar":"إشتقت إليك كثيرا !"},{"t":"Ich mag keine Filme.","ar":"لا أحب مشاهدة الأفلام."},{"t":"Warum schrieb ich all jene Briefe?","ar":"لماذا كتبت كل تلك الرسائل؟"},{"t":"Er lacht immer.","ar":"دائماً ما أراه ضاحكاً."},{"t":"Tom hat dich vermisst.","ar":"اشتاق لك توم."},{"t":"Wer ist schwerer, Ben oder Mike?","ar":"من أثقل بِن أم مايك؟"},{"t":"Das Mädchen lächelte.","ar":"ابتسمت الفتاة."},{"t":"Ich bin Student.","ar":"أنا طالب."},{"t":"Ihr wisst es nicht.","ar":"أنت لا تعرف."},{"t":"Tom hat ein schlechtes Gedächtnis.","ar":"توم له ذاكرة ضعيفة."}],"difficulty":1}}