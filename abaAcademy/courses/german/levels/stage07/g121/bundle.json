ld.","ar":"أنا لو كنت غنياً, كنت أود أن أعطيكَ مال."},{"t":"Wenn du fertig bist, zahl die Rechnung.","ar":"عندما تنتهي ادفع الحساب."},{"t":"Ich wünschte, es gäbe mehr Leute wie dich.","ar":"أتمنى لو كان هناك المزيد من الناس مثلك."},{"t":"Maria hat die Rechnung noch nicht bezahlt.","ar":"لم تسدد ماري الفاتورة بعد."},{"t":"Das Geschäft hat von Montag bis Samstag geöffnet.","ar":"يفتح المتجر من الإثنين إلى السبت."},{"t":"Selbst wenn ich reich wäre, gäbe ich ihm kein Geld.","ar":"إذا كنت غنياً لما أعطيته فلساً."}],"focus":["helfe","Maschine","Hauses","Hose","Gras","Samstag","Ei","gäbe","Rechnung","sprang"],"words":[{"word":"Maschine","topic":"L121","difficulty":1,"meaning":"آلَة"},{"word":"Hose","topic":"L121","difficulty":1,"meaning":"بِنْطَال","example":"Das ist meine Hose.","translation":"ذاك بنطالي."},{"word":"Gras","topic":"L121","difficulty":1,"meaning":"حَشِيش"},{"word":"Samstag","topic":"L121","difficulty":1,"meaning":"السَّبْت","example":"Es ist Samstag.","translation":"هل اليوم هو السبت؟"},{"word":"Ei","topic":"L121","difficulty":1,"meaning":"بَيْض، بَيْضَة","example":"Die Welt ist ein Ei.","translation":"الدنيا بيضة."},{"word":"Rechnung","topic":"L121","difficulty":1,"meaning":"فَاتُورَة","example":"Die Rechnung bitte.","translation":"الفاتورة من فضلك."}],"difficulty":1}}