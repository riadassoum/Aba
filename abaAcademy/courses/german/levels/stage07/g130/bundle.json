{"theory":{"blocks":[{"btype":"text","text":"الدرس 130. الكلمات الجديدة: Waffe، werfen، Kälte، Geräusch، schenken، wussten، Überraschung، beibringen، Test، täte."},{"btype":"example","text":"Waffe = سِلَاح","note":""},{"btype":"example","text":"werfen = رَمَى","note":"مثال: Lass mich mal einen Blick auf das Bild werfen. — دعني ألقي نظرة على الصورة."},{"btype":"example","text":"Kälte = بُرُودَة","note":""},{"btype":"example","text":"Geräusch = ضَوْضَاء","note":""},{"btype":"example","text":"schenken = أَهْدَى","note":"مثال: Du solltest mir Blumen schenken. — ينبغي أن تقدّم لي أزهارا."},{"btype":"example","text":"wussten = عَلِمَ، دَرَى","note":"صيغة من wissen (الجمع، الغائب، الماضي التامّ)"},{"btype":"example","text":"Überraschung = مُفَاجَأَة، دَهْشَة","note":"مثال: Was für eine Überraschung! — يا لها من مفاجأة."},{"btype":"example","text":"beibringen = عَلَّمَ","note":"مثال: Ich kann dir etwas beibringen. — أستطيع أن أعلمك شيئا."},{"btype":"example","text":"Test = اِخْتِبَار، اِمْتِحَان","note":"مثال: Wie war der Test heute? — كيف كان امتحان اليوم؟"},{"btype":"example","text":"täte = هَل، فَعَلَ","note":"صيغة من tun (الغائب، صيغة الالتماس (الشرطية))؛ مثال: Für dich täte ich alles, Maria. — سأفعل أيّ شيء لأجلك يا ماري."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Wie war der Test heute?","note":"كيف كان امتحان اليوم؟"},{"btype":"example","text":"Was für eine Überraschung!","note":"يا لها من مفاجأة."},{"btype":"example","text":"Das ist eine Überraschung.","note":"إنّها مفاجأة."},{"btype":"example","text":"Ich kann dir etwas beibringen.","note":"أستطيع أن أعلمك شيئا."},{"btype":"example","text":"Ich kann dir Dinge beibringen.","note":"أستطيع أن أعلمك بعض الأشياء."},{"btype":"example","text":"Für dich täte ich alles, Maria.","note":"سأفعل أيّ شيء لأجلك يا ماري."},{"btype":"example","text":"Du solltest mir Blumen schenken.","note":"ينبغي أن تقدّم لي أزهارا."},{"btype":"example","text":"Kannst du mir Englisch beibringen?","note":"أيمكنكَ تعليمي الإنجليزية؟"},{"btype":"example","text":"Ich habe eine Überraschung für dich.","note":"لدي مفاجأة لك."},{"btype":"example","text":"Ich kann dir beibringen, wie man kocht.","note":"يمكنني أن أعلمك الطبخ."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Wie war der Test heute?","ar":"كيف كان امتحان اليوم؟"},{"t":"Was für eine Überraschung!","ar":"يا لها من مفاجأة."},{"t":"Das ist eine Überraschung.","ar":"إنّها مفاجأة."},{"t":"Ich kann dir etwas beibringen.","ar":"أستطيع أن أعلمك شيئا."},{"t":"Ich kann dir Dinge beibringen.","ar":"أستطيع أن أعلمك بعض الأشياء."},{"t":"Für dich täte ich alles, Maria.","ar":"سأفعل أيّ شيء لأجلك يا ماري."},{"t":"Du solltest mir Blumen schenken.","ar":"ينبغي أن تقدّم لي أزهارا."},{"t":"Kannst du mir Englisch beibringen?","ar":"أيمكنكَ تعليمي الإنجليزية؟"},{"t":"Ich habe eine Überraschung für dich.","ar":"لدي مفاجأة لك."},{"t":"Ich kann dir beibringen, wie man kocht.","ar":"يمكنني أن أعلمك الطبخ."},{"t":"