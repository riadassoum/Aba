itische Botschaft?","ar":"أين السفارة البريطانية؟"},{"t":"Ich spüre, dass etwas nicht stimmt.","ar":"أشعر أن هناك شيئًا خاطئًا."},{"t":"Kann jemand dieses Wort aussprechen?","ar":"هل من أحد يستطيع أن ينطق هذه الكلمة؟"},{"t":"Haben Sie eine englische Speisekarte?","ar":"هل لديك قائمة في اللغة الإنجليزية؟"},{"t":"Es geht mir gut. Danke der Nachfrage!","ar":"أنا بخير. شكرا على سؤالك !"},{"t":"Bringe diesen Stuhl ins Sitzungszimmer!","ar":"خذ هذا إلى قاعة الاجتماع."},{"t":"Es ist das Gesetz von Angebot und Nachfrage.","ar":"انه قانون العرض والطلب."},{"t":"Wir werden die Welt in ein Paradies verwandeln.","ar":"سنحول العالم إلى جنة."},{"t":"In dieser Firma gibt es nicht einmal ein Sitzungszimmer.","ar":"هذه الشركة لا تملك حتى قاعة اجتماع."}],"focus":["Speisekarte","verwandeln","umarmte","spüre","britische","Sonnensystems","Sitzungszimmer","Nachfrage","husten","aussprechen"],"words":[{"word":"Speisekarte","topic":"L404","difficulty":5,"meaning":"قَائِمَة","example":"Haben Sie eine englische Speisekarte?","translation":"هل لديك قائمة في اللغة الإنجليزية؟"},{"word":"verwandeln","topic":"L404","difficulty":5,"meaning":"تَحَوَّلَ","example":"Wir werden die Welt in ein Paradies verwandeln.","translation":"سنحول العالم إلى جنة."},{"word":"Nachfrage","topic":"L404","difficulty":5,"meaning":"طَلَب","example":"Es geht mir gut. Danke der Nachfrage!","translation":"أنا بخير. شكرا على سؤالك !"},{"word":"husten","topic":"L404","difficulty":5,"meaning":"كَحَّ، سَعَلَ","example":"Ich habe Husten.","translation":"لدي كحة."},{"word":"aussprechen","topic":"L404","difficulty":5,"meaning":"لَفَظَ","example":"Kann jemand dieses Wort aussprechen?","translation":"هل من أحد يستطيع أن ينطق هذه الكلمة؟"}],"difficulty":5}}