{"theory":{"blocks":[{"btype":"text","text":"الدرس 420. الكلمات الجديدة: Webseite، fantastisch، doof، Bedürfnis، widmete، weckte، Laub، Hemden، Drache، zündete."},{"btype":"example","text":"Webseite = مَوْقِع","note":""},{"btype":"example","text":"fantastisch = رَائِع","note":"مثال: Dein Haus ist fantastisch. — منزلك رائع."},{"btype":"example","text":"doof = سَخِيف","note":"مثال: Er ist süß, aber doof. — إنهُ ظريف, ولكن غبي."},{"btype":"example","text":"Bedürfnis = حَاجَة","note":"مثال: Ich habe wirklich das Bedürfnis, jemanden zu schlagen. — انا اريد شخصا لأضربه"},{"btype":"example","text":"widmete = كَرَّسَ","note":"صيغة من widmen (الغائب، الماضي التامّ)؛ مثال: Er widmete sein ganzes Leben der Wissenschaft. — كرّسَ حياته كلّها للعلم."},{"btype":"example","text":"weckte = أَيْقَظَ","note":"صيغة من wecken (الغائب، الماضي التامّ)؛ مثال: Ich weckte dich. — لقد أيقظتُك."},{"btype":"example","text":"Laub = نَفَضِي","note":"مثال: Das meiste Laub ist gefallen. — سقطت معظم الأوراق."},{"btype":"example","text":"Hemden = قَمِيص","note":"صيغة من Hemd (الجمع)؛ مثال: Er trägt immer blaue Hemden. — دائماً ما يلبس القمصان الزرقاء."},{"btype":"example","text":"Drache = تِنِّين","note":""},{"btype":"example","text":"zündete","note":"مثال: Ken zündete die Kerzen an. — أشعل كين الشمع."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ich weckte dich.","note":"لقد أيقظتُك."},{"btype":"example","text":"Er ist süß, aber doof.","note":"إنهُ ظريف, ولكن غبي."},{"btype":"example","text":"Dein Haus ist fantastisch.","note":"منزلك رائع."},{"btype":"example","text":"Tom sieht fantastisch aus.","note":"يبدو \"توم\" مذهلا"},{"btype":"example","text":"Ken zündete die Kerzen an.","note":"أشعل كين الشمع."},{"btype":"example","text":"Ich zündete die Kerzen an.","note":"أشعلت الشموع."},{"btype":"example","text":"Er trägt immer blaue Hemden.","note":"دائماً ما يلبس القمصان الزرقاء."},{"btype":"example","text":"Das meiste Laub ist gefallen.","note":"سقطت معظم الأوراق."},{"btype":"example","text":"Er widmete sein ganzes Leben der Wissenschaft.","note":"كرّسَ حياته كلّها للعلم."},{"btype":"example","text":"Obwohl es kalt war, zündete er das Feuer nicht an.","note":"لم يشعل النار مع أن الجو كان بارداً."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich weckte dich.","ar":"لقد أيقظتُك."},{"t":"Er ist süß, aber doof.","ar":"إنهُ ظريف, ولكن غبي."},{"t":"Dein Haus ist fantastisch.","ar":"منزلك رائع."},{"t":"Tom sieht fantastisch aus.","ar":"يبدو \"توم\" مذهلا"},{"t":"Ken zündete die Kerzen an.","ar":"أشعل كين الشمع."},{"t":"Ich zündete die Kerzen an.","ar":"أشعلت الشموع."},{"t":"Er trägt immer blaue Hemden.","ar":"دائماً ما يلبس القمصان الزرقاء."},{"t":"Das meiste Laub ist gefallen.","ar":"سقطت معظم الأوراق."},{"t":"Er widmete sein ganzes Leben der Wissenschaft.","ar":"كرّسَ حياته كلّها للعلم."},{"t":"Obwohl es kalt war, zündete er das Feuer nicht an.","ar":"لم يشعل النار مع أن الجو كان بارداً."},{"t":"Ich habe 