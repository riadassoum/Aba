{"theory":{"blocks":[{"btype":"text","text":"الدرس 467. الكلمات الجديدة: Festival، unwahr، selbstsüchtig، Klassenraum، taucher، Thunfisch، Auswirkung، segnen، gläubig، glaube."},{"btype":"example","text":"Festival = عِيد","note":""},{"btype":"example","text":"unwahr = زَائِف","note":"مثال: Das Gerücht ist unwahr. — تلك الإشاعة ليست صحيحة."},{"btype":"example","text":"selbstsüchtig = أَنَانِيّ","note":""},{"btype":"example","text":"Klassenraum = صَفّ","note":""},{"btype":"example","text":"taucher = غَطَّاس","note":""},{"btype":"example","text":"Thunfisch = تُونَة","note":""},{"btype":"example","text":"Auswirkung = تَأْثِير","note":"مثال: Es hat keine Auswirkung auf ihn gehabt. — لم يكن لها أي أثرٍ عليه."},{"btype":"example","text":"segnen = بَارَكَ","note":""},{"btype":"example","text":"gläubig = مُتَدَيِّن","note":""},{"btype":"example","text":"glaube = إِيمَان","note":"مثال: Ich glaube nicht. — لا أظن ذلك."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ich glaube nicht.","note":"لا أظن ذلك."},{"btype":"example","text":"Bitte glaube mir!","note":"من فضلك، صدقني."},{"btype":"example","text":"Ich glaube an dich.","note":"أثق في قدرتك."},{"btype":"example","text":"Das glaube ich nicht.","note":"لا أعتقد ذلك."},{"btype":"example","text":"Das Gerücht ist unwahr.","note":"تلك الإشاعة ليست صحيحة."},{"btype":"example","text":"Glaube ihm nicht, Maria!","note":"لا تصدّقيه يا ليلى."},{"btype":"example","text":"Ich glaube, du hast recht.","note":"أعتقد أنك صائب."},{"btype":"example","text":"Ich glaube, ich habe recht.","note":"أعتقد بأني محق."},{"btype":"example","text":"Ich glaube, er ist glücklich.","note":"أظن أنه سعيد."},{"btype":"example","text":"Ich glaube, ich bin verliebt.","note":"أظن أنني وقعت في الحب"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich glaube nicht.","ar":"لا أظن ذلك."},{"t":"Bitte glaube mir!","ar":"من فضلك، صدقني."},{"t":"Ich glaube an dich.","ar":"أثق في قدرتك."},{"t":"Das glaube ich nicht.","ar":"لا أعتقد ذلك."},{"t":"Das Gerücht ist unwahr.","ar":"تلك الإشاعة ليست صحيحة."},{"t":"Glaube ihm nicht, Maria!","ar":"لا تصدّقيه يا ليلى."},{"t":"Ich glaube, du hast recht.","ar":"أعتقد أنك صائب."},{"t":"Ich glaube, ich habe recht.","ar":"أعتقد بأني محق."},{"t":"Ich glaube, er ist glücklich.","ar":"أظن أنه سعيد."},{"t":"Ich glaube, ich bin verliebt.","ar":"أظن أنني وقعت في الحب"},{"t":"Ich glaube an meine Fähigkeit.","ar":"انا أؤمن في قدراتي."},{"t":"Ich glaube, dass ich verstehe.","ar":"أظنني أنني فهمت"},{"t":"Ich glaube, dass sie krank ist.","ar":"أظن أنها مريضة."},{"t":"Ich glaube, dass Tom recht hat.","ar":"أنا موقن بأن توم محق."},{"t":"Ich glaube, dass er morgen kommt.","ar":"أظن أنه سيأتي غداً."},{"t":"Ich glaube, du hörst mir nicht zu.","ar":"أعتقد انك لا تصغي لي."},{"t":"Ich glaube, wir haben telefoniert.","ar":"أظن أننا تحادثنا عبر الهاتف."},{"t":"Ich glaube, sie haben mich gesehen.","ar":"أظن أنهم قد رأوني"},{"t":"Ich glaube, dass ich schon hier war.","ar":"أظن أنني قد كنت هنا."},{"t":"Ich glaube, du verstehst mich nicht.","ar":"أعتقد أنّكَ لا تفهمني."},{"t":"Ich glaube nicht, dass er Anwalt ist.","ar":"لا أصدق أنه محام."},{"t":"Bist du bereit? Ich glaube schon.","ar":"هل أنت جاهز؟ أعتقد."},{"t":"Ich glaube, hier wird es uns gefallen.","ar":"أعتقد أنه سيعجبنا المكان هنا."},{"t":"Ich glaube, das ist, was passiert ist.","ar":"أظنّ أن هذا ما حدث."},{"t":"Es hat keine Auswirkung auf ihn gehabt.","ar":"لم يكن لها أي أثرٍ عليه."},{"t":"Kommt er? — Nein, ich glaube nicht.","ar":"\"هل هو قادم؟\"، \"لا أظن أنه سيأتي.\""},{"t":"Ich glaube nicht, dass Tom der Mörder ist.","ar":"لا أصدق أن توم هو القاتل"},{"t":"Ich glaube, Tom meint, dass ich das denke.","ar":"أنا أظنّ أن تومًا يظنّ أنني أظنّ ذلك."},{"t":"Ich glaube dir nicht! – Ich schwöre es!","ar":"\"قسما!\" \"إني لا أصدّقك!\""},{"t":"Ich glaube kein Wort von dem, was du sagst.","ar":"لا أصدّق أي كلمة تقول."}],"focus":["Festival","unwahr","selbstsüchtig","Klassenraum","taucher","Thunfisch","Auswirkung","segnen","gläubig","glaube"],"words":[{"word":"Festival","topic":"L467","difficulty":3,"meaning":"عِيد"},{"word":"unwahr","topic":"L467","difficulty":3,"meaning":"زَائِف","example":"Das Gerücht ist unwahr.","translation":"تلك الإشاعة ليست صحيحة."},{"word":"selbstsüchtig","topic":"L467","difficulty":3,"meaning":"أَنَانِيّ"},{"word":"Klassenraum","topic":"L467","difficulty":3,"meaning":"صَفّ"},{"word":"taucher","topic":"L467","difficulty":3,"meaning":"غَطَّاس"},{"word":"Thunfisch","topic":"L467","difficulty":3,"meaning":"تُونَة"},{"word":"Auswirkung","topic":"L467","difficulty":3,"meaning":"تَأْثِير","example":"Es hat keine Auswirkung auf ihn gehabt.","translation":"لم يكن لها أي أثرٍ عليه."},{"word":"segnen","topic":"L467","difficulty":3,"meaning":"بَارَكَ"},{"word":"gläubig","topic":"L467","difficulty":3,"meaning":"مُتَدَيِّن"},{"word":"glaube","topic":"L467","difficulty":3,"meaning":"إِيمَان","example":"Ich glaube nicht.","translation":"لا أظن ذلك."}],"difficulty":3}}