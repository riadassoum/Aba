{"theory":{"blocks":[{"btype":"text","text":"الدرس 459. الكلمات الجديدة: zögere، hütet، angezeigt، schmolz، feuerte، Bettes، Abteilungsleiter، aufladen، überwacht، Mittagszeit، breche."},{"btype":"example","text":"zögere = تَرَدَّدَ","note":"صيغة من zögern (المتكلّم، المضارع)؛ مثال: Zögere nicht! — لا تترددوا."},{"btype":"example","text":"hütet = رَعَى","note":"صيغة من hüten (الجمع، المخاطب، المضارع)؛ مثال: Sami hütet Kinder. — سامي يحرس الأطفال."},{"btype":"example","text":"angezeigt = دَلَّ عَلَى","note":"صيغة من anzeigen (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"schmolz = ذَابَ","note":"صيغة من schmelzen (الغائب، الماضي التامّ)"},{"btype":"example","text":"feuerte = طَرَدَ","note":"صيغة من feuern (الغائب، الماضي التامّ)؛ مثال: Er feuerte Maria. — قام بطرد ماري."},{"btype":"example","text":"Bettes = سَرِير، قَاع","note":"صيغة من Bett (حالة الإضافة)؛ مثال: Er maß die Länge des Bettes ab. — قاس طول السرير."},{"btype":"example","text":"Abteilungsleiter = مُدِير","note":"مثال: Tom ist gerade zum Abteilungsleiter befördert worden. — ترقّى سامي وأصبح مديرًا للتو."},{"btype":"example","text":"aufladen = شَحَنَ","note":"مثال: Ich muss mein Mobiltelefon aufladen. — علي شحن هاتفي الجوال."},{"btype":"example","text":"überwacht = رَاقَّبَ","note":"صيغة من überwachen (اسم المفعول (التصريف الثالث))؛ مثال: Ich weiß, dass er mich überwacht. — أعلم أنه يراقبني."},{"btype":"example","text":"Mittagszeit = وَقْتُ الْغَدَاء","note":""},{"btype":"example","text":"breche = كَسَرَ","note":"صيغة من brechen (المتكلّم، المضارع)؛ مثال: Ich breche nächste Woche nach China auf. — سأسافر إلى الصين الأسبوع القادم."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Zögere nicht!","note":"لا تترددوا."},{"btype":"example","text":"Er feuerte Maria.","note":"قام بطرد ماري."},{"btype":"example","text":"Sami hütet Kinder.","note":"سامي يحرس الأطفال."},{"btype":"example","text":"Er maß die Länge des Bettes ab.","note":"قاس طول السرير."},{"btype":"example","text":"Ich weiß, dass er mich überwacht.","note":"أعلم أنه يراقبني."},{"btype":"example","text":"Ich muss mein Mobiltelefon aufladen.","note":"علي شحن هاتفي الجوال."},{"btype":"example","text":"Ich breche nächste Woche nach China auf.","note":"سأسافر إلى الصين الأسبوع القادم."},{"btype":"example","text":"Tom ist gerade zum Abteilungsleiter befördert worden.","note":"ترقّى سامي وأصبح مديرًا للتو."},{"btype":"example","text":"Ich werde alles für euch tun.","note":"سأفعل أي شيء من أجلك."},{"btype":"example","text":"Du selbst hast es mir gesagt.","note":"أخبرتني ذلك بنفسك."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Zögere nicht!","ar":"لا تترددوا."},{"t":"Er feuerte Maria.","ar":"قام بطرد ماري."},{"t":"Sami hütet Kinder.","ar":"سامي يحرس الأطفال."},{"t":"Er maß die Länge des Bettes ab.","ar":"قاس طول السرير."},{"t":"Ich weiß, dass er mich überwacht.","ar":"أعلم أنه يراقبني."},{"t":"Ich muss mein Mobiltelefon aufladen.","ar":"علي شحن هاتفي الجوال."},{"t":"Ich breche nächste Woche nach China auf.","ar":"سأسافر إلى الصين الأسبوع القادم."},{"t":"Tom ist gerade zum Abteilungsleiter befördert worden.","ar":"ترقّى سامي وأصبح مديرًا للتو."},{"t":"Ich werde alles für euch tun.","ar":"سأفعل أي شيء من أجلك."},{"t":"Du selbst hast es mir gesagt.","ar":"أخبرتني ذلك بنفسك."},{"t":"Du hast viele Fehler gemacht.","ar":"لقد ارتكبت الكثير من الأخطاء."},{"t":"Wir müssen an Freunde denken.","ar":"يجب أن نفكر بالأصدقاء."}],"focus":["zögere","hütet","angezeigt","schmolz","feuerte","Bettes","Abteilungsleiter","aufladen","überwacht","Mittagszeit","breche"],"words":[{"word":"Abteilungsleiter","topic":"L459","difficulty":3,"meaning":"مُدِير","example":"Tom ist gerade zum Abteilungsleiter befördert worden.","translation":"ترقّى سامي وأصبح مديرًا للتو."},{"word":"aufladen","topic":"L459","difficulty":3,"meaning":"شَحَنَ","example":"Ich muss mein Mobiltelefon aufladen.","translation":"علي شحن هاتفي الجوال."},{"word":"Mittagszeit","topic":"L459","difficulty":3,"meaning":"وَقْتُ الْغَدَاء"}],"difficulty":3}}