{"theory":{"blocks":[{"btype":"text","text":"الدرس 113. الكلمات الجديدة: Wolken، welchen، Haut، Schirm، stärker، schrecklich، Tor، Zeichen، sauber، hingehen."},{"btype":"example","text":"Wolken = سَحَاب","note":"صيغة من Wolke (الجمع)؛ مثال: Nicht alle Wolken regnen. — ليست كل الغيوم تسقط أمطاراً."},{"btype":"example","text":"welchen = أَيّ، اَلَّذِي","note":"صيغة من welcher (المذكّر، حالة المفعول به)"},{"btype":"example","text":"Haut = إِهَاب","note":"مثال: Mama, Maria haut mich! — أُمي, ماري تضربني."},{"btype":"example","text":"Schirm = مِظَلَّة، وَاقٍ","note":"مثال: Ist das dein Schirm? — هل هذه مظلتك؟"},{"btype":"example","text":"stärker = قَوِيّ، مَنِيع","note":"صيغة من stark (صيغة التفضيل)؛ مثال: Ich bin jünger und stärker als du. — أنا أصغر سنّا و أقوى منك."},{"btype":"example","text":"schrecklich = فَظِيع","note":"مثال: Ich bin schrecklich hungrig. — أنا جائع جداً."},{"btype":"example","text":"Tor = مَرْمًى، هَدَف","note":"مثال: Das Tor hat sich geöffnet. — فُتحت البوابة من تلقاء نفسها."},{"btype":"example","text":"Zeichen = إِشَارَة، لافِتَة","note":""},{"btype":"example","text":"sauber = نَظِيف","note":"مثال: Das Wasser ist sauber. — الماء نقي."},{"btype":"example","text":"hingehen = ذَهَبَ، عَمَلَ","note":"مثال: Du darfst hingehen. — يمكنك الذهاب إلى هناك."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Du darfst hingehen.","note":"يمكنك الذهاب إلى هناك."},{"btype":"example","text":"Ist das dein Schirm?","note":"هل هذه مظلتك؟"},{"btype":"example","text":"Du solltest hingehen.","note":"من الأفضل أن تذهب."},{"btype":"example","text":"Mama, Maria haut mich!","note":"أُمي, ماري تضربني."},{"btype":"example","text":"Das Wasser ist sauber.","note":"الماء نقي."},{"btype":"example","text":"Sind deine Hände sauber?","note":"هل يداك نظيفتان؟"},{"btype":"example","text":"Mach dein Zimmer sauber.","note":"نظف غرفتك."},{"btype":"example","text":"Nicht alle Wolken regnen.","note":"ليست كل الغيوم تسقط أمطاراً."},{"btype":"example","text":"Ich wollte dort hingehen.","note":"أردت الذهاب إلى هناك."},{"btype":"example","text":"Das Tor hat sich geöffnet.","note":"فُتحت البوابة من تلقاء نفسها."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Du darfst hingehen.","ar":"يمكنك الذهاب إلى هناك."},{"t":"Ist das dein Schirm?","ar":"هل هذه مظلتك؟"},{"t":"Du solltest hingehen.","ar":"من الأفضل أن تذهب."},{"t":"Mama, Maria haut mich!","ar":"أُمي, ماري تضربني."},{"t":"Das Wasser ist sauber.","ar":"الماء نقي."},{"t":"Sind deine Hände sauber?","ar":"هل يداك نظيفتان؟"},{"t":"Mach dein Zimmer sauber.","ar":"نظف غرفتك."},{"t":"Nicht alle Wolken regnen.","ar":"ليست كل الغيوم تسقط أمطاراً."},{"t":"Ich wollte dort hingehen.","ar":"أردت الذهاب إلى هناك."},{"t":"Das Tor hat sich geöffnet.","ar":"فُتحت البوابة من تلقاء نفسها."},{"t":"Man kann überall hingehen.","ar":"يمكنك الذهاب إلى أين تشاء."},{"t":"Wir sollten alle hingehen.","ar":"علينا جميعا أن نذهب."},{"t":"Du musst da nicht hingehen.","ar":"ليس من الضروري أن تذهب."},{"t":"Er ließ einen Schirm im Bus.","ar":"لقد ترك مظلته في الحافلة."},{"t":"Ich bin schrecklich hungrig.","ar":"أنا جائع جداً."},{"t":"Es war schrecklich kalt gestern.","ar":"كان الجو باردا جدا البارحة."},{"t":"Du solltest dort nicht hingehen.","ar":"عليك ألا تذهب إلى هناك."},{"t":"Sie hält ihr Zimmer immer sauber.","ar":"دائماً ما تبقي غرفتها نظيفة."},{"t":"Ich bin jünger und stärker als du.","ar":"أنا أصغر سنّا و أقوى منك."},{"t":"Wir hätten selbst hingehen sollen.","ar":"كان يجب أن نذهب إلى هناك بأنفسنا."},{"t":"Du musst dein Zimmer sauber machen.","ar":"عليك أن تنظّف غرفتك."},{"t":"Du musst dein Zimmer sauber halten.","ar":"عليك أن تبقي غرفتك نظيفة."},{"t":"Das Tor wird um acht Uhr geschlossen.","ar":"تغلق البوابة ليلا."},{"t":"Liebe ist stark, Geld aber ist noch stärker.","ar":"الحُب قوي, ولكن المال أقوى."},{"t":"Tom sagte Maria, dass sie nicht allein hingehen soll.","ar":"أخبر توم ماري بأنها لا يجب أن تذهب إلى هناك بمفردها."}],"focus":["Wolken","welchen","Haut","Schirm","stärker","schrecklich","Tor","Zeichen","sauber","hingehen"],"words":[{"word":"Haut","topic":"L113","difficulty":1,"meaning":"إِهَاب","example":"Mama, Maria haut mich!","translation":"أُمي, ماري تضربني."},{"word":"Schirm","topic":"L113","difficulty":1,"meaning":"مِظَلَّة، وَاقٍ","example":"Ist das dein Schirm?","translation":"هل هذه مظلتك؟"},{"word":"schrecklich","topic":"L113","difficulty":1,"meaning":"فَظِيع","example":"Ich bin schrecklich hungrig.","translation":"أنا جائع جداً."},{"word":"Tor","topic":"L113","difficulty":1,"meaning":"مَرْمًى، هَدَف","example":"Das Tor hat sich geöffnet.","translation":"فُتحت البوابة من تلقاء نفسها."},{"word":"Zeichen","topic":"L113","difficulty":1,"meaning":"إِشَارَة، لافِتَة"},{"word":"sauber","topic":"L113","difficulty":1,"meaning":"نَظِيف","example":"Das Wasser ist sauber.","translation":"الماء نقي."},{"word":"hingehen","topic":"L113","difficulty":1,"meaning":"ذَهَبَ، عَمَلَ","example":"Du darfst hingehen.","translation":"يمكنك الذهاب إلى هناك."}],"difficulty":1}}