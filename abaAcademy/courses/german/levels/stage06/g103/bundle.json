{"theory":{"blocks":[{"btype":"text","text":"الدرس 103. الكلمات الجديدة: Bein، geschlagen، Nachrichten، neun، Antworten، Händen، Herbst، Vergnügen، Schritt، Wissenschaft."},{"btype":"example","text":"Bein = رِجْل","note":""},{"btype":"example","text":"geschlagen = سَاقَ","note":"صيغة من schlagen (اسم المفعول (التصريف الثالث))؛ مثال: Bob hat mich geschlagen, nicht sie. — بوب هو الذي ضربني و ليس هي."},{"btype":"example","text":"Nachrichten = أَخْبَار","note":"مثال: Er sah die Nachrichten. — شاهد الأخبار."},{"btype":"example","text":"neun = تِسْعَة","note":"مثال: Der Zug fährt um neun Uhr ab. — يغادر القطار في الساعة التاسعة."},{"btype":"example","text":"Antworten = أَجَابَ","note":"مثال: Er will Antworten. — هو يريد أجوبة."},{"btype":"example","text":"Händen = يَد","note":"صيغة من Hand (الجمع، حالة المفعول غير المباشر)"},{"btype":"example","text":"Herbst = خَرِيف","note":"مثال: Es ist jetzt Herbst. — دخل الخريف."},{"btype":"example","text":"Vergnügen = مُتْعَة","note":"مثال: Viel Vergnügen! — استمتع بوقتك."},{"btype":"example","text":"Schritt = خُطْوَة، خَطْوَة","note":"مثال: Das ist der erste Schritt. — تلك هي الخطوة الأولى."},{"btype":"example","text":"Wissenschaft = عِلْم","note":"مثال: Ich mag keine Wissenschaft. — لا أحب مادة العلوم."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Viel Vergnügen!","note":"استمتع بوقتك."},{"btype":"example","text":"Er will Antworten.","note":"هو يريد أجوبة."},{"btype":"example","text":"Es ist jetzt Herbst.","note":"دخل الخريف."},{"btype":"example","text":"Er braucht Antworten.","note":"هو بحاجة لأجوبة."},{"btype":"example","text":"Tom braucht Antworten.","note":"توم بحاجة لأجوبة."},{"btype":"example","text":"Sie braucht Antworten.","note":"هي بحاجة لأجوبة."},{"btype":"example","text":"Er sah die Nachrichten.","note":"شاهد الأخبار."},{"btype":"example","text":"Wir brauchen Antworten.","note":"نحتاج لأجوبة."},{"btype":"example","text":"Sie sah die Nachrichten.","note":"شاهدت الأخبار."},{"btype":"example","text":"Er kennt alle Antworten.","note":"هوَ يعرف كل الإجابات."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Viel Vergnügen!","ar":"استمتع بوقتك."},{"t":"Er will Antworten.","ar":"هو يريد أجوبة."},{"t":"Es ist jetzt Herbst.","ar":"دخل الخريف."},{"t":"Er braucht Antworten.","ar":"هو بحاجة لأجوبة."},{"t":"Tom braucht Antworten.","ar":"توم بحاجة لأجوبة."},{"t":"Sie braucht Antworten.","ar":"هي بحاجة لأجوبة."},{"t":"Er sah die Nachrichten.","ar":"شاهد الأخبار."},{"t":"Wir brauchen Antworten.","ar":"نحتاج لأجوبة."},{"t":"Sie sah die Nachrichten.","ar":"شاهدت الأخبار."},{"t":"Er kennt alle Antworten.","ar":"هوَ يعرف كل الإجابات."},{"t":"Maria braucht Antworten.","ar":"ماري بحاجة لأجوبة."},{"t":"Das ist der erste Schritt.","ar":"تلك هي الخطوة الأولى."},{"t":"Ich mag keine Wissenschaft.","ar":"لا أحب مادة العلوم."},{"t":"Der Zug fährt um neun Uhr ab.","ar":"يغادر القطار في الساعة التاسعة."},{"t":"Dieser Laden macht um neun zu.","ar":"يُغلق هذا المحل عند التاسعة."},{"t":"Das Spiel war um neun Uhr zu Ende.","ar":"انتهت المباراة الساعة التاسعة."},{"t":"Bob hat mich geschlagen, nicht sie.","ar":"بوب هو الذي ضربني و ليس هي."},{"t":"Bitte antworten Sie auf alle Fragen.","ar":"من فضلك أجب على كل الأسئلة."},{"t":"Sage ihm nie: Ich kann nicht antworten.","ar":"لا تخبره أبداً \"لا أستطيع الاجابة\""},{"t":"Magst du lieber den Frühling oder den Herbst?","ar":"هل تحب الربيع أم الخريف؟"},{"t":"Es war uns ein Vergnügen, im Fluss zu schwimmen.","ar":"تمتعنا بالسباحة في النهر."},{"t":"Tom war sich nicht sicher, wie er antworten sollte.","ar":"لم يعرف سامي كيف يردّ."},{"t":"Was ist der nächste Schritt, der getan werden sollte?","ar":"ما هي الخطوة التالية ليصبح جاهز؟"},{"t":"Heute Morgen habe ich die Nachrichten im Fernsehen gesehen.","ar":"رأيت الأخبار على التلفاز هذا الصباح."},{"t":"Eins, zwei, drei, vier, fünf, sechs, sieben, acht, neun, zehn.","ar":"واحد، اثنان، ثلاثة، أربعة، خمسة، ستة، سبعة، ثمانية، تسعة، عشرة."},{"t":"Ich möchte, dass du es liest.","ar":"أريدك أن تقرأه"},{"t":"Gib mir bitte ein Stück Brot.","ar":"أعطني كسرة خبز من فضلك."},{"t":"Du magst Englisch, nicht wahr?","ar":"أنت تحب اللغة الإنجليزية ، أليس كذلك؟"},{"t":"Wir können das Fenster öffnen.","ar":"يمكننا فتح النافذة."},{"t":"Nicht alle Kinder mögen Äpfel.","ar":"لا يحب كل الأطفال التفاح."}],"focus":["Bein","geschlagen","Nachrichten","neun","Antworten","Händen","Herbst","Vergnügen","Schritt","Wissenschaft"],"words":[{"word":"Bein","topic":"L103","difficulty":1,"meaning":"رِجْل"},{"word":"Nachrichten","topic":"L103","difficulty":1,"meaning":"أَخْبَار","example":"Er sah die Nachrichten.","translation":"شاهد الأخبار."},{"word":"neun","topic":"L103","difficulty":1,"meaning":"تِسْعَة","example":"Der Zug fährt um neun Uhr ab.","translation":"يغادر القطار في الساعة التاسعة."},{"word":"Antworten","topic":"L103","difficulty":1,"meaning":"أَجَابَ","example":"Er will Antworten.","translation":"هو يريد أجوبة."},{"word":"Herbst","topic":"L103","difficulty":1,"