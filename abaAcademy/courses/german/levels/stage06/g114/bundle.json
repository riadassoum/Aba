 شخصية مهمة."},{"t":"Alle Häuser hatten einen Garten.","ar":"كان لكل بيت حديقة."},{"t":"Der Weg ist wichtiger als das Ziel.","ar":"اهمّ من الوصول مشوار الطريق."},{"t":"Ich möchte in einem Schloss wohnen.","ar":"أريد أن أسكن في قلعة."},{"t":"Die Reise ist wichtiger als das Ziel.","ar":"مشوار الطريق أهمّ من الوصول."},{"t":"Jede Minute mit dir ist ein Geschenk.","ar":"كل دقيقة معك هي بمثابة هدية"},{"t":"Ich stehe jeden Morgen um sechs Uhr auf.","ar":"أستيقظ في الساعة السادسة كل صباح."},{"t":"Gib mir den Schlüssel für dieses Schloss!","ar":"أعطني مفتاح القلعة!"},{"t":"Was du bist, ist wichtiger, als was du hast.","ar":"من تكون أهم بكثير مما تملك"},{"t":"Mein neuer Job lässt mir wenig Zeit, mich mit Leuten zu treffen.","ar":"عملي الجديد يترك لي القليل من الوقت للاختلاط."}],"focus":["Häuser","Jahres","vollkommen","stehe","wichtiger","Schloss","Maus","neuer","Minute","jener"],"words":[{"word":"vollkommen","topic":"L114","difficulty":1,"meaning":"كُلّ","example":"Nichts ist vollkommen.","translation":"لا شيئَ مثالي."},{"word":"Maus","topic":"L114","difficulty":1,"meaning":"فَأْرَة","example":"Das war eine Maus.","translation":"كان ذلك فأراً."},{"word":"Minute","topic":"L114","difficulty":1,"meaning":"دَقِيقَة","example":"Nur eine Minute.","translation":"دقيقة من فضلك."},{"word":"jener","topic":"L114","difficulty":1,"meaning":"ذَاكَ"}],"difficulty":1}}