{"theory":{"blocks":[{"btype":"text","text":"الدرس 189. الكلمات الجديدة: Energie، meinst، Ferien، ausgehen، Ding، unterrichtet، einfacher، verstehst، Sieg، Geschenke."},{"btype":"example","text":"Energie = طَاقَة","note":"مثال: Kinder sind voller Energie. — الأطفالُ مفعمونَ بالطاقة."},{"btype":"example","text":"meinst = عَنَى","note":"صيغة من meinen (المخاطب، المضارع)؛ مثال: Was meinst du? — ماذا تعني؟"},{"btype":"example","text":"Ferien = عُطْلَة","note":"مثال: Wie waren deine Ferien? — كيف كانت إجازتك؟"},{"btype":"example","text":"ausgehen = خَرَجَ","note":"مثال: Ich sah ihn ausgehen. — رأيته يخرج."},{"btype":"example","text":"Ding = شَيْء","note":"مثال: Mach das Ding auf! — إفتح هذا الشئ!"},{"btype":"example","text":"unterrichtet = عَالِم","note":"مثال: Sie unterrichtet. — هي تدرس."},{"btype":"example","text":"einfacher = بَسِيط، أَبْلَه","note":"صيغة من einfach (صيغة التفضيل)"},{"btype":"example","text":"verstehst = فَهِمَ","note":"صيغة من verstehen (المخاطب، المضارع)؛ مثال: Verstehst du sie? — هل تفهَمُها؟"},{"btype":"example","text":"Sieg = اِنْتِصَار","note":""},{"btype":"example","text":"Geschenke = هَدِيَّة","note":"صيغة من Geschenk (الجمع، المضارع، حالة الإضافة)؛ مثال: Ich gebe gern Geschenke. — أحب تقديم الهدايا."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Was meinst du?","note":"ماذا تعني؟"},{"btype":"example","text":"Meinst du mich?","note":"هل تقصدني؟"},{"btype":"example","text":"Sie unterrichtet.","note":"هي تدرس."},{"btype":"example","text":"Verstehst du sie?","note":"هل تفهَمُها؟"},{"btype":"example","text":"Mach das Ding auf!","note":"إفتح هذا الشئ!"},{"btype":"example","text":"Verstehst du mich?","note":"هل تفهمني؟"},{"btype":"example","text":"Du verstehst mich.","note":"أنت تفهمني."},{"btype":"example","text":"Ich sah ihn ausgehen.","note":"رأيته يخرج."},{"btype":"example","text":"Wie waren deine Ferien?","note":"كيف كانت إجازتك؟"},{"btype":"example","text":"Ich gebe gern Geschenke.","note":"أحب تقديم الهدايا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Was meinst du?","ar":"ماذا تعني؟"},{"t":"Meinst du mich?","ar":"هل تقصدني؟"},{"t":"Sie unterrichtet.","ar":"هي تدرس."},{"t":"Verstehst du sie?","ar":"هل تفهَمُها؟"},{"t":"Mach das Ding auf!","ar":"إفتح هذا الشئ!"},{"t":"Verstehst du mich?","ar":"هل تفهمني؟"},{"t":"Du verstehst mich.","ar":"أنت تفهمني."},{"t":"Ich sah ihn ausgehen.","ar":"رأيته يخرج."},{"t":"Wie waren deine Ferien?","ar":"كيف كانت إجازتك؟"},{"t":"Ich gebe gern Geschenke.","ar":"أحب تقديم الهدايا."},{"t":"Kinder sind voller Energie.","ar":"الأطفالُ مفعمونَ بالطاقة."},{"t":"Verstehst du diese Sprache?","ar":"هل يمكنك أن تفهم هذه اللغة؟"},{"t":"Ich verstehe, was du meinst.","ar":"أفهم قصدك."},{"t":"Ich möchte mit dir ausgehen.","ar":"أريد أن أذهب معك."},{"t":"Ich weiß nicht, was du meinst.","ar":"لا أفهم ما تقصده."},{"t":"Er nahm die Geschenke nicht an.","ar":"لم يقبل الهدايا."},{"t":"Meinst du, dass Tom kommen wird?","ar":"هل ت