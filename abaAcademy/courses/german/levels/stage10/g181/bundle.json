:"بإمكان الطفل أن يحسب حتى عشرة."},{"t":"Schließlich kamen wir am See an.","ar":"أخيراً وصلنا للبحيرة."},{"t":"Schließlich kamen wir im Dorf an.","ar":"و أخيراً وصلنا إلى القرية."},{"t":"Ich bleibe dort bis um sechs Uhr.","ar":"سأبقى هناك حتى الساعة السادسة."},{"t":"Sie kann von eins bis zehn zählen.","ar":"يمكنها ان تعد من واحد إلى عشرة."},{"t":"Ein Teil dieses Landes gehört mir.","ar":"جزء من هذه الأرض ملك لي."},{"t":"Er bemerkte den Unterschied nicht.","ar":"لم يلاحظ الفرق."},{"t":"Hab keine Angst! Ich bleibe bei dir!","ar":"لا تقلق. أنا سأبقى معك.."},{"t":"Tom hat den Zucker für Salz gehalten.","ar":"خلط توم بين السّكّر و الملح."},{"t":"Wie weit ist es von hier bis zum Museum?","ar":"كم يبعد المتحف عن هنا؟"},{"t":"Wenn es morgen regnet, bleibe ich zu Hause.","ar":"إذا أمطرت غداً سأبقى في المنزل."},{"t":"Vergiss nicht zu zählen, wie viele Leute warten.","ar":"لا تنس أن تعدّ الحاضرين."},{"t":"Dieses Kind ist erst vier Jahre alt, aber kann schon bis hundert zählen.","ar":"بإمكان هذا الطفل أن يعد إلى مئة مع أنه ما زال لديه أربع سنوات."},{"t":"Ich weiß eigentlich nicht.","ar":"حقيقةً لا أعلم."},{"t":"Sie scheint krank zu sein.","ar":"تبدو مريضة."},{"t":"Jeder Mensch macht Fehler.","ar":"كل ابن آدم خطاّء"},{"t":"Das war nicht mein Fehler.","ar":"لم يكن هذا خطئي."}],"focus":["zählen","Salz","Landes","Wesen","schließlich","bleibe","bemerkte","besorgt","beschloss","Museum"],"words":[{"word":"zählen","topic":"L181","difficulty":2,"meaning":"عَدَّ","example":"Zählen Sie das Geld.","translation":"احسب المال."},{"word":"Salz","topic":"L181","difficulty":2,"meaning":"مِلْح","example":"Ist noch Salz da?","translation":"هل بقي ملح؟"},{"word":"Wesen","topic":"L181","difficulty":2,"meaning":"كَائِن"},{"word":"schließlich","topic":"L181","difficulty":2,"meaning":"أَخِيراً","example":"Schließlich kam sie nicht.","translation":"رغم كل شيء فهي لم تأتي."},{"word":"besorgt","topic":"L181","difficulty":2,"meaning":"قَلِق","example":"Du bist besorgt.","translation":"تشعر بالقلق."},{"word":"Museum","topic":"L181","difficulty":2,"meaning":"مَتْحَف","example":"Wo ist das Museum?","translation":"أين المتحف؟"}],"difficulty":2}}