":"Die Kirche steht noch. Alles andere wurde zerstört.","ar":"مازالت الكنيسة قائمة. كل شيء آخر دُمر."},{"t":"Vergiss deine Sachen nicht.","ar":"لا تنسى أدواتك."},{"t":"Sprechen Sie bitte langsam.","ar":"من فضلك، تحدث ببطء."},{"t":"Sie gab vor, krank zu sein.","ar":"تظاهرت بأنها مريضة."},{"t":"Also muss ich hier bleiben.","ar":"بالتالي، سوف أضطرُ للقاءِ هنا."},{"t":"Ich werde zu Hause bleiben.","ar":"سوف أبقى في المنزل."},{"t":"Bleiben Sie nicht zu lange!","ar":"لا تطل البقاء!"},{"t":"Sie können bei uns bleiben.","ar":"يستطيعو البقاء معنا"},{"t":"Aus welchem Land kommst du?","ar":"من أي بلد أنت؟"},{"t":"Er und ich sind gleich alt.","ar":"هو و أنا في نفس العمر"},{"t":"Pass auf! Da kommt ein Auto!","ar":"انتبه فثمّة سيارة قادمة!"},{"t":"Ich habe es ihm versprochen.","ar":"لقد وعدته."},{"t":"Das Volk liebt die Freiheit.","ar":"الناس يحبون الحرية."},{"t":"Zeigen Sie mir bitte den Pass.","ar":"أرِنِي جواز سفرك، لو سمحت."},{"t":"Darüber herrscht kein Zweifel.","ar":"لا شك في ذلك."}],"focus":["Gewalt","Sturm","Verbrechen","leise","Intelligenz","Markt","verliert","Hochzeit","zerstört","Kosten"],"words":[{"word":"Gewalt","topic":"L183","difficulty":2,"meaning":"قُوَّة"},{"word":"Sturm","topic":"L183","difficulty":2,"meaning":"عَاصِفَة"},{"word":"Verbrechen","topic":"L183","difficulty":2,"meaning":"جَرِيمَة"},{"word":"leise","topic":"L183","difficulty":2,"meaning":"خافِت","example":"Der Lehrer spricht leise.","translation":"المعلم يتحدث بهدوء."},{"word":"Intelligenz","topic":"L183","difficulty":2,"meaning":"ذَكَاء"},{"word":"Markt","topic":"L183","difficulty":2,"meaning":"سُوق","example":"Er ist auf dem Markt.","translation":"هو في السوق."},{"word":"Hochzeit","topic":"L183","difficulty":2,"meaning":"عُرْس","example":"Ihre Hochzeit ist morgen.","translation":"حفل زفافهم غداً."},{"word":"Kosten","topic":"L183","difficulty":2,"meaning":"سَاوَى","example":"Lasst uns die Kosten gemeinsam tragen!","translation":"دعنا نتقاسم النفقات."}],"difficulty":2}}