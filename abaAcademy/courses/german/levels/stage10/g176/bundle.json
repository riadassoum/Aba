er.","ar":"يكره سامي ذلك المدرّس."},{"t":"Suche und du wirst finden.","ar":"إبحث و ستجد."},{"t":"Sie hasst dich nicht, Tom.","ar":"هي لا تكرهكَ يا توم."},{"t":"Er hat mich nicht bemerkt.","ar":"هو لم يلاحظني."},{"t":"Ich habe sie auch bemerkt.","ar":"أنا أيضا لاحظتها."},{"t":"Sie hat mich nicht bemerkt.","ar":"هي لم تلاحظني."},{"t":"Sie sieht gerade nicht fern.","ar":"هي لا تشاهد التلفاز الآن."},{"t":"Tom hasst dich nicht, Maria.","ar":"توم لا يكرهكِ يا ماري."},{"t":"Das Dach meines Hauses ist rot.","ar":"سقف بيتي أحمر."},{"t":"Er hasst mich und ich hasse ihn!","ar":"هو يكرهني وأنا أكرهه!"},{"t":"Ich werde deinen Bericht studieren.","ar":"سألقي نظرة على تقريرك."},{"t":"Es ist nur ein bisschen Milch übrig.","ar":"لم يبقَ إلا القليل من الحليب."},{"t":"Tom hasst es, in die Schule zu gehen.","ar":"توم يكره الذهاب إلى المدرسة"},{"t":"Ich sah ein Haus, dessen Dach rot war.","ar":"رأيت بيتاً سطحه أحمر."},{"t":"Ziri hasst es, in Frankreich zu leben.","ar":"زيري يكره العيش في فرنسا."},{"t":"Nach genau dieser CD habe ich gesucht.","ar":"هذه هي الأسطوانة نفسها التي كنت أبحث عنها."}],"focus":["fern","suche","Bericht","nötig","Dach","hasst","bemerkt","zieht","gesucht","übrig"],"words":[{"word":"fern","topic":"L176","difficulty":2,"meaning":"بَعِيد","example":"Sehen Sie fern?","translation":"أتشاهد التلفاز؟"},{"word":"Bericht","topic":"L176","difficulty":2,"meaning":"تَقْرِير","example":"Er schrieb den Bericht.","translation":"كتب التقرير."},{"word":"nötig","topic":"L176","difficulty":2,"meaning":"ضَرُورِيّ","example":"Das ist nicht nötig.","translation":"ليس بالضرورة."},{"word":"Dach","topic":"L176","difficulty":2,"meaning":"سَقْف","example":"Das Dach meines Hauses ist rot.","translation":"سقف بيتي أحمر."}],"difficulty":2}}