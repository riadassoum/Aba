alten.","ar":"لا يمكن أن يدوم طويلا."},{"t":"Ich will ein Buch schreiben.","ar":"أريد أن أكتب كتاباً."},{"t":"Tom wird ein guter Lehrer sein.","ar":"توم سيصبح معلم جيد."},{"t":"Wann geht heute die Sonne unter?","ar":"متى تغرب الشمس اليوم؟"},{"t":"Ich musste überhaupt nichts tun.","ar":"لم يكن عليّ فعل شيء."},{"t":"Lässt du mich jetzt bitte gehen?","ar":"هل تسمح لي بالذهاب الآن؟"},{"t":"Das ist es, was wir Frauen wollen?","ar":"هذا ما تريده النّساء."},{"t":"Vielleicht wird er ein guter Lehrer.","ar":"لربما أصبح معلماً ماهراً."},{"t":"Das musste ich ihm nicht erst sagen.","ar":"لم أكن بحاجة لإخباره."},{"t":"Wir wissen nicht, warum er gehen musste.","ar":"لا نعلم لم اضطرّ للمغادرة."},{"t":"Ich musste den ganzen Tag an dich denken.","ar":"كنت أفكر بك طوال اليوم."},{"t":"Ich werde Maria nie einen Brief schreiben.","ar":"لن أكتب أبدا رسالة أخرى لماري."},{"t":"Können Sie in Englisch einen Brief schreiben?","ar":"أيمكنك كتابة رسالة بالإنجليزية؟"},{"t":"Ich werde keinen Brief auf Englisch schreiben.","ar":"لن أكتب رسالة بالإنجليزية."},{"t":"Ich werde nicht vergessen, meiner Mutter zu schreiben.","ar":"لن أنس مراسلة أمّي."},{"t":"Ich habe ein Buch.","ar":"عندي كتاب."},{"t":"Das ist mein Buch.","ar":"هذا كتابي."}],"focus":["Frauen","beiden","schreiben","halten","wegen","Sonne","guter","musste","beide","lässt"],"words":[{"word":"schreiben","topic":"L40","difficulty":1,"meaning":"كَاتَبَ، َأَلَّف","example":"Warum schreiben Sie noch?","translation":"لماذا تواصل الكتابة؟"},{"word":"halten","topic":"L40","difficulty":1,"meaning":"مَسَكَ","example":"Halten Sie den Bus an!","translation":"اوقف الحافلة."},{"word":"wegen","topic":"L40","difficulty":1,"meaning":"لِأَجْل","example":"Ich komme wegen dir.","translation":"أنا قادم إليكَ."},{"word":"Sonne","topic":"L40","difficulty":1,"meaning":"شَمْس","example":"Heute scheint die Sonne.","translation":"الجو مشمس اليوم."},{"word":"beide","topic":"L40","difficulty":1,"meaning":"كِلَا","example":"Beide sind am Leben.","translation":"كلاهما على قيد الحياة."}],"difficulty":1}}