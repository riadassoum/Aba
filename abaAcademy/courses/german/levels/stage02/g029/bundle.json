{"theory":{"blocks":[{"btype":"text","text":"الدرس 29. الكلمات الجديدة: ganze، warten، ganzen، Bruder، dachte، gekommen، daran، scheint، ihrer، Ende."},{"btype":"example","text":"ganze = حَسَنًا","note":"صيغة من ganz (المؤنث، حالة المفعول به)"},{"btype":"example","text":"warten = اِنْتَظَرَ","note":"مثال: Ich kann nur warten. — كل ما أستطيع فعله هو الإنتظار."},{"btype":"example","text":"ganzen = حَسَنًا","note":"صيغة من ganz (المذكّر، حالة الإضافة)"},{"btype":"example","text":"Bruder = أَخ","note":"مثال: Wo ist dein Bruder? — أين أخوك؟"},{"btype":"example","text":"dachte = ظَنَّ، فَكَّرَ","note":"صيغة من denken (الغائب، الماضي التامّ)؛ مثال: Ich dachte, es wäre wahr. — ظننته صحيحًا."},{"btype":"example","text":"gekommen = جَاءَ، قَدِمَ","note":"صيغة من kommen (اسم المفعول (التصريف الثالث))؛ مثال: Er ist nicht gekommen. — لم يأتي."},{"btype":"example","text":"daran","note":""},{"btype":"example","text":"scheint = بَدَا","note":"صيغة من scheinen (الغائب، المضارع)"},{"btype":"example","text":"ihrer = لَهَا","note":"مثال: Ich bin Ihrer Hilfe sicher. — أنا واثق من أنك ستساعدني."},{"btype":"example","text":"Ende = نِهَايَة","note":"مثال: Das ist das Ende. — هذه هي النهاية."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Das ist das Ende.","note":"هذه هي النهاية."},{"btype":"example","text":"Wo ist dein Bruder?","note":"أين أخوك؟"},{"btype":"example","text":"Ich kann nur warten.","note":"كل ما أستطيع فعله هو الإنتظار."},{"btype":"example","text":"Das ist mein Bruder.","note":"هذا أخي."},{"btype":"example","text":"Tom ist sein Bruder.","note":"توم هو أخوه"},{"btype":"example","text":"Tom ist dein Bruder.","note":"توم هو أخوك"},{"btype":"example","text":"Ende gut, alles gut.","note":"إنما العبرة بالنهاية."},{"btype":"example","text":"Alle warten auf dich.","note":"الكل ينتظرك."},{"btype":"example","text":"Tom sah Maria warten.","note":"رأى توم ماري و هي تنتظر."},{"btype":"example","text":"Ich habe einen Bruder.","note":"لديّ أخ واحد."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Das ist das Ende.","ar":"هذه هي النهاية."},{"t":"Wo ist dein Bruder?","ar":"أين أخوك؟"},{"t":"Ich kann nur warten.","ar":"كل ما أستطيع فعله هو الإنتظار."},{"t":"Das ist mein Bruder.","ar":"هذا أخي."},{"t":"Tom ist sein Bruder.","ar":"توم هو أخوه"},{"t":"Tom ist dein Bruder.","ar":"توم هو أخوك"},{"t":"Ende gut, alles gut.","ar":"إنما العبرة بالنهاية."},{"t":"Alle warten auf dich.","ar":"الكل ينتظرك."},{"t":"Tom sah Maria warten.","ar":"رأى توم ماري و هي تنتظر."},{"t":"Ich habe einen Bruder.","ar":"لديّ أخ واحد."},{"t":"Er ist nicht gekommen.","ar":"لم يأتي."},{"t":"Sie sind nie gekommen.","ar":"لم يأتوا أبدا."},{"t":"Ich habe keinen Bruder.","ar":"ليس لديّ إخوة."},{"t":"Es gehört meinem Bruder.","ar":"إنها لأخي."},{"t":"Sie warten wohl auf dich.","ar":"لا بد أنهم ينتظرونك."},{"t":"Ich dachte, es wäre wahr.","ar":"ظننته صحيحًا."},{"t":"Ich bin mit Tom gekommen.","ar":"لقد جئت مع توم."},{"t":"Er kann bis morgen warten.","ar":"بإمكانه الانتظار حتى الغد."},{"t":"Das war es, was ich dachte.","ar":"ذلك ما ظننته"},{"t":"Er ist noch nicht gekommen.","ar":"لم يأتِ بعد."},{"t":"Ich bin Ihrer Hilfe sicher.","ar":"أنا واثق من أنك ستساعدني."},{"t":"Wie lange müssen wir warten?","ar":"كم من الوقت علينا أن ننتظر؟"},{"t":"Kann Ihr Bruder Auto fahren?","ar":"هل يستطيع أخوك أن يقود سيارة؟"},{"t":"Kann ich hier auf Tom warten?","ar":"هل يمكنني إنتظار توم هنا؟"},{"t":"Mein Bruder kann Auto fahren.","ar":"يستطيع أخي أن يقود سيارة."},{"t":"Warum bist du nicht gekommen?","ar":"لِمَ لمْ تأتِ؟"},{"t":"Er will nicht auf dich warten.","ar":"لا يريد أن ينتظرك."},{"t":"Er wird auf sie warten müssen.","ar":"سيكون عليها أن تنتظره."},{"t":"Ich will nicht so lange warten.","ar":"لا أريد أن أنتظر هذا أطول."},{"t":"Helfen Sie Ihrer Frau zu Hause?","ar":"هل تساعد زوجتك في المنزل؟"}],"focus":["ganze","warten","ganzen","Bruder","dachte","gekommen","daran","scheint","ihrer","Ende"],"words":[{"word":"warten","topic":"L29","difficulty":1,"meaning":"اِنْتَظَرَ","example":"Ich kann nur warten.","translation":"كل ما أستطيع فعله هو الإنتظار."},{"word":"Bruder","topic":"L29","difficulty":1,"meaning":"أَخ","example":"Wo ist dein Bruder?","translation":"أين أخوك؟"},{"word":"ihrer","topic":"L29","difficulty":1,"meaning":"لَهَا","example":"Ich bin Ihrer Hilfe sicher.","translation":"أنا واثق من أنك ستساعدني."},{"word":"Ende","topic":"L29","difficulty":1,"meaning":"نِهَايَة","example":"Das ist das Ende.","translation":"هذه هي النهاية."}],"difficulty":1}}