bend an.","ar":"أنا أتصِل بها كُل مساء."},{"t":"Tom ist deinem Bruder ähnlich.","ar":"توم يشبه اخاك."},{"t":"Ich habe Informationen für Tom.","ar":"لدي معلومات لتوم."},{"t":"Sie waren gestern nicht zuhause.","ar":"لم يكونوا في المنزل البارحة."},{"t":"Dein Problem ist meinem ähnlich.","ar":"مشكلتك شبيهة بمشكلتي."},{"t":"Das sieht ihm gar nicht ähnlich.","ar":"هذا ليس من عاداته أبدا."},{"t":"Ab und zu träume ich von zuhause.","ar":"أحياناً أحلمُ بالمنزل."},{"t":"Ich werde morgen zuhause bleiben.","ar":"سأبقى بالبيت غداً."},{"t":"Er sieht seinem Vater sehr ähnlich.","ar":"إنه يشبه أباه كثيراً."},{"t":"Pass auf! Dort ist ein großes Loch.","ar":"انتبه! هناك حفرة كبيرة هناك."},{"t":"Ich rufe dich morgen Nachmittag an.","ar":"سأتصل عليك بعد ظهر الغد."},{"t":"Tom und Maria spielen gerade Schach.","ar":"يلعب توم وماري الشطرنج."},{"t":"Möchten Sie, dass ich ein Taxi rufe?","ar":"هل تريدني أن أستدعي لك سيارة أجرة؟"},{"t":"Ich rufe des Morgens gerne Maria an.","ar":"أحب أن أتصل بماري صباحا."},{"t":"Tom und Maria sind sich sehr ähnlich.","ar":"توم وماري متشابهان كثيراً."},{"t":"Die Haare dieses Jungen sind schwarz.","ar":"شعر ذاك الفتى أسود."},{"t":"Das sieht dir überhaupt nicht ähnlich.","ar":"هذا اذن على خلافك."},{"t":"Wir sind nicht auf der richtigen Straße.","ar":"لسنا في الطّريق الصّحيح."}],"focus":["perfekt","zuhause","Schach","ähnlich","Spiegel","richtigen","schwarz","Informationen","Loch","rufe"],"words":[{"word":"perfekt","topic":"L149","difficulty":2,"meaning":"كَامِل","example":"Es war perfekt.","translation":"لقد كان مثالياً."},{"word":"zuhause","topic":"L149","difficulty":2,"meaning":"بَيْت","example":"Tom ist nicht zuhause.","translation":"توم ليس في البيت"},{"word":"Schach","topic":"L149","difficulty":2,"meaning":"كِشّ مَلِك","example":"Tom spielte gerne Schach.","translation":"كان توم يحب لعب الشطرنج"},{"word":"ähnlich","topic":"L149","difficulty":2,"meaning":"مِثْل","example":"Tom ist deinem Bruder ähnlich.","translation":"توم يشبه اخاك."},{"word":"Spiegel","topic":"L149","difficulty":2,"meaning":"مِرْآة","example":"Schau in den Spiegel!","translation":"أنظر في المرآة!"},{"word":"schwarz","topic":"L149","difficulty":2,"meaning":"أَسْوَد","example":"Ist es nicht schwarz?","translation":"أليست سوداء؟"},{"word":"Loch","topic":"L149","difficulty":2,"meaning":"ثَقْب","example":"Pass auf! Dort ist ein großes Loch.","translation":"انتبه! هناك حفرة كبيرة هناك."}],"difficulty":2}}