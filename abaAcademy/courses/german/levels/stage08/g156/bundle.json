 nicht hingehen.","ar":"ليس من الضروري أن تذهب."},{"t":"Ich war wirklich beeindruckt.","ar":"لقد تأُثرت حقاً"},{"t":"Ich beschloss, Arzt zu werden.","ar":"قررت أن أصبح طبيباً."},{"t":"Da musst du unbedingt hingehen.","ar":"يجب أن تذهب."},{"t":"Du solltest dort nicht hingehen.","ar":"عليك ألا تذهب إلى هناك."},{"t":"Sie hält ihr Zimmer immer sauber.","ar":"دائماً ما تبقي غرفتها نظيفة."},{"t":"Den Rest der Geschichte kennst du.","ar":"أنتَ تعرف بقية القصة."},{"t":"Wir hätten selbst hingehen sollen.","ar":"كان يجب أن نذهب إلى هناك بأنفسنا."},{"t":"Tom machte das Haus alleine sauber.","ar":"نظّفَ توم البيت بمفرده."},{"t":"Du musst dein Zimmer sauber machen.","ar":"عليك أن تنظّف غرفتك."},{"t":"Du musst dein Zimmer sauber halten.","ar":"عليك أن تبقي غرفتك نظيفة."},{"t":"Das Tor wird um acht Uhr geschlossen.","ar":"تغلق البوابة ليلا."},{"t":"Könnten wir irgendwo anders hingehen?","ar":"هلا ذهبنا إلى مكان آخر؟"},{"t":"Sag mir, wohin ich diese Bücher legen soll.","ar":"أخبرني أين أضع هذه الكتب."}],"focus":["Rest","beeindruckt","besorgt","Tor","legen","Beziehung","Zeichen","beschloss","sauber","hingehen"],"words":[{"word":"Rest","topic":"L156","difficulty":2,"meaning":"بَاقِيَّة","example":"Den Rest musst du machen!","translation":"الباقي عليك!"},{"word":"besorgt","topic":"L156","difficulty":2,"meaning":"قَلِق","example":"Du bist besorgt.","translation":"تشعر بالقلق."},{"word":"Tor","topic":"L156","difficulty":2,"meaning":"مَرْمًى، هَدَف","example":"Tom ging ans Tor.","translation":"مشى توم باتجاه الباب"},{"word":"legen","topic":"L156","difficulty":2,"meaning":"وَضَعَ","example":"Die Vögel legen Eier.","translation":"تضع الطيور البيض."},{"word":"Beziehung","topic":"L156","difficulty":2,"meaning":"عَلَاقَة"},{"word":"Zeichen","topic":"L156","difficulty":2,"meaning":"إِشَارَة، لافِتَة"},{"word":"sauber","topic":"L156","difficulty":2,"meaning":"نَظِيف","example":"Das Wasser ist sauber.","translation":"الماء نقي."},{"word":"hingehen","topic":"L156","difficulty":2,"meaning":"ذَهَبَ