":"لم يكن يعرف تلك الفتاة."},{"t":"Jane ist draußen, einkaufen.","ar":"خرجت جين للتسوق."},{"t":"Tom geht oft allein einkaufen.","ar":"عادة ما يذهب توم للتبضع وحده."},{"t":"Mama ist vom Einkaufen zurück.","ar":"عادت أمي من التسوّق."},{"t":"Ich gehe jeden Morgen einkaufen.","ar":"أتسوق كل صباح."},{"t":"Ich kannte Tom nicht besonders gut.","ar":"لم أكن أعرف توم جيّدا."},{"t":"Ich war mit einem Freund einkaufen.","ar":"ذهبت للتسوق مع صديق لي."},{"t":"Ich habe schon drei Briefe geschrieben.","ar":"لقد كتبت ثلاث رسائل."},{"t":"Ich will nicht alleine einkaufen gehen.","ar":"لا أريد التّسوّق بمفردي."},{"t":"Sie war für mich wie eine zweite Mutter.","ar":"كانت كأم ثانية بالنسبة لي."},{"t":"Ich fahre nach dem Mittagessen einkaufen.","ar":"سوف اذهب للتسوق بعد الغداء."},{"t":"Sie hat ihm geraten, nicht zu viel zu essen.","ar":"نصحتْه ألّا يأكل كثيراً."},{"t":"Sind irgendwelche Briefe für mich angekommen?","ar":"هل وصلتني أي رسائل؟"},{"t":"Niemand, den ich kenne, schreibt noch Briefe.","ar":"لا أحد أعرفهُ يكتب خِطابات بعد الآن."},{"t":"Ich habe gestern Abend drei Briefe geschrieben.","ar":"كتبت ثلاث رسائل ليلة البارحة."}],"focus":["Schmerz","Meter","geraten","zweite","Füße","Briefe","kannte","einkaufen","bestehen","zahlen"],"words":[{"word":"Schmerz","topic":"L148","difficulty":2,"meaning":"أَلَم"},{"word":"Meter","topic":"L148","difficulty":2,"meaning":"مِتْر","example":"Es ist 30 Meter lang.","translation":"طوله ثلاثون مترًا."},{"word":"zweite","topic":"L148","difficulty":2,"meaning":"ثَانٍ","example":"Sie war für mich wie eine zweite Mutter.","translation":"كانت كأم ثانية بالنسبة لي."},{"word":"einkaufen","topic":"L148","difficulty":2,"meaning":"تَسَوُّق","example":"Sie ging einkaufen.","translation":"ذهبت للتسوق."},{"word":"bestehen","topic":"L148","difficulty":2,"meaning":"اِجْتَازَ"},{"word":"zahlen","topic":"L148","difficulty":2,"meaning":"دَفَعَ","example":"Zahlen bitte!","translation":"أعطني الحساب من فضلك."}],"difficulty":2}}