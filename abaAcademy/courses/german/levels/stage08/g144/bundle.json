misse Tom immer noch.","ar":"ما أزال أفتقد توم."},{"t":"Darf ich zur Toilette gehen?","ar":"أيمكنني الذهاب إلى الحمام؟"},{"t":"Reisen ist heutzutage leicht.","ar":"السفر سهل هذه الأيام."},{"t":"Fleisch ist heutzutage teuer.","ar":"ثمن اللحم باهظ في أيامنا هذه."},{"t":"Ich vermisse dich schrecklich.","ar":"أشتاق إليك كثيراً."},{"t":"Er hat noch nicht geantwortet.","ar":"لم يجب بعد."},{"t":"Wer schreibt heutzutage Briefe?","ar":"من يكتب الرسائل اليوم؟"},{"t":"Lasst uns eine kurze Pause machen.","ar":"لنأخذ استراحة قصيرة."},{"t":"Unser Haus ist schön, aber ich vermisse das alte dennoch.","ar":"منزلنا رائع, ولكني ما زلت أشتاق إلى القديم."},{"t":"Nachdem sie ihre Arbeit beendet hatten, gingen sie hinaus.","ar":"بعد أن إنتهوا من العمل، ذهبوا للخارج"}],"focus":["möge","beendet","laufe","vermisse","aussehen","kurze","geantwortet","Toilette","heutzutage","schlägt"],"words":[{"word":"laufe","topic":"L144","difficulty":1,"meaning":"مَشَى","example":"Ich laufe schnell.","translation":"أنا أركض بسرعة."},{"word":"aussehen","topic":"L144","difficulty":1,"meaning":"مَرْأىً","example":"Ich möchte reich aussehen.","translation":"أريد أن أبدو غنياً"},{"word":"Toilette","topic":"L144","difficulty":1,"meaning":"مِرْحَاض","example":"Wo ist die Toilette?","translation":"أين الحمّام؟"},{"word":"heutzutage","topic":"L144","difficulty":1,"meaning":"حَاضِر","example":"Reisen ist heutzutage leicht.","translation":"السفر سهل هذه الأيام."}],"difficulty":1}}