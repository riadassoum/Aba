reche täglich Englisch.","ar":"أتحدث الإنجليزية يومياً."},{"t":"Warum wollte sie meine Nummer?","ar":"لماذا أرادت الحصول على رقم هاتفي؟"},{"t":"Wohin geht die Sonne des Nachts?","ar":"إلى أين تذهب الشمس ليلًا؟"},{"t":"Sie hat gerade den Zug verpasst.","ar":"لقد فوتت القطار للتو."},{"t":"Ich kann Tom da drüben sitzen sehen.","ar":"يمكنني أن أرى توم جالسًا هناك."},{"t":"Wir haben vielleicht den Bus verpasst.","ar":"لربما فاتنا الباص."},{"t":"Es ist gefährlich, nachts zu schwimmen.","ar":"السباحة ليلاً خطرة."},{"t":"Ich glaube, Tom meint, dass ich das denke.","ar":"أنا أظنّ أن تومًا يظنّ أنني أظنّ ذلك."},{"t":"Vergessen Sie nicht die Regel mit der Nummer 72.","ar":"لا تنسى القاعدة رقم إثنان وسبعون."},{"t":"Wenn ihr schon hier seid, können wir auch beginnen.","ar":"بما أنك هنا، لعلنا نبدأ."},{"t":"Ich wollte dich anrufen, aber ich hatte deine Nummer nicht.","ar":"أردتُ أن أتصل بِكَ ولكن لم يكُن لديَ رقمك."},{"t":"Mach dich besser auf den Weg, dass du den Bus nicht verpasst!","ar":"من الأفضل أن تذهب الآن قبل أن تفوتك الحافلة."},{"t":"Vergiss nicht, mich dazu zu nehmen.","ar":"لا تنس إضافتي."},{"t":"Vergiss unser Treffen morgen nicht!","ar":"لا تنسى ميعادنا غدا."},{"t":"Ich werde nach Deutschland fliegen.","ar":"سأُحَلِق إلى المانيا."},{"t":"Es lag viel Schnee im letzten Jahr.","ar":"هطل الكثير من الثلج السنة الماضية."}],"focus":["meint","fangen","beginnen","Kiste","nachts","Erklärung","drüben","verpasst","Nummer","täglich"],"words":[{"word":"fangen","topic":"L146","difficulty":2,"meaning":"أَمْسَكَ","example":"Dann fangen wir an.","translation":"إذاً فلنبدأ."},{"word":"beginnen","topic":"L146","difficulty":2,"meaning":"بَدَأَ","example":"Lasst uns am Anfang beginnen.","translation":"دعنا نبداً من البداية."},{"word":"Kiste","topic":"L146","difficulty":2,"meaning":"عُلَب"},{"word":"nachts","topic":"L146","difficulty":2,"meaning":"فِي اَللَّيْلَ","example":"Ich arbeite nachts.","translation":"أعمل في الليل."},{"word":"Erklärung","topic":"L146","difficulty":2,"meaning":"إِعْلَان","example":"Danke für Ihre Erklärung.","translation":"شكراً لتوضيحك."},{"word":"drüben","topic":"L146","difficulty":2,"meaning":"هُنَاك","example":"Was ist dort drüben?","translation":"ماذا يوجد هناك؟"},{"word":"Nummer","topic":"L146","difficulty":2,"meaning":"رَقْم، عَدَد","example":"Warum wollte sie meine Nummer?","translation":"لماذا أرادت الحصول على رقم هاتفي؟"},{"word":"täglich","topic":"L146","difficulty":2,"meaning":"يَوْمِيّ","example":"Ich spreche täglich Englisch.","translation":"أتحدث الإنجليزية يومياً."}],"difficulty":2}}