:"Gebt mir noch eine Chance.","ar":"أعطني فرصةً أخرى."},{"t":"Das musst du selber machen.","ar":"يجب عليك فعل ذلك بنفسك."},{"t":"Wir waren nicht eingeladen.","ar":"لم نكن مدعوين"},{"t":"Das habe ich selber gemacht.","ar":"صنعتها بنفسي."},{"t":"Wir gingen um den See herum.","ar":"مشينا حول البحيرة."},{"t":"Ich erinnere mich nicht genau.","ar":"لا أذكر بدقة."},{"t":"Mach deine Hausaufgaben selber.","ar":"قم بعملك بنفسك."},{"t":"Der See ist weit fort von hier.","ar":"البحيرة بعيدة جداً عن هنا."},{"t":"Wir leben in einer Gesellschaft.","ar":"نحن نعيش في مجتمع."},{"t":"In diesem Fall liegen Sie falsch.","ar":"انت مخطئ في هذه الحالة."},{"t":"Die sind nicht eingeladen worden.","ar":"إنهم لم يكونوا مدعويين."},{"t":"Der See ist an dieser Stelle tief.","ar":"البحيرة عميقة هنا."},{"t":"Was immer es ist, ich bin dagegen.","ar":"أيا كان، أنا ضده."},{"t":"Wie viele Leute hast du eingeladen?","ar":"كم شخصًا دعوت؟"},{"t":"Alle wurden eingeladen, nur ich nicht.","ar":"الجميع تم دعوتهم إلا أنا."},{"t":"Es ist unmöglich, ohne Wasser zu leben.","ar":"من المستحيل العيش بدون ماء."},{"t":"Tom hat Mary zum Abendessen eingeladen.","ar":"توم دعا ميري إلى العشاء."}],"focus":["Gesellschaft","liegen","unmöglich","leider","selber","Chance","See","eingeladen","dagegen","erinnere"],"words":[{"word":"Gesellschaft","topic":"L168","difficulty":2,"meaning":"شَرِكَة، رِفْقَة","example":"Wir leben in einer Gesellschaft.","translation":"نحن نعيش في مجتمع."},{"word":"liegen","topic":"L168","difficulty":2,"meaning":"ضَجَعَ","example":"In diesem Fall liegen Sie falsch.","translation":"انت مخطئ في هذه الحالة."},{"word":"unmöglich","topic":"L168","difficulty":2,"meaning":"مُسْتَحِيل","example":"Unmöglich!","translation":"غير معقول!"},{"word":"leider","topic":"L168","difficulty":2,"meaning":"لِلْأَسَف","example":"Leider erinnere ich mich an nichts.","translation":"للأسف، لا أتذكر أي شيء."},{"word":"selber","topic":"L168","difficulty":2,"meaning":"بِمُفْرَدِي","example":"Das musst du selber machen.","translatio