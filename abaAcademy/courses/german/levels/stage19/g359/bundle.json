{"theory":{"blocks":[{"btype":"text","text":"الدرس 359. الكلمات الجديدة: Quellen، Geräusche، Formular، leihe، Karotten، beneide، rauchte، verlorene، verdorben، angehen."},{"btype":"example","text":"Quellen = أَصْل","note":""},{"btype":"example","text":"Geräusche = ضَوْضَاء","note":"صيغة من Geräusch (الجمع، حالة الإضافة، حالة المفعول به)؛ مثال: Ich hörte Geräusche. — سمعت ضجّة."},{"btype":"example","text":"Formular = اِسْتِمَارَة","note":""},{"btype":"example","text":"leihe = أَعَارَ","note":"صيغة من leihen (المتكلّم، المضارع)؛ مثال: Ich leihe dir einen, wenn du magst. — سأعيرك واحدا إن شئتَ."},{"btype":"example","text":"Karotten = جَزَر","note":"صيغة من Karotte (الجمع)؛ مثال: Ich liebe Karotten. — أحبُ الجزر"},{"btype":"example","text":"beneide = حَسَدَ","note":"صيغة من beneiden (المتكلّم، المضارع)؛ مثال: Ich beneide sie. — أنا أحسدها."},{"btype":"example","text":"rauchte = تَدْخِين","note":"صيغة من rauchen (الغائب، الماضي التامّ)؛ مثال: Er rauchte. — كان يدخّن."},{"btype":"example","text":"verlorene = ضَائِع","note":"صيغة من verloren (المؤنث، حالة المفعول به)"},{"btype":"example","text":"verdorben = فَاسِد","note":"مثال: Das Fleisch ist verdorben. — أصبح هذا اللحم سيئا."},{"btype":"example","text":"angehen = خَصَّ","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Er rauchte.","note":"كان يدخّن."},{"btype":"example","text":"Ich beneide sie.","note":"أنا أحسدها."},{"btype":"example","text":"Ich liebe Karotten.","note":"أحبُ الجزر"},{"btype":"example","text":"Ich hörte Geräusche.","note":"سمعت ضجّة."},{"btype":"example","text":"Das Fleisch ist verdorben.","note":"أصبح هذا اللحم سيئا."},{"btype":"example","text":"Ich leihe dir einen, wenn du magst.","note":"سأعيرك واحدا إن شئتَ."},{"btype":"example","text":"Die Hälfte der Äpfel sind verdorben.","note":"نصف هذه التفاحات فاسد."},{"btype":"example","text":"Wenn du einen Schirm brauchst, leihe ich dir einen.","note":"إن كنت تحتاج مظلةً، فسأعيرك واحدةً."},{"btype":"example","text":"Ich liebe Tom nicht mehr.","note":"لم أعد أحب توم."},{"btype":"example","text":"Sag mir, was passiert ist.","note":"أخبرني ما حدث."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Er rauchte.","ar":"كان يدخّن."},{"t":"Ich beneide sie.","ar":"أنا أحسدها."},{"t":"Ich liebe Karotten.","ar":"أحبُ الجزر"},{"t":"Ich hörte Geräusche.","ar":"سمعت ضجّة."},{"t":"Das Fleisch ist verdorben.","ar":"أصبح هذا اللحم سيئا."},{"t":"Ich leihe dir einen, wenn du magst.","ar":"سأعيرك واحدا إن شئتَ."},{"t":"Die Hälfte der Äpfel sind verdorben.","ar":"نصف هذه التفاحات فاسد."},{"t":"Wenn du einen Schirm brauchst, leihe ich dir einen.","ar":"إن كنت تحتاج مظلةً، فسأعيرك واحدةً."},{"t":"Ich liebe Tom nicht mehr.","ar":"لم أعد أحب توم."},{"t":"Sag mir, was passiert ist.","ar":"أخبرني ما حدث."},{"t":"Mike und Ken sind Freunde.","ar":"مايك وكين صديقان."},{"t":"Wann gehen wir nach Hause?","ar":"متى سنذهب إلى المنزل؟"}],"focus":["Quellen","Geräusche","Formular","leihe","Ka