{"theory":{"blocks":[{"btype":"text","text":"الدرس 368. الكلمات الجديدة: Mittelpunkt، Konflikt، irgendjemand، eingehen، Chemie، Weltraum، freier، großartige، erzeugt، beachten."},{"btype":"example","text":"Mittelpunkt = مُنْتَصَف","note":"مثال: Sie hält sich für den Mittelpunkt des Universums. — هي تعتقد أنها مركز الكون."},{"btype":"example","text":"Konflikt = صِرَاع","note":""},{"btype":"example","text":"irgendjemand","note":"مثال: Hat irgendjemand mich während meiner Abwesenheit angerufen? — هل اتصل بي أحد عندما كنت في الخارج؟"},{"btype":"example","text":"eingehen = وَصَلَ","note":"مثال: Um das zu tun, musst du Risiken eingehen. — لفعل ذلك، يجِبُ أن تُخاطر."},{"btype":"example","text":"Chemie = كِيمِيَاء، كِيمِيَائِيّ","note":"مثال: Ich hasse Chemie. — أكره مادة الكيمياء."},{"btype":"example","text":"Weltraum = فَضَاء","note":"مثال: Der Weltraum ist voller Rätsel. — الفضاء مليء بالألغاز."},{"btype":"example","text":"freier = حُرّ، شَاغِر","note":"صيغة من frei (صيغة التفضيل)؛ مثال: Ich bin ein freier Mann. — أنا رجل حر."},{"btype":"example","text":"großartige = رَائِع","note":"صيغة من großartig (المؤنث، حالة المفعول به)؛ مثال: Das ist eine großartige Idee. — إنها فكرة جيدة."},{"btype":"example","text":"erzeugt = صَنَعَ","note":"صيغة من erzeugen (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"beachten = ذَكَرَ","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ich hasse Chemie.","note":"أكره مادة الكيمياء."},{"btype":"example","text":"Ich bin ein freier Mann.","note":"أنا رجل حر."},{"btype":"example","text":"Du bist ein freier Mann.","note":"أنت رجل حر."},{"btype":"example","text":"Morgen ist dein freier Tag.","note":"غدا عطلتك."},{"btype":"example","text":"Das ist eine großartige Idee.","note":"إنها فكرة جيدة."},{"btype":"example","text":"Der Weltraum ist voller Rätsel.","note":"الفضاء مليء بالألغاز."},{"btype":"example","text":"Der Weltraum scheint unendlich.","note":"يبدو الفضاء بلا حدود."},{"btype":"example","text":"Um das zu tun, musst du Risiken eingehen.","note":"لفعل ذلك، يجِبُ أن تُخاطر."},{"btype":"example","text":"Ich kann nicht auf Einzelheiten eingehen.","note":"لا أستطيع الدخول في التفاصيل."},{"btype":"example","text":"Sie hält sich für den Mittelpunkt des Universums.","note":"هي تعتقد أنها مركز الكون."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich hasse Chemie.","ar":"أكره مادة الكيمياء."},{"t":"Ich bin ein freier Mann.","ar":"أنا رجل حر."},{"t":"Du bist ein freier Mann.","ar":"أنت رجل حر."},{"t":"Morgen ist dein freier Tag.","ar":"غدا عطلتك."},{"t":"Das ist eine großartige Idee.","ar":"إنها فكرة جيدة."},{"t":"Der Weltraum ist voller Rätsel.","ar":"الفضاء مليء بالألغاز."},{"t":"Der Weltraum scheint unendlich.","ar":"يبدو الفضاء بلا حدود."},{"t":"Um das zu tun, musst du Risiken eingehen.","ar":"لفعل ذلك، يجِبُ أن تُخاطر."},{"t":"Ich kann nicht auf Einzelheiten eingehen.","ar":"لا أستطيع الدخول في التفاصيل."},{"t":"Sie hält sich fü