{"theory":{"blocks":[{"btype":"text","text":"الدرس 353. الكلمات الجديدة: Nachbarschaft، gelobt، reserviert، Leichtigkeit، Arbeitsstelle، vorkommen، allgemein، Nägel، Vorlesung، Werte."},{"btype":"example","text":"Nachbarschaft = جِوَار","note":"مثال: Ein Hund bellt in der Nachbarschaft. — ينبح كلب في الحي."},{"btype":"example","text":"gelobt = مَدَحَ","note":"صيغة من loben (اسم المفعول (التصريف الثالث))؛ مثال: Gelobt sei Satan! — يحيا الشيطان!"},{"btype":"example","text":"reserviert = حَجَزَ","note":"صيغة من reservieren (اسم المفعول (التصريف الثالث))؛ مثال: Dieser Tisch ist reserviert. — حجزت هذه الطاولة."},{"btype":"example","text":"Leichtigkeit = سُهُولَة","note":"مثال: Er löste das Problem mit Leichtigkeit. — حل المشكلة بسهولة."},{"btype":"example","text":"Arbeitsstelle = مَكَان عَمَل","note":""},{"btype":"example","text":"vorkommen = حَدَثَ","note":"مثال: Mach dir keine Gedanken. Das wird nicht wieder vorkommen. — لا تقلق. لن يحدث هذا ثانية."},{"btype":"example","text":"allgemein = عَامّ، عُمُومِيّ","note":"مثال: Allgemein gesagt: Geschichte wiederholt sich. — على العموم ، التاريخ يكرّر نفسه."},{"btype":"example","text":"Nägel = ظُفْر، مِسْمَار","note":"صيغة من Nagel (الجمع)"},{"btype":"example","text":"Vorlesung = مُحَاضَرَة","note":""},{"btype":"example","text":"Werte = قِيمَة","note":"صيغة من Wert (الجمع، حالة الإضافة، حالة المفعول به)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Gelobt sei Satan!","note":"يحيا الشيطان!"},{"btype":"example","text":"Dieser Tisch ist reserviert.","note":"حجزت هذه الطاولة."},{"btype":"example","text":"Ich habe einen Platz reserviert.","note":"لقد حجزت مكانا."},{"btype":"example","text":"Ein Hund bellt in der Nachbarschaft.","note":"ينبح كلب في الحي."},{"btype":"example","text":"Er löste das Problem mit Leichtigkeit.","note":"حل المشكلة بسهولة."},{"btype":"example","text":"Er wohnt nicht in meiner Nachbarschaft.","note":"إنه لا يسكن في حيي."},{"btype":"example","text":"Ich habe den Saal für Donnerstag reserviert.","note":"حجزت الصالة يوم الخميس."},{"btype":"example","text":"Allgemein gesagt: Geschichte wiederholt sich.","note":"على العموم ، التاريخ يكرّر نفسه."},{"btype":"example","text":"Mach dir keine Gedanken. Das wird nicht wieder vorkommen.","note":"لا تقلق. لن يحدث هذا ثانية."},{"btype":"example","text":"Uns sind Fehler passiert.","note":"ارتكبنا أخطاءً."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Gelobt sei Satan!","ar":"يحيا الشيطان!"},{"t":"Dieser Tisch ist reserviert.","ar":"حجزت هذه الطاولة."},{"t":"Ich habe einen Platz reserviert.","ar":"لقد حجزت مكانا."},{"t":"Ein Hund bellt in der Nachbarschaft.","ar":"ينبح كلب في الحي."},{"t":"Er löste das Problem mit Leichtigkeit.","ar":"حل المشكلة بسهولة."},{"t":"Er wohnt nicht in meiner Nachbarschaft.","ar":"إنه لا يسكن في حيي."},{"t":"Ich habe den Saal für Donnerstag reserviert.","ar":"حجزت الصالة يوم الخميس."},{"t":"Allgemein gesagt: Geschichte wiederholt sich.","ar":"على