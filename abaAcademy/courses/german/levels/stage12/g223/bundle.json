":"Sie ist sehr stolz auf ihr Aussehen.","ar":"هي فخورة جدا بمظهرها."},{"t":"Kannst du mit einem Wörterbuch umgehen?","ar":"هل تعرف كيف تستخدم قاموسًا؟"},{"t":"Wir wollen ehrlich miteinander umgehen.","ar":"دعونا نكون صادقين معَ بعض."},{"t":"Er kann nicht mit der Wahrheit umgehen.","ar":"لا يستطيع تحمل الحقيقة."},{"t":"Ich warte seit fast einer halben Stunde.","ar":"انتظرت قرابة النصف ساعة."},{"t":"Dem Aussehen nach ist sie mindestens 60.","ar":"تبدو في الستينات من عمرها على الأقل."},{"t":"Es gibt viele Probleme, die wir nicht umgehen können.","ar":"هناك الكثير من المشاكل التي لا يمكننا تجنبها."},{"t":"Sie wusste nicht, wie sie mit dem Problem umgehen sollte.","ar":"لم تعرف كيف تتصرف تجاه المشكلة."},{"t":"Unser Haus ist schön, aber ich vermisse das alte dennoch.","ar":"منزلنا رائع, ولكني ما زلت أشتاق إلى القديم."},{"t":"Wenn Sie es mir zum halben Preis geben, kaufe ich sofort zwei davon.","ar":"اذا بعتني القطعة بنصف السعر فسوف اشتري منك قطعتان"}],"focus":["innerhalb","laufe","umgehen","vermisse","halben","Schwert","Aussehen","kurze","hinzu","Wut"],"words":[{"word":"innerhalb","topic":"L223","difficulty":3,"meaning":"في غضون، دَاخِل"},{"word":"laufe","topic":"L223","difficulty":3,"meaning":"مَشَى","example":"Ich laufe schnell.","translation":"أنا أركض بسرعة."},{"word":"umgehen","topic":"L223","difficulty":3,"meaning":"تَجَنَّبَ","example":"Können Sie damit umgehen?","translation":"أيمكنك تولّي أمره؟"},{"word":"Schwert","topic":"L223","difficulty":3,"meaning":"سَيْف","example":"Ich will ein Schwert.","translation":"أريد السيف!"},{"word":"Aussehen","topic":"L223","difficulty":3,"meaning":"مَرْأىً","example":"Ich möchte reich aussehen.","translation":"أريد أن أبدو غنياً"},{"word":"Wut","topic":"L223","difficulty":3,"meaning":"حَنَق"}],"difficulty":3}}