.","ar":"هذا مالي أيضا."}],"focus":["Sätzen","zerbrochen","dünn","wahnsinnig","Arsch","öffentlichen","tritt","bittet","Erwachsene","verlässt"],"words":[{"word":"zerbrochen","topic":"L223","difficulty":2,"meaning":"مَكْسُور"},{"word":"dünn","topic":"L223","difficulty":2,"meaning":"رَفِيع","example":"Bleib dünn.","translation":"حافظي على جسم نحيف."},{"word":"wahnsinnig","topic":"L223","difficulty":2,"meaning":"مَجْنُون"},{"word":"Arsch","topic":"L223","difficulty":2,"meaning":"عَجِيزَة","example":"Was ihr sagt, geht mir so was von am Arsch vorbei!","translation":"أنا لا أبالي إطلاقا بما تقولونه."},{"word":"tritt","topic":"L223","difficulty":2,"meaning":"خُطْوَة، خَطْوَة","example":"Er tritt mich!","translation":"إنه يركلني!"},{"word":"Erwachsene","topic":"L223","difficulty":2,"meaning":"بَالِغ","example":"Nur für Erwachsene.","translation":"للكبار فقط."}],"difficulty":2}}