ht.","ar":"لا أشارك رأيك."},{"t":"Das hast du absichtlich getan!","ar":"لقد تعمدت ذلك!"},{"t":"Du brauchst nicht aufzustehen.","ar":"لا تحتاج أن تقف."},{"t":"Es ist zu früh, um aufzustehen.","ar":"لا يزال الوقت مبكرا للقيام."},{"t":"Tom schickte Maria nach Boston.","ar":"توم أرسل ماري إلى بوسطن."},{"t":"Es kommen viele Touristen hierher.","ar":"الكثير من السياح ياتون هنا ."},{"t":"Ich muss mit jemandem diskutieren.","ar":"انا يجب ان اناقش مع شخص ما."},{"t":"Er trat absichtlich auf meinen Fuß.","ar":"تعمد أن يدوس على قدمي."},{"t":"Es gibt auch französische Touristen.","ar":"هنالك ايضا سياح فرنسيون ."},{"t":"Der Aufzug funktioniert heute nicht.","ar":"المصعد لا يعمل اليوم."},{"t":"In der Stadt gibt es viele Touristen.","ar":"هنالك العديد من السياح في البلدة ."},{"t":"Japanische Touristen findet man überall.","ar":"انت تواجه السياح اليابانيين في كل مكان ."},{"t":"Sein Sohn wurde von der Schule geworfen.","ar":"فُصِل ابنه من المدرسة."},{"t":"Lassen Sie uns nicht darüber diskutieren!","ar":"لنتوقف عن النقاش في ذلك."},{"t":"Seit einer Stunde diskutieren wir am Telefon.","ar":"نحن نتحدّث على الهاتف لما يقارب الساعة."},{"t":"Viele Touristen besuchen jedes Jahr diese Insel.","ar":"يأتي العديد من السياح الى هذه الجزيرة كل سنة ."},{"t":"Einige Touristen wurden bei dem Unfall verletzt.","ar":"عدد من السياح اصيبوا في الحادثة ."}],"focus":["Erden","absichtlich","teile","aufzustehen","schickte","brennt","Touristen","geworfen","diskutieren","Aufzug"],"words":[{"word":"Erden","topic":"L238","difficulty":3,"meaning":"تُرْبَة، أَرْض"},{"word":"absichtlich","topic":"L238","difficulty":3,"meaning":"عَمْدًا","example":"Das hast du absichtlich getan!","translation":"لقد تعمدت ذلك!"},{"word":"diskutieren","topic":"L238","difficulty":3,"meaning":"نَاقَشَ","example":"Sie diskutieren das Problem.","translation":"هم يناقشون المشكلة."},{"word":"Aufzug","topic":"L238","difficulty":3,"meaning":"مِصْعَد","example":"Wo ist der Aufzug?","translation":"أين المصعد؟"}],"difficulty":3}}