{"theory":{"blocks":[{"btype":"text","text":"قاعدة: الفعل في المرتبة الثانية"},{"btype":"text","text":"في الجملة الخبرية يأتي الفعل المصرّف دائمًا في المرتبة الثانية: Ich lerne heute Deutsch، وHeute lerne ich Deutsch."},{"btype":"text","text":"إذا بدأت الجملة بغير الفاعل، انتقل الفاعل إلى ما بعد الفعل."},{"btype":"text","text":"في سؤال نعم/لا يأتي الفعل أوّلًا: Lernst du Deutsch?"},{"btype":"example","text":"Morgen fahre ich nach Berlin.","note":"غدًا أسافر إلى برلين."},{"btype":"example","text":"Kommst du mit?","note":"هل تأتي معنا؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich sehe sie selten.","ar":"أراها نادراً"},{"t":"Heute bin ich zum Arzt gegangen.","ar":"ذهبت اليوم إلى الطبيب"},{"t":"Heute ist schönes Wetter.","ar":"طقس اليوم جميل."},{"t":"Ich bin zu Hause.","ar":"إني في المنزل."},{"t":"Ich mag die Schule nicht.","ar":"لا أحب المدرسة."},{"t":"Ich weiß nicht.","ar":"لا أعرف‏.‏‏"},{"t":"Ich bin heute Morgen um sieben aufgestanden.","ar":"استيقظت في السابعة هذا الصباح."},{"t":"Ich habe es gestern gekauft.","ar":"اشتريته بالأمس."},{"t":"Ich habe da ein Problem.","ar":"عندي مشكلة."},{"t":"Ich bin ihr auf der Straße begegnet.","ar":"قابلتها في الشارع."},{"t":"Ich weiß nichts.","ar":"لا أعرف شيئاً."},{"t":"Ich werde ihm morgen helfen.","ar":"سأساعده غداً."},{"t":"Ich habe nur eine Schwester.","ar":"لي أخت واحدة."},{"t":"Woher soll ich das wissen?","ar":"كيف لي أن أعرف؟"},{"t":"Ich bin nicht aus Indien.","ar":"لست من الهند."},{"t":"Ich bin frei.","ar":"أنا حُرّ."},{"t":"Ich habe vergessen, ihn zu fragen.","ar":"نسيت أن أسأله."},{"t":"Fehlt heute irgendwer?","ar":"هل غاب أحد اليوم؟"},{"t":"Ich verlasse mich auf dich.","ar":"أعتمد عليك."},{"t":"Jetzt erinnere ich mich.","ar":"الآن تذكرت."},{"t":"Sie fragte mich, wie alt ich sei.","ar":"سألتني عن عمري."},{"t":"Ich möchte dir etwas sagen.","ar":"أريد أن أقول لك شيئاً."},{"t":"Ich brauche deine Hilfe.","ar":"أحتاج مساعدتك."},{"t":"Wird es heute regnen?","ar":"هل ستمطر اليوم؟"},{"t":"Ich wohne im Erdgeschoss.","ar":"أعيش في الطابق الأرضي."},{"t":"Ich war schon in Rom.","ar":"لقد زرت روما."},{"t":"Ich liebe dieses Photo.","ar":"أحب هذه الصورة."},{"t":"Ich liebe französische Filme.","ar":"أحب الأفلام الفرنسية."},{"t":"Ich bin nicht Ihrer Meinung.","ar":"لا أوافقك الرأي."},{"t":"Ich spiele mit ihm.","ar":"ألعب معه."},{"t":"Ich arbeite mit ihm.","ar":"أعمل معه."},{"t":"Ich verstehe nicht.","ar":"لا أفهم."},{"t":"Ich bin arbeitslos.","ar":"أنا عاطل عن العمل."},{"t":"Ich weiß nicht, wie ich dir danken soll.","ar":"لا أعرف كيف أشكرك."},{"t":"Darf ich etwas sagen?","ar":"أيمكنني أن أقول شيئاً؟"},{"t":"Was hast du heute Morgen gemacht?","ar":"ماذا فعلت هذا الصباح؟"},{"t":"Ich komme aus Norwegen.","ar":"أنا من النرويج."},{"t":"Kann ich mir heute Abend dein Auto leihen?","ar":"هل يُمكنني استعارة سيارتك لهذه الليلة؟"},{"t":"Was? Ich kann dich nicht hören.","ar":"ماذا؟ لا أسمعك."},{"t":"Ich werde Arzt.","ar":"سأصبح طبيبًا."},{"t":"Morgen fahre ich nach Berlin.","ar":"غدًا أسافر إلى برلين."},{"t":"Kommst du mit?","ar":"هل تأتي معنا؟"}]}}