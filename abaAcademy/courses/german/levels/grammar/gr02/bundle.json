ة يدي."},{"t":"Ich habe da ein Problem.","ar":"عندي مشكلة."},{"t":"Ich bin ihr auf der Straße begegnet.","ar":"قابلتها في الشارع."},{"t":"Bob ist ein Ingenieur geworden.","ar":"أصبح بوب مهندساً."},{"t":"Die Tür ist auf.","ar":"الباب مفتوح."},{"t":"Eine Witwe ist eine Frau, deren Ehemann verstorben ist.","ar":"الأرملة امرأة توفي زوجها."},{"t":"Wo ist er hingegangen?","ar":"أين ذهب؟"},{"t":"Ich habe nur eine Schwester.","ar":"لي أخت واحدة."},{"t":"Sie hat fünf ältere Brüder.","ar":"لديها خمس إخوة أكبر منها."},{"t":"Mein Vater ist Lehrer.","ar":"أبي مدرّس."},{"t":"Ich bin nicht aus Indien.","ar":"لست من الهند."},{"t":"Fatima ist die älteste Studentin in unserer Klasse.","ar":"فاطمة أكبر طالبة في فصلنا."},{"t":"Ich bin frei.","ar":"أنا حُرّ."},{"t":"Ich habe vergessen, ihn zu fragen.","ar":"نسيت أن أسأله."},{"t":"Der Junge ist durstig.","ar":"الولد عطشان."},{"t":"Es ist rot.","ar":"لونه أحمر."},{"t":"Es ist kalt.","ar":"الجو بارد."},{"t":"Das ist nicht wichtig.","ar":"ليس مهماً."},{"t":"Es ist spät.","ar":"إنها ساعة متأخرة."},{"t":"Das ist hübscher.","ar":"هذا أجمل."},{"t":"Das Klima hier ist mild.","ar":"الجو معتدل هنا."},{"t":"Er ist nach Hause gegangen.","ar":"مشى إلى البيت."},{"t":"Er ist zum Laden gegangen.","ar":"ذهب إلى المتجر."},{"t":"Ich bin nicht Ihrer Meinung.","ar":"لا أوافقك الرأي."},{"t":"Ich bin arbeitslos.","ar":"أنا عاطل عن العمل."},{"t":"Ich bin müde.","ar":"أنا متعب."},{"t":"Hast du Zeit?","ar":"هل عندك وقت؟"}]}}