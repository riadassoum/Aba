{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Ich möchte hier sein.","note":"أريد أن أكون هنا"},{"btype":"example","text":"Ich möchte sie nicht.","note":"لا أريدهم."},{"btype":"example","text":"Ich möchte dir etwas sagen.","note":"أريد أن أقول لك شيئاً."},{"btype":"example","text":"Tom möchte nicht mit dir gehen.","note":"لا يريد توم الذهاب معك."},{"btype":"example","text":"Wer hat das gesagt?","note":"من قال هذا؟"},{"btype":"example","text":"Er weiß, wer du bist.","note":"هو يعلم من تكون."},{"btype":"example","text":"Ich weiß, wer ich bin.","note":"أعرف من أكون."},{"btype":"example","text":"Sie weiß, wer du bist.","note":"هي تعلم من أنت."},{"btype":"example","text":"Ich weiß, wer sie ist.","note":"أعلم من هي."},{"btype":"example","text":"Er weiß, wer wir sind.","note":"هو يعلم من نكون."},{"btype":"example","text":"Ich weiß, wer die sind.","note":"أعلم من يكونون."},{"btype":"example","text":"Wer hat Ziri das gesagt?","note":"من قال هذا لزيري؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich möchte hier sein.","ar":"أريد أن أكون هنا"},{"t":"Ich möchte sie nicht.","ar":"لا أريدهم."},{"t":"Ich möchte dir etwas sagen.","ar":"أريد أن أقول لك شيئاً."},{"t":"Tom möchte nicht mit dir gehen.","ar":"لا يريد توم الذهاب معك."},{"t":"Wer hat das gesagt?","ar":"من قال هذا؟"},{"t":