{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Meine Eltern leben auf dem Land.","note":"يعيش أبويّ في القرية."},{"btype":"example","text":"Ich liebe ihn nicht mehr.","note":"لم أعد أحبه."},{"btype":"example","text":"Ich liebe ihn immer noch.","note":"لاَ أَزَالُ أُحِبُّهُ."},{"btype":"example","text":"Ich liebe sie immer noch.","note":"ما زلت أحبها"},{"btype":"example","text":"Ich liebe Tom nicht mehr.","note":"لم أعد أحب توم."},{"btype":"example","text":"Ich liebe es, allein zu sein.","note":"احب أن اكون لوحدي"},{"btype":"example","text":"Ich liebe dich mehr als du mich.","note":"أحبك أكثر مما تحبني."},{"btype":"example","text":"Ich liebe dieses Buch über alles.","note":"أحب هذا الكتاب أكثر من غيره."},{"btype":"example","text":"Das ist eine gute Frage.","note":"هذا سؤال جيد."},{"btype":"example","text":"Ich habe eine Frage zu dir!","note":"لدي سؤال عنك"},{"btype":"example","text":"Diese Frage ist nicht einfach.","note":"هذا السؤال ليس سهلاً."},{"btype":"example","text":"Jeden Morgen frage ich mich, warum.","note":"كل صباح أتساءل لماذا."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Meine Eltern leben auf dem Land.","ar":"يعيش أبويّ في القرية."},{"t":"Ich liebe ihn nicht mehr.","ar":"لم أعد أحبه."},{"t":"Ich liebe ihn immer noch.","ar":"لاَ أَزَالُ أُحِبُّهُ."},{"t":"Ich liebe sie immer noch.","ar":"ما زلت أحبها"},{"t":"Ich liebe Tom nicht mehr.","ar":"لم أعد أحب توم."},{"t":"Ich liebe es, allein zu sein.","ar":"احب أن اكون لوحدي"},{"t":"Ich liebe dich mehr als du mich.","ar":"أحبك أكثر مما تحبني."},{"t":"Ich liebe dieses Buch über alles.","ar":"أحب هذا الكتاب أكثر من غيره."},{"t":"Das ist eine gute Frage.","ar":"هذا سؤال جيد."},{"t":"Ich habe eine Frage zu dir!","ar":"لدي سؤال عنك"},{"t":"Diese Frage ist nicht einfach.","ar":"هذا السؤال ليس سهلاً."},{"t":"Jeden Morgen frage ich mich, warum.","ar":"كل صباح أتساءل لماذا."},{"t":"Ich frage mich, warum Tom das gesagt hat.","ar":"أتساءل لماذا قال توم ذلك"},{"t":"Die Frage ist, wo man das Buch kaufen kann.","ar":"المشكلة هي أين يمكن أن يُشترى الكتاب."},{"t":"Ich habe keine Freunde.","ar":"لا أملك أصدقاء."},{"t":"Er und ich sind Freunde.","ar":"نحن صديقان."},{"t":"Wir waren keine Freunde.","ar":"لم نكن اصدقاء"},{"t":"Mike und Ken sind Freunde.","ar":"مايك وكين صديقان."},{"t":"Tom hat viel Geld, doch keine Freunde.","ar":"لتوم الكثير من المال، ولكنه يفتقر للأصدقاء."},{"t":"Maria hat auf der Arbeit viele Freunde.","ar":"كوّنت ليلى صداقات كثيرة في العمل."},{"t":"Ohne ihre Hilfe würde ich jetzt nicht mehr leben.","ar":"لولا مساعدتها لم اكن علي قيد الحياه الان"},{"t":"Ich will Englisch lernen.","ar":"انا اريد تعلم الانجليزية"},{"t":"Ich kann Englisch sprechen.","ar":"أستطيع تحدث الإنجليزية."},{"t":"Kannst du Englisch sprechen?","ar":"هل تتكلم الإنجليزية؟"},{"t":"Wie sagt man das auf Englisch?","ar":"كيف تقول هذا بالإنجليزية؟"},{"t":"Sprechen wir doch auf Englisch!","ar":"لنتحدث بالإنجليزية."},{"t":"Englisch ist einfach zu lernen.","ar":"الإنجليزية لغة سهلة التعلم."},{"t":"Ich will nicht Englisch lernen.","ar":"لا أريد تعلم الإنجليزية."},{"t":"Warum willst du Englisch lernen?","ar":"لم تريد تعلّم الإنجليزيّة؟"},{"t":"Kannst du nicht Englisch sprechen?","ar":"ألا يمكنك تحدث الإنجليزية؟"}],"focus":[],"difficulty":5}}