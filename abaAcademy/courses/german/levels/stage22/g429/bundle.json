{"theory":{"blocks":[{"btype":"text","text":"الدرس 429. الكلمات الجديدة: CDs، Eigentümer، vollendet، Mönch، Kinn، erforschen، Arbeitszimmer، Ursprungs، ändere، angemeldet، Satelliten، Arbeitern، direkten."},{"btype":"example","text":"CDs = سِي دِي","note":"صيغة من CD (الجمع)"},{"btype":"example","text":"Eigentümer = مُلْك","note":"صيغة من Eigentum (الجمع، حالة الإضافة، حالة المفعول به)؛ مثال: Gib das Buch seinem Eigentümer zurück. — أعد الكتاب إلى صاحبه."},{"btype":"example","text":"vollendet = أَتْقَنَ","note":"صيغة من vollenden (اسم المفعول (التصريف الثالث))؛ مثال: Ich habe grad' die Arbeit vollendet. — لقد أنهيت عملي للتو."},{"btype":"example","text":"Mönch = رَاهِب","note":"مثال: Ich bin ein Mönch. — انا راهب."},{"btype":"example","text":"Kinn = ذَقْن","note":""},{"btype":"example","text":"erforschen = اِسْتَكْشَفَ","note":"مثال: Wir erforschen den Mars. — نحن نستكشف المريخ."},{"btype":"example","text":"Arbeitszimmer = مَكْتَب","note":""},{"btype":"example","text":"Ursprungs = مَنْشَأ","note":"صيغة من Ursprung (حالة الإضافة)"},{"btype":"example","text":"ändere = غَيَّرَ","note":"صيغة من ändern (المتكلّم، المضارع)؛ مثال: Ändere bitte nichts! — رجاءً لا تغير أي شيء"},{"btype":"example","text":"angemeldet = تَسْجِيل","note":"صيغة من anmelden (اسم المفعول (التصريف الثالث))؛ مثال: Was mache ich jetzt, da ich angemeldet bin? — ما الذي عليّ فعله الآن بعد أن سجّلت؟"},{"btype":"example","text":"Satelliten = قَمَر اِصْطِنَاعِيّ، قَمَر","note":"صيغة من Satellit (حالة الإضافة)"},{"btype":"example","text":"Arbeitern = عَامِل","note":"صيغة من Arbeiter (الجمع، حالة المفعول غير المباشر)"},{"btype":"example","text":"direkten = مُبَاشَرَةً","note":"صيغة من direkt (المذكّر، حالة الإضافة)؛ مثال: Zeigen Sie uns den direkten Weg. — اهدنا الصراط المستقيم."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ich bin ein Mönch.","note":"انا راهب."},{"btype":"example","text":"Ändere bitte nichts!","note":"رجاءً لا تغير أي شيء"},{"btype":"example","text":"Wir erforschen den Mars.","note":"نحن نستكشف المريخ."},{"btype":"example","text":"Ändere bitte die Flagge.","note":"غيّر العلم، لو سمحت."},{"btype":"example","text":"Zeigen Sie uns den direkten Weg.","note":"اهدنا الصراط المستقيم."},{"btype":"example","text":"Ich habe grad' die Arbeit vollendet.","note":"لقد أنهيت عملي للتو."},{"btype":"example","text":"Gib das Buch seinem Eigentümer zurück.","note":"أعد الكتاب إلى صاحبه."},{"btype":"example","text":"Was mache ich jetzt, da ich angemeldet bin?","note":"ما الذي عليّ فعله الآن بعد أن سجّلت؟"},{"btype":"example","text":"Ich habe dir etwas zu sagen.","note":"أريد أن أقول لك شيئاً."},{"btype":"example","text":"Du bist nicht schnell genug.","note":"لست سريعاً بما فيه الكفاية."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich bin ein Mönch.","ar":"انا راهب."},{"t":"Ändere bitte nichts!","ar":"رجاءً لا تغير أي شيء"},{"t":"Wir erforschen den Mars.","ar":"نحن نستكشف المريخ."},{"t":"Ändere bitte die Fla