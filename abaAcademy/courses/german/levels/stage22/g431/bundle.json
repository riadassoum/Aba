ب."},{"t":"Mein Freund lernt Koreanisch.","ar":"صديقي يدرس اللغة الكورية."},{"t":"Ich kann Koreanisch sprechen.","ar":"أستطيع تحدث الكورية."},{"t":"Sie haben gestern Englisch geübt.","ar":"درسوا الإنجليزية البارحة."},{"t":"Eine Minute umfasst sechzig Sekunden.","ar":"هناك ستون ثانية في الدقيقة."},{"t":"Tom hat mir einen Heiratsantrag gemacht.","ar":"عرض علي توم الزواج."},{"t":"Sie scheinen ein ehrlicher Mann zu sein.","ar":"تبدو رجلًا صدوقًا."},{"t":"Ich mag ihn, weil er ein ehrlicher Mensch ist.","ar":"أحب فيه صدقه."},{"t":"Sie hat gestern ihre englische Aussprache geübt.","ar":"تدربتْ على نطقها للإنجليزية أمس."},{"t":"Ich verstehe kein Koreanisch. Ich habe es nie gelernt.","ar":"لا أفهم اللغة الكورية، لم أتعلمها."},{"t":"Die Erklärung ist vielleicht bei weitem komplizierter.","ar":"التفسير يمكن أن يكون أكثر تعقيدا."},{"t":"Er ist durch seine Prüfungen durchgefallen, weil er nicht genug gelernt hat.","ar":"رسب في امتحاناته بسبب قلة المذاكرة."}],"focus":["umfasst","giftig","durchgefallen","Brasilianer","Heiratsantrag","ehrlicher","Koreanisch","genieße","komplizierter","geübt"],"words":[{"word":"giftig","topic":"L431","difficulty":5,"meaning":"سَامّ","example":"Ist diese Spinne giftig?","translation":"هل هذا العنكبوت سام؟"},{"word":"Heiratsantrag","topic":"L431","difficulty":5,"meaning":"طَلَب الزَّوَاج","example":"Tom hat mir einen Heiratsantrag gemacht.","translation":"عرض علي توم الزواج."},{"word":"Koreanisch","topic":"L431","difficulty":5,"meaning":"كُورِيّ","example":"Ich lerne Koreanisch.","translation":"أتعلّم اللغة الكورية."}],"difficulty":5}}