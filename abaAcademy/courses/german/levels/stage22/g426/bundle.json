{"theory":{"blocks":[{"btype":"text","text":"الدرس 426. الكلمات الجديدة: schlimme، hervorragende، Schweiß، augenblicklich، überzeugend، ehemaligen، Nadel، Vorwürfe، gelegentlich، Friedhof."},{"btype":"example","text":"schlimme = سَيِّئ","note":"صيغة من schlimm (المؤنث، حالة المفعول به)؛ مثال: Ich habe eine schlimme Erkältung. — لديّ زكام شديد."},{"btype":"example","text":"hervorragende = أعلى فائق","note":"صيغة من hervorragend (المؤنث، حالة المفعول به)"},{"btype":"example","text":"Schweiß = عَرَق","note":"مثال: Ohne Schweiß keinen Preis. — كل شيء وله ثمن"},{"btype":"example","text":"augenblicklich = آنِيًا","note":"مثال: Höre augenblicklich damit auf! — أوقف هذا حالاً!"},{"btype":"example","text":"überzeugend = مُقْنِع","note":"مثال: Er klang nicht überzeugend. — لم يبدو مقنعا."},{"btype":"example","text":"ehemaligen = سَابِق","note":"صيغة من ehemalig (المذكّر، حالة الإضافة)"},{"btype":"example","text":"Nadel = إِبْرَة","note":""},{"btype":"example","text":"Vorwürfe = تَأْنِيب","note":"صيغة من Vorwurf (الجمع، حالة الإضافة، حالة المفعول به)؛ مثال: Mach dir keine Vorwürfe! — لا تلوم نفسك."},{"btype":"example","text":"gelegentlich = أَحْيَانًا","note":"مثال: Er hat mich gelegentlich besucht. — كان يزورني أحياناً."},{"btype":"example","text":"Friedhof = مَقْبَرَة","note":"مثال: Wir gehen zum Friedhof. — نحن ذاهبون إلى المقبرة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Wir gehen zum Friedhof.","note":"نحن ذاهبون إلى المقبرة."},{"btype":"example","text":"Mach dir keine Vorwürfe!","note":"لا تلوم نفسك."},{"btype":"example","text":"Ohne Schweiß keinen Preis.","note":"كل شيء وله ثمن"},{"btype":"example","text":"Er klang nicht überzeugend.","note":"لم يبدو مقنعا."},{"btype":"example","text":"Höre augenblicklich damit auf!","note":"أوقف هذا حالاً!"},{"btype":"example","text":"Ich habe eine schlimme Erkältung.","note":"لديّ زكام شديد."},{"btype":"example","text":"Er hat mich gelegentlich besucht.","note":"كان يزورني أحياناً."},{"btype":"example","text":"Erdbeben können augenblicklich passieren.","note":"يمكن أن تحدث الزلازل في أي لحظة."},{"btype":"example","text":"Er und ich sind Freunde.","note":"نحن صديقان."},{"btype":"example","text":"Hier sind unsere Bücher.","note":"ها هي كتبنا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Wir gehen zum Friedhof.","ar":"نحن ذاهبون إلى المقبرة."},{"t":"Mach dir keine Vorwürfe!","ar":"لا تلوم نفسك."},{"t":"Ohne Schweiß keinen Preis.","ar":"كل شيء وله ثمن"},{"t":"Er klang nicht überzeugend.","ar":"لم يبدو مقنعا."},{"t":"Höre augenblicklich damit auf!","ar":"أوقف هذا حالاً!"},{"t":"Ich habe eine schlimme Erkältung.","ar":"لديّ زكام شديد."},{"t":"Er hat mich gelegentlich besucht.","ar":"كان يزورني أحياناً."},{"t":"Erdbeben können augenblicklich passieren.","ar":"يمكن أن تحدث الزلازل في أي لحظة."},{"t":"Er und ich sind Freunde.","ar":"نحن صديقان."},{"t":"Hier sind unsere Bücher.","ar":"ها هي كتبنا."},{"t":"Du musst schnell machen.","ar":"