{"theory":{"blocks":[{"btype":"text","text":"الدرس 253. الكلمات الجديدة: schreit، attraktiv، bar، irgendeinen، Wange، umzubringen، schätzt، Maler، geheim، kaputtgemacht."},{"btype":"example","text":"schreit = صَاحَ","note":"صيغة من schreien (الغائب، المضارع)؛ مثال: Er schreit viel. — إنه يصرخ كثيراً."},{"btype":"example","text":"attraktiv = جَذَّاب","note":"مثال: Er ist sehr attraktiv. — إنه وسيم."},{"btype":"example","text":"bar = حَانَة، بَار","note":"مثال: Er hat bar bezahlt. — لقد دفع نقدا."},{"btype":"example","text":"irgendeinen = أَيّ","note":"صيغة من irgendein (المذكّر، حالة المفعول به)؛ مثال: Gib mir mal irgendeinen Bleistift! — أعطني أي قلم رصاص"},{"btype":"example","text":"Wange = خَدّ","note":""},{"btype":"example","text":"umzubringen = قَتَلَ","note":"صيغة من umbringen (المصدر)؛ مثال: Sie versuchte, sich umzubringen. — حاولت قتل نفسها."},{"btype":"example","text":"schätzt = خَمَّنَ","note":"صيغة من schätzen (الغائب، المضارع)؛ مثال: Wie alt schätzt du sie? — ما عمرها برأيك؟"},{"btype":"example","text":"Maler = رَسَّام، دَهَّان","note":"مثال: Er behauptet, ein Maler zu sein. — يدعي أنه رسام."},{"btype":"example","text":"geheim = سِرِّيّ","note":"مثال: Bitte halte das geheim. — من فضلك أبقِ ذلك سراً."},{"btype":"example","text":"kaputtgemacht = دَمَّرَ","note":"صيغة من kaputtmachen (اسم المفعول (التصريف الثالث))؛ مثال: Wer hat das kaputtgemacht? — من كسر هذا؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Er schreit viel.","note":"إنه يصرخ كثيراً."},{"btype":"example","text":"Er hat bar bezahlt.","note":"لقد دفع نقدا."},{"btype":"example","text":"Er ist sehr attraktiv.","note":"إنه وسيم."},{"btype":"example","text":"Sie gehen in eine Bar.","note":"ذهبوا إلى حانة."},{"btype":"example","text":"Wie alt schätzt du sie?","note":"ما عمرها برأيك؟"},{"btype":"example","text":"Bitte halte das geheim.","note":"من فضلك أبقِ ذلك سراً."},{"btype":"example","text":"Tom fand Maria attraktiv.","note":"وجد توم ماري جذّابةً."},{"btype":"example","text":"Wer hat das kaputtgemacht?","note":"من كسر هذا؟"},{"btype":"example","text":"Ich habe es kaputtgemacht.","note":"لقد كسرتها."},{"btype":"example","text":"Sie versuchte, sich umzubringen.","note":"حاولت قتل نفسها."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Er schreit viel.","ar":"إنه يصرخ كثيراً."},{"t":"Er hat bar bezahlt.","ar":"لقد دفع نقدا."},{"t":"Er ist sehr attraktiv.","ar":"إنه وسيم."},{"t":"Sie gehen in eine Bar.","ar":"ذهبوا إلى حانة."},{"t":"Wie alt schätzt du sie?","ar":"ما عمرها برأيك؟"},{"t":"Bitte halte das geheim.","ar":"من فضلك أبقِ ذلك سراً."},{"t":"Tom fand Maria attraktiv.","ar":"وجد توم ماري جذّابةً."},{"t":"Wer hat das kaputtgemacht?","ar":"من كسر هذا؟"},{"t":"Ich habe es kaputtgemacht.","ar":"لقد كسرتها."},{"t":"Sie versuchte, sich umzubringen.","ar":"حاولت قتل نفسها."},{"t":"Er behauptet, ein Maler zu sein.","ar":"يدعي أنه رسام."},{"t":"Ich halte sie für sehr attraktiv.","ar":"أعتقد أنها جذابةً جداً."},{"t":"Gib mir mal irgendeinen Bleistift!","ar":"أعطني أي قلم رصاص"},{"t":"Tom hat versucht, uns umzubringen.","ar":"حاول توم قتلنا!"},{"t":"Tom hat das Fenster kaputtgemacht.","ar":"كسر توم زجاج النافذة."},{"t":"Du hättest es geheim halten sollen.","ar":"كان يجب عليك أن تبقيها سراً."},{"t":"Gesundheit schätzt man erst, wenn man krank wird.","ar":"الصحة كنز لا يعرف قيمته إلا المرضى."}],"focus":["schreit","attraktiv","bar","irgendeinen","Wange","umzubringen","schätzt","Maler","geheim","kaputtgemacht"],"words":[{"word":"attraktiv","topic":"L253","difficulty":2,"meaning":"جَذَّاب","example":"Er ist sehr attraktiv.","translation":"إنه وسيم."},{"word":"bar","topic":"L253","difficulty":2,"meaning":"حَانَة، بَار","example":"Er hat bar bezahlt.","translation":"لقد دفع نقدا."},{"word":"Wange","topic":"L253","difficulty":2,"meaning":"خَدّ"},{"word":"Maler","topic":"L253","difficulty":2,"meaning":"رَسَّام، دَهَّان","example":"Er behauptet, ein Maler zu sein.","translation":"يدعي أنه رسام."},{"word":"geheim","topic":"L253","difficulty":2,"meaning":"سِرِّيّ","example":"Bitte halte das geheim.","translation":"من فضلك أبقِ ذلك سراً."}],"difficulty":2}}