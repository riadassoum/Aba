{"theory":{"blocks":[{"btype":"text","text":"الدرس 247. الكلمات الجديدة: worüber، hole، erreichte، fuhren، scheiden، versteckte، schlau، treffe، Löffel، behaupten."},{"btype":"example","text":"worüber","note":"مثال: Worüber? — بخصوص ماذا؟"},{"btype":"example","text":"hole = جَلَبَ","note":"صيغة من holen (المتكلّم، المضارع)؛ مثال: Ich hole meine Tasche. — سوفَ أُحضرُ حقيبتي."},{"btype":"example","text":"erreichte = بَلَغَ","note":"صيغة من erreichen (الغائب، الماضي التامّ)"},{"btype":"example","text":"fuhren = قَادَ","note":"صيغة من fahren (الجمع، الغائب، الماضي التامّ)؛ مثال: Wir fuhren nach Italien. — ذهبنا إلى إيطاليا."},{"btype":"example","text":"scheiden = طَلَّقَ","note":"مثال: Sie ließ sich von ihrem Mann scheiden. — طلّقت زوجها."},{"btype":"example","text":"versteckte = غُمَّيْضَة","note":"صيغة من verstecken (الغائب، الماضي التامّ)؛ مثال: Tom versteckte sich unter dem Tisch. — اختبأ توم تحت الطاولة."},{"btype":"example","text":"schlau = خَبِيث","note":"مثال: Wie schlau! — أحسنت القول!"},{"btype":"example","text":"treffe = لَاقَى، اِلْتَقَى","note":"صيغة من treffen (المتكلّم، المضارع)؛ مثال: Ich treffe ihn oft. — عادة ما أراه."},{"btype":"example","text":"Löffel = مِلْعَقَة","note":"مثال: Gib mir den Löffel. — أعطني الملعقة."},{"btype":"example","text":"behaupten = ٱِدَّعَى","note":"مثال: Ich kann nicht das Gegenteil behaupten. — لا أستطيع أن أقول العكس."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Worüber?","note":"بخصوص ماذا؟"},{"btype":"example","text":"Wie schlau!","note":"أحسنت القول!"},{"btype":"example","text":"Worüber lacht ihr?","note":"علامَ تضحك؟"},{"btype":"example","text":"Er ist sehr schlau.","note":"إنه ذكي جداً."},{"btype":"example","text":"Ich treffe ihn oft.","note":"عادة ما أراه."},{"btype":"example","text":"Gib mir den Löffel.","note":"أعطني الملعقة."},{"btype":"example","text":"Worüber sprichst du?","note":"ما الذي تتحدث عنه؟"},{"btype":"example","text":"Ich hole meine Tasche.","note":"سوفَ أُحضرُ حقيبتي."},{"btype":"example","text":"Der Löffel gehört mir.","note":"اون قاشق مال منه."},{"btype":"example","text":"Worüber denkst du nach?","note":"بماذا تفكر؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Worüber?","ar":"بخصوص ماذا؟"},{"t":"Wie schlau!","ar":"أحسنت القول!"},{"t":"Worüber lacht ihr?","ar":"علامَ تضحك؟"},{"t":"Er ist sehr schlau.","ar":"إنه ذكي جداً."},{"t":"Ich treffe ihn oft.","ar":"عادة ما أراه."},{"t":"Gib mir den Löffel.","ar":"أعطني الملعقة."},{"t":"Worüber sprichst du?","ar":"ما الذي تتحدث عنه؟"},{"t":"Ich hole meine Tasche.","ar":"سوفَ أُحضرُ حقيبتي."},{"t":"Der Löffel gehört mir.","ar":"اون قاشق مال منه."},{"t":"Worüber denkst du nach?","ar":"بماذا تفكر؟"},{"t":"Wir fuhren nach Italien.","ar":"ذهبنا إلى إيطاليا."},{"t":"Worüber regen sie sich auf?","ar":"لم هم غاضبين؟"},{"t":"Worüber habt ihr gesprochen?","ar":"عن ماذا تحدّثت؟"},{"t":"Worüber sprachen wir gerade?","ar":"عن ماذا كنا نتحدث؟"},{"t":"Ich treffe ihn nicht so oft.","ar":"لا ألتقي به كثيرا."},{"t":"Worüber möchtest du sprechen?","ar":"ما الذي تريد أن تتحدث عنه؟"},{"t":"Mein Hund ist ziemlich schlau.","ar":"كلبي حاد الذكاء."},{"t":"Kann mir jemand einen Löffel geben?","ar":"هل من أحد يعطيني ملعقة؟"},{"t":"Tom versteckte sich unter dem Tisch.","ar":"اختبأ توم تحت الطاولة."},{"t":"Sie fuhren einer nach dem anderen los.","ar":"بدأوا واحداً تلو الآخر."},{"t":"Sie ließ sich von ihrem Mann scheiden.","ar":"طلّقت زوجها."},{"t":"Ich kann nicht das Gegenteil behaupten.","ar":"لا أستطيع أن أقول العكس."},{"t":"Layla versteckte sich hinter einem Baum.","ar":"اختبأت ليلى خلف الشّجرة."},{"t":"Ich treffe mich heute Nachmittag mit Mary.","ar":"سألتقي بماري هذا المساء."},{"t":"Ich habe gesehen, wie sie etwas versteckte.","ar":"رأيتها وهي تخبّئ شيئًا."},{"t":"Das Kaninchen versteckte sich hinter dem Baum.","ar":"اختبأ الأرنب خلف الشجرة."},{"t":"Mir fällt nichts ein, worüber ich schreiben könnte.","ar":"لا شيء في بالي للكتابة عنه."},{"t":"„Ich hasse dich.“ – „Dann lass dich von mir scheiden.“","ar":"”أنا أكرهكِ.“ ”طلّقني إذا. “"},{"t":"Kinder geben oft sich die Schuld, wenn sich die Eltern scheiden lassen.","ar":"الأطفال غالبًا ما يلومون أنفسهم على طلاق والديهم."},{"t":"Wenn du mich liebst, wie ich dich liebe, kann nichts als der Tod uns scheiden.","ar":"إن كنت تحبني كما أفعل أنا، فلا شيء يفرّقنا سوى الموت."}],"focus":["worüber","hole","erreichte","fuhren","scheiden","versteckte","schlau","treffe","Löffel","behaupten"],"words":[{"word":"scheiden","topic":"L247","difficulty":4,"meaning":"طَلَّقَ","example":"Sie ließ sich von ihrem Mann scheiden.","translation":"طلّقت زوجها."},{"word":"schlau","topic":"L247","difficulty":4,"meaning":"خَبِيث","example":"Wie schlau!","translation":"أحسنت القول!"},{"word":"Löffel","topic":"L247","difficulty":4,"meaning":"مِلْعَقَة","example":"Gib mir den Löffel.","translation":"أعطني الملعقة."},{"word":"behaupten","topic":"L247","difficulty":4,"meaning":"ٱِدَّعَى","example":"Ich kann nicht das Gegenteil behaupten.","translation":"لا أستطيع أن أقول العكس."}],"difficulty":4}}