{"theory":{"blocks":[{"btype":"text","text":"الدرس 85. الكلمات الجديدة: sogar، gestohlen، unbedingt، fuhr، Herzen، höre، Schwierigkeiten، Tages، aufhören، Gefühl."},{"btype":"example","text":"sogar = حَتَّى","note":"مثال: Sogar Tom wusste das. — حتى توم علم بذلك."},{"btype":"example","text":"gestohlen = سَرَقَ","note":"صيغة من stehlen (اسم المفعول (التصريف الثالث))؛ مثال: Meine Tasche wurde gestohlen. — سُرقت حقيبتي."},{"btype":"example","text":"unbedingt = حَتْماً","note":"مثال: Ich muss ihr unbedingt helfen. — يجب أن أساعدها."},{"btype":"example","text":"fuhr = قَادَ","note":"صيغة من fahren (الغائب، الماضي التامّ)؛ مثال: Er fuhr. — كان يسوق."},{"btype":"example","text":"Herzen = قَلْب، كُبَّا","note":"صيغة من Herz (حالة المفعول غير المباشر)؛ مثال: Ich sage dies aus meinem Herzen. — أقول ذلك من قلبي."},{"btype":"example","text":"höre = سَمِعَ، سَمِع","note":"صيغة من hören (المتكلّم، المضارع)؛ مثال: Ich höre dich. — أنا أسمعك."},{"btype":"example","text":"Schwierigkeiten = صُعُوبَة","note":"صيغة من Schwierigkeit (الجمع)؛ مثال: Er ist in Schwierigkeiten. — إنهُ في مشكلة."},{"btype":"example","text":"Tages = يَوْم","note":"صيغة من Tag (حالة الإضافة)؛ مثال: Eines Tages habe ich ihn getroffen. — قابلته يوما."},{"btype":"example","text":"aufhören = تَوَقَّفَ","note":"مثال: Du musst aufhören. — يجب أن تتوقف"},{"btype":"example","text":"Gefühl = شُعُور، عَاطِفَة","note":"مثال: Ich habe kein gutes Gefühl dabei. — لست مرتاحا لهذا."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Er fuhr.","note":"كان يسوق."},{"btype":"example","text":"Ziri fuhr.","note":"ساق زيري."},{"btype":"example","text":"Ich höre dich.","note":"أنا أسمعك."},{"btype":"example","text":"Layla fuhr weiter.","note":"واصلت ليلى السّياقة."},{"btype":"example","text":"Ich sehe und höre.","note":"أنا أرى وأسمع."},{"btype":"example","text":"Du musst aufhören.","note":"يجب أن تتوقف"},{"btype":"example","text":"Ich höre dich kaum.","note":"بالكاد أسمعك."},{"btype":"example","text":"Sogar Tom wusste das.","note":"حتى توم علم بذلك."},{"btype":"example","text":"Höre auf deinen Vater!","note":"إستمع إلى أبيك"},{"btype":"example","text":"Du musst damit aufhören.","note":"عليك أن تستقيل."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Er fuhr.","ar":"كان يسوق."},{"t":"Ziri fuhr.","ar":"ساق زيري."},{"t":"Ich höre dich.","ar":"أنا أسمعك."},{"t":"Layla fuhr weiter.","ar":"واصلت ليلى السّياقة."},{"t":"Ich sehe und höre.","ar":"أنا أرى وأسمع."},{"t":"Du musst aufhören.","ar":"يجب أن تتوقف"},{"t":"Ich höre dich kaum.","ar":"بالكاد أسمعك."},{"t":"Sogar Tom wusste das.","ar":"حتى توم علم بذلك."},{"t":"Höre auf deinen Vater!","ar":"إستمع إلى أبيك"},{"t":"Du musst damit aufhören.","ar":"عليك أن تستقيل."},{"t":"Er ist in Schwierigkeiten.","ar":"إنهُ في مشكلة."},{"t":"Sie ist in Schwierigkeiten.","ar":"إنها في ورطة."},{"t":"Ich bin in Schwierigkeiten.","ar":"أنا في ورطة."},{"t":"Jim ist in Schwierigkeiten.","ar":"جيم في مشكلة."},{"t":"Das wissen sogar die Kinder.","ar":"حتى الأطفال تعرف ذلك."},{"t":"Meine Tasche wurde gestohlen.","ar":"سُرقت حقيبتي."},{"t":"Er hat ein Fahrrad gestohlen.","ar":"سرق دراجة."},{"t":"Mir wurde mein Geld gestohlen.","ar":"سُرقت نقودي."},{"t":"Ich muss ihr unbedingt helfen.","ar":"يجب أن أساعدها."},{"t":"Sie wollte unbedingt heiraten.","ar":"هىَ كانت يائسة من أن تتزوج."},{"t":"Ich denke, er hat sie gestohlen.","ar":"أظنّ أنه سرقها."},{"t":"Ich sage dies aus meinem Herzen.","ar":"أقول ذلك من قلبي."},{"t":"Das ist nicht unbedingt der Fall.","ar":"ليس بالضرورة."},{"t":"Ich habe kein gutes Gefühl dabei.","ar":"لست مرتاحا لهذا."},{"t":"Er tat so, als höre er mich nicht.","ar":"لقد تظاهر أنه لا يسمعني"},{"t":"Eines Tages habe ich ihn getroffen.","ar":"قابلته يوما."},{"t":"Das Gefühl werde ich nie vergessen.","ar":"لن أنسى ذلك الشعور أبدا."},{"t":"Ich höre dich, aber sehe dich nicht.","ar":"أسمعك لكنني لا أراك."},{"t":"Du wirst mich eines Tages vergessen.","ar":"ستنسَني يوماً ما."},{"t":"Sogar Kinder können dieses Buch lesen.","ar":"حتى الأطفال بإمكانهم قراءة هذا الكتاب."}],"focus":["sogar","gestohlen","unbedingt","fuhr","Herzen","höre","Schwierigkeiten","Tages","aufhören","Gefühl"],"words":[{"word":"sogar","topic":"L85","difficulty":2,"meaning":"حَتَّى","example":"Sogar Tom wusste das.","translation":"حتى توم علم بذلك."},{"word":"unbedingt","topic":"L85","difficulty":2,"meaning":"حَتْماً","example":"Ich muss ihr unbedingt helfen.","translation":"يجب أن أساعدها."},{"word":"aufhören","topic":"L85","difficulty":2,"meaning":"تَوَقَّفَ","example":"Du musst aufhören.","translation":"يجب أن تتوقف"},{"word":"Gefühl","topic":"L85","difficulty":2,"meaning":"شُعُور، عَاطِفَة","example":"Ich habe kein gutes Gefühl dabei.","translation":"لست مرتاحا لهذا."}],"difficulty":2}}