{"theory":{"blocks":[{"btype":"text","text":"الدرس 91. الكلمات الجديدة: morgens، Hälfte، deren، zwanzig، kochen، Baby، Brücke، Zähne، Wand، lachen."},{"btype":"example","text":"morgens = قَبْلَ الظُّهْر","note":"مثال: Morgens brauche ich Kaffee. — أحتاج إلى قهوة الصباح."},{"btype":"example","text":"Hälfte = نِصْف","note":"مثال: Yanni gab Skura die andere Hälfte. — قدم ياني لسكورة النصف الآخر."},{"btype":"example","text":"deren = اَلَّذِي","note":""},{"btype":"example","text":"zwanzig = عِشْرُونَ","note":"مثال: Sie ist zwanzig Jahre alt. — هي في العشرين من العمر."},{"btype":"example","text":"kochen = طَبَخَ","note":"مثال: Bob kann kochen. — بوب يعرف كيف يطبخ."},{"btype":"example","text":"Baby = رَضِيع","note":"مثال: Das ist mein Baby. — هذا طفلي."},{"btype":"example","text":"Brücke = جِسْر","note":"مثال: Wie lang ist die Brücke? — ما طول الجسر؟"},{"btype":"example","text":"Zähne = سِنّ","note":"صيغة من Zahn (الجمع، حالة الإضافة، حالة المفعول به)"},{"btype":"example","text":"Wand = جِدَار","note":"مثال: Wo ist die Wand? — أين الجدار ؟"},{"btype":"example","text":"lachen = ضَحْكَة","note":"مثال: Kein Grund zu lachen! — لا داعٍ للضحك"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Bob kann kochen.","note":"بوب يعرف كيف يطبخ."},{"btype":"example","text":"Wo ist die Wand?","note":"أين الجدار ؟"},{"btype":"example","text":"Wir kochen Wasser.","note":"نحن نغلّي الماء."},{"btype":"example","text":"Das ist mein Baby.","note":"هذا طفلي."},{"btype":"example","text":"Er kann gut kochen.","note":"هو بارع في الطبخ."},{"btype":"example","text":"Diese Wand ist kalt.","note":"هذا الجدار بارد."},{"btype":"example","text":"Kann das Baby laufen?","note":"هل يستطيع الطفل أن يمشي؟"},{"btype":"example","text":"Dem Baby geht es gut.","note":"الرضيع بخير."},{"btype":"example","text":"Kein Grund zu lachen!","note":"لا داعٍ للضحك"},{"btype":"example","text":"Lachen Sie über mich?","note":"هل تضحك علي؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate"