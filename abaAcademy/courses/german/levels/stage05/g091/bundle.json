{"theory":{"blocks":[{"btype":"text","text":"الدرس 91. الكلمات الجديدة: Freiheit، Urlaub، Auge، Frühstück، letzter، gefährlich، Anfang، setzte، führen، Laden."},{"btype":"example","text":"Freiheit = حُرِّيَّة","note":"مثال: Was ist Freiheit? — ما هي الحرية؟"},{"btype":"example","text":"Urlaub = إِجَازَة","note":"مثال: Wie war dein Urlaub? — كيف كانت إجازتك؟"},{"btype":"example","text":"Auge = عَيْن","note":""},{"btype":"example","text":"Frühstück = إِفْطَار","note":"مثال: Wir sind gerade mit dem Frühstück fertig. — لقد أنهينا أكل طعام الفطور للتو."},{"btype":"example","text":"letzter = آخِر، مَاضٍ","note":"صيغة من letzte (المذكّر)؛ مثال: In letzter Zeit geht es mir nicht gut. — أنا لا أشعر بالراحة مؤخرا."},{"btype":"example","text":"gefährlich = خَطِر","note":"مثال: Es ist gefährlich. — إنك في خطر!"},{"btype":"example","text":"Anfang = بِدَايَة","note":"مثال: Am Anfang ist es schwer. — إنها صعبة في البداية."},{"btype":"example","text":"setzte = وَضَعَ","note":"صيغة من setzen (الغائب، الماضي التامّ)؛ مثال: Ich setzte mich neben ihn. — جلست إلى جانبه."},{"btype":"example","text":"führen = قَادَ","note":""},{"btype":"example","text":"Laden = دُكَّان","note":"مثال: Er ging zum Laden. — ذهب إلى المحل."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Was ist Freiheit?","note":"ما هي الحرية؟"},{"btype":"example","text":"Es ist gefährlich.","note":"إنك في خطر!"},{"btype":"example","text":"Er ging zum Laden.","note":"ذهب إلى المحل."},{"btype":"example","text":"Ich gehe zum Laden.","note":"أذهب إلى المتجر."},{"btype":"example","text":"Wie war dein Urlaub?","note":"كيف كانت إجازتك؟"},{"btype":"example","text":"Ich liebe diesen Laden.","note":"أحِبُّ هذا المتجر."},{"btype":"example","text":"Am Anfang ist es schwer.","note":"إنها صعبة في البداية."},{"btype":"example","text":"Der Fluss ist gefährlich.","note":"النهر خطير."},{"btype":"example","text":"Sein Plan ist gefährlich!","note":"خطته خطرة!"},{"btype":"example","text":"Die Straße ist gefährlich.","note":"الطريق خطير."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Was ist Freiheit?","ar":"ما هي الحرية؟"},{"t":"Es ist gefährlich.","ar":"إنك في خطر!"},{"t":"Er ging zum Laden.","ar":"ذهب إلى المحل."},{"t":"Ich gehe zum Laden.","ar":"أذهب إلى المتجر."},{"t":"Wie war dein Urlaub?","ar":"كيف كانت إجازتك؟"},{"t":"Ich liebe diesen Laden.","ar":"أحِبُّ هذا المتجر."},{"t":"Am Anfang ist es schwer.","ar":"إنها صعبة في البداية."},{"t":"Der Fluss ist gefährlich.","ar":"النهر خطير."},{"t":"Sein Plan ist gefährlich!","ar":"خطته خطرة!"},{"t":"Die Straße ist gefährlich.","ar":"الطريق خطير."},{"t":"Ich setzte mich neben ihn.","ar":"جلست إلى جانبه."},{"t":"Ich setzte mich neben sie.","ar":"جلست بالقرب منها."},{"t":"Er ist zum Laden gegangen.","ar":"ذهب إلى المتجر."},{"t":"Tom setzte sich neben Mary.","ar":"جلس توم بجنب ماري."},{"t":"Bist du zum Laden gegangen?","ar":"هل ذهبت إلى المحلّ؟"},{"t":"Sind Sie zum Laden gegangen?","ar":"هل ذهبت إلى المت