{"theory":{"blocks":[{"btype":"text","text":"الدرس 98. الكلمات الجديدة: besucht، manche، bloß، beginnt، dagegen، lustig، traurig، echt، welchem، erinnere."},{"btype":"example","text":"besucht = زَارَ","note":"صيغة من besuchen (اسم المفعول (التصريف الثالث))؛ مثال: Sie hat niemanden besucht. — هي لم تزر أحدا."},{"btype":"example","text":"manche = بَعْض","note":""},{"btype":"example","text":"bloß = بِالْكَاد","note":"مثال: Es ist bloß Wasser. — هذا مجرّد ماء."},{"btype":"example","text":"beginnt = بَدَأَ","note":"صيغة من beginnen (الغائب، المضارع)؛ مثال: Wann beginnt der Film? — متى سيبدأ الفيلم؟"},{"btype":"example","text":"dagegen","note":"مثال: Ich war erst dagegen. — في البداية رفضت."},{"btype":"example","text":"lustig = مَرِح","note":"مثال: Was ist so lustig? — ما الشيء المضحك؟"},{"btype":"example","text":"traurig = حَزِين، مُحْزِن","note":"مثال: Ich bin traurig. — أنا حزين."},{"btype":"example","text":"echt = حَقِيقِيّ، حَقّ","note":"مثال: Das ist echt nett von euch. — هذا حقاً لطفاً منك."},{"btype":"example","text":"welchem = أَيّ، اَلَّذِي","note":"صيغة من welcher (المذكّر، حالة المفعول غير المباشر)؛ مثال: Aus welchem Land kommst du? — من أي بلد أنت؟"},{"btype":"example","text":"erinnere = ذَكَّرَ","note":"صيغة من erinnern (المتكلّم، المضارع)؛ مثال: Jetzt erinnere ich mich. — الآن تذكرت."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ich bin traurig.","note":"أنا حزين."},{"btype":"example","text":"Bist du traurig?","note":"هل أنتَ حزين؟"},{"btype":"example","text":"Tom war traurig.","note":"كان توم حزينا."},{"btype":"example","text":"Was ist so lustig?","note":"ما الشيء المضحك؟"},{"btype":"example","text":"Es ist bloß Wasser.","note":"هذا مجرّد ماء."},{"btype":"example","text":"Ich war erst dagegen.","note":"في البداية رفضت."},{"btype":"example","text":"Er ist immer traurig.","note":"دائمًا ما يكون حزينًا."},{"btype":"example","text":"Wann beginnt der Film?","note":"متى سيبدأ الفيلم؟"},{"btype":"example","text":"Warum bist du traurig?","note":"لماذا أنت حزين؟"},{"btype":"example","text":"Hör bloß nicht auf Tom.","note":"لا تعطي اهتمامك لتوم."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich bin traurig.","ar":"أنا حزين."},{"t":"Bist du traurig?","ar":"هل أنتَ حزين؟"},{"t":"Tom war traurig.","ar":"كان توم حزينا."},{"t":"Was ist so lustig?","ar":"ما الشيء المضحك؟"},{"t":"Es ist bloß Wasser.","ar":"هذا مجرّد ماء."},{"t":"Ich war erst dagegen.","ar":"في البداية رفضت."},{"t":"Er ist immer traurig.","ar":"دائمًا ما يكون حزينًا."},{"t":"Wann beginnt der Film?","ar":"متى سيبدأ الفيلم؟"},{"t":"Warum bist du traurig?","ar":"لماذا أنت حزين؟"},{"t":"Hör bloß nicht auf Tom.","ar":"لا تعطي اهتمامك لتوم."},{"t":"Wann beginnt das Spiel?","ar":"متى ستبدأ المباراة؟"},{"t":"Jetzt erinnere ich mich.","ar":"الآن تذكرت."},{"t":"Sie hat niemanden besucht.","ar":"هي لم تزر أحدا."},{"t":"Was macht dich so traurig?","ar":"مالذي يحزنك؟"},{"t":"Heute bin ich sehr traurig.","ar":"أنا حزينة جدا اليوم."},{"t":"Das ist echt nett von euch.","ar":"هذا حقاً لطفاً منك."},{"t":"Aus welchem Land kommst du?","ar":"من أي بلد أنت؟"},{"t":"Ich erinnere mich nicht mehr.","ar":"لا أتذكر."},{"t":"Ich habe gestern Tony besucht.","ar":"زرت طوني البارحة."},{"t":"Lass ihn das bloß nicht lesen.","ar":"لا تدعه يقرأ هذا."},{"t":"Ich erinnere mich nicht genau.","ar":"لا أذكر بدقة."},{"t":"Was immer es ist, ich bin dagegen.","ar":"أيا كان، أنا ضده."},{"t":"Du siehst traurig aus. Was ist los?","ar":"تبدو حزينا. ما الأمر؟"},{"t":"In welchem Bett willst du schlafen?","ar":"على أي سرير تريد أن تنام؟"},{"t":"Leider erinnere ich mich an nichts.","ar":"للأسف، لا أتذكر أي شيء."},{"t":"Ich habe ihn im Krankenhaus besucht.","ar":"ذهبت إلى المستشفى لزيارته."},{"t":"Wir brauchen bloß ein bisschen Zeit.","ar":"نحتاج فقط قليلا من الوقت."},{"t":"Ich erinnere mich an alles, was du mir sagst.","ar":"أتذكر كل ما تقوله لي."},{"t":"Ich erinnere mich daran, sie gesehen zu haben.","ar":"أتذكر أني رأيتها."},{"t":"Sie ist traurig, seit ihre Katze gestorben ist.","ar":"هي حزينة منذ أن مات قطها."}],"focus":["besucht","manche","bloß","beginnt","dagegen","lustig","traurig","echt","welchem","erinnere"],"words":[{"word":"manche","topic":"L98","difficulty":2,"meaning":"بَعْض"},{"word":"bloß","topic":"L98","difficulty":2,"meaning":"بِالْكَاد","example":"Es ist bloß Wasser.","translation":"هذا مجرّد ماء."},{"word":"lustig","topic":"L98","difficulty":2,"meaning":"مَرِح","example":"Was ist so lustig?","translation":"ما الشيء المضحك؟"},{"word":"traurig","topic":"L98","difficulty":2,"meaning":"حَزِين، مُحْزِن","example":"Ich bin traurig.","translation":"أنا حزين."},{"word":"echt","topic":"L98","difficulty":2,"meaning":"حَقِيقِيّ، حَقّ","example":"Das ist echt nett von euch.","translation":"هذا حقاً لطفاً منك."}],"difficulty":2}}