":"gesagt","topic":"L2","difficulty":1,"meaning":"مقول (التصريف الثالث من sagen)","example":"Wer hat Ziri das gesagt?","translation":"من قال هذا لزيري؟"},{"word":"wir","topic":"L2","difficulty":1,"meaning":"نحن","example":"Wir wissen, wer sie ist.","translation":"نعلم من تكون."},{"word":"bist","topic":"L2","difficulty":1,"meaning":"تكون (sein مع أنت)","example":"Wir wissen, wer du bist.","translation":"نعلم من أنت."}],"difficulty":1}}