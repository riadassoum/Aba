اك مرة أخرى."},{"t":"Wir haben eine weiße Katze.","ar":"لدينا قط أبيض."},{"t":"Tom spielt mit Mary Karten.","ar":"توم يلعب الورق مع ماري."},{"t":"Warum lernst du chinesisch?","ar":"لماذا تتعلمين اللغة الصينية؟"},{"t":"Ich kann Chinesisch sprechen.","ar":"أستطيع التحدث باللغة الصينية."},{"t":"Sind Sie Chinese oder Japaner?","ar":"هل أنت صيني أم ياباني؟"},{"t":"Wann kann ich dich wiedersehen?","ar":"متى يمكنني أن أراك مجددا؟"},{"t":"Das Huhn hat viele Eier gelegt.","ar":"باضت الدجاجة الكثير من البيض."},{"t":"Die Karten liegen auf dem Tisch.","ar":"لقد وُضِعت الأوراق على الطّاوِلة."},{"t":"Ich will dich nicht wiedersehen.","ar":"لا أريد رؤيتك مرّة ثانية"},{"t":"Ich habe Angst vor der Dunkelheit.","ar":"لدي خوف من الظلام."},{"t":"Fast alle Japaner haben dunkle Haare.","ar":"جميع اليابانيين تقريبا لديهم شعر داكن اللون."},{"t":"Er fürchtete sich vor der Dunkelheit.","ar":"كان خائفا من الظلام."},{"t":"Reden ist Silber, Schweigen ist Gold.","ar":"إذا كان الكلام من فضة فالسكوت من ذهب."},{"t":"Du müsstest schon längst im Bett sein!","ar":"لقد تجاوزت وقت نومك."},{"t":"Der Sturm scheint sich gelegt zu haben.","ar":"يبدو أن العصافة هدأت."}],"focus":["weiße","Karten","Chinesisch","Japaner","längst","Dunkelheit","unschuldig","Schweigen","wiedersehen","gelegt"],"words":[{"word":"weiße","topic":"L309","difficulty":3,"meaning":"بَيَاض","example":"Wir haben eine weiße Katze.","translation":"لدينا قط أبيض."},{"word":"Karten","topic":"L309","difficulty":3,"meaning":"لَعْبَة وَرَق","example":"Lasst uns Karten spielen.","translation":"لنلعب الورق."},{"word":"Chinesisch","topic":"L309","difficulty":3,"meaning":"صِينِيّ","example":"Es ist chinesisch.","translation":"هذه صينيّة."},{"word":"Japaner","topic":"L309","difficulty":3,"meaning":"يَابَانِيّ","example":"Ist er Japaner?","translation":"هل هو ياباني؟"},{"word":"längst","topic":"L309","difficulty":3,"meaning":"قَدِيماً","example":"Du müsstest schon längst im Bett sein!","translation":"لقد تجاوزت وقت نومك."},{"word":"Dunkelheit","topic":