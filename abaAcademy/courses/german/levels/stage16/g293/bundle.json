.","ar":"كعكتك شهية."},{"t":"Es schmeckt wirklich gut.","ar":"إنها لذيذة."},{"t":"Maria, ich meine es ernst.","ar":"أنا جادٌّ يا ماري."},{"t":"Dieses Wasser schmeckt gut.","ar":"مذاق هذا الماء طيب."},{"t":"An der Wand hängt ein Bild.","ar":"هناك صورة معلقة على الحائط."},{"t":"Das Bild hängt an der Wand.","ar":"الصورة معلقة على الحائط."},{"t":"Er las das Dokument laut vor.","ar":"قرأ الورقة بصوت عالٍ."},{"t":"Die Straße fällt plötzlich ab.","ar":"الطريق تنحني للأسفل فجأة."},{"t":"Lass ihn das bloß nicht lesen.","ar":"لا تدعه يقرأ هذا."},{"t":"Das Fleisch schmeckt schlecht.","ar":"طعم اللحم سيء."},{"t":"Tom wurde im Gefängnis getötet.","ar":"توم قُتل في السجن."},{"t":"Plötzlich fing es an zu regnen.","ar":"فجأة بدأ المطر بالهطول."},{"t":"Das kann nicht dein Ernst sein.","ar":"لا يمكن أن تكون جاداً."},{"t":"Finger weg von meinem Sandwich!","ar":"إيّاك ولمس شطيرتي!"}],"focus":["Gefängnis","legte","laut","plötzlich","bloß","schmeckt","ernst","Politik","hängt","Finger"],"words":[{"word":"Gefängnis","topic":"L293","difficulty":3,"meaning":"سِجْن","example":"Tom wurde im Gefängnis getötet.","translation":"توم قُتل في السجن."},{"word":"laut","topic":"L293","difficulty":3,"meaning":"عَالٍ","example":"Er las das Dokument laut vor.","translation":"قرأ الورقة بصوت عالٍ."},{"word":"plötzlich","topic":"L293","difficulty":3,"meaning":"فَجْأَةً","example":"Die Straße fällt plötzlich ab.","translation":"الطريق تنحني للأسفل فجأة."},{"word":"bloß","topic":"L293","difficulty":3,"meaning":"بِالْكَاد","example":"Bleib bloß weg!","translation":"لأجل الجحيم، ابق بعيدا عني!"},{"word":"ernst","topic":"L293","difficulty":3,"meaning":"جِدِّيّ، جَدِّيّ","example":"Das ist ernst.","translation":"ذلك جِدّي."},{"word":"Politik","topic":"L293","difficulty":3,"meaning":"سِيَاسَة","example":"Ich hasse Politik.","translation":"أكره السياسة."},{"word":"Finger","topic":"L293","difficulty":3,"meaning":"إِصْبَع","example":"Das war mein Finger.","translation":"هذا اصبعي."}],"difficulty":3}}