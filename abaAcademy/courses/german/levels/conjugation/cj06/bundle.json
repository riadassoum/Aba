{"theory":{"blocks":[{"btype":"text","text":"المضارع (Präsens): entdecken (اِكْتَشَفَ)، polen (بُولَنْدَا)، leiden (مُعَانَاة)، fliehen (هَرَبَ)، sparen (اِدَّخَرَ)، schneiden (قَطَعَ)، öffnen (فَتَحَ)، schreiben (كَاتَبَ، َأَلَّف)، unterschreiben (وَقَّعَ)، ärgern (أَسْخَطَ)."},{"btype":"example","text":"entdecken","note":"ich entdecke، du entdeckst، er/sie/es entdeckt، wir entdecken، ihr entdeckt، sie/Sie entdecken"},{"btype":"example","text":"polen","note":"ich pole، du polst، er/sie/es polt، wir polen، ihr polt، sie/Sie polen"},{"btype":"example","text":"leiden","note":"ich leide، du leidest، er/sie/es leidet، wir leiden، ihr leidet، sie/Sie leiden"},{"btype":"example","text":"fliehen","note":"ich fliehe، du fliehst، er/sie/es flieht، wir fliehen، ihr flieht، sie/Sie fliehen"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","verbs":[{"infinitive":"entdecken","meaning":"اِكْتَشَفَ","tense":"المضارع (Präsens)","forms":{"ich":"entdecke","du":"entdeckst","er/sie/es":"entdeckt","wir":"entdecken","ihr":"entdeckt","sie/Sie":"entdecken"},"difficulty":2},{"infinitive":"polen","meaning":"بُولَنْدَا","tense":"المضارع (Präsens)","forms":{"ich":"pole","du":"polst","er/sie/es":"polt","wir":"polen","ihr":"polt","sie/Sie":"polen"},"difficulty":2},{"infinitive":"leiden","meaning":"مُعَانَاة","tense":"المضارع (Präsens)","forms":{"ich":"leide","du":"leidest","er/sie/es":"leidet","wir":"leiden","ihr":"leidet","sie/Sie":"leiden"},"difficulty":2},{"infinitive":"fliehen","meaning":"هَرَبَ","tense":"المضارع (Präsens)","forms":{"ich":"fliehe","du":"fliehst","er/sie/es":"flieht","wir":"fliehen","ihr":"flieht","sie/Sie":"fliehen"},"difficulty":2},{"infinitive":"sparen","meaning":"اِدَّخَرَ","te