{"theory":{"blocks":[{"btype":"text","text":"المضارع (Präsens): geben (أَعْطَى)، nerven (أزْعَجَ)، glauben (صَدَّقَ، ظَنَّ)، bergen (أَنْقَذَ)، übersetzen (تَرْجَمَ)، pflanzen (زَرَعَ)، baden (بَادِن)، zahlen (دَفَعَ)، zählen (عَدَّ)، backen (خَبْز)."},{"btype":"example","text":"geben","note":"ich gebe، du gibst، er/sie/es gibt، wir geben، ihr gebt، sie/Sie geben"},{"btype":"example","text":"nerven","note":"ich nerve، du nervst، er/sie/es nervt، wir nerven، ihr nervt، sie/Sie nerven"},{"btype":"example","text":"glauben","note":"ich glaube، du glaubst، er/sie/es glaubt، wir glauben، ihr glaubt، sie/Sie glauben"},{"btype":"example","text":"bergen","note":"ich berge، du birgst، er/sie/es birgt، wir bergen، ihr bergt، sie/Sie bergen"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","verbs":[{"infinitive":"geben","meaning":"أَعْطَى","tense":"المضارع (Präsens)","forms":{"ich":"gebe","du":"gibst","er/sie/es":"gibt","wir":"geben","ihr":"gebt","sie/Sie":"geben"},"difficulty":2},{"infinitive":"nerven","meaning":"أزْعَجَ","tense":"المضارع (Präsens)","forms":{"ich":"nerve","du":"nervst","er/sie/es":"nervt","wir":"nerven","ihr":"nervt","sie/Sie":"nerven"},"difficulty":2},{"infinitive":"glauben","meaning":"صَدَّقَ، ظَنَّ","tense":"المضارع (Präsens)","forms":{"ich":"glaube","du":"glaubst","er/sie/es":"glaubt","wir":"glauben","ihr":"glaubt","sie/Sie":"glauben"},"difficulty":2},{"infinitive":"bergen","meaning":"أَنْقَذَ","tense":"المضارع (Präsens)","forms":{"ich":"berge","du":"birgst","er/sie/es":"birgt","wir":"bergen","ihr":"bergt","sie/Sie":"bergen"},"difficulty":2},{"infinitive":"übersetzen","meaning":"تَرْجَمَ","tense":"المضارع (Präsens)","forms":{"ich":"übersetze","du":"übersetzt","e