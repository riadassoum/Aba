m Lehrer die Schuld.","ar":"لامَ سامي معلّمه على فشله هو."},{"t":"Ich bedaure, dass ich dich heute Abend nicht treffen kann.","ar":"آسف لكني لا أستطيع أن أقابلك الليلة."}],"focus":["Versagen","Wal","ankamen","Liebling","halfen","Friedens","Valentinstag","Besserung","bedaure","hab's"],"words":[{"word":"Versagen","topic":"L456","difficulty":5,"meaning":"عُطْل","example":"Tom gab für sein Versagen seinem Lehrer die Schuld.","translation":"لامَ سامي معلّمه على فشله هو."},{"word":"Wal","topic":"L456","difficulty":5,"meaning":"حُوت"},{"word":"Liebling","topic":"L456","difficulty":5,"meaning":"حَبِيب","example":"Jetzt nicht, Liebling.","translation":"ليس الأن عزيزي 😁"},{"word":"Besserung","topic":"L456","difficulty":5,"meaning":"تَحْسِين","example":"Er ist auf dem Wege der Besserung.","translation":"بدأ يتحسن"}],"difficulty":5}}