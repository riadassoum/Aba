{"theory":{"blocks":[{"btype":"text","text":"الدرس 257. الكلمات الجديدة: Bauernhof، Interessen، demselben، Anlass، tapfer، überprüfen، gelehrt، Hotels، gemalt، plus."},{"btype":"example","text":"Bauernhof = مَزْرَعَة","note":"مثال: Wir wohnen neben einem Bauernhof. — نحن نسكن قرب أحد المزارع."},{"btype":"example","text":"Interessen = اِهْتِمَام","note":"صيغة من Interesse (الجمع)"},{"btype":"example","text":"demselben = نَفْسَهُ، مِثْلَهَا","note":"صيغة من derselbe (المذكّر، حالة المفعول غير المباشر)؛ مثال: Ich bin in demselben Boot. — أنا في نفس الحالة."},{"btype":"example","text":"Anlass = أَمْر","note":""},{"btype":"example","text":"tapfer = شُجَاع","note":"مثال: Du bist sehr tapfer. — أنت شجاع جداً."},{"btype":"example","text":"überprüfen = اِسْتَأْنَى","note":"مثال: Überprüfen Sie das. — إفحص هذا."},{"btype":"example","text":"gelehrt = عَلَّمَ","note":"صيغة من lehren (اسم المفعول (التصريف الثالث))؛ مثال: Englisch wird in den meisten Ländern gelehrt. — الانجليزية تدرس في اغلب الدول."},{"btype":"example","text":"Hotels = فُنْدُق","note":"صيغة من Hotel (الجمع)"},{"btype":"example","text":"gemalt = لَوَّنَ","note":"صيغة من malen (اسم المفعول (التصريف الثالث))؛ مثال: Wer hat dieses Bild gemalt? — من رسم هذه اللوحة؟"},{"btype":"example","text":"plus = زَائِد","note":"مثال: Was ist zwei plus zwei? — ما هو إثنان زائد إثنان؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Überprüfen Sie das.","note":"إفحص هذا."},{"btype":"example","text":"Du bist sehr tapfer.","note":"أنت شجاع جداً."},{"btype":"example","text":"Überprüfen Sie alle.","note":"إفحص كُل واحد."},{"btype":"example","text":"Was ist zwei plus zwei?","note":"ما هو إثنان زائد إثنان؟"},{"btype":"example","text":"Was ist eins plus eins?","note":"كم واحد زائد واحد؟"},{"btype":"example","text":"Ich bin in demselben Boot.","note":"أنا في نفس الحالة."},{"btype":"example","text":"Wer hat dieses Bild gemalt?","note":"من رسم هذه اللوحة؟"},{"btype":"example","text":"Wer hat diese Bilder gemalt?","note":"من رسم هذه اللوحات؟"},{"btype":"example","text":"Eins plus zwei ist gleich drei.","note":"واحد زائد اثنان يساوي ثلاثة."},{"btype":"example","text":"Wir wohnen neben einem Bauernhof.","note":"نحن نسكن قرب أحد المزارع."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Überprüfen Sie das.","ar":"إفحص هذا."},{"t":"Du bist sehr tapfer.","ar":"أنت شجاع جداً."},{"t":"Überprüfen Sie alle.","ar":"إفحص كُل واحد."},{"t":"Was ist zwei plus zwei?","ar":"ما هو إثنان زائد إثنان؟"},{"t":"Was ist eins plus eins?","ar":"كم واحد زائد واحد؟"},{"t":"Ich bin in demselben Boot.","ar":"أنا في نفس الحالة."},{"t":"Wer hat dieses Bild gemalt?","ar":"من رسم هذه اللوحة؟"},{"t":"Wer hat diese Bilder gemalt?","ar":"من رسم هذه اللوحات؟"},{"t":"Eins plus zwei ist gleich drei.","ar":"واحد زائد اثنان يساوي ثلاثة."},{"t":"Wir wohnen neben einem Bauernhof.","ar":"نحن نسكن قرب أحد المزارع."},{"t":"Ich arbeitete auf einem Bauernhof.","ar":"لقد عملت في مزرعة."},{"t":"