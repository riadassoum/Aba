{"theory":{"blocks":[{"btype":"text","text":"الدرس 267. الكلمات الجديدة: achtzig، Niveau، versuchst، klettern، kürzer، verstorben، hilfreich، volle، wider، hasste، Temperaturen، schweine."},{"btype":"example","text":"achtzig = ثَمَانِينَ","note":"مثال: Er ist achtzig Jahre alt. — عمره ثمانون سنةً."},{"btype":"example","text":"Niveau = مُسْتَوًى","note":""},{"btype":"example","text":"versuchst = حَاوَلَ","note":"صيغة من versuchen (المخاطب، المضارع)؛ مثال: Ich weiß, was du versuchst. — أنا أعرف ما الذى تحاول فعله."},{"btype":"example","text":"klettern = تَسَلَّقَ","note":"مثال: Ein Bär kann auf einen Baum klettern. — يستطيع الدب تسلق الشجرة."},{"btype":"example","text":"kürzer = قَصِير","note":"صيغة من kurz (صيغة التفضيل)"},{"btype":"example","text":"verstorben = مَرْحُوم","note":"مثال: Er ist gestern verstorben. — مات البارحة."},{"btype":"example","text":"hilfreich = نَافِع","note":"مثال: Ich werde nie vergessen, wie hilfreich du gewesen bist. — لن أنس مدى مساعدتك لي."},{"btype":"example","text":"volle = مُمْتَلِئ، شِبَع","note":"صيغة من voll (المؤنث، حالة المفعول به)"},{"btype":"example","text":"wider = ضِدّ","note":""},{"btype":"example","text":"hasste = كَرِهَ","note":"صيغة من hassen (الغائب، الماضي التامّ)؛ مثال: Ziri hasste Rima. — كان زيري يكره ريمة."},{"btype":"example","text":"Temperaturen = دَرَجَةْ الْحَرَارَة","note":"صيغة من Temperatur (الجمع)"},{"btype":"example","text":"schweine = خِنْزِير","note":"صيغة من Schwein (الجمع، حالة الإضافة، حالة المفعول به)؛ مثال: Schweine sind klüger als Hunde und Katzen. — الخنازير أذكى من الكلاب والقطط."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ziri hasste Rima.","note":"كان زيري يكره ريمة."},{"btype":"example","text":"Sie hasste die Schule.","note":"كانت تكره المدرسة."},{"btype":"example","text":"Er ist achtzig Jahre alt.","note":"عمره ثمانون سنةً."},{"btype":"example","text":"Er ist gestern verstorben.","note":"مات البارحة."},{"btype":"example","text":"Ich weiß, was du versuchst.","note":"أنا أعرف ما الذى تحاول فعله."},{"btype":"example","text":"Ein Bär kann auf einen Baum klettern.","note":"يستطيع الدب تسلق الشجرة."},{"btype":"example","text":"Schweine sind klüger als Hunde und Katzen.","note":"الخنازير أذكى من الكلاب والقطط."},{"btype":"example","text":"Ich werde nie vergessen, wie hilfreich du gewesen bist.","note":"لن أنس مدى مساعدتك لي."},{"btype":"example","text":"Ich bin als Freund hier.","note":"أنا هنا كصديق."},{"btype":"example","text":"Wasser ist sehr wichtig.","note":"الماء مهم جدا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ziri hasste Rima.","ar":"كان زيري يكره ريمة."},{"t":"Sie hasste die Schule.","ar":"كانت تكره المدرسة."},{"t":"Er ist achtzig Jahre alt.","ar":"عمره ثمانون سنةً."},{"t":"Er ist gestern verstorben.","ar":"مات البارحة."},{"t":"Ich weiß, was du versuchst.","ar":"أنا أعرف ما الذى تحاول فعله."},{"t":"Ein Bär kann auf einen Baum klettern.","ar":"يستطيع الدب تسلق الشجرة."},{"t":"Schwein