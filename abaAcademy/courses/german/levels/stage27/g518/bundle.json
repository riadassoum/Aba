{"theory":{"blocks":[{"btype":"text","text":"الدرس 518. الكلمات الجديدة: Folter، eingesperrt، streicheln، Erleichterung، breiten، Wölfen، Faktoren، Geständnis، Schwiegervater، Regime، zusammenzuarbeiten، Koma."},{"btype":"example","text":"Folter = تَعْذِيب","note":""},{"btype":"example","text":"eingesperrt = حَبَسَ","note":"صيغة من einsperren (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"streicheln = لَاطَفَ","note":"مثال: Du kannst den Hund streicheln. — بإمكانك ملاطفة الكلب."},{"btype":"example","text":"Erleichterung = رَاحَة","note":"مثال: Das ist eine Erleichterung. — هذا يدعو للراحة."},{"btype":"example","text":"breiten = عَرْض","note":"صيغة من Breite (الجمع)؛ مثال: Breiten Sie die Decke über das Baby aus, es ist kalt. — ضع بطانية على الطفل أنه بارد."},{"btype":"example","text":"Wölfen = ذِئْب","note":"صيغة من Wolf (الجمع، حالة المفعول غير المباشر)"},{"btype":"example","text":"Faktoren = عَامِل","note":"صيغة من Faktor (الجمع)؛ مثال: Es gibt viele Faktoren. — هناك عوامل كثيرة."},{"btype":"example","text":"Geständnis = إِقْرَار","note":""},{"btype":"example","text":"Schwiegervater = حَم","note":""},{"btype":"example","text":"Regime = نِظَام","note":""},{"btype":"example","text":"zusammenzuarbeiten = تَعَاوَنَ","note":"صيغة من zusammenarbeiten (المصدر)؛ مثال: Ich freue mich darauf, mit dir zusammenzuarbeiten. — أنا أتتطلع لأعمل معك."},{"btype":"example","text":"Koma = غَيْبُوبَة","note":"مثال: Sami erwachte aus seinem Koma. — استيقظ سامي من غيبوبته."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Es gibt viele Faktoren.","note":"هناك عوامل كثيرة."},{"btype":"example","text":"Das ist eine Erleichterung.","note":"هذا يدعو للراحة."},{"btype":"example","text":"Was für eine Erleichterung!","note":"يا لها من راحة"},{"btype":"example","text":"Du kannst den Hund streicheln.","note":"بإمكانك ملاطفة الكلب."},{"btype":"example","text":"Sami erwachte aus seinem Koma.","note":"استيقظ سامي من غيبوبته."},{"btype":"example","text":"Diese zwei Faktoren sind unabhängig voneinander.","note":"هذان العنصران مستقلان عن بعضهما."},{"btype":"example","text":"Ich freue mich darauf, mit dir zusammenzuarbeiten.","note":"أنا أتتطلع لأعمل معك."},{"btype":"example","text":"Breiten Sie die Decke über das Baby aus, es ist kalt.","note":"ضع بطانية على الطفل أنه بارد."},{"btype":"example","text":"Ich lese gern Bücher.","note":"أحب قراءة الكُتُب."},{"btype":"example","text":"Reist du gern allein?","note":"أتحب السفر بمفردك؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Es gibt viele Faktoren.","ar":"هناك عوامل كثيرة."},{"t":"Das ist eine Erleichterung.","ar":"هذا يدعو للراحة."},{"t":"Was für eine Erleichterung!","ar":"يا لها من راحة"},{"t":"Du kannst den Hund streicheln.","ar":"بإمكانك ملاطفة الكلب."},{"t":"Sami erwachte aus seinem Koma.","ar":"استيقظ سامي من غيبوبته."},{"t":"Diese zwei Faktoren sind unabhängig voneinander.","ar":"هذان العنصران مستقلان عن بعضهما."},{"t":"Ich freue mich darauf, mit dir zusammenzuarbeiten.","ar":"أنا أتتطلع لأعمل معك."},{"t":"Breiten Sie die Decke über das Baby aus, es ist kalt.","ar":"ضع بطانية على الطفل أنه بارد."},{"t":"Ich lese gern Bücher.","ar":"أحب قراءة الكُتُب."},{"t":"Reist du gern allein?","ar":"أتحب السفر بمفردك؟"},{"t":"Er sieht gerne Filme.","ar":"هو يحب الأفلام."},{"t":"Magst du gerne Tennis?","ar":"هل تحب كرة المضرب؟"}],"focus":["Folter","eingesperrt","streicheln","Erleichterung","breiten","Wölfen","Faktoren","Geständnis","Schwiegervater","Regime","zusammenzuarbeiten","Koma"],"words":[{"word":"Folter","topic":"L518","difficulty":4,"meaning":"تَعْذِيب"},{"word":"streicheln","topic":"L518","difficulty":4,"meaning":"لَاطَفَ","example":"Du kannst den Hund streicheln.","translation":"بإمكانك ملاطفة الكلب."},{"word":"Erleichterung","topic":"L518","difficulty":4,"meaning":"رَاحَة","example":"Das ist eine Erleichterung.","translation":"هذا يدعو للراحة."},{"word":"Geständnis","topic":"L518","difficulty":4,"meaning":"إِقْرَار"},{"word":"Schwiegervater","topic":"L518","difficulty":4,"meaning":"حَم"},{"word":"Regime","topic":"L518","difficulty":4,"meaning":"نِظَام"},{"word":"Koma","topic":"L518","difficulty":4,"meaning":"غَيْبُوبَة","example":"Sami erwachte aus seinem Koma.","translation":"استيقظ سامي من غيبوبته."}],"difficulty":4}}