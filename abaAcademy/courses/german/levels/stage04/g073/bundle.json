 teuer.","ar":"اللحم باهظ الثمن."},{"t":"Montag kommt nach Sonntag.","ar":"يأتي الاثنين بعد الأحد."},{"t":"Die Farbe steht mir nicht.","ar":"هذا اللون لا يناسبني."},{"t":"Welche Farbe hat dein Hut?","ar":"ما لون قبعتك؟"},{"t":"Wie viel hast du gewonnen?","ar":"كم رَبِحتَ؟"},{"t":"Was machst du am Nachmittag?","ar":"ماذا تفعل ظهرا؟"},{"t":"Vielleicht regnet es morgen.","ar":"لربما تمطر غداً."},{"t":"Diese Farbe steht mir nicht.","ar":"هذا اللون لا يناسبني."},{"t":"Mir gefällt die Farbe nicht.","ar":"لم يعجبني اللّون."},{"t":"Musst du am Sonntag arbeiten?","ar":"هل عليك أن تعمل يوم الأحد؟"},{"t":"Sie hat ein Telefon gewonnen.","ar":"ربحت هاتفا."},{"t":"Tom gefällt diese Farbe nicht.","ar":"لا يحب توم هذا اللون."}],"focus":["Sonntag","Blick","Nachmittag","verletzt","regnet","Farbe","gewonnen","großes","Freunden","teuer"],"words":[{"word":"Sonntag","topic":"L73","difficulty":1,"meaning":"الْأَحَد","example":"Es regnet seit Sonntag.","translation":"إنها تمطر منذ يوم الأحد."},{"word":"Blick","topic":"L73","difficulty":1,"meaning":"نَظْرَة"},{"word":"Nachmittag","topic":"L73","difficulty":1,"meaning":"بَعْد الظُّهْر","example":"Was machst du am Nachmittag?","translation":"ماذا تفعل ظهرا؟"},{"word":"Farbe","topic":"L73","difficulty":1,"meaning":"لَوْن","example":"Die Farbe steht mir nicht.","translation":"هذا اللون لا يناسبني."},{"word":"teuer","topic":"L73","difficulty":1,"meaning":"غَالٍ","example":"Es ist zu teuer.","translation":"إنه مكلف للغاية."}],"difficulty":1}}