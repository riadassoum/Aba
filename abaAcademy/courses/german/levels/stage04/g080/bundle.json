st auch ein Apfel.","ar":"هذه تفاحة أيضاً."},{"t":"Warum tust du das immer?","ar":"لم تفعل هذا دائما؟"},{"t":"Tom, was tust du gerade?","ar":"توم، ماذا تفعل؟"},{"t":"Frauen und Kinder zuerst!","ar":"النساء و الأطفال أولا!"},{"t":"Alle Gefühle gehen vorbei.","ar":"كل المشاعر تمر."},{"t":"Er hat den Apfel gegessen.","ar":"هو أكل التفاحة."},{"t":"Wir sind zuerst angekommen.","ar":"وصلنا أولاً"},{"t":"Es sieht wie ein Apfel aus.","ar":"تبدو كتفاحة."},{"t":"Sie hat den Apfel gegessen.","ar":"هي أكلت التفاحة."},{"t":"Hast du gestern gearbeitet?","ar":"هل عملت البارحة؟"},{"t":"Ich bin frei wie ein Vogel.","ar":"أنا حرّ كالطّائر."},{"t":"Ich habe ein Flugzeug gesehen.","ar":"رأيت طائرة."},{"t":"Gestern habe ich ihn angerufen.","ar":"اتصلت به بالأمس."},{"t":"Darf ich euer Telefon benutzen?","ar":"هل لي أن أستخدم هاتفك؟"}],"focus":["schläft","Gefühle","angerufen","zuerst","Flugzeug","Apfel","gearbeitet","tust","euer","Vogel"],"words":[{"word":"zuerst","topic":"L80","difficulty":1,"meaning":"أَوَّلاً","example":"Du zuerst.","translation":"اذهب أنت أولاً."},{"word":"Flugzeug","topic":"L80","difficulty":1,"meaning":"طَائِرَة","example":"Ich habe ein Flugzeug gesehen.","translation":"رأيت طائرة."},{"word":"Apfel","topic":"L80","difficulty":1,"meaning":"تُفَّاحَة","example":"Er isst einen Apfel.","translation":"إنه يأكل تفاحة."},{"word":"euer","topic":"L80","difficulty":1,"meaning":"ـكُم","example":"Wer ist euer Lehrer?","translation":"من مدرسك؟"},{"word":"Vogel","topic":"L80","difficulty":1,"meaning":"طَائِر","example":"Wie heißt dieser Vogel?","translation":"ما اسم هذا الطائر؟"}],"difficulty":1}}