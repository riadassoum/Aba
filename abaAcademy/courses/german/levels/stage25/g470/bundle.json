":"هل هذه الترجمة صحيحة؟"},{"t":"Ich habe diesen Stuhl gemacht.","ar":"صنعتُ هذا الكرسي."},{"t":"Diese Übersetzung stimmt nicht.","ar":"هذه الترجمة غير دقيقة."},{"t":"Vielleicht mag Tom dich leiden.","ar":"ربما توم يحبك."},{"t":"Das Schicksal kann grausam sein.","ar":"القدر في بعض الأحيان يكون قاسياً."},{"t":"Wider Erwarten war er pünktlich.","ar":"بعكس ما توقّعته، فقد وصل في الوقت."},{"t":"Warum magst du mich nicht leiden?","ar":"لماذا لا تحبني"},{"t":"Seine Vorlesung begann pünktlich.","ar":"بدأت محاضرته في موعدها."},{"t":"Tom hat mir eine E-Mail geschickt.","ar":"أرسل لي توم بريدًا إلكترونيًا."},{"t":"Die Katze schläft auf einem Stuhl.","ar":"القط نائم على الكرسي."},{"t":"Er hat seine Sekretärin entlassen.","ar":"قام بطرد سكرتيرته."},{"t":"Ich habe dir eine E-Mail geschickt.","ar":"لقد أرسلتُ إليكَ بريداً إلكترونياً."},{"t":"Dieser Stuhl muss repariert werden.","ar":"هذا الكرسي يحتاج إلى الإصلاح."},{"t":"Nimm diesen Stuhl — der ist stabil!","ar":"خذ هذا الكرسي فهو صلب."},{"t":"Der Bus kommt nicht immer pünktlich.","ar":"لا تأتي الحافلة دائما في الوقت."},{"t":"Wir sind pünktlich im Büro angekommen.","ar":"وصلنا إلى المكتب في الوقت المطلوب."},{"t":"Ich habe ihn noch nie zuvor getroffen.","ar":"لم أقابله من قبل."}],"focus":["Übersetzung","leiden","geschickt","Stuhl","Schicksal","pünktlich","entlassen","Projekt","tatsächlich","zuvor"],"words":[{"word":"Übersetzung","topic":"L470","difficulty":4,"meaning":"تَرْجَمَة","example":"Ich ändere diese Übersetzung.","translation":"سأغير هذه الترجمة"},{"word":"leiden","topic":"L470","difficulty":4,"meaning":"مُعَانَاة","example":"Warum leiden wir?","translation":"لماذا نعاني؟"},{"word":"geschickt","topic":"L470","difficulty":4,"meaning":"مَاهِر","example":"Tom hat mir eine E-Mail geschickt.","translation":"أرسل لي توم بريدًا إلكترونيًا."},{"word":"Stuhl","topic":"L470","difficulty":4,"meaning":"بِرَاز","example":"Sie sprang vom Stuhl.","translation":"قفزت من على الكرسي."},{"word":"Schicksal","topic":"L470","difficulty":4,"mean