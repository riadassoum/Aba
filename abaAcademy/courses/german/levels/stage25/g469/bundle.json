":"ولم يساعدك أحد؟"},{"t":"Was hast du heute geschafft?","ar":"ماذا فعلت اليوم ؟"},{"t":"Tom fand seine Brille nicht.","ar":"لم يجد توم نظاراته."},{"t":"Keiner spricht über mein Land.","ar":"لا أحد يتكلم عن بلدي."},{"t":"Er ist im ganzen Land bekannt.","ar":"هو معروف للبلد بأكمله."},{"t":"Ich muss ihr unbedingt helfen.","ar":"يجب أن أساعدها."},{"t":"Sie wollte unbedingt heiraten.","ar":"هىَ كانت يائسة من أن تتزوج."},{"t":"Da musst du unbedingt hingehen.","ar":"يجب أن تذهب."},{"t":"Es ist weder gut noch schlecht.","ar":"انها لا جيدة ولا سيئة."},{"t":"Ich habe meine Brille verloren.","ar":"لقد فقدتُ نظّاراتي."},{"t":"Gott wird den Teufel bestrafen.","ar":"سيعاقب الله الشيطان."},{"t":"Keiner von uns kann Französisch.","ar":"لا أحد منا يتحدث اللغة الفرنسية."},{"t":"Ich bin froh, daß keiner da ist.","ar":"أنا سعيد لأنّه لا يوجد أحد هنا."},{"t":"Das ist nicht unbedingt der Fall.","ar":"ليس بالضرورة."},{"t":"Wo, zum Teufel, warst du so lange?","ar":"بربّك، أين كنت كل هذه الفترة؟"},{"t":"Keiner wusste, was er sagen sollte.","ar":"لا أحد كان يعلم ماذا يقول."},{"t":"Ruf mich in zwei Tagen noch mal an.","ar":"اتصل بي مرة أخرى خلال يومين."}],"focus":["keiner","Tagen","bekannt","unbedingt","weder","geschafft","Vereinigten","Mühe","Brille","Teufel"],"words":[{"word":"keiner","topic":"L469","difficulty":4,"meaning":"أَحَد لَا","example":"Keiner war da.","translation":"لم يكن هناك أحد."},{"word":"Tagen","topic":"L469","difficulty":4,"meaning":"فَجْر","example":"Ruf mich in zwei Tagen noch mal an.","translation":"اتصل بي مرة أخرى خلال يومين."},{"word":"bekannt","topic":"L469","difficulty":4,"meaning":"مَعْلُوم","example":"Er ist bei allen bekannt.","translation":"هو معروف لدى الجميع."},{"word":"unbedingt","topic":"L469","difficulty":4,"meaning":"حَتْماً","example":"Ich muss ihr unbedingt helfen.","translation":"يجب أن أساعدها."},{"word":"weder","topic":"L469","difficulty":4,"meaning":"أَحَد لَا","example":"Es ist weder gut noch schlecht.","translation":"انها لا جيدة ولا سيئة."},{"wo