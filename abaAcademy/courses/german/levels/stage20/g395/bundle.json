{"theory":{"blocks":[{"btype":"text","text":"الدرس 395. الكلمات الجديدة: Inneren، such، Eigentum، kochte، Dialekt، zeitig، versprich، Fischer، Verabredung، Argument."},{"btype":"example","text":"Inneren = داخلى","note":"صيغة من inner (المذكّر، حالة الإضافة)"},{"btype":"example","text":"such = بَحَثَ، بَحَثَ عَنْ","note":"صيغة من suchen (الأمر)؛ مثال: Such mich nicht. — لا تبحث عني"},{"btype":"example","text":"Eigentum = مُلْك","note":"مثال: Dieses Land ist mein Eigentum. — هذه الأرض من أملاكي."},{"btype":"example","text":"kochte = طَبَخَ","note":"صيغة من kochen (الغائب، الماضي التامّ)؛ مثال: Ziri kochte. — كان زيري يطبخ."},{"btype":"example","text":"Dialekt = لَهْجَة","note":""},{"btype":"example","text":"zeitig = بَاكِر","note":"مثال: Bill stand zeitig auf, um den ersten Zug zu nehmen. — استيقظ بيل باكراً ليلحق بأوّل قطار."},{"btype":"example","text":"versprich = وَعْد","note":"صيغة من versprechen (الأمر)"},{"btype":"example","text":"Fischer = صَيَّاد","note":"مثال: Der Fischer steht allein am Ufer. — يقف الصياد وحيداً على الشاطئ."},{"btype":"example","text":"Verabredung = مُوَاعَدَة، لِقَاء الْحُبّ","note":"مثال: Hast du eine Verabredung mit ihm? — هل لديك موعد معه؟"},{"btype":"example","text":"Argument = حُجَّة، وَسِيط","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ziri kochte.","note":"كان زيري يطبخ."},{"btype":"example","text":"Such mich nicht.","note":"لا تبحث عني"},{"btype":"example","text":"Such dir einen Job.","note":"إبحث عن عمل"},{"btype":"example","text":"Such dir eine gute Arbeit.","note":"ابحث عن وظيفة جيّدة."},{"btype":"example","text":"Such es in deinem Wörterbuch.","note":"طالعها في قاموسك."},{"btype":"example","text":"Dieses Land ist mein Eigentum.","note":"هذه الأرض من أملاكي."},{"btype":"example","text":"Der Fischer steht allein am Ufer.","note":"يقف الصياد وحيداً على الشاطئ."},{"btype":"example","text":"Hast du eine Verabredung mit ihm?","note":"هل لديك موعد معه؟"},{"btype":"example","text":"Bill stand zeitig auf, um den ersten Zug zu nehmen.","note":"استيقظ بيل باكراً ليلحق بأوّل قطار."},{"btype":"example","text":"Er kam in sein Eigentum, und die Seinen nahmen ihn nicht auf.","note":"إلى خاصته جاء وخاصته لم تقبله."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ziri kochte.","ar":"كان زيري يطبخ."},{"t":"Such mich nicht.","ar":"لا تبحث عني"},{"t":"Such dir einen Job.","ar":"إبحث عن عمل"},{"t":"Such dir eine gute Arbeit.","ar":"ابحث عن وظيفة جيّدة."},{"t":"Such es in deinem Wörterbuch.","ar":"طالعها في قاموسك."},{"t":"Dieses Land ist mein Eigentum.","ar":"هذه الأرض من أملاكي."},{"t":"Der Fischer steht allein am Ufer.","ar":"يقف الصياد وحيداً على الشاطئ."},{"t":"Hast du eine Verabredung mit ihm?","ar":"هل لديك موعد معه؟"},{"t":"Bill stand zeitig auf, um den ersten Zug zu nehmen.","ar":"استيقظ بيل باكراً ليلحق بأوّل قطار."},{"t":"Er kam in sein Eigentum, und die Seinen nahmen ihn nicht auf.","ar":"إلى خاصته جاء وخاصته لم تقبله."}],"focus":