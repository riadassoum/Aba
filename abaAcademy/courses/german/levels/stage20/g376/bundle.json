{"theory":{"blocks":[{"btype":"text","text":"الدرس 376. الكلمات الجديدة: Schiffes، putzt، manches، widmen، niedlich، losgehen، eingeschlossen، offene، jagt، negativ، flach، malte، zahlte."},{"btype":"example","text":"Schiffes = سَفِينَة","note":"صيغة من Schiff (حالة الإضافة)"},{"btype":"example","text":"putzt = فَرَشَ","note":"صيغة من putzen (الغائب، المضارع)؛ مثال: Putzt eure Zähne. — فرش أسنانك."},{"btype":"example","text":"manches = بَعْض","note":"صيغة من manch (المذكّر، حالة الإضافة)؛ مثال: Manches lässt sich nicht in Worten ausdrücken. — ثمّة أمور لا يمكن التعبير عنها بالكلمات."},{"btype":"example","text":"widmen = كَرَّسَ","note":""},{"btype":"example","text":"niedlich = فَاتِن","note":""},{"btype":"example","text":"losgehen = تَرَكَ","note":"مثال: Ich bin fertig! Können wir losgehen? — أنا جاهز! هل يمكننا الذهاب؟"},{"btype":"example","text":"eingeschlossen = تضمن","note":"صيغة من einschließen (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"offene = مَفْتُوح","note":"صيغة من offen (المؤنث، حالة المفعول به)"},{"btype":"example","text":"jagt = اِصْطَادَ","note":"صيغة من jagen (الغائب، المضارع)"},{"btype":"example","text":"negativ = سَلْبِيّ","note":"مثال: Ihre Antwort war negativ. — لقد كان رده سلبياً."},{"btype":"example","text":"flach = مُسَطَّح","note":""},{"btype":"example","text":"malte = لَوَّنَ","note":"صيغة من malen (الغائب، الماضي التامّ)؛ مثال: Sie malte einen Baum. — رسمت شجرة."},{"btype":"example","text":"zahlte = دَفَعَ","note":"صيغة من zahlen (الغائب، الماضي التامّ)؛ مثال: Er zahlte einen zu hohen Preis für den Erfolg. — نجاحُهُ كلّفه كثيرًا."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Putzt eure Zähne.","note":"فرش أسنانك."},{"btype":"example","text":"Sie malte einen Baum.","note":"رسمت شجرة."},{"btype":"example","text":"Tom putzt sich die Zähne.","note":"توم يفرشي أسنانهُ."},{"btype":"example","text":"Ihre Antwort war negativ.","note":"لقد كان رده سلبياً."},{"btype":"example","text":"Er malte sein Fahrrad rot an.","note":"طلى دراجته بالأحمر."},{"btype":"example","text":"Ich bin fertig! Können wir losgehen?","note":"أنا جاهز! هل يمكننا الذهاب؟"},{"btype":"example","text":"Manches lässt sich nicht in Worten ausdrücken.","note":"ثمّة أمور لا يمكن التعبير عنها بالكلمات."},{"btype":"example","text":"Er zahlte einen zu hohen Preis für den Erfolg.","note":"نجاحُهُ كلّفه كثيرًا."},{"btype":"example","text":"Gestern war ich glücklich.","note":"كنت سعيدًا بالأمس."},{"btype":"example","text":"Sie kam, um mich zu sehen.","note":"أتت لتراني."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Putzt eure Zähne.","ar":"فرش أسنانك."},{"t":"Sie malte einen Baum.","ar":"رسمت شجرة."},{"t":"Tom putzt sich die Zähne.","ar":"توم يفرشي أسنانهُ."},{"t":"Ihre Antwort war negativ.","ar":"لقد كان رده سلبياً."},{"t":"Er malte sein Fahrrad rot an.","ar":"طلى دراجته بالأحمر."},{"t":"Ich bin fertig! Können wir losgehen?","ar":"أنا جاهز! هل يمكننا الذهاب؟"},{"t":"Manches lässt sich nicht in Worten ausdrücken.","ar":"ثمّة أمور لا يمكن التعبير عنها بالكلمات."},{"t":"Er zahlte einen zu hohen Preis für den Erfolg.","ar":"نجاحُهُ كلّفه كثيرًا."},{"t":"Gestern war ich glücklich.","ar":"كنت سعيدًا بالأمس."},{"t":"Sie kam, um mich zu sehen.","ar":"أتت لتراني."},{"t":"Ich will zur Schule gehen.","ar":"أريد أن أذهب إلى المدرسة."},{"t":"Ich muss jetzt nach Hause.","ar":"يجب أن أذهب إلى البيت الآن."}],"focus":["Schiffes","putzt","manches","widmen","niedlich","losgehen","eingeschlossen","offene","jagt","negativ","flach","malte","zahlte"],"words":[{"word":"widmen","topic":"L376","difficulty":3,"meaning":"كَرَّسَ"},{"word":"niedlich","topic":"L376","difficulty":3,"meaning":"فَاتِن"},{"word":"losgehen","topic":"L376","difficulty":3,"meaning":"تَرَكَ","example":"Ich bin fertig! Können wir losgehen?","translation":"أنا جاهز! هل يمكننا الذهاب؟"},{"word":"negativ","topic":"L376","difficulty":3,"meaning":"سَلْبِيّ","example":"Ihre Antwort war negativ.","translation":"لقد كان رده سلبياً."},{"word":"flach","topic":"L376","difficulty":3,"meaning":"مُسَطَّح"}],"difficulty":3}}