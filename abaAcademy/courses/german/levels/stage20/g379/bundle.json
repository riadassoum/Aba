{"theory":{"blocks":[{"btype":"text","text":"الدرس 379. الكلمات الجديدة: Kreativität، Ananas، lustige، Zitrone، lebend، brachen، sonnig، nennst، Mitgefühl، Zehen."},{"btype":"example","text":"Kreativität = إِبْدَاع","note":""},{"btype":"example","text":"Ananas = أَنَانَاس","note":"مثال: Ich esse eine Ananas. — أنا آكل أناناساً."},{"btype":"example","text":"lustige = مَرِح","note":"صيغة من lustig (المؤنث، حالة المفعول به)"},{"btype":"example","text":"Zitrone = لَيْمُون، شَجَرَةُ لَيْمُونٍ","note":"مثال: Einen Tee mit Zitrone, bitte. — شاي بالليمون، لو سمحت."},{"btype":"example","text":"lebend = حَيّ","note":"مثال: Wir haben ihn lebend gefunden. — وجدناه حيا."},{"btype":"example","text":"brachen = كَسَرَ","note":"صيغة من brechen (الجمع، الغائب، الماضي التامّ)"},{"btype":"example","text":"sonnig = مُشْمِس","note":"مثال: Heute ist es sonnig. — الجو مشمس اليوم."},{"btype":"example","text":"nennst = دَعَا","note":"صيغة من nennen (المخاطب، المضارع)؛ مثال: Wie nennst du das? — ماذا تسمي هذا ؟"},{"btype":"example","text":"Mitgefühl = تَعَاطُف","note":"مثال: Du hast mein Mitgefühl. — أشعر بما تمر به."},{"btype":"example","text":"Zehen = إِصْبَع","note":"صيغة من Zeh (الجمع)؛ مثال: Ein Fuß hat fünf Zehen. — للقدم خمسة أصابع."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Wie nennst du das?","note":"ماذا تسمي هذا ؟"},{"btype":"example","text":"Heute ist es sonnig.","note":"الجو مشمس اليوم."},{"btype":"example","text":"Ich esse eine Ananas.","note":"أنا آكل أناناساً."},{"btype":"example","text":"Das Wetter ist sonnig.","note":"الطقس مشمس."},{"btype":"example","text":"Du hast mein Mitgefühl.","note":"أشعر بما تمر به."},{"btype":"example","text":"Ein Fuß hat fünf Zehen.","note":"للقدم خمسة أصابع."},{"btype":"example","text":"Unser Wohnzimmer ist sonnig.","note":"غرفة معيشتنا مشمسة."},{"btype":"example","text":"Einen Tee mit Zitrone, bitte.","note":"شاي بالليمون، لو سمحت."},{"btype":"example","text":"Wir haben ihn lebend gefunden.","note":"وجدناه حيا."},{"btype":"example","text":"Weil es heute sehr sonnig ist, tragen alle eine Sonnenbrille.","note":"اليوم مُشمس جداً, لذلك الجميع يرتدي نظارات الشمس."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Wie nennst du das?","ar":"ماذا تسمي هذا ؟"},{"t":"Heute ist es sonnig.","ar":"الجو مشمس اليوم."},{"t":"Ich esse eine Ananas.","ar":"أنا آكل أناناساً."},{"t":"Das Wetter ist sonnig.","ar":"الطقس مشمس."},{"t":"Du hast mein Mitgefühl.","ar":"أشعر بما تمر به."},{"t":"Ein Fuß hat fünf Zehen.","ar":"للقدم خمسة أصابع."},{"t":"Unser Wohnzimmer ist sonnig.","ar":"غرفة معيشتنا مشمسة."},{"t":"Einen Tee mit Zitrone, bitte.","ar":"شاي بالليمون، لو سمحت."},{"t":"Wir haben ihn lebend gefunden.","ar":"وجدناه حيا."},{"t":"Weil es heute sehr sonnig ist, tragen alle eine Sonnenbrille.","ar":"اليوم مُشمس جداً, لذلك الجميع يرتدي نظارات الشمس."}],"focus":["Kreativität","Ananas","lustige","Zitrone","lebend","brachen","sonnig","nennst","Mitgefühl","Zehen"],"words":[