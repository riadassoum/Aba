{"theory":{"blocks":[{"btype":"text","text":"الدرس 546. الكلمات الجديدة: hinsetzen، trieb، breitete، talentiert، gutgeht، Matthias، angesprochen، ausgelacht، beiseite، umfasst."},{"btype":"example","text":"hinsetzen","note":"مثال: Wir sollten uns hinsetzen. — علينا الجلوس."},{"btype":"example","text":"trieb = نَبْتَة","note":""},{"btype":"example","text":"breitete = نَشَرَ","note":"صيغة من breiten (الغائب، الماضي التامّ)؛ مثال: Tom breitete die Decke aus. — مد توم الغطاء."},{"btype":"example","text":"talentiert","note":"مثال: Er ist sehr talentiert. — هو موهوب جدا."},{"btype":"example","text":"gutgeht","note":"مثال: Bist du dir sicher, dass es dir gutgeht? — أمتأكد من أنك على ما يرام؟"},{"btype":"example","text":"Matthias = مَتَّى","note":""},{"btype":"example","text":"angesprochen = فَاتَحَ","note":"صيغة من ansprechen (اسم المفعول (التصريف الثالث))؛ مثال: Ich mag es nicht, angesprochen zu werden. — لا أحب أن يكلمني الناس."},{"btype":"example","text":"ausgelacht = سَخِرَ","note":"صيغة من auslachen (اسم المفعول (التصريف الثالث))؛ مثال: Tom hat Mary ausgelacht. — ضحك توم على ماري."},{"btype":"example","text":"beiseite","note":"مثال: Er legte das Buch beiseite. — وضع الكتاب جانبا."},{"btype":"example","text":"umfasst","note":"مثال: Eine Minute umfasst sechzig Sekunden. — هناك ستون ثانية في الدقيقة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Er ist sehr talentiert.","note":"هو موهوب جدا."},{"btype":"example","text":"Sie ist sehr talentiert.","note":"إنها موهوبة جدا."},{"btype":"example","text":"Tom hat Mary ausgelacht.","note":"ضحك توم على ماري."},{"btype":"example","text":"Wir sollten uns hinsetzen.","note":"علينا الجلوس."},{"btype":"example","text":"Tom breitete die Decke aus.","note":"مد توم الغطاء."},{"btype":"example","text":"Er legte das Buch beiseite.","note":"وضع الكتاب جانبا."},{"btype":"example","text":"Kann ich mich hier hinsetzen?","note":"أيمكنني الجلوس هنا؟"},{"btype":"example","text":"Eine Minute umfasst sechzig Sekunden.","note":"هناك ستون ثانية في الدقيقة."},{"btype":"example","text":"Bist du dir sicher, dass es dir gutgeht?","note":"أمتأكد من أنك على ما يرام؟"},{"btype":"example","text":"Ich mag es nicht, angesprochen zu werden.","note":"لا أحب أن يكلمني الناس."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Er ist sehr talentiert.","ar":"هو موهوب جدا."},{"t":"Sie ist sehr talentiert.","ar":"إنها موهوبة جدا."},{"t":"Tom hat Mary ausgelacht.","ar":"ضحك توم على ماري."},{"t":"Wir sollten uns hinsetzen.","ar":"علينا الجلوس."},{"t":"Tom breitete die Decke aus.","ar":"مد توم الغطاء."},{"t":"Er legte das Buch beiseite.","ar":"وضع الكتاب جانبا."},{"t":"Kann ich mich hier hinsetzen?","ar":"أيمكنني الجلوس هنا؟"},{"t":"Eine Minute umfasst sechzig Sekunden.","ar":"هناك ستون ثانية في الدقيقة."},{"t":"Bist du dir sicher, dass es dir gutgeht?","ar":"أمتأكد من أنك على ما يرام؟"},{"t":"Ich mag es nicht, angesprochen zu werden.","ar":"لا أحب أن يكلمني الناس."},{"t":"Ich stimme dir zu, dass der Schauspieler sehr talentiert ist.","ar":"أوافقك الرأي أن الممثل موهوب جدا."}],"focus":["hinsetzen","trieb","breitete","talentiert","gutgeht","Matthias","angesprochen","ausgelacht","beiseite","umfasst"],"