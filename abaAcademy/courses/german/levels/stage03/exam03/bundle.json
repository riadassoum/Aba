{"theory":{"blocks":[{"btype":"text","text":"اختبار شامل للمرحلة 3: جمل من كل دروسها. انجح فيه قبل الانتقال."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":4,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":5,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Schwimmen ist leicht.","ar":"السباحة أمر سهل."},{"t":"Er kennt keinen von uns.","ar":"لا يعرف أيّا منّا."},{"t":"Er fährt mit dem Zug zur Arbeit.","ar":"يذهب زيري إلى العمل بالقطار."},{"t":"Tom kennt uns gut.","ar":"يعرفنا توم جيدا"},{"t":"Mach es jetzt!","ar":"افعل ذلك الآن."},{"t":"Wenn du kannst, komm mit.","ar":"إن استطعت، تعال معنا."},{"t":"Wie kurz das Leben ist!","ar":"ما أقصر الحياة!"},{"t":"Endlich habe ich sie gefunden.","ar":"لقد وجدتها أخيرا."},{"t":"Ich werde dich morgen besuchen.","ar":"سأزورك غداً."},{"t":"Endlich kam der Bus.","ar":"وصلت الحافلة أخيرا."},{"t":"Da wohnt niemand.","ar":"لا أحد يسكن هناك."},{"t":"Tom ist der Beste.","ar":"توم هو الأفضل."},{"t":"Endlich kam er.","ar":"و أخيراً أتى."},{"t":"Wie du bereits weißt.","ar":"كما تعرف."},{"t":"Lass uns etwas versuchen!","ar":"لنجرب فعل شيءٍ ما."},{"t":"Tom sah Maria beim Schwimmen zu.","ar":"شاهد توم ماري و هي تسبح."},{"t":"Ist dein Vater Arzt?","ar":"هل أبوك طبيب؟"},{"t":"Er kennt sie.","ar":"هو يعرفها."},{"t":"Ich bin beschäftigt.","ar":"أنا مشغول."},{"t":"Deine Schuhe sind hier.","ar":"حذاءك هنا."},{"t":"Du musst sofort los.","ar":"عليك أن تذهب حالاً."},{"t":"Er nahm seine Hand vom Tisch weg.","ar":"سحب يده من الطاولة."},{"t":"Gut, danke!","ar":"أنا بخير، شكرا."},{"t":"Er spricht vier Sprachen.","ar":"إنةُ يتحدث أربع لغات."},{"t":"Hat er eine Freundin?","ar":"هل لديه حبيبة؟"},{"t":"Du machst es falsch!","ar":"أنت تفعله بطريقة خاطئة!"},{"t":"Mach, was dir gefällt.","ar":"افعل ما تريد."},{"t":"Ich sehe einen Film.","ar":"أشاهد فيلمًا."},{"t":"Sie sind nicht bereit.","ar":"هم ليسوا مستعدين."},{"t":"Sie sind im Garten.","ar":"هم في الحديقة."},{"t":"Er kennt uns sehr gut.","ar":"إنه يعرفنا جيداً."},{"t":"Er ging den ganzen Weg zu Fuß.","ar":"مشي الطريق كله سيرا علي قدمه"},{"t":"Es tut mir leid.","ar":"أنا آسف."},{"t":"Weißt du das?","ar":"هل أنت تعلم؟"},{"t":"Ich habe kein Fahrrad.","ar":"ليس لدي دراجة."},{"t":"Krieg ist schlecht.","ar":"الحرب سيئة."},{"t":"Wir sollten schlafen gehen.","ar":"علينا الخلود إلى النوم."},{"t":"Wie heißt mein Arzt?","ar":"ما اسم طبيبي؟"},{"t":"Er muss dich lieben.","ar":"يجب ان يحبك"},{"t":"Tom glaubt nicht an Gott.","ar":"توم لا يؤمن بالله."},{"t":"Zu Tisch!","ar":"وقت المائدة!"},{"t":"Was machst du?","ar":"ماذا تفعل؟"},{"t":"Er versuchte es wieder und wieder.","ar":"جرّبها مرة بعد أخرى."},{"t":"Ich habe einen Plan.","ar":"عندي خطة."},{"t":"Mag dein Freund Tee?","ar":"هل صاحبك يحب الشاي؟"},{"t":"Du brauchst uns.","ar":"أنت تحتاجنا."},{"t":"Komm wieder.","ar":"تعالَ مُجدداً."},{"t":"Ich brauche ein paar Minuten.","ar":"أحتاج بضع دقائق."},{"t":"Da kommt der Bus!","ar":"ها قد وصلت الحافلة!"},{"t":"Die Sonne geht jetzt auf.","ar":"تشرق الشمس الآن."},{"t":"Du brauchst ihn nicht.","ar":"أنت لا تحتاجه."},{"t":"Wir kennen ihn nicht.","ar":"إننا لا نعرفه."},{"t":"Du hast viele Probleme.","ar":"عندك الكثير من المشاكل."},{"t":"Es ist sehr kalt.","ar":"إن الجو قارس."},{"t":"Das Wasser ist kalt.","ar":"الماء بارد"},{"t":"Der Zug fährt in zehn Minuten.","ar":"سينطلق القطار خلال عشر دقائق."},{"t":"Tom hat kein Brot gekauft.","ar":"لم يشتري توم خبزا."},{"t":"Ich mache nur Spaß.","ar":"كنت أمزح فقط."},{"t":"Lass mich bitte schlafen!","ar":"أرجوك اتركني أنام."},{"t":"Lucy fand Maria.","ar":"وجدت لوسي ماري."},{"t":"Er liebt Tee.","ar":"انه يحب الشاي."},{"t":"Ich bin unter dem Baum.","ar":"أنا تحت الشجرة."},{"t":"Sie liebt Kinder.","ar":"إنها تحب الأطفال."},{"t":"Tom hat ein neues Auto.","ar":"توم عنده السيارة جديدة."},{"t":"Sind Sie Lehrer oder Schüler?","ar":"أمدرّس أنت أم طالب؟"},{"t":"Ich denke, er ist noch zu jung.","ar":"انا اعتقد انه ما يزال صغيراً"},{"t":"Er sah den Himmel.","ar":"نظر إلى السماء."},{"t":"Wir sind im Krieg.","ar":"نحن في حرب."},{"t":"Er lebt noch.","ar":"ما زال على قيد الحياة."},{"t":"Ich werde Arzt.","ar":"سأصبح طبيبًا."},{"t":"Sag es allen.","ar":"أخبر الجميع"},{"t":"Wie ist das Wetter?","ar":"كيف حال الطقس؟"},{"t":"Das ist sehr wichtig.","ar":"هذا مهم جداً."},{"t":"Sie haben einen Plan.","ar":"عندهم خطة."},{"t":"Es ist zu weit weg.","ar":"إنها بعيدة جداً."},{"t":"Tom trägt Mary.","ar":"توم يحمل ماري."},{"t":"Sie trinken Milch.","ar":"يشربن الحليب."},{"t":"Halten Sie den Bus an!","ar":"اوقف الحافلة."},{"t":"Kennt sie dich?","ar":"هل تعرفك؟"},{"t":"Ist meine Antwort richtig?","ar":"هل جوابي صحيح؟"}],"difficulty":1}}