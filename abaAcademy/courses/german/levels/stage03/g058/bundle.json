{"theory":{"blocks":[{"btype":"text","text":"الدرس 58. الكلمات الجديدة: frei، Meer، findet، spreche، gewinnen، Montag، Name، gewöhnlich، Dollar، sechs."},{"btype":"example","text":"frei = حُرّ، شَاغِر","note":"مثال: Ich bin frei. — أنا حُرّ."},{"btype":"example","text":"Meer = بَحْر","note":"مثال: Einige Kinder schwimmen im Meer. — بعض الأطفال يسبحون في البحر."},{"btype":"example","text":"findet = وَجَدَ","note":"صيغة من finden (الغائب، المضارع)"},{"btype":"example","text":"spreche = تَكَلَّمَ، تَحَدَّثَ","note":"صيغة من sprechen (المتكلّم، المضارع)؛ مثال: Ich spreche darüber. — أنا أتحدث عنه."},{"btype":"example","text":"gewinnen = رَبِحَ","note":"مثال: Tom wird nicht gewinnen. — لن يفوز توم."},{"btype":"example","text":"Montag = الْاِثْنَيْن","note":"مثال: Es ist Montag. — اليوم الإثنين."},{"btype":"example","text":"Name = اِسْم، اِشْتِهَار","note":"مثال: Wie ist Ihr Name? — ما اسمُك؟"},{"btype":"example","text":"gewöhnlich = عَادَةً","note":"مثال: Ich gehe gewöhnlich um vier nach Hause. — عادةً ما أعود إلى المنزل الساعة الرابعة."},{"btype":"example","text":"Dollar = دُولَار","note":""},{"btype":"example","text":"sechs = سِتَّة","note":"مثال: Es ist fast sechs Uhr. — قاربت على السادسة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ich bin frei.","note":"أنا حُرّ."},{"btype":"example","text":"Es ist Montag.","note":"اليوم الإثنين."},{"btype":"example","text":"Heute ist Montag.","note":"اليوم هو الإثنين"},{"btype":"example","text":"Wie ist Ihr Name?","note":"ما اسمُك؟"},{"btype":"example","text":"Tom ist ein Name.","note":"توم اسم."},{"btype":"example","text":"Mein Name ist Tom.","note":"إسمي توم."},{"btype":"example","text":"Tom ist mein Name.","note":"توم هو اسمي."},{"btype":"example","text":"Ziri ließ Rima frei.","note":"حرّر زيري ريمة."},{"btype":"example","text":"Ich spreche darüber.","note":"أنا أتحدث عنه."},{"btype":"example","text":"Ich spreche über dich.","note":"أتحدث عنك."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ich bin frei.","ar":"أنا حُرّ."},{"t":"Es ist Montag.","ar":"اليوم الإثنين."},{"t":"Heute ist Montag.","ar":"اليوم هو الإثنين"},{"t":"Wie ist Ihr Name?","ar":"ما اسمُك؟"},{"t":"Tom ist ein Name.","ar":"توم اسم."},{"t":"Mein Name ist Tom.","ar":"إسمي توم."},{"t":"Tom ist mein Name.","ar":"توم هو اسمي."},{"t":"Ziri ließ Rima frei.","ar":"حرّر زيري ريمة."},{"t":"Ich spreche darüber.","ar":"أنا أتحدث عنه."},{"t":"Ich spreche über dich.","ar":"أتحدث عنك."},{"t":"Wo seid ihr am Montag?","ar":"أين ستكون يوم الإثنين؟"},{"t":"Es ist fast sechs Uhr.","ar":"قاربت على السادسة."},{"t":"Tom wird nicht gewinnen.","ar":"لن يفوز توم."},{"t":"Es ist Montag, weißt du?","ar":"إنه يوم الإثنين, كما تعلم"},{"t":"Der Name sagt mir etwas.","ar":"أتذكر هذا الاسم جيدًا."},{"t":"Ich spreche kein Deutsch.","ar":"لا أتكلم الألمانية."},{"t":"Warten Sie bis sechs Uhr!","ar":"أنتظر حتى الساعة السادسة!"},{"t":"Ich habe heute nicht frei.","ar":"أنا مشغول اليوم."},{"t":"Ich s