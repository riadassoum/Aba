de.","ar":"نحن نعيش على كوكب الأرض."},{"t":"Tom arbeitet in Boston.","ar":"توم يعمل في بوسطن."},{"t":"Tom arbeitet für Maria.","ar":"يعمل توم عند ماري."},{"t":"Darf ich mit ihm gehen?","ar":"هل بإمكاني مرافقته؟"},{"t":"Darf ich fragen, warum?","ar":"أيمكنني سؤالك عن السبب؟"},{"t":"Weißt du, was ich meine?","ar":"هل فهمت ما أقصده؟"},{"t":"Du weißt, was ich meine.","ar":"تعرف ما أعنيه."},{"t":"Es geht um Leben und Tod!","ar":"إنها مسالة حياة أو موت."},{"t":"Weißt du, wie spät es ist?","ar":"أتعرف كم الساعة؟"},{"t":"Weißt du, wo ich es finde?","ar":"هل تعرفان أين يمكن أن أجده؟"},{"t":"Du weißt nicht, wo er ist.","ar":"أنت لا تعلم أين هو."},{"t":"Ich weiß, wo Tom arbeitet.","ar":"أنا أعرف أين يعمل توم."}],"focus":["weißt","nächsten","Erde","arbeitet","Sache","besteht","Tod","niemals","möglich","darf"],"words":[{"word":"Erde","topic":"L47","difficulty":1,"meaning":"تُرْبَة","example":"Wir leben auf der Erde.","translation":"نحن نعيش على كوكب الأرض."},{"word":"Sache","topic":"L47","difficulty":1,"meaning":"قَضِيَّة"},{"word":"Tod","topic":"L47","difficulty":1,"meaning":"مَوْت","example":"Es geht um Leben und Tod!","translation":"إنها مسالة حياة أو موت."},{"word":"niemals","topic":"L47","difficulty":1,"meaning":"أَبَدًا","example":"Sag niemals „nie“!","translation":"لا اقو ابدا."},{"word":"möglich","topic":"L47","difficulty":1,"meaning":"مُمْكِن","example":"Das ist nicht möglich!","translation":"لا يمكن أن يحصل ذلك!"}],"difficulty":1}}