{"theory":{"blocks":[{"btype":"text","text":"الدرس 283. الكلمات الجديدة: hübscher، Leitung، berührte، ruiniert، Kaltes، gelandet، Ast، Inneren، such، kochte."},{"btype":"example","text":"hübscher = جَمِيل","note":"صيغة من hübsch (صيغة التفضيل)؛ مثال: Das ist hübscher. — هذا أجمل."},{"btype":"example","text":"Leitung = خَطّ","note":"مثال: Bleiben Sie bitte in der Leitung. — يرجى الأنتظار."},{"btype":"example","text":"berührte = لَمَسَ","note":"صيغة من berühren (الغائب، الماضي التامّ)؛ مثال: Ziri berührte Rima. — لمسَ زيري ريمة."},{"btype":"example","text":"ruiniert = دَمَّرَ","note":"صيغة من ruinieren (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"Kaltes = بَارِد","note":"صيغة من kalt (حالة المفعول به)؛ مثال: Er will etwas Kaltes. — يريد شيئا باردا."},{"btype":"example","text":"gelandet = هَبَطَ","note":"صيغة من landen (اسم المفعول (التصريف الثالث))؛ مثال: Das Flugzeug ist gelandet. — هبطت الطائرة."},{"btype":"example","text":"Ast = فَرْع","note":"مثال: Der Ast fällt gleich herunter. — سوف يسقط الغصن قريباً"},{"btype":"example","text":"Inneren = داخلى","note":"صيغة من inner (المذكّر، حالة الإضافة)"},{"btype":"example","text":"such = بَحَثَ، بَحَثَ عَنْ","note":"صيغة من suchen (الأمر)؛ مثال: Such mich nicht. — لا تبحث عني"},{"btype":"example","text":"kochte = طَبَخَ","note":"صيغة من kochen (الغائب، الماضي التامّ)؛ مثال: Ziri kochte. — كان زيري يطبخ."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ziri kochte.","note":"كان زيري يطبخ."},{"btype":"example","text":"Such mich nicht.","note":"لا تبحث عني"},{"btype":"example","text":"Das ist hübscher.","note":"هذا أجمل."},{"btype":"example","text":"Ziri berührte Rima.","note":"لمسَ زيري ريمة."},{"btype":"example","text":"Such dir einen Job.","note":"إبحث عن عمل"},{"btype":"example","text":"Er will etwas Kaltes.","note":"يريد شيئا باردا."},{"btype":"example","text":"Das Flugzeug ist gelandet.","note":"هبطت الطائرة."},{"btype":"example","text":"Such dir eine gute Arbeit.","note":"ابحث عن وظيفة جيّدة."},{"btype":"example","text":"Such es in deinem Wörterbuch.","note":"طالعها في قاموسك."},{"btype":"example","text":"Der Ast fällt gleich herunter.","note":"سوف يسقط الغصن قريباً"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"de","lang_name":"الألمانية","sentences":[{"t":"Ziri kochte.","ar":"كان زيري يطبخ."},{"t":"Such mich nicht.","ar":"لا تبحث عني"},{"t":"Das ist hübscher.","ar":"هذا أجمل."},{"t":"Ziri berührte Rima.","ar":"لمسَ زيري ريمة."},{"t":"Such dir einen Job.","ar":"إبحث عن عمل"},{"t":"Er will etwas Kaltes.","ar":"يريد شيئا باردا."},{"t":"Das Flugzeug ist gelandet.","ar":"هبطت الطائرة."},{"t":"Such dir eine gute Arbeit.","ar":"ابحث عن وظيفة جيّدة."},{"t":"Such es in deinem Wörterbuch.","ar":"طالعها في قاموسك."},{"t":"Der Ast fällt gleich herunter.","ar":"سوف يسقط الغصن قريباً"},{"t":"Sie wird hübscher und hübscher.","ar":"تزداد جمالاً يوماً بعد يوم."},{"t":"Bleiben Sie bitte in der Leitung.","ar":"يرجى الأنتظار."}],"focus":["hübscher","Leitung","berührte","ruiniert","Kaltes","gelandet","Ast","Inneren","such","kochte"],"words":[{"word":"Leitung","topic":"L283","difficulty":2,"meaning":"خَطّ","example":"Bleiben Sie bitte in der Leitung.","translation":"يرجى الأنتظار."},{"word":"Ast","t