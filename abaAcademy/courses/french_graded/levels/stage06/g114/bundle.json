.","ar":"الجوّ بارد جداً هذا الشتاء."},{"t":"S'il te plaît, ne pleure pas.","ar":"من فضلك لا تبكِ."},{"t":"Pourquoi le bébé pleure-t-il ?","ar":"لماذا يصرخ الصبي؟"},{"t":"Salut, John ! Comment vas-tu ?","ar":"مرحباً جون ، كيف حالك؟"},{"t":"As-tu acheté les médicaments ?","ar":"هل إشتريت الدواء؟"},{"t":"Ziri a acheté des médicaments.","ar":"اشترى زيري دواءا."},{"t":"Je dois prendre des médicaments.","ar":"عليّ أن آخذ الدواء."},{"t":"Il n'y a nulle part où se cacher.","ar":"ليس هناك مكان للاختباء."},{"t":"Je lui achèterai des médicaments.","ar":"سأشتري له دواءا."},{"t":"J'attrape toujours froid en hiver.","ar":"أصاب بالبرد دائمًا في الشتاء."},{"t":"Ouvre les fenêtres, s'il te plaît.","ar":"افتح النوافذ، من فضلك."},{"t":"Nous pouvons nous cacher là-dedans.","ar":"يمكننا الاختباء هنا."},{"t":"Je dois y aller maintenant. Salut !","ar":"أنا يجب أن أذهب الآن. وداعا!"}],"focus":["hiver","pleure","cacher","fenêtres","jus","Salut","médicaments","remercier","gueule","cinquante"],"words":[{"word":"hiver","topic":"L114","difficulty":1,"meaning":"شِتَاء","example":"Il fait très froid cet hiver.","translation":"الجوّ بارد جداً هذا الشتاء."},{"word":"cacher","topic":"L114","difficulty":1,"meaning":"أَخْفَى","example":"Je dois me cacher.","translation":"عليّ الاختباء."},{"word":"jus","topic":"L114","difficulty":1,"meaning":"عَصِير","example":"Ziri a bu du jus.","translation":"شرب زيري عصيرا."},{"word":"Salut","topic":"L114","difficulty":1,"meaning":"مَرْحَبًا","example":"Salut, Tom.","translation":"مرحبا يا توم."},{"word":"médicaments","topic":"L114","difficulty":1,"meaning":"عِلَاج","example":"Yanni prend ses médicaments.","translation":"ياني يأخذ دواءه."},{"word":"remercier","topic":"L114","difficulty":1,"meaning":"شَكَرَ","example":"Tu devrais le remercier.","translation":"يتوجب عليك أن تشكره."},{"word":"gueule","topic":"L114","difficulty":1,"meaning":"فَم","example":"Tom s'est cassé la gueule.","translation":"سقط توم على وجهه."},{"word":"cinquante","topic":"L114","difficulty":1,