{"theory":{"blocks":[{"btype":"text","text":"الدرس 453. الكلمات الجديدة: hésite، géants، dissertation، ensoleillé، bravoure، bars، visitent، comprendra، ascenseur، calculatrice."},{"btype":"example","text":"hésite = تَرَدَّدَ","note":"صيغة من hésiter (الغائب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Qui hésite, perd. — من يتردد يخسر"},{"btype":"example","text":"géants = عِمْلَاق","note":"صيغة من géant (الجمع)"},{"btype":"example","text":"dissertation = مَقَالَة","note":"مثال: J'avais besoin de travailler sur une dissertation. — كان علي أن أكتب إنشاءا."},{"btype":"example","text":"ensoleillé = مُشْمِس","note":"مثال: Le temps est ensoleillé. — الطقس مشمس."},{"btype":"example","text":"bravoure = شَجَاعَة","note":""},{"btype":"example","text":"bars = حَانَة، بَار","note":"صيغة من bar (الجمع)؛ مثال: Sami ne va jamais dans les bars. — ًلا يرتد سامي الحانات أبدا"},{"btype":"example","text":"visitent = زَارَ","note":"صيغة من visiter (الجمع، الغائب، صيغة الالتماس (الشرطية))؛ مثال: Beaucoup de touristes visitent Kyoto. — كيوتو يزورها الكثير من السياح ."},{"btype":"example","text":"comprendra = فَهِمَ","note":"صيغة من comprendre (الغائب، المستقبل)؛ مثال: Ziri comprendra. — سيتفهّم زيري الأمر."},{"btype":"example","text":"ascenseur = مِصْعَد","note":"مثال: Y a-t-il un ascenseur ? — هل هناك مصعد؟"},{"btype":"example","text":"calculatrice = حَاسِبَة","note":"مثال: J'ai acheté une nouvelle calculatrice. — اشتريت حاسبة جديدة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ziri comprendra.","note":"سيتفهّم زيري الأمر."},{"btype":"example","text":"Qui hésite, perd.","note":"من يتردد يخسر"},{"btype":"example","text":"Y a-t-il un ascenseur ?","note":"هل هناك مصعد؟"},{"btype":"example","text":"Le temps est ensoleillé.","note":"الطقس مشمس."},{"btype":"example","text":"C'est ensoleillé aujourd'hui.","note":"الجو مشمس اليوم."},{"btype":"example","text":"Ziri ne comprendra jamais ça.","note":"لن يفهم زيري هذا أبدا."},{"btype":"example","text":"Sami ne va jamais dans les bars.","note":"ًلا يرتد سامي الحانات أبدا"},{"btype":"example","text":"Beaucoup de touristes visitent Kyoto.","note":"كيوتو يزورها الكثير من السياح ."},{"btype":"example","text":"J'ai acheté une nouvelle calculatrice.","note":"اشتريت حاسبة جديدة."},{"btype":"example","text":"J'avais besoin de travailler sur une dissertation.","note":"كان علي أن أكتب إنشاءا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Ziri comprendra.","ar":"سيتفهّم زيري الأمر."},{"t":"Qui hésite, perd.","ar":"من يتردد يخسر"},{"t":"Y a-t-il un ascenseur ?","ar":"هل هناك مصعد؟"},{"t":"Le temps est ensoleillé.","ar":"الطقس مشمس."},{"t":"C'est ensoleillé aujourd'hui.","ar":"الجو مشمس اليوم."},{"t":"Ziri ne comprendra jamais ça.","ar":"لن يفهم زيري هذا أبدا."},{"t":"Sami ne va jamais dans les bars.","ar":"ًلا يرتد سامي الحانات أبدا"},{"t":"Beaucoup de touristes visitent Kyoto.","ar":"كيوتو يزورها الكثير من السياح ."},{"t":"J'ai acheté une nouvelle calculatrice.