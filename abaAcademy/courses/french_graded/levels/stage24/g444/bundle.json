{"theory":{"blocks":[{"btype":"text","text":"الدرس 444. الكلمات الجديدة: nettoyez، préparait، conduirai، bénisse، marchera، chanta، lèves، fréquenté، haïr، soupçons."},{"btype":"example","text":"nettoyez = نَظَّفَ","note":"صيغة من nettoyer (الجمع، المخاطب، المضارع)؛ مثال: Nettoyez le miroir. — نظّفوا المرآة."},{"btype":"example","text":"préparait = جَهَّزَ","note":"صيغة من préparer (الغائب، الماضي المستمرّ)؛ مثال: Elle préparait le petit déjeuner. — أعدت فطور الصباح."},{"btype":"example","text":"conduirai = قَادَ، سَاقَ","note":"صيغة من conduire (المتكلّم، المستقبل)؛ مثال: Je te conduirai chez toi. — سأوصلك إلى المنزل بالسيارة."},{"btype":"example","text":"bénisse = بَارَكَ","note":"صيغة من bénir (الغائب، صيغة الالتماس (الشرطية)، المضارع)"},{"btype":"example","text":"marchera = سَارَ","note":"صيغة من marcher (الغائب، المستقبل)؛ مثال: Ça ne marchera pas. — لن ينجح هذا."},{"btype":"example","text":"chanta = غَنَّى","note":"صيغة من chanter (الغائب، الماضي)؛ مثال: Elle chanta mieux que lui. — غنَّتْ أفضل منه."},{"btype":"example","text":"lèves = رَفَعَ","note":"صيغة من lever (المخاطب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: À quelle heure te lèves-tu ? — متى تستيقظ؟"},{"btype":"example","text":"fréquenté = اِرْتَادَ","note":"صيغة من fréquenter (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"haïr = كَرِهَ","note":""},{"btype":"example","text":"soupçons = اِتِّهَام","note":"صيغة من soupçon (الجمع)؛ مثال: Son silence a confirmé ses soupçons. — أكد صمته شكوكها"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Nettoyez le miroir.","note":"نظّفوا المرآة."},{"btype":"example","text":"Ça ne marchera pas.","note":"لن ينجح هذا."},{"btype":"example","text":"Ça ne marchera pas !","note":"لن يصلح ذلك!"},{"btype":"example","text":"Nettoyez votre chambre.","note":"نظف غرفتك."},{"btype":"example","text":"Je te conduirai chez toi.","note":"سأوصلك إلى المنزل بالسيارة."},{"btype":"example","text":"Elle chanta mieux que lui.","note":"غنَّتْ أفضل منه."},{"btype":"example","text":"À quelle heure te lèves-tu ?","note":"متى تستيقظ؟"},{"btype":"example","text":"Je te conduirai à l'aéroport.","note":"سأوصلك إلى المطار."},{"btype":"example","text":"Ta magie ne marchera pas ici.","note":"لن ينفع سحرك هنا."},{"btype":"example","text":"Elle préparait le petit déjeuner.","note":"أعدت فطور الصباح."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Nettoyez le miroir.","ar":"نظّفوا المرآة."},{"t":"Ça ne marchera pas.","ar":"لن ينجح هذا."},{"t":"Ça ne marchera pas !","ar":"لن يصلح ذلك!"},{"t":"Nettoyez votre chambre.","ar":"نظف غرفتك."},{"t":"Je te conduirai chez toi.","ar":"سأوصلك إلى المنزل بالسيارة."},{"t":"Elle chanta mieux que lui.","ar":"غنَّتْ أفضل منه."},{"t":"À quelle heure te lèves-tu ?","ar":"متى تستيقظ؟"},{"t":"Je te conduirai à l'aéroport.","ar":"سأوصلك إلى المطار."},{"t":"Ta magie ne marchera pas ici.","ar":"لن ينفع سحرك هنا."},{"t":"Elle préparait le petit déjeuner.","ar":"أعدت فطور الصباح."},{"t":"Son silence a confirmé ses soupçons.","ar":"أكد صمته شكوكها"},{"t":"À quelle heure te lèves-tu chaque jour ?","ar":"متى تستيقظ كل يوم؟"},{"t":"Tu ne te lèves pas aussi tôt que ta sœur, n'est-ce pas ?","ar":"انت لا ت