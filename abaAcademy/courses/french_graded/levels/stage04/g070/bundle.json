يد أن أعلم."},{"t":"Tom a cassé la fenêtre.","ar":"كسر توم زجاج النافذة."},{"t":"Il est allé à la plage.","ar":"ذهب إلى الشاطئ."},{"t":"Elle est allée à la plage.","ar":"ذهبت إلى الشاطئ."},{"t":"Ils avaient vraiment froid.","ar":"كانوا باردين للغاية."},{"t":"Ils avaient besoin d'argent.","ar":"هم بحاجة للمال."},{"t":"Je ne sais pas où il habite.","ar":"لا أعلم أين يسكن."},{"t":"J'aimerais connaître son nom.","ar":"أود أن أعرف اسمها."},{"t":"Je voudrais connaître son nom.","ar":"أود أن أعرف اسمها."},{"t":"Je vais encore essayer, merci.","ar":"سأحاول مرة أخرى، شكراً لك."},{"t":"Ce soir, nous faisons la fête.","ar":"نحن نحتفل الليلة."},{"t":"Tu es le grand amour de ma vie.","ar":"أنت حب حياتي."},{"t":"Ils avaient l'air très heureux.","ar":"كانا يبدوان سعيدين جدا."},{"t":"Cette histoire est très longue.","ar":"هذه القصة طويلة جداً"}],"focus":["connaître","cassé","essayer","faisons","bout","amour","avaient","plage","longue","habite"],"words":[{"word":"connaître","topic":"L70","difficulty":1,"meaning":"عَرَفَ، دَرَى","example":"Je veux vous connaître.","translation":"أريد أن أعلم."},{"word":"essayer","topic":"L70","difficulty":1,"meaning":"حَاوَلَ","example":"Je veux essayer ça.","translation":"أريد أن أجرب ذلك."},{"word":"bout","topic":"L70","difficulty":1,"meaning":"رَأْس"},{"word":"amour","topic":"L70","difficulty":1,"meaning":"حُبّ، حَبِيب","example":"Amour et Paix.","translation":"الحب و السلام."},{"word":"plage","topic":"L70","difficulty":1,"meaning":"شَاطِئ","example":"Allons à la plage.","translation":"لنذهب إلى الشاطئ."}],"difficulty":1}}