{"theory":{"blocks":[{"btype":"text","text":"الدرس 228. الكلمات الجديدة: sauce، serveur، puissance، défaut، mail، cherchais، mignonne، entra، saurait، apprenez."},{"btype":"example","text":"sauce = صَلْصَة","note":""},{"btype":"example","text":"serveur = نَادِل","note":"مثال: Je travaille comme serveur depuis trois ans. — عملت نادلًا لثلاث سنوات."},{"btype":"example","text":"puissance = قُدْرَة، قُوَّة","note":""},{"btype":"example","text":"défaut = خَلَل","note":""},{"btype":"example","text":"mail = مَرْكَز تَسَوِّق","note":""},{"btype":"example","text":"cherchais = بَحَثَ، بَحَثَ عَنْ","note":"صيغة من chercher (المخاطب، الماضي المستمرّ)؛ مثال: Tu es l'homme que je cherchais. — أنت الرجل الذي كنت أبحث عنه."},{"btype":"example","text":"mignonne = فَاتِن","note":"صيغة من mignon (المؤنث)؛ مثال: Elle est très mignonne. — إنها جميلة جداً."},{"btype":"example","text":"entra = دَخَلَ","note":"صيغة من entrer (الغائب، الماضي)؛ مثال: Il entra dans la mosquée. — دخل إلى المسجد."},{"btype":"example","text":"saurait = عَلِمَ، دَرَى","note":"صيغة من savoir (الغائب، الشرطي)؛ مثال: Que saurait-il ? — ماذا سيعرف؟"},{"btype":"example","text":"apprenez = تَعَلَّمَ، اِعْتَبَرَ","note":"صيغة من apprendre (الجمع، المخاطب، المضارع)؛ مثال: Apprenez votre langue. — تعلم لغتك."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Que saurait-il ?","note":"ماذا سيعرف؟"},{"btype":"example","text":"Apprenez votre langue.","note":"تعلم لغتك."},{"btype":"example","text":"Elle est très mignonne.","note":"إنها جميلة جداً."},{"btype":"example","text":"Il entra dans la mosquée.","note":"دخل إلى المسجد."},{"btype":"example","text":"Apprenez ces noms par cœur.","note":"احفظ هذه الأسماء عن ظهر قلب."},{"btype":"example","text":"Tu es l'homme que je cherchais.","note":"أنت الرجل الذي كنت أبحث عنه."},{"btype":"example","text":"Quelles langues apprenez-vous ?","note":"ما اللغات التي تتعلمها؟"},{"btype":"example","text":"Je pensais qu'elle était mignonne.","note":"رأيي أنها جميلة."},{"btype":"example","text":"C'est celui-ci le livre que je cherchais.","note":"هذا هو الكتاب الذي كنت أبحث عنه"},{"btype":"example","text":"Je travaille comme serveur depuis trois ans.","note":"عملت نادلًا لثلاث سنوات."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Que saurait-il ?","ar":"ماذا سيعرف؟"},{"t":"Apprenez votre langue.","ar":"تعلم لغتك."},{"t":"Elle est très mignonne.","ar":"إنها جميلة جداً."},{"t":"Il entra dans la mosquée.","ar":"دخل إلى المسجد."},{"t":"Apprenez ces noms par cœur.","ar":"احفظ هذه الأسماء عن ظهر قلب."},{"t":"Tu es l'homme que je cherchais.","ar":"أنت الرجل الذي كنت أبحث عنه."},{"t":"Quelles langues apprenez-vous ?","ar":"ما اللغات التي تتعلمها؟"},{"t":"Je pensais qu'elle était mignonne.","ar":"رأيي أنها جميلة."},{"t":"C'est celui-ci le livre que je cherchais.","ar":"هذا هو الكتاب الذي كنت أبحث عنه"},{"t":"Je travaille comme serveur depuis trois ans.","ar":"عملت نادلًا لثلاث سنوات."},{"t":"Comment apprenez-vo