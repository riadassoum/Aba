{"theory":{"blocks":[{"btype":"text","text":"الدرس 682. الكلمات الجديدة: sortiez، avertit، sourirent، enrhumée، prédictions، supprimez، défenseurs، suspense، parlementaire، zeus."},{"btype":"example","text":"sortiez","note":"مثال: Je veux que vous sortiez de la ville. — أريد أن تخرج من المدينة."},{"btype":"example","text":"avertit","note":"مثال: Elle avertit les enfants de ne pas jouer dans la rue. — لقد حذّرت الأولاد من اللعب على الطريق."},{"btype":"example","text":"sourirent","note":"مثال: Ils se sourirent les uns aux autres. — ابتسموا لبعضهم."},{"btype":"example","text":"enrhumée","note":""},{"btype":"example","text":"prédictions","note":"مثال: Ses prédictions se sont réalisées. — لقد تحققت تنبّؤاته."},{"btype":"example","text":"supprimez","note":"مثال: Supprimez ce fichier, s'il vous plaît ! — من فضلك إلغِ هذا الملفّ."},{"btype":"example","text":"défenseurs","note":"مثال: Ils sont les défenseurs de la ville. — هم المدافعون عن المدينة."},{"btype":"example","text":"suspense = تَشْوِيق","note":"مثال: Le suspense me tue ! — التشويق يقتلني!"},{"btype":"example","text":"parlementaire = بَرْلَمَانِيّ","note":"مثال: L'Allemagne est une république parlementaire. — ألمانيا جمهورية برلمانية."},{"btype":"example","text":"zeus = زَفْس","note":"مثال: Zeus est en colère. — زيوس غاضب."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Zeus est en colère.","note":"زيوس غاضب."},{"btype":"example","text":"Le suspense me tue !","note":"التشويق يقتلني!"},{"btype":"example","text":"Ses prédictions se sont réalisées.","note":"لقد تحققت تنبّؤاته."},{"btype":"example","text":"Ils se sourirent les uns aux autres.","note":"ابتسموا لبعضهم."},{"btype":"example","text":"Ils sont les défenseurs de la ville.","note":"هم المدافعون عن المدينة."},{"btype":"example","text":"Je veux que vous sortiez de la ville.","note":"أريد أن تخرج من المدينة."},{"btype":"example","text":"Supprimez ce fichier, s'il vous plaît !","note":"من فضلك إلغِ هذا الملفّ."},{"btype":"example","text":"Supprimez le commentaire, s'il vous plait.","note":"إحذف التعليقَ من فَضلك."},{"btype":"example","text":"L'Allemagne est une république parlementaire.","note":"ألمانيا جمهورية برلمانية."},{"btype":"example","text":"J'espère que les prédictions de Tom sont fausses.","note":"آمل أن تخطئ توقعات توم."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Zeus est en colère.","ar":"زيوس غاضب."},{"t":"Le suspense me tue !","ar":"التشويق يقتلني!"},{"t":"Ses prédictions se sont réalisées.","ar":"لقد تحققت تنبّؤاته."},{"t":"Ils se sourirent les uns aux autres.","ar":"ابتسموا لبعضهم."},{"t":"Ils sont les défenseurs de la ville.","ar":"هم المدافعون عن المدينة."},{"t":"Je veux que vous sortiez de la ville.","ar":"أريد أن تخرج من المدينة."},{"t":"Supprimez ce fichier, s'il vous plaît !","ar":"من فضلك إلغِ هذا الملفّ."},{"t":"Supprimez le commentaire, s'il vous plait.","ar":"إحذف التعليقَ من فَضلك."},{"t":"L'Allemagne est une république parlementaire.","