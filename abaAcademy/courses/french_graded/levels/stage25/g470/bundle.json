 maintenant ?","ar":"هل أنتَ بخير الآن؟"},{"t":"Je ne peux pas lire ceci.","ar":"أنا لا أستطيع أن أقرأ هذا."},{"t":"Pourquoi es-tu venu ici ?","ar":"من أجل ماذا أتيتَ إلى هنا؟"}],"focus":["loyauté","directions","immobiles","thon","écrivons","gaiement","préférons","supplié","ballons","priait"],"words":[{"word":"loyauté","topic":"L470","difficulty":3,"meaning":"وَفَاء","example":"J'apprécie sa loyauté.","translation":"أقدّر ولائها."},{"word":"thon","topic":"L470","difficulty":3,"meaning":"تُونَة","example":"Les Japonais aiment manger du thon.","translation":"يحبّ اليابانيّون أكل التونا."},{"word":"gaiement","topic":"L470","difficulty":3,"meaning":"بِسَعَادَة","example":"Elle le salua gaiement, comme à son habitude.","translation":"لقد حياها بسرور كما عادته."}],"difficulty":3}}