{"theory":{"blocks":[{"btype":"text","text":"الدرس 56. الكلمات الجديدة: aimé، regardé، l'as، vingt، devriez، arriver، présent، l'année، serai، bras."},{"btype":"example","text":"aimé = حَبَّ","note":"صيغة من aimer (اسم المفعول (التصريف الثالث))؛ مثال: Vous avez aimé ? — هل أحببتها؟"},{"btype":"example","text":"regardé = نَظَرَ","note":"صيغة من regarder (اسم المفعول (التصريف الثالث))؛ مثال: Sami a regardé. — كان سامي يشاهد."},{"btype":"example","text":"l'as","note":"مثال: J'ai l'as de cœur. — انا املك الآس قلوب."},{"btype":"example","text":"vingt = عِشْرُونَ","note":"مثال: Elle a vingt ans. — هي في العشرين من العمر."},{"btype":"example","text":"devriez = وَجَبَ، لَابُدَّ","note":"صيغة من devoir (الجمع، المخاطب، الشرطي)؛ مثال: Vous ne devriez pas y aller. — عليك ألا تذهب إلى هناك."},{"btype":"example","text":"arriver = قَدِمَ","note":"مثال: Le bus devrait bientôt arriver. — سوف يأتي الباس عن قريب."},{"btype":"example","text":"présent = الزَّمَان","note":"مثال: Personne n'était présent. — لم يكن هناك أحد."},{"btype":"example","text":"l'année","note":""},{"btype":"example","text":"serai = كَانَ، كَانَ هُوَ","note":"صيغة من être (المتكلّم، المستقبل)؛ مثال: Je serai occupé, demain. — سأكون مشغولا غدا."},{"btype":"example","text":"bras = ذِرَاع","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sami a regardé.","note":"كان سامي يشاهد."},{"btype":"example","text":"Vous avez aimé ?","note":"هل أحببتها؟"},{"btype":"example","text":"Je n'ai pas aimé.","note":"لم أحبه."},{"btype":"example","text":"Il a aimé Boston.","note":"كان يحب بوسطن."},{"btype":"example","text":"Elle a vingt ans.","note":"هي في العشرين من العمر."},{"btype":"example","text":"J'ai l'as de cœur.","note":"انا املك الآس قلوب."},{"btype":"example","text":"Si, tu l'as fait !","note":"نعم، فعلت."},{"btype":"example","text":"Il a aimé ma chambre.","note":"أعجبته غرفتي."},{"btype":"example","text":"Elles ont aimé Marie.","note":"كانوا بحبون ماري."},{"btype":"example","text":"Je t'ai toujours aimé.","note":"لطالما أحببتك."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Sami a regardé.","ar":"كان سامي يشاهد."},{"t":"Vous avez aimé ?","ar":"هل أحببتها؟"},{"t":"Je n'ai pas aimé.","ar":"لم أحبه."},{"t":"Il a aimé Boston.","ar":"كان يحب بوسطن."},{"t":"Elle a vingt ans.","ar":"هي في العشرين من العمر."},{"t":"J'ai l'as de cœur.","ar":"انا املك الآس قلوب."},{"t":"Si, tu l'as fait !","ar":"نعم، فعلت."},{"t":"Il a aimé ma chambre.","ar":"أعجبته غرفتي."},{"t":"Elles ont aimé Marie.","ar":"كانوا بحبون ماري."},{"t":"Je t'ai toujours aimé.","ar":"لطالما أحببتك."},{"t":"Il n'a pas aimé ce jeu.","ar":"لم تعجبه هذه اللعبة."},{"t":"Je suis aimé de ma mère.","ar":"أمي تحبني."},{"t":"Tout le monde a regardé.","ar":"شاهد الجميع."},{"t":"Tu me l'as dit toi-même.","ar":"أخبرتني ذلك بنفسك."},{"t":"Je serai occupé, demain.","ar":"سأكون مشغولا غدا."},{"t":"Personne n'était présent.","ar":"لم يكن هناك أحد."},{"t":"Je serai là tout le mois.