{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futur): acheter (اِشْتَرَى)، donner (أَعْطَى)، rester (مَكَثَ)، perdre (خَسِرَ، فَقَدَ)، demander (سَأَلَ)، rendre (جَعَلَ)، mettre (شَغَّلَ)، laisser (سَمَحَ)، entendre (سَمِعَ، سَمِع)، lire (قَرَأَ)."},{"btype":"example","text":"acheter","note":"je achèterai، tu achèteras، il/elle achètera، nous achèterons، vous achèterez، ils/elles achèteront"},{"btype":"example","text":"donner","note":"je donnerai، tu donneras، il/elle donnera، nous donnerons، vous donnerez، ils/elles donneront"},{"btype":"example","text":"rester","note":"je resterai، tu resteras، il/elle restera، nous resterons، vous resterez، ils/elles resteront"},{"btype":"example","text":"perdre","note":"je perdrai، tu perdras، il/elle perdra، nous perdrons، vous perdrez، ils/elles perdront"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"acheter","meaning":"اِشْتَرَى","tense":"المستقبل (futur)","forms":{"je":"achèterai","tu":"achèteras","il/elle":"achètera","nous":"achèterons","vous":"achèterez","ils/elles":"achèteront"},"difficulty":2},{"infinitive":"donner","meaning":"أَعْطَى","tense":"المستقبل (futur)","forms":{"je":"donnerai","tu":"donneras","il/elle":"donnera","nous":"donnerons","vous":"donnerez","ils/elles":"donneront"},"difficulty":2},{"infinitive":"rester","meaning":"مَكَثَ","tense":"المستقبل (futur)","forms":{"je":"resterai","tu":"resteras","il/elle":"restera","nous":"resterons","vous":"resterez","ils/elles":"resteront"},"difficulty":2},{"infinitive":"perdre","meaning":"خَسِرَ، فَقَدَ","tense":"المستقبل (futur)","forms":{"je":"perdrai","tu":"perdras","il/elle":"perdra","nous":"perdrons","vous":"perdrez","ils/elles":"perdront"}