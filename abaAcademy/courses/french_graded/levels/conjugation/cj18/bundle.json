{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futur): arriver (قَدِمَ)، jouer (مَثَّلَ، لَعِبَ)، connaître (عَرَفَ، دَرَى)، écrire (َأَلَّف، كَتَبَ)، vivre (حَيِيَ)، compter (عَدَّ)، regarder (نَظَرَ)، téléphoner (تَلْفَنَ)، travailler (عَمِلَ)، comprendre (فَهِمَ)."},{"btype":"example","text":"arriver","note":"je arriverai، tu arriveras، il/elle arrivera، nous arriverons، vous arriverez، ils/elles arriveront"},{"btype":"example","text":"jouer","note":"je jouerai، tu joueras، il/elle jouera، nous jouerons، vous jouerez، ils/elles joueront"},{"btype":"example","text":"connaître","note":"je connaîtrai، tu connaîtras، il/elle connaîtra، nous connaîtrons، vous connaîtrez، ils/elles connaîtront"},{"btype":"example","text":"écrire","note":"je écrirai، tu écriras، il/elle écrira، nous écrirons، vous écrirez، ils/elles écriront"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"arriver","meaning":"قَدِمَ","tense":"المستقبل (futur)","forms":{"je":"arriverai","tu":"arriveras","il/elle":"arrivera","nous":"arriverons","vous":"arriverez","ils/elles":"arriveront"},"difficulty":2},{"infinitive":"jouer","meaning":"مَثَّلَ، لَعِبَ","tense":"المستقبل (futur)","forms":{"je":"jouerai","tu":"joueras","il/elle":"jouera","nous":"jouerons","vous":"jouerez","ils/elles":"joueront"},"difficulty":2},{"infinitive":"connaître","meaning":"عَرَفَ، دَرَى","tense":"المستقبل (futur)","forms":{"je":"connaîtrai","tu":"connaîtras","il/elle":"connaîtra","nous":"connaîtrons","vous":"connaîtrez","ils/elles":"connaîtront"},"difficulty":2},{"infinitive":"écrire","meaning":"َأَلَّف، كَتَبَ","tense":"المستقبل (futur)","forms":{"je":"écrirai","tu":"écriras","il/elle":"écrira","nous":"écrirons","vous":"écrirez","ils/elles":"écriront"},"difficulty":2},{"infinitive":"vivre","meaning":"حَيِيَ","tense":"المستقبل (futur)","forms":{"je":"vivrai","tu":"vivras","il/elle":"vivra","nous":"vivrons","vous":"vivrez","ils/elles":"vivront"},"difficulty":2},{"infinitive":"compter","meaning":"عَدَّ","tense":"المستقبل (futur)","forms":{"je":"compterai","tu":"compteras","il/elle":"comptera","nous":"compterons","vous":"compterez","ils/elles":"compteront"},"difficulty":2},{"infinitive":"regarder","meaning":"نَظَرَ","tense":"المستقبل (futur)","forms":{"je":"regarderai","tu":"regarderas","il/elle":"regardera","nous":"regarderons","vous":"regarderez","ils/elles":"regarderont"},"difficulty":2},{"infinitive":"téléphoner","meaning":"تَلْفَنَ","tense":"المستقبل (futur)","forms":{"je":"téléphonerai","tu":"téléphoneras","il/elle":"téléphonera","nous":"téléphonerons","vous":"téléphonerez","ils/elles":"téléphoneront"},"difficulty":2},{"infinitive":"travailler","meaning":"عَمِلَ","tense":"المستقبل (futur)","forms":{"je":"travaillerai","tu":"travailleras","il/elle":"travaillera","nous":"travaillerons","vous":"travaillerez","ils/elles":"travailleront"},"difficulty":2},{"infinitive":"comprendre","meaning":"فَهِمَ","tense":"المستقبل (futur)","forms":{"je":"comprendrai","tu":"comprendras","il/elle":"comprendra","nous":"comprendrons","vous":"comprendrez","ils/elles":"comprendront"},"difficulty":2}]}}