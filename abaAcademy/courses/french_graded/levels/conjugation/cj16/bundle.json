{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futur): hier (أَمْس)، manger (طَعَام)، soir (مَغْرِب)، mourir (مَاتَ)، entrer (دَخَلَ)، aimer (حَبَّ)، sentir (شَعَرَ)، croire (صَدَّقَ، ظَنَّ)، trouver (وَجَدَ)، venir (جَاءَ)."},{"btype":"example","text":"hier","note":"je hierai، tu hieras، il/elle hiera، nous hierons، vous hierez، ils/elles hieront"},{"btype":"example","text":"manger","note":"je mangerai، tu mangeras، il/elle mangera، nous mangerons، vous mangerez، ils/elles mangeront"},{"btype":"example","text":"soir","note":"je siérai، tu siéras، il/elle siéra، nous siérons، vous siérez، ils/elles siéront"},{"btype":"example","text":"mourir","note":"je mourrai، tu mourras، il/elle mourra، nous mourrons، vous mourrez، ils/elles mourront"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"hier","meaning":"أَمْس","tense":"المستقبل (futur)","forms":{"je":"hierai","tu":"hieras","il/elle":"hiera","nous":"hierons","vous":"hierez","ils/elles":"hieront"},"difficulty":2},{"infinitive":"manger","meaning":"طَعَام","tense":"المستقبل (futur)","forms":{"je":"mangerai","tu":"mangeras","il/elle":"mangera","nous":"mangerons","vous":"mangerez","ils/elles":"mangeront"},"difficulty":2},{"infinitive":"soir","meaning":"مَغْرِب","tense":"المستقبل (futur)","forms":{"je":"siérai","tu":"siéras","il/elle":"siéra","nous":"siérons","vous":"siérez","ils/elles":"siéront"},"difficulty":2},{"infinitive":"mourir","meaning":"مَاتَ","tense":"المستقبل (futur)","forms":{"je":"mourrai","tu":"mourras","il/elle":"mourra","nous":"mourrons","vous":"mourrez","ils/elles":"mourront"},"difficulty":2},{"infinitive":"entrer","meaning":"دَخَلَ","tense":"المستقبل (futur)","forms":{"je":"entrer