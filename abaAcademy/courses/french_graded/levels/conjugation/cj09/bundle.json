{"theory":{"blocks":[{"btype":"text","text":"الماضي الناقص (imparfait): descendre (نَزَلَ)، sortir (خَرَجَ)، retourner (قَلَبَ)، paraître (بَدَا)، disparaître (اِخْتَفَى)، repasser (كَوَى)، devoir (وَجَبَ، لَابُدَّ)، maintenir (أَبْقَى)، porter (لَبِسَ)، prendre (تَنَاوَلَ)."},{"btype":"example","text":"descendre","note":"je descendais، tu descendais، il/elle descendait، nous descendions، vous descendiez، ils/elles descendaient"},{"btype":"example","text":"sortir","note":"je sortais، tu sortais، il/elle sortait، nous sortions، vous sortiez، ils/elles sortaient"},{"btype":"example","text":"retourner","note":"je retournais، tu retournais، il/elle retournait، nous retournions، vous retourniez، ils/elles retournaient"},{"btype":"example","text":"paraître","note":"je paraissais، tu paraissais، il/elle paraissait، nous paraissions، vous paraissiez، ils/elles paraissaient"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"descendre","meaning":"نَزَلَ","tense":"الماضي الناقص (imparfait)","forms":{"je":"descendais","tu":"descendais","il/elle":"descendait","nous":"descendions","vous":"descendiez","ils/elles":"descendaient"},"difficulty":2},{"infinitive":"sortir","meaning":"خَرَجَ","tense":"الماضي الناقص (imparfait)","forms":{"je":"sortais","tu":"sortais","il/elle":"sortait","nous":"sortions","vous":"sortiez","ils/elles":"sortaient"},"difficulty":2},{"infinitive":"retourner","meaning":"قَلَبَ","tense":"الماضي الناقص (imparfait)","forms":{"je":"retournais","tu":"retournais","il/elle":"retournait","nous":"retournions","vous":"retourniez","ils/elles":"retournaient"},"difficulty":2},{"infinitive":"paraître","meaning":"بَدَا","tense":"الماضي الناقص (imparfait)","for