{"theory":{"blocks":[{"btype":"text","text":"المضارع (présent): aller (ذَهَبَ)، savoir (عَلِمَ، دَرَى)، penser (ظَنَّ)، falloir (يَضْطَر)، voir (يرى)، parler (يتكلّم)، passer (قَضَى)، partir (تَرَكَ)، tomber (وَقَعَ)، monter (بَلَغَ)."},{"btype":"example","text":"aller","note":"je vais، tu vas، il/elle va، nous allons، vous allez، ils/elles vont"},{"btype":"example","text":"savoir","note":"je sais، tu sais، il/elle sait، nous savons، vous savez، ils/elles savent"},{"btype":"example","text":"penser","note":"je pense، tu penses، il/elle pense، nous pensons، vous pensez، ils/elles pensent"},{"btype":"example","text":"falloir","note":"je -، tu -، il/elle faut، nous -، vous -، ils/elles -"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"aller","meaning":"ذَهَبَ","tense":"المضارع (présent)","forms":{"je":"vais","tu":"vas","il/elle":"va","nous":"allons","vous":"allez","ils/elles":"vont"},"difficulty":2},{"infinitive":"savoir","meaning":"عَلِمَ، دَرَى","tense":"المضارع (présent)","forms":{"je":"sais","tu":"sais","il/elle":"sait","nous":"savons","vous":"savez","ils/elles":"savent"},"difficulty":2},{"infinitive":"penser","meaning":"ظَنَّ","tense":"المضارع (présent)","forms":{"je":"pense","tu":"penses","il/elle":"pense","nous":"pensons","vous":"pensez","ils/elles":"pensent"},"difficulty":2},{"infinitive":"falloir","meaning":"يَضْطَر","tense":"المضارع (présent)","forms":{"je":"-","tu":"-","il/elle":"faut","nous":"-","vous":"-","ils/elles":"-"},"difficulty":2},{"infinitive":"voir","meaning":"يرى","tense":"المضارع (présent)","forms":{"je":"vois","tu":"vois","il/elle":"voit","nous":"voyons","vous":"voyez","ils/elles":"voient"},"difficulty":2},{"infinitive":"parle