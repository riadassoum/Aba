{"theory":{"blocks":[{"btype":"text","text":"صيغة الالتماس (subjonctif): acheter (اِشْتَرَى)، donner (أَعْطَى)، rester (مَكَثَ)، perdre (خَسِرَ، فَقَدَ)، demander (سَأَلَ)، rendre (جَعَلَ)، mettre (شَغَّلَ)، laisser (سَمَحَ)، entendre (سَمِعَ، سَمِع)، lire (قَرَأَ)."},{"btype":"example","text":"acheter","note":"je achète، tu achètes، il/elle achète، nous achetions، vous achetiez، ils/elles achètent"},{"btype":"example","text":"donner","note":"je donne، tu donnes، il/elle donne، nous donnions، vous donniez، ils/elles donnent"},{"btype":"example","text":"rester","note":"je reste، tu restes، il/elle reste، nous restions، vous restiez، ils/elles restent"},{"btype":"example","text":"perdre","note":"je perde، tu perdes، il/elle perde، nous perdions، vous perdiez، ils/elles perdent"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"acheter","meaning":"اِشْتَرَى","tense":"صيغة الالتماس (subjonctif)","forms":{"je":"achète","tu":"achètes","il/elle":"achète","nous":"achetions","vous":"achetiez","ils/elles":"achètent"},"difficulty":2},{"infinitive":"donner","meaning":"أَعْطَى","tense":"صيغة الالتماس (subjonctif)","forms":{"je":"donne","tu":"donnes","il/elle":"donne","nous":"donnions","vous":"donniez","ils/elles":"donnent"},"difficulty":2},{"infinitive":"rester","meaning":"مَكَثَ","tense":"صيغة الالتماس (subjonctif)","forms":{"je":"reste","tu":"restes","il/elle":"reste","nous":"restions","vous":"restiez","ils/elles":"restent"},"difficulty":2},{"infinitive":"perdre","meaning":"خَسِرَ، فَقَدَ","tense":"صيغة الالتماس (subjonctif)","forms":{"je":"perde","tu":"perdes","il/elle":"perde","nous":"perdions","vous":"perdiez","ils/elles":"perdent"},"difficulty":2},{"infinit