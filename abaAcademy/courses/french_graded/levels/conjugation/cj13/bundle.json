{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futur): être (يكون)، avoir (مَلَكَ)، taire (كَمَّمَ الفَمَ)، plaire (أَرْضَى)، suivre (تَبِعَ، خَلَفَ)، faire (يفعل، يصنع)، dire (يقول)، vouloir (أَرَادَ)، pouvoir (قَدَرَ، اِسْتَطَاعَ)، marier (زَوَّجَ)."},{"btype":"example","text":"être","note":"je serai، tu seras، il/elle sera، nous serons، vous serez، ils/elles seront"},{"btype":"example","text":"avoir","note":"je aurai، tu auras، il/elle aura، nous aurons، vous aurez، ils/elles auront"},{"btype":"example","text":"taire","note":"je tairai، tu tairas، il/elle taira، nous tairons، vous tairez، ils/elles tairont"},{"btype":"example","text":"plaire","note":"je plairai، tu plairas، il/elle plaira، nous plairons، vous plairez، ils/elles plairont"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"être","meaning":"يكون","tense":"المستقبل (futur)","forms":{"je":"serai","tu":"seras","il/elle":"sera","nous":"serons","vous":"serez","ils/elles":"seront"},"difficulty":2},{"infinitive":"avoir","meaning":"مَلَكَ","tense":"المستقبل (futur)","forms":{"je":"aurai","tu":"auras","il/elle":"aura","nous":"aurons","vous":"aurez","ils/elles":"auront"},"difficulty":2},{"infinitive":"taire","meaning":"كَمَّمَ الفَمَ","tense":"المستقبل (futur)","forms":{"je":"tairai","tu":"tairas","il/elle":"taira","nous":"tairons","vous":"tairez","ils/elles":"tairont"},"difficulty":2},{"infinitive":"plaire","meaning":"أَرْضَى","tense":"المستقبل (futur)","forms":{"je":"plairai","tu":"plairas","il/elle":"plaira","nous":"plairons","vous":"plairez","ils/elles":"plairont"},"difficulty":2},{"infinitive":"suivre","meaning":"تَبِعَ، خَلَفَ","tense":"المستقبل (futur)","forms":{"je":"suivrai","t