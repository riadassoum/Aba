{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futur): aller (ذَهَبَ)، savoir (عَلِمَ، دَرَى)، penser (ظَنَّ)، falloir (يَضْطَر)، voir (يرى)، parler (يتكلّم)، passer (قَضَى)، partir (تَرَكَ)، tomber (وَقَعَ)، monter (بَلَغَ)."},{"btype":"example","text":"aller","note":"je irai، tu iras، il/elle ira، nous irons، vous irez، ils/elles iront"},{"btype":"example","text":"savoir","note":"je saurai، tu sauras، il/elle saura، nous saurons، vous saurez، ils/elles sauront"},{"btype":"example","text":"penser","note":"je penserai، tu penseras، il/elle pensera، nous penserons، vous penserez، ils/elles penseront"},{"btype":"example","text":"falloir","note":"je -، tu -، il/elle faudra، nous -، vous -، ils/elles -"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"aller","meaning":"ذَهَبَ","tense":"المستقبل (futur)","forms":{"je":"irai","tu":"iras","il/elle":"ira","nous":"irons","vous":"irez","ils/elles":"iront"},"difficulty":2},{"infinitive":"savoir","meaning":"عَلِمَ، دَرَى","tense":"المستقبل (futur)","forms":{"je":"saurai","tu":"sauras","il/elle":"saura","nous":"saurons","vous":"saurez","ils/elles":"sauront"},"difficulty":2},{"infinitive":"penser","meaning":"ظَنَّ","tense":"المستقبل (futur)","forms":{"je":"penserai","tu":"penseras","il/elle":"pensera","nous":"penserons","vous":"penserez","ils/elles":"penseront"},"difficulty":2},{"infinitive":"falloir","meaning":"يَضْطَر","tense":"المستقبل (futur)","forms":{"je":"-","tu":"-","il/elle":"faudra","nous":"-","vous":"-","ils/elles":"-"},"difficulty":2},{"infinitive":"voir","meaning":"يرى","tense":"المستقبل (futur)","forms":{"je":"verrai","tu":"verras","il/elle":"verra","nous":"verrons","vous":"verrez","ils/elle