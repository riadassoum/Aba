{"theory":{"blocks":[{"btype":"text","text":"المضارع (présent): descendre (نَزَلَ)، sortir (خَرَجَ)، retourner (قَلَبَ)، paraître (بَدَا)، disparaître (اِخْتَفَى)، repasser (كَوَى)، devoir (وَجَبَ، لَابُدَّ)، maintenir (أَبْقَى)، porter (لَبِسَ)، prendre (تَنَاوَلَ)."},{"btype":"example","text":"descendre","note":"je descends، tu descends، il/elle descend، nous descendons، vous descendez، ils/elles descendent"},{"btype":"example","text":"sortir","note":"je sors، tu sors، il/elle sort، nous sortons، vous sortez، ils/elles sortent"},{"btype":"example","text":"retourner","note":"je retourne، tu retournes، il/elle retourne، nous retournons، vous retournez، ils/elles retournent"},{"btype":"example","text":"paraître","note":"je parais، tu parais، il/elle paraît، nous paraissons، vous paraissez، ils/elles paraissent"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"descendre","meaning":"نَزَلَ","tense":"المضارع (présent)","forms":{"je":"descends","tu":"descends","il/elle":"descend","nous":"descendons","vous":"descendez","ils/elles":"descendent"},"difficulty":2},{"infinitive":"sortir","meaning":"خَرَجَ","tense":"المضارع (présent)","forms":{"je":"sors","tu":"sors","il/elle":"sort","nous":"sortons","vous":"sortez","ils/elles":"sortent"},"difficulty":2},{"infinitive":"retourner","meaning":"قَلَبَ","tense":"المضارع (présent)","forms":{"je":"retourne","tu":"retournes","il/elle":"retourne","nous":"retournons","vous":"retournez","ils/elles":"retournent"},"difficulty":2},{"infinitive":"paraître","meaning":"بَدَا","tense":"المضارع (présent)","forms":{"je":"parais","tu":"parais","il/elle":"paraît","nous":"paraissons","vous":"paraissez","ils/elles":"paraissent"},"diff