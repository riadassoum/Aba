{"theory":{"blocks":[{"btype":"text","text":"الشرطي (conditionnel): descendre (نَزَلَ)، sortir (خَرَجَ)، retourner (قَلَبَ)، paraître (بَدَا)، disparaître (اِخْتَفَى)، repasser (كَوَى)، devoir (وَجَبَ، لَابُدَّ)، maintenir (أَبْقَى)، porter (لَبِسَ)، prendre (تَنَاوَلَ)."},{"btype":"example","text":"descendre","note":"je descendrais، tu descendrais، il/elle descendrait، nous descendrions، vous descendriez، ils/elles descendraient"},{"btype":"example","text":"sortir","note":"je sortirais، tu sortirais، il/elle sortirait، nous sortirions، vous sortiriez، ils/elles sortiraient"},{"btype":"example","text":"retourner","note":"je retournerais، tu retournerais، il/elle retournerait، nous retournerions، vous retourneriez، ils/elles retourneraient"},{"btype":"example","text":"paraître","note":"je paraîtrais، tu paraîtrais، il/elle paraîtrait، nous paraîtrions، vous paraîtriez، ils/elles paraîtraient"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"descendre","meaning":"نَزَلَ","tense":"الشرطي (conditionnel)","forms":{"je":"descendrais","tu":"descendrais","il/elle":"descendrait","nous":"descendrions","vous":"descendriez","ils/elles":"descendraient"},"difficulty":2},{"infinitive":"sortir","meaning":"خَرَجَ","tense":"الشرطي (conditionnel)","forms":{"je":"sortirais","tu":"sortirais","il/elle":"sortirait","nous":"sortirions","vous":"sortiriez","ils/elles":"sortiraient"},"difficulty":2},{"infinitive":"retourner","meaning":"قَلَبَ","tense":"الشرطي (conditionnel)","forms":{"je":"retournerais","tu":"retournerais","il/elle":"retournerait","nous":"retournerions","vous":"retourneriez","ils/elles":"retourneraient"},"difficulty":2},{"infinitive":"paraître","meaning":"بَد