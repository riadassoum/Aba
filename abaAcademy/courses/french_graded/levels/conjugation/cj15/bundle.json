{"theory":{"blocks":[{"btype":"text","text":"المستقبل (futur): descendre (نَزَلَ)، sortir (خَرَجَ)، retourner (قَلَبَ)، paraître (بَدَا)، disparaître (اِخْتَفَى)، repasser (كَوَى)، devoir (وَجَبَ، لَابُدَّ)، maintenir (أَبْقَى)، porter (لَبِسَ)، prendre (تَنَاوَلَ)."},{"btype":"example","text":"descendre","note":"je descendrai، tu descendras، il/elle descendra، nous descendrons، vous descendrez، ils/elles descendront"},{"btype":"example","text":"sortir","note":"je sortirai، tu sortiras، il/elle sortira، nous sortirons، vous sortirez، ils/elles sortiront"},{"btype":"example","text":"retourner","note":"je retournerai، tu retourneras، il/elle retournera، nous retournerons، vous retournerez، ils/elles retourneront"},{"btype":"example","text":"paraître","note":"je paraîtrai، tu paraîtras، il/elle paraîtra، nous paraîtrons، vous paraîtrez، ils/elles paraîtront"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","verbs":[{"infinitive":"descendre","meaning":"نَزَلَ","tense":"المستقبل (futur)","forms":{"je":"descendrai","tu":"descendras","il/elle":"descendra","nous":"descendrons","vous":"descendrez","ils/elles":"descendront"},"difficulty":2},{"infinitive":"sortir","meaning":"خَرَجَ","tense":"المستقبل (futur)","forms":{"je":"sortirai","tu":"sortiras","il/elle":"sortira","nous":"sortirons","vous":"sortirez","ils/elles":"sortiront"},"difficulty":2},{"infinitive":"retourner","meaning":"قَلَبَ","tense":"المستقبل (futur)","forms":{"je":"retournerai","tu":"retourneras","il/elle":"retournera","nous":"retournerons","vous":"retournerez","ils/elles":"retourneront"},"difficulty":2},{"infinitive":"paraître","meaning":"بَدَا","tense":"المستقبل (futur)","forms":{"je":"paraîtrai","tu":"paraîtras","i