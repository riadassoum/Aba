u pays.","ar":"إيطاليا بلد جميل جدا."},{"t":"L'homme portait un masque de tigre.","ar":"لبس الرجل قناع نمر."},{"t":"Il y a cinquante États dans l'union.","ar":"يوجد هناك خمسون مقاطعة في الولايات المتحدة."},{"t":"Je ne sais pas pourquoi j'ai été viré.","ar":"لا أعلم لم تمّ فصلي."},{"t":"La France a une frontière commune avec l'Italie.","ar":"لدى فرنسا حدود مشتركة مع إيطاليا."}],"focus":["viré","l'information","masque","m'appeler","ouvrage","l'Italie","l'union","l'image","gratuit","voile"],"words":[{"word":"masque","topic":"L506","difficulty":4,"meaning":"قِناع","example":"L'homme mit un masque de tigre.","translation":"لبس الرجل قناع نمر."},{"word":"gratuit","topic":"L506","difficulty":4,"meaning":"مَجَّانِيّ"},{"word":"voile","topic":"L506","difficulty":4,"meaning":"شِرَاع"}],"difficulty":4}}