{"theory":{"blocks":[{"btype":"text","text":"الدرس 295. الكلمات الجديدة: cabinet، écrivit، nourrissent، diamant، plaisante، fine، revenez، prononcé، mette، couverts."},{"btype":"example","text":"cabinet = مِرْحَاض","note":""},{"btype":"example","text":"écrivit = َأَلَّف، كَتَبَ","note":"صيغة من écrire (الغائب، الماضي)؛ مثال: Il écrivit le rapport. — كتب التقرير."},{"btype":"example","text":"nourrissent = أَطْعَمَ","note":"صيغة من nourrir (الجمع، الغائب، صيغة الالتماس (الشرطية))؛ مثال: Ces animaux se nourrissent d'herbe. — تأكل هذه الحيوانات العشب."},{"btype":"example","text":"diamant = أَلْمَاس، مَاس","note":"مثال: Tu n'as jamais vu un véritable diamant. — أنت لم تر قط ألماسا حقيقيا."},{"btype":"example","text":"plaisante = مَزَحَ","note":"صيغة من plaisanter (الغائب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Je plaisante. — أَنَا أَمْزَح فَقَط."},{"btype":"example","text":"fine = نِهَايَة","note":"صيغة من fin (المؤنث)"},{"btype":"example","text":"revenez = رَجَعَ","note":"صيغة من revenir (الجمع، المخاطب، المضارع)؛ مثال: Revenez nous voir. — تعالَ مُجدداً."},{"btype":"example","text":"prononcé = لَفَظَ","note":"صيغة من prononcer (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"mette = شَغَّلَ","note":"صيغة من mettre (الغائب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Prends un parapluie avec toi au cas où il se mette à pleuvoir. — خذ مظلة معك في حال أمطرت."},{"btype":"example","text":"couverts = مُغَطًّى","note":"صيغة من couvert (الجمع)؛ مثال: Où sont les couverts ? — أين هي أدوات الأكل؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Je plaisante.","note":"أَنَا أَمْزَح فَقَط."},{"btype":"example","text":"Ziri plaisante.","note":"زيري يمزح."},{"btype":"example","text":"Ne plaisante pas !","note":"لا تمزح رجاءً!"},{"btype":"example","text":"Revenez nous voir.","note":"تعالَ مُجدداً."},{"btype":"example","text":"Il écrivit le rapport.","note":"كتب التقرير."},{"btype":"example","text":"Où sont les couverts ?","note":"أين هي أدوات الأكل؟"},{"btype":"example","text":"Yanni ne plaisante pas.","note":"ياني لا يمزح."},{"btype":"example","text":"Ils mangent avec des couverts.","note":"يأكلون بالشوكة و السكين."},{"btype":"example","text":"Ces animaux se nourrissent d'herbe.","note":"تأكل هذه الحيوانات العشب."},{"btype":"example","text":"Tu n'as jamais vu un véritable diamant.","note":"أنت لم تر قط ألماسا حقيقيا."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Je plaisante.","ar":"أَنَا أَمْزَح فَقَط."},{"t":"Ziri plaisante.","ar":"زيري يمزح."},{"t":"Ne plaisante pas !","ar":"لا تمزح رجاءً!"},{"t":"Revenez nous voir.","ar":"تعالَ مُجدداً."},{"t":"Il écrivit le rapport.","ar":"كتب التقرير."},{"t":"Où sont les couverts ?","ar":"أين هي أدوات الأكل؟"},{"t":"Yanni ne plaisante pas.","ar":"ياني لا يمزح."},{"t":"Ils mangent avec des couverts.","ar":"يأكلون بالشوكة و السكين."},{"t":"Ces animaux se nourrissent d'herbe.","ar":"تأكل هذه الحيوانات العشب."},{"t":"Tu n'as jamais vu un véritable diamant.","ar":"أنت لم تر قط ألماسا حقيقيا."},{"t":"Prends un parapluie avec toi au cas où il se mette à pleuvoir.","ar":"خذ مظلة معك في حال أمطرت."}],"focus":["cabinet","écrivit","nourrissent","diamant","plaisante","fine