ù puis-je trouver un taxi ?","ar":"أين يمكنني أن أجد سيارة أجرة؟"},{"t":"Où puis-je prendre un taxi ?","ar":"أين أستطيع أن أجد سيارة أجرة؟"},{"t":"Ils ne mangent pas de viande.","ar":"لا يأكلون اللحم."},{"t":"L'as-tu montré à tes parents ?","ar":"أأريتها والديك؟"},{"t":"Tu l'as construit, n'est-ce pas ?","ar":"لقد بنيتها، أليس كذلك؟"},{"t":"Ce n'est pas du véritable argent.","ar":"ليست نقودًا حقيقية."},{"t":"C'est un garçon très intelligent.","ar":"هو ولد ذكي جدا."},{"t":"J'ai très bien dormi la nuit passée.","ar":"نمتُ جيدا الليلة الماضية."},{"t":"Comment s'est passée l'école, aujourd'hui ?","ar":"كيفَ كانت المدرسة اليوم؟"},{"t":"Devrions-nous y aller en voiture ou en taxi ?","ar":"هل نذهب بالسيارة أم بالتكسي؟"},{"t":"Quelle sorte d'information trouve-t-on sur Internet ?","ar":"أيَّ نوع من المعلومات تجد في الإنترنت؟"},{"t":"Quelle est la véritable raison pour laquelle vous ne voulez pas faire ceci ?","ar":"ما هو السبب الحقيقي لعدم رغبتك بعمل هذا؟"},{"t":"Nous voulons parler à Tom.","ar":"نريد أن نتحدث إلى توم."},{"t":"Nous voulons de la viande.","ar":"نريد لحما."},{"t":"J'aime chacun d'entre eux.","ar":"انا احب كلا منهما"},{"t":"J'adore vraiment les chats.","ar":"أنا حقا احب القطط."},{"t":"Il aime beaucoup son école.","ar":"إنه يحب مدرسته كثيراً."}],"focus":["mangent","Internet","construit","nul","véritable","taxi","montré","passée","intelligent","utilise"],"words":[{"word":"Internet","topic":"L97","difficulty":1,"meaning":"إِنْتَرْنَت","example":"Quelle sorte d'information trouve-t-on sur Internet ?","translation":"أيَّ نوع من المعلومات تجد في الإنترنت؟"},{"word":"nul","topic":"L97","difficulty":1,"meaning":"لَا"},{"word":"véritable","topic":"L97","difficulty":1,"meaning":"حَقِيقِيّ، حَقّ","example":"Ce n'est pas du véritable argent.","translation":"ليست نقودًا حقيقية."},{"word":"taxi","topic":"L97","difficulty":1,"meaning":"تَاكْسِي","example":"Où puis-je trouver un taxi ?","translation":"أين يمكنني أن أجد سيارة أجرة؟"},{"word":"intelligent","topic":"L97","diffic