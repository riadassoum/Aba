{"theory":{"blocks":[{"btype":"text","text":"الدرس 92. الكلمات الجديدة: auparavant، bouche، réalité، disent، erreurs، système، bonjour، ferai، l'hôpital، résoudre."},{"btype":"example","text":"auparavant = كَانَ","note":"مثال: Je ne l'ai pas rencontré auparavant. — لم أقابله من قبل."},{"btype":"example","text":"bouche = فَم","note":""},{"btype":"example","text":"réalité = وَاقِع","note":"مثال: En réalité, Ziri est parti. — في الحقيقة، غادر زيري."},{"btype":"example","text":"disent = أَخْبَرَ","note":"صيغة من dire (الجمع، الغائب، صيغة الالتماس (الشرطية))؛ مثال: C'est ce que disent les gens. — هذا ما يقوله الناس."},{"btype":"example","text":"erreurs = خَطَأ","note":"صيغة من erreur (الجمع)؛ مثال: Tom a fait des erreurs. — ارتكب توم أخطاء."},{"btype":"example","text":"système = نِظَام","note":"مثال: Ça fait partie du système. — إنه جزء من النظام."},{"btype":"example","text":"bonjour = صباح الخير، مرحبًا","note":"مثال: Bonjour ! — صباح الخير."},{"btype":"example","text":"ferai = فَعَلَ","note":"صيغة من faire (المتكلّم، المستقبل)؛ مثال: D'accord, je le ferai. — لا بأس، سأتولى أنا الأمر."},{"btype":"example","text":"l'hôpital","note":"مثال: J'allai à l'hôpital. — ذهبت إلى المستشفى."},{"btype":"example","text":"résoudre = ذَابَ","note":"مثال: Je ne peux pas résoudre ce problème. — لا يمكنني حل هذه المشكلة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Bonjour !","note":"صباح الخير."},{"btype":"example","text":"Bonjour, mon ami.","note":"مرحبا, يا صديقي."},{"btype":"example","text":"Bonjour, Chicago !","note":"مرحباً ، أهل شيكاغو!"},{"btype":"example","text":"Bonjour la Terre !","note":"مرحبًا بالعالم!"},{"btype":"example","text":"J'allai à l'hôpital.","note":"ذهبت إلى المستشفى."},{"btype":"example","text":"Bonjour tout le monde.","note":"صَبَاح الْخَيْر جَمِيْعاً."},{"btype":"example","text":"D'accord, je le ferai.","note":"لا بأس، سأتولى أنا الأمر."},{"btype":"example","text":"Tom a fait des erreurs.","note":"ارتكب توم أخطاء."},{"btype":"example","text":"Sami a fini à l'hôpital.","note":"في نهاية المطاف، وجد سامي نفسه في المستشفى."},{"btype":"example","text":"Ça fait partie du système.","note":"إنه جزء من النظام."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Bonjour !","ar":"صباح الخير."},{"t":"Bonjour, mon ami.","ar":"مرحبا, يا صديقي."},{"t":"Bonjour, Chicago !","ar":"مرحباً ، أهل شيكاغو!"},{"t":"Bonjour la Terre !","ar":"مرحبًا بالعالم!"},{"t":"J'allai à l'hôpital.","ar":"ذهبت إلى المستشفى."},{"t":"Bonjour tout le monde.","ar":"صَبَاح الْخَيْر جَمِيْعاً."},{"t":"D'accord, je le ferai.","ar":"لا بأس، سأتولى أنا الأمر."},{"t":"Tom a fait des erreurs.","ar":"ارتكب توم أخطاء."},{"t":"Sami a fini à l'hôpital.","ar":"في نهاية المطاف، وجد سامي نفسه في المستشفى."},{"t":"Ça fait partie du système.","ar":"إنه جزء من النظام."},{"t":"Je suis allée à l'hôpital.","ar":"ذهبت إلى المستشفى."},{"t":"Je veux aller à l'hôpital.","ar":"أريد أن أذهب إلى المستشفى."},{"t":"J'ai été à l'hôpital hier.","ar":"ذهبت إلى المستشفى البارحة."},{"t":"En réalité, Ziri est parti.","ar":"في الحقيقة، غادر زيري."},{"t":"C'est simple comme bonjour.","ar":"إنه سهل جدا."},{"t":"Nous avons fait des erreurs.","ar":"ارتكبنا أخطاءً."},{"t":"Il n'a même pas dit bonjour.","ar":"لم يلقي التحية حتى."},{"t":"Dois-je rester à l'hôpital ?","ar":"هل يجب علي أن أبقى في المستشفى؟"},{"t":"C'est ce que disent les gens.","ar":"هذا ما يقوله الناس."},{"t":"Bonjour, comment allez-vous ?","ar":"مرحبا, كيف حالك؟"},{"t":"Tom est toujours à l'hôpital.","ar":"ما زال توم في المستشفى."},{"t":"Nous faisons tous des erreurs.","ar":"كلنا نخطئ."},{"t":"Tout le monde fait des erreurs.","ar":"كل ابن آدم خطاّء"},{"t":"Il faut que j'aille à l'hôpital.","ar":"يجب ان اذهب للمستشفى."},{"t":"Nous faisons parfois des erreurs.","ar":"أحياناً نخطئ."},{"t":"Je ferai n'importe quoi pour vous.","ar":"سأفعل أي شيء من أجلك."},{"t":"Je ne l'ai pas rencontré auparavant.","ar":"لم أقابله من قبل."},{"t":"Vous devez apprendre de vos erreurs.","ar":"يجب أن تتعلم من أخطائك."},{"t":"Je ne peux pas résoudre ce problème.","ar":"لا يمكنني حل هذه المشكلة."},{"t":"Dis-moi comment résoudre le problème.","ar":"علمني كيف أحل هذه المشكلة."}],"focus":["auparavant","bouche","réalité","disent","erreurs","système","bonjour","ferai","l'hôpital","résoudre"],"words":[{"word":"auparavant","topic":"L92","difficulty":2,"meaning":"كَانَ","example":"Je ne l'ai pas rencontré auparavant.","translation":"لم أقابله من قبل."},{"word":"bouche","topic":"L92","difficulty":2,"meaning":"فَم"},{"word":"réalité","topic":"L92","difficulty":2,"meaning":"وَاقِع","example":"En réalité, Ziri est parti.","translation":"في الحقيقة، غادر زيري."},{"word":"système","topic":"L92","difficulty":2,"meaning":"نِظَام","example":"Ça fait partie du système.","translation":"إنه جزء من النظام."},{"word":"bonjour","topic":"L92","difficulty":2,"meaning":"صباح الخير، مرحبًا","example":"Bonjour !","translation":"صباح الخير."},{"word":"résoudre","topic":"L92","difficulty":2,"meaning":"ذَابَ","example":"Je ne peux pas résoudre ce problème.","translation":"لا يمكنني حل هذه المشكلة."}],"difficulty":2}}