 pas besoin de travailler.","ar":"إنه لا يحتاج إلى أن يعمل."},{"t":"Elle n'a pas besoin de travailler.","ar":"إنها لا تحتاج إلى أن تعمل."},{"t":"On a encore deux jours devant nous.","ar":"ما زال هناك يومان أمامنا"},{"t":"Il y a un téléphone dans ma chambre.","ar":"يوجد هاتف في غرفتي."},{"t":"Personne ne veut travailler avec toi.","ar":"لا أحد يرغب في العمل معك."},{"t":"Nous avons fait la fête toute la nuit.","ar":"احتفلنا طيلة الليل"},{"t":"J'aimerais bien pouvoir aller au Japon.","ar":"كَم أتمنّى الذهاب إلى اليابان."},{"t":"Je ne sais pas si on va pouvoir faire ça.","ar":"لا أدري إن كان بإمكاننا فعل ذلك."},{"t":"Je ne suis pas sûr de pouvoir venir avec toi.","ar":"أنا لست متأكّداً أنّني سأكون قادراً على القدوم معك"},{"t":"Il faut travailler pour vivre, et non pas vivre pour travailler.","ar":"اعمل من أجل العيش و لا تعش من أجل العمل."},{"t":"Ça m'a fait peur.","ar":"لقد أخافني هذا."},{"t":"Il m'a fait peur.","ar":"لقد أفزعني."}],"focus":["fête","droit","devant","téléphone","ainsi","pouvoir","soleil","travailler","vue","l'homme"],"words":[{"word":"fête","topic":"L38","difficulty":1,"meaning":"حَفْلَة","example":"J'étais à la fête.","translation":"كنت في الحفلة."},{"word":"droit","topic":"L38","difficulty":1,"meaning":"حَقّ","example":"À qui de droit.","translation":"إلى من يهمه الأمر."},{"word":"devant","topic":"L38","difficulty":1,"meaning":"قَبْلَ","example":"On a encore deux jours devant nous.","translation":"ما زال هناك يومان أمامنا"},{"word":"téléphone","topic":"L38","difficulty":1,"meaning":"هَاتِف","example":"Il parle au téléphone.","translation":"إنه يتحدث على الهاتف."},{"word":"ainsi","topic":"L38","difficulty":1,"meaning":"هَكَذَا، وَهٰكَذَا","example":"Ainsi soit-il !","translation":"فليكن الأمر كذلك!"},{"word":"pouvoir","topic":"L38","difficulty":1,"meaning":"قَدَرَ، اِسْتَطَاعَ","example":"Je pense pouvoir.","translation":"أعتقد أنه بإمكاني ..."},{"word":"soleil","topic":"L38","difficulty":1,"meaning":"شَمْس","example":"J'aime le soleil.","translation":"