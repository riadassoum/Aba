ès.","ar":"متأكد من نجاحه."},{"t":"Vous aimez-vous beaucoup ?","ar":"هل تحبان بعضكما البعض بشدة؟"},{"t":"Je dois mon succès à mon ami.","ar":"أدين بنجاحي لصديقي."},{"t":"Je ne partage pas votre avis.","ar":"لا أشارك رأيك."},{"t":"Elle mit sur papier ses idées.","ar":"دونت ما تفكر به على الورق."},{"t":"Ce n'est la faute de personne.","ar":"هذا ليس خطأ أى شخص."},{"t":"Tiens bon, nous y sommes presque.","ar":"اصبر فقد أوشكنا على الانتهاء."},{"t":"Je te l'ai envoyé il y a deux jours.","ar":"بعثتُه لك منذ يومين."},{"t":"Je n'avais pas l'intention de le faire.","ar":"لم أقصد فعل ذلك."},{"t":"Il a l'habitude de parler à des étrangers.","ar":"هو معتاد على التحدُّث إلى الأجانب."},{"t":"Ma mère m'a envoyé un cadeau d'anniversaire.","ar":"أرسلت لي أمي هدية لعيد ميلادي."},{"t":"En tout cas, je tiens à vous remercier tous.","ar":"علي كل حال, أود أن أشكركم جميعاً."},{"t":"Je n'arrive pas du tout à comprendre ses idées.","ar":"لا أستطيع فهم أفكاره على الإطلاق."},{"t":"Tom n'a pas l'habitude de montrer ses sentiments.","ar":"لا يظهر توم مشاعره دائما."}],"focus":["loi","l'intention","l'habitude","succès","aimez","avis","idées","envoyé","faute","tiens"],"words":[{"word":"loi","topic":"L166","difficulty":2,"meaning":"قَانُون","example":"Lis la loi.","translation":"اقرأ القانون."},{"word":"succès","topic":"L166","difficulty":2,"meaning":"نَجَاح","example":"J'ai beaucoup de succès.","translation":"أنا شعبي جداً."},{"word":"avis","topic":"L166","difficulty":2,"meaning":"رَأْي","example":"Chacun a son propre avis.","translation":"كل شخص لديه آرائه الخاصّة."},{"word":"faute","topic":"L166","difficulty":2,"meaning":"خَطَأ","example":"C'est de ma faute.","translation":"هذه غلطتي."},{"word":"tiens","topic":"L166","difficulty":2,"meaning":"تَفَضَّل","example":"Tiens-toi droit.","translation":"إجلس مستقيماً."}],"difficulty":2}}