 que je veux dire ?","ar":"هل فهمت ما أقصده؟"},{"t":"Aujourd'hui, c'est mon jour de congé.","ar":"اليوم هو يوم راحتي."},{"t":"Je suis allé chez moi et j'ai pleuré.","ar":"ذهبت للمنزل وبكيت."},{"t":"Il me traite toujours comme un enfant.","ar":"هو دائماً ما يتعامل معي كطفل."},{"t":"Son nom ne se trouvait pas sur la liste.","ar":"لم يكن اسمها في القائمة."},{"t":"Ne me traite pas comme si j'étais un enfant.","ar":"لا تعاملني وكأني طفل."},{"t":"Le patron nous donna à tous un jour de congé.","ar":"أعطى رئيس العمل الكل إجازة."}],"focus":["tromper","chaussettes","occasion","lion","comprenez","paie","congé","pleuré","traite","trouvait"],"words":[{"word":"tromper","topic":"L207","difficulty":3,"meaning":"خَدَعَ"},{"word":"occasion","topic":"L207","difficulty":3,"meaning":"فُرْصَة"},{"word":"lion","topic":"L207","difficulty":3,"meaning":"أَسَد","example":"Je vois un lion.","translation":"أرى أسداً."},{"word":"congé","topic":"L207","difficulty":3,"meaning":"إِجَازَة","example":"Je prends deux jours de congé.","translation":"سآخذ إذنا ليومين."},{"word":"traite","topic":"L207","difficulty":3,"meaning":"حَلْب","example":"Traite-la avec respect.","translation":"تعامل معها باحترام."}],"difficulty":3}}