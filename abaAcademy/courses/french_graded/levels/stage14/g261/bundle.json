{"theory":{"blocks":[{"btype":"text","text":"الدرس 261. الكلمات الجديدة: essayait، jaunes، donnera، puissions، deviendra، remplacer، paraissait، poires، planche، moche."},{"btype":"example","text":"essayait = حَاوَلَ","note":"صيغة من essayer (الغائب، الماضي المستمرّ)؛ مثال: Sami essayait d'améliorer sa vie. — كان سامي يحاول تحسين حياته."},{"btype":"example","text":"jaunes = أَصْفَر","note":"صيغة من jaune (الجمع)؛ مثال: Les bananes sont jaunes. — الموز أصفر."},{"btype":"example","text":"donnera = أَعْطَى","note":"صيغة من donner (الغائب، المستقبل)"},{"btype":"example","text":"puissions = قَدَرَ، اِسْتَطَاعَ","note":"صيغة من pouvoir (الجمع، المتكلّم، صيغة الالتماس (الشرطية))؛ مثال: Il est mort pour que nous puissions vivre. — لقد مات لكي نعيش."},{"btype":"example","text":"deviendra = أَصْبَحَ","note":"صيغة من devenir (الغائب، المستقبل)؛ مثال: L'Algérie deviendra-t-elle riche ? — هل ستصبح الجزائر بلدا غنيّا؟"},{"btype":"example","text":"remplacer = اِسْتَبْدَلَ","note":""},{"btype":"example","text":"paraissait = بَدَا","note":"صيغة من paraître (الغائب، الماضي المستمرّ)"},{"btype":"example","text":"poires = كُمَّثْرَى","note":"صيغة من poire (الجمع)؛ مثال: Ziri mangeait des poires. — أكل زيري الإجّاص."},{"btype":"example","text":"planche = لَوْحَة","note":""},{"btype":"example","text":"moche = قَبِيح","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Les bananes sont jaunes.","note":"الموز أصفر."},{"btype":"example","text":"Ziri mangeait des poires.","note":"أكل زيري الإجّاص."},{"btype":"example","text":"Ma fille aime les jaunes d'œufs.","note":"ابنتي تحب صفار البيض."},{"btype":"example","text":"Sami essayait d'améliorer sa vie.","note":"كان سامي يحاول تحسين حياته."},{"btype":"example","text":"Il essayait de ne pas la regarder.","note":"حاول ألا ينظر إليها."},{"btype":"example","text":"L'Algérie deviendra-t-elle riche ?","note":"هل ستصبح الجزائر بلدا غنيّا؟"},{"btype":"example","text":"Elle essayait de ne pas le regarder.","note":"حاولت ألا تنظر إليه."},{"btype":"example","text":"Je pense qu'il deviendra riche un jour.","note":"أعتقد أنه سيصبح غنياً يوماً ما."},{"btype":"example","text":"Il est mort pour que nous puissions vivre.","note":"لقد مات لكي نعيش."},{"btype":"example","text":"J'ai perdu la mémoire.","note":"لقد فقدت ذاكرتي."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Les bananes sont jaunes.","ar":"الموز أصفر."},{"t":"Ziri mangeait des poires.","ar":"أكل زيري الإجّاص."},{"t":"Ma fille aime les jaunes d'œufs.","ar":"ابنتي تحب صفار البيض."},{"t":"Sami essayait d'améliorer sa vie.","ar":"كان سامي يحاول تحسين حياته."},{"t":"Il essayait de ne pas la regarder.","ar":"حاول ألا ينظر إليها."},{"t":"L'Algérie deviendra-t-elle riche ?","ar":"هل ستصبح الجزائر بلدا غنيّا؟"},{"t":"Elle essayait de ne pas le regarder.","ar":"حاولت ألا تنظر إليه."},{"t":"Je pense qu'il deviendra riche un jour.","ar":"أعتقد أنه سيصبح غنياً يوماً ما."},{"t":"Il est mort pour que nous puissions vivre.","ar":"لقد مات لكي نعيش."},{"t":"J'ai perdu la mémoire.","ar":"لقد فقدت ذاكرتي."},{"t":"Nous sommes du Canada.","ar":"نحن من كندا."},{"t":"De quoi as-tu besoin ?","ar":"ماذا تحتاج؟"}],"focus":["essayait","jaunes","donnera","puissions","deviendra","remplacer","paraissait","poires","planche","moche"],"words":[{"word":"remplacer","topic":"L261","difficulty":2,"meaning":"اِسْتَبْدَلَ"},{"word":"planche","topic":"L261","difficulty":2,"meaning":"لَوْحَة"},{"word":"moche","topic":"L261","difficulty":2,"meaning":"قَبِيح"}],"difficulty":2}}