{"theory":{"blocks":[{"btype":"text","text":"الدرس 434. الكلمات الجديدة: culpabilité، spécialiste، démarré، identité، battus، sushis، malheureuse، gelé، m'avais، souliers."},{"btype":"example","text":"culpabilité = ذَنْب","note":""},{"btype":"example","text":"spécialiste = مُتَخَصِّص","note":""},{"btype":"example","text":"démarré = بَدَأَ","note":"صيغة من démarrer (اسم المفعول (التصريف الثالث))؛ مثال: Ziri a démarré le moteur. — شغل زيري المحرك."},{"btype":"example","text":"identité = مُطَابَقَة، هُوِيَّة","note":""},{"btype":"example","text":"battus","note":"مثال: Il les a battus. — لقد هزمهم."},{"btype":"example","text":"sushis","note":"مثال: Elle n'aime pas les sushis. — إنها لا تحب السوشي."},{"btype":"example","text":"malheureuse = لَعُوق","note":"صيغة من malheureux (المؤنث)؛ مثال: Mary, malheureuse enfant, où avez-vous été ? Que vous est-il arrivé ? — ماري, أنتِ فتاة مسكينة, أين كنتِ؟ ماذا حدث لكِ؟"},{"btype":"example","text":"gelé = مَسْطُول","note":"مثال: Le lac était gelé. — تجمدت البحيرة."},{"btype":"example","text":"m'avais","note":"مثال: Tu m'avais promis de prendre soin d'eux. — وعدتني أن تبحث عنهم."},{"btype":"example","text":"souliers = حِذَاء","note":"مثال: Ces souliers sont à elle. — ذلك حذاءها."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Il les a battus.","note":"لقد هزمهم."},{"btype":"example","text":"Tom les a battus.","note":"هزمهم توم."},{"btype":"example","text":"Le lac était gelé.","note":"تجمدت البحيرة."},{"btype":"example","text":"Ziri a démarré le moteur.","note":"شغل زيري المحرك."},{"btype":"example","text":"Ces souliers sont à elle.","note":"ذلك حذاءها."},{"btype":"example","text":"Elle n'aime pas les sushis.","note":"إنها لا تحب السوشي."},{"btype":"example","text":"Ils se sont battus avec Ziri.","note":"تعاركوا مع زيري."},{"btype":"example","text":"Tu m'avais promis de prendre soin d'eux.","note":"وعدتني أن تبحث عنهم."},{"btype":"example","text":"Le projet a démarré d'une manière assez mauvaise.","note":"كانت للمشروع بداية سيئة."},{"btype":"example","text":"N'allez pas avec des souliers dans cette mosquée.","note":"لا ترتدِ حذاءا في المسجد."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Il les a battus.","ar":"لقد هزمهم."},{"t":"Tom les a battus.","ar":"هزمهم توم."},{"t":"Le lac était gelé.","ar":"تجمدت البحيرة."},{"t":"Ziri a démarré le moteur.","ar":"شغل زيري المحرك."},{"t":"Ces souliers sont à elle.","ar":"ذلك حذاءها."},{"t":"Elle n'aime pas les sushis.","ar":"إنها لا تحب السوشي."},{"t":"Ils se sont battus avec Ziri.","ar":"تعاركوا مع زيري."},{"t":"Tu m'avais promis de prendre soin d'eux.","ar":"وعدتني أن تبحث عنهم."},{"t":"Le projet a démarré d'une manière assez mauvaise.","ar":"كانت للمشروع بداية سيئة."},{"t":"N'allez pas avec des souliers dans cette mosquée.","ar":"لا ترتدِ حذاءا في المسجد."},{"t":"Mary, malheureuse enfant, où avez-vous été ? Que vous est-il arrivé ?","ar":"ماري, أنتِ فتاة مسكينة, أين كنتِ؟ ماذا حدث لكِ؟"}],"focu