{"theory":{"blocks":[{"btype":"text","text":"الدرس 121. الكلمات الجديدة: continuer، retrouver، ouvrir، apporté، frais، menti، avion، Sud، attends، vol."},{"btype":"example","text":"continuer = تَابَعَ","note":"مثال: Peuvent-elles continuer ? — هل بإمكانهن الاستمرار؟"},{"btype":"example","text":"retrouver = استرجع","note":""},{"btype":"example","text":"ouvrir = فَتَحَ","note":"مثال: Tu peux ouvrir les yeux. — يمكنك أن تفتح عينيك الآن."},{"btype":"example","text":"apporté = أَحْضَرَ","note":"صيغة من apporter (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"frais = بَارِد","note":"مثال: Le pain est frais. — الخبز طازج."},{"btype":"example","text":"menti = كَذَبَ","note":"صيغة من mentir (اسم المفعول (التصريف الثالث))؛ مثال: Tom a menti. — لقد كذِبَ توم."},{"btype":"example","text":"avion = طَائِرَة","note":"مثال: J'ai vu un avion. — رأيت طائرة."},{"btype":"example","text":"Sud = جَنُوب","note":"مثال: Il doit venir du Sud. — لا بد أنه من الجنوب."},{"btype":"example","text":"attends = اِنْتَظَرَ","note":"صيغة من attendre (المخاطب، المضارع)؛ مثال: Je vous attends. — أنا في انتظارك."},{"btype":"example","text":"vol = طَيَرَان","note":"مثال: Bon vol. — استمتع برحلتك."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Bon vol.","note":"استمتع برحلتك."},{"btype":"example","text":"Tom a menti.","note":"لقد كذِبَ توم."},{"btype":"example","text":"Ziri a menti.","note":"كذب زيري."},{"btype":"example","text":"C'est un vol.","note":"انها سرقه."},{"btype":"example","text":"Yanni a menti.","note":"كذب يانّي."},{"btype":"example","text":"Marie m'a menti.","note":"كذبت ماري علي."},{"btype":"example","text":"Ils m'ont menti.","note":"كذبوا عليّ."},{"btype":"example","text":"Il nous a menti.","note":"كذب علينا."},{"btype":"example","text":"Je vous attends.","note":"أنا في انتظارك."},{"btype":"example","text":"J'ai vu un avion.","note":"رأيت طائرة."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"ge