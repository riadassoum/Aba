{"theory":{"blocks":[{"btype":"text","text":"الدرس 126. الكلمات الجديدة: noirs، seriez، vivons، connaissait، premiers، lourd، regardent، timide، aimons، mec."},{"btype":"example","text":"noirs = زِنْجِيّ، أَسْوَد","note":"صيغة من noir (الجمع)؛ مثال: Regarde ces nuages noirs. — أنظر إلى تلك الغيوم السوداء."},{"btype":"example","text":"seriez = كَانَ، كَانَ هُوَ","note":"صيغة من être (الجمع، المخاطب، الشرطي)؛ مثال: Ne seriez-vous pas Tom ? — ألست طوم؟"},{"btype":"example","text":"vivons = حَيِيَ","note":"صيغة من vivre (الجمع، المتكلّم، المضارع)؛ مثال: Nous vivons ici. — نعيش هنا."},{"btype":"example","text":"connaissait = عَرَفَ، دَرَى","note":"صيغة من connaître (الغائب، الماضي المستمرّ)؛ مثال: Il me connaissait. — كان يعرفني."},{"btype":"example","text":"premiers = أَوَّل","note":"صيغة من premier (الجمع، المذكّر)"},{"btype":"example","text":"lourd = ثَقِيل","note":"مثال: Qu'est-ce que tu es lourd ! — كم ثقيل أنت."},{"btype":"example","text":"regardent = نَظَرَ","note":"صيغة من regarder (الجمع، الغائب، صيغة الالتماس (الشرطية))"},{"btype":"example","text":"timide = خَجُول","note":"مثال: Je ne suis pas timide. — لست خجولا."},{"btype":"example","text":"aimons = حَبَّ","note":"صيغة من aimer (الجمع، المتكلّم، المضارع)؛ مثال: Nous aimons tous Tom. — جميعنا نحبّ توم."},{"btype":"example","text":"mec = رَجُل","note":"مثال: Cette fête était super, mec ! — تلك الحفلة كانت مميزة، يا صاحِ!"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Nous vivons ici.","note":"نعيش هنا."},{"btype":"example","text":"Il me connaissait.","note":"كان يعرفني."},{"btype":"example","text":"Nous aimons tous Tom.","note":"جميعنا نحبّ توم."},{"btype":"example","text":"Nous aimons la neige.","note":"نحب الثلج."},{"btype":"example","text":"Je ne suis pas timide.","note":"لست خجولا."},{"btype":"example","text":"Je suis un peu timide.","note":"أنا خجول قليلاً."},{"btype":"example","text":"Nous vous aimons tant.","note":"نحبّك كثيرا."},{"btype":"example","text":"Nous aimons les arbres.","note":"نحن نحب الأشجار."},{"btype":"example","text":"Ne seriez-vous pas Tom ?","note":"ألست طوم؟"},{"btype":"example","text":"Nous aimons nos enfants.","note":"نحن نحب أولادنا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Nous vivons ici.","ar":"نعيش هنا."},{"t":"Il me connaissait.","ar":"كان يعرفني."},{"t":"Nous aimons tous Tom.","ar":"جميعنا نحبّ توم."},{"t":"Nous aimons la neige.","ar":"نحب الثلج."},{"t":"Je ne suis pas timide.","ar":"لست خجولا."},{"t":"Je suis un peu timide.","ar":"أنا خجول قليلاً."},{"t":"Nous vous aimons tant.","ar":"نحبّك كثيرا."},{"t":"Nous aimons les arbres.","ar":"نحن نحب الأشجار."},{"t":"Ne seriez-vous pas Tom ?","ar":"ألست طوم؟"},{"t":"Nous aimons nos enfants.","ar":"نحن نحب أولادنا."},{"t":"Regarde ces nuages noirs.","ar":"أنظر إلى تلك الغيوم السوداء."},{"t":"Nous aimons faire du vélo.","ar":"نحب ركوب دراجاتنا."},{"t":"Qu'est-ce que tu es lourd !","ar":"كم ثقيل أنت."},{"t":"Cette fête était super, mec !","ar":"تلك الحفلة كانت مميزة، يا صاحِ!"},{"t":"Ce garçon a les cheveux noirs.","ar":"شعر ذاك الولد أسود."},{"t":"Nous nous aimons l'un l'autre.","ar":"نحن نحب بعضنا البعض."},{"t":"Il ne connaissait pas la fille.","ar":"لم يكن يعرف تلك الفتاة."},{"t":"Tom a dit qu'il connaissait Mary.","ar":"توم قال أنه يعرف ماري"},{"t":"Elle était une fille très timide.","ar":"كان من طبيعتها أنها فتاة خجولة جداً."},{"t":"Les cheveux de ce garçon sont noirs.","ar":"شعر ذاك الفتى أسود."},{"t":"Elle m'a dit qu'elle connaissait mon frère.","ar":"أخبرتني بأنها تعرف أخي."},{"t":"Nous avons un chat. Nous aimons tous les chats.","ar":"عندنا قط. كلنا نحب القطط."},{"t":"Il est facile de parler quand on n’est pas timide.","ar":"من السهل التحدث عندما لا تكون خجولاً."},{"t":"Aussi longtemps que nous vivons, nous devons travailler.","ar":"طالما أننا نعيش، علينا أن نعمل."},{"t":"Sami regarda par la fenêtre et vit deux hommes noirs courir.","ar":"نظر سامي عبر النّافذة، فرأى رجلان أسودان يجريان."}],"focus":["noirs","seriez","vivons","connaissait","premiers","lourd","regardent","timide","aimons","mec"],"words":[{"word":"lourd","topic":"L126","difficulty":1,"meaning":"ثَقِيل","example":"Qu'est-ce que tu es lourd !","translation":"كم ثقيل أنت."},{"word":"timide","topic":"L126","difficulty":1,"meaning":"خَجُول","example":"Je ne suis pas timide.","translation":"لست خجولا."},{"word":"mec","topic":"L126","difficulty":1,"meaning":"رَجُل","example":"Cette fête était super, mec !","translation":"تلك الحفلة كانت مميزة، يا صاحِ!"}],"difficulty":1}}