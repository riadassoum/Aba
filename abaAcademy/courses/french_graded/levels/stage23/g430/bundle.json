{"theory":{"blocks":[{"btype":"text","text":"الدرس 430. الكلمات الجديدة: divisé، pleures، bureaux، vanter، facilité، financières، prévisions، s'excuser، accepta، quittes."},{"btype":"example","text":"divisé = قَسَّمَ","note":"صيغة من diviser (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"pleures = بَكَى","note":"صيغة من pleurer (المخاطب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Pourquoi pleures-tu ? — لماذا تبكي؟"},{"btype":"example","text":"bureaux = مَكْتَب","note":"صيغة من bureau (الجمع)؛ مثال: Ce sont nos bureaux. — هذه مكاتبنا."},{"btype":"example","text":"vanter = تَفَاخَرَ","note":"مثال: Il n'aime pas se vanter. — هو لا يحب التباهي."},{"btype":"example","text":"facilité = سُهُولَة","note":""},{"btype":"example","text":"financières = مَالِيّ","note":"صيغة من financier (الجمع)؛ مثال: Ils souffrent de difficultés financières. — إنهم يعانون من صعوبات مالية."},{"btype":"example","text":"prévisions = تَوَقُّع","note":"صيغة من prévision (الجمع)؛ مثال: Quelles sont les prévisions météo ? — ما توقعات الطقس؟"},{"btype":"example","text":"s'excuser = اِعْتَذَرَ","note":"مثال: Sami doit s'excuser. — يجب على سامي أن يعتذر."},{"btype":"example","text":"accepta = قَبِلَ","note":"صيغة من accepter (الغائب، الماضي)؛ مثال: Elle accepta sa demande en mariage. — قبلت أن تتزوج به."},{"btype":"example","text":"quittes = تَرَكَ","note":"صيغة من quitter (المخاطب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Nous sommes quittes. — نحن بخير."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ce sont nos bureaux.","note":"هذه مكاتبنا."},{"btype":"example","text":"Sami doit s'excuser.","note":"يجب على سامي أن يعتذر."},{"btype":"example","text":"Nous sommes quittes.","note":"نحن بخير."},{"btype":"example","text":"Pourquoi pleures-tu ?","note":"لماذا تبكي؟"},{"btype":"example","text":"Il devrait s'excuser.","note":"ينبغي أن يعتذر."},{"btype":"example","text":"Il n'aime pas se vanter.","note":"هو لا يحب التباهي."},{"btype":"example","text":"Quelles sont les prévisions météo ?","note":"ما توقعات الطقس؟"},{"btype":"example","text":"Elle accepta sa demande en mariage.","note":"قبلت أن تتزوج به."},{"btype":"example","text":"Elle sourit et accepta mon petit cadeau.","note":"ابتسمت وقبلت هديتي الصغيرة."},{"btype":"example","text":"Ils souffrent de difficultés financières.","note":"إنهم يعانون من صعوبات مالية."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Ce sont nos bureaux.","ar":"هذه مكاتبنا."},{"t":"Sami doit s'excuser.","ar":"يجب على سامي أن يعتذر."},{"t":"Nous sommes quittes.","ar":"نحن بخير."},{"t":"Pourquoi pleures-tu ?","ar":"لماذا تبكي؟"},{"t":"Il devrait s'excuser.","ar":"ينبغي أن يعتذر."},{"t":"Il n'aime pas se vanter.","ar":"هو لا يحب التباهي."},{"t":"Quelles sont les prévisions météo ?","ar":"ما توقعات الطقس؟"},{"t":"Elle accepta sa demande en mariage.","ar":"قبلت أن تتزوج به."},{"t":"Elle sourit et accepta mon petit cadeau.","ar":"ابتسمت وقبلت هديتي الصغيرة."},{"t":"Ils souffren