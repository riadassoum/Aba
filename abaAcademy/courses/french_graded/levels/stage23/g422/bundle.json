{"theory":{"blocks":[{"btype":"text","text":"الدرس 422. الكلمات الجديدة: graisse، prirent، craignait، rapporter، chassé، portons، supprimé، monstres، flic، gagnant."},{"btype":"example","text":"graisse = دُهْن","note":""},{"btype":"example","text":"prirent = تَنَاوَلَ","note":"صيغة من prendre (الجمع، الغائب، الماضي)"},{"btype":"example","text":"craignait = خَافَ","note":"صيغة من craindre (الغائب، الماضي المستمرّ)؛ مثال: Sami craignait pour sa vie. — كان سامي يخشى على حياته."},{"btype":"example","text":"rapporter = وَصَفَ","note":""},{"btype":"example","text":"chassé = اِصْطَادَ","note":"صيغة من chasser (اسم المفعول (التصريف الثالث))؛ مثال: Ziri a chassé Rima. — طارد زيري ريمة."},{"btype":"example","text":"portons = لَبِسَ","note":"صيغة من porter (الجمع، المتكلّم، المضارع)؛ مثال: Nous portons des bijoux chers. — نحن نرتدي حليا غاليا."},{"btype":"example","text":"supprimé = حَذَفَ","note":"صيغة من supprimer (اسم المفعول (التصريف الثالث))؛ مثال: Yanni a supprimé son compte. — حذف ياني حسابه."},{"btype":"example","text":"monstres = وَحْش","note":"صيغة من monstre (الجمع)؛ مثال: Leur fille prétend voir des monstres. — تقول ابنتهم أنها ترى وحوشا."},{"btype":"example","text":"flic = شُرْطِيّ","note":"مثال: T'as l'air d'un flic. — تبدو وكأنك شرطيٌّ."},{"btype":"example","text":"gagnant = فَائِز","note":"مثال: Dans une guerre, il n'y a pas de gagnant. — في الحرب، الجميع يخسر."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ziri a chassé Rima.","note":"طارد زيري ريمة."},{"btype":"example","text":"T'as l'air d'un flic.","note":"تبدو وكأنك شرطيٌّ."},{"btype":"example","text":"Sami craignait pour sa vie.","note":"كان سامي يخشى على حياته."},{"btype":"example","text":"Yanni a supprimé son compte.","note":"حذف ياني حسابه."},{"btype":"example","text":"Nous portons des bijoux chers.","note":"نحن نرتدي حليا غاليا."},{"btype":"example","text":"Leur fille prétend voir des monstres.","note":"تقول ابنتهم أنها ترى وحوشا."},{"btype":"example","text":"Dans une guerre, il n'y a pas de gagnant.","note":"في الحرب، الجميع يخسر."},{"btype":"example","text":"J'aimerais savoir pourquoi mon nom a été supprimé de la liste.","note":"أود معرفة سبب حذف اسمي من القائمة."},{"btype":"example","text":"C'est plus petit que ça.","note":"هذا أصغر من ذاك."},{"btype":"example","text":"As-tu entendu ça, Mike ?","note":"هل سمعت ذلك يا مايك؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"fr","lang_name":"الفرنسية","sentences":[{"t":"Ziri a chassé Rima.","ar":"طارد زيري ريمة."},{"t":"T'as l'air d'un flic.","ar":"تبدو وكأنك شرطيٌّ."},{"t":"Sami craignait pour sa vie.","ar":"كان سامي يخشى على حياته."},{"t":"Yanni a supprimé son compte.","ar":"حذف ياني حسابه."},{"t":"Nous portons des bijoux chers.","ar":"نحن نرتدي حليا غاليا."},{"t":"Leur fille prétend voir des monstres.","ar":"تقول ابنتهم أنها ترى وحوشا."},{"t":"Dans une guerre, il n'y a pas de gagnant.","ar":"في الحرب، الجميع يخسر."},{"t":"J'aimerais savoir pourquoi mon nom a été supprimé de la liste.","ar":"أود معرفة سبب حذف اسمي من القائمة."},{"t":"C'est plus petit que ça.","ar":"هذا أصغر من ذاك."},{"t":"As-tu entendu ça, Mike ?","ar":"هل سمعت ذلك يا مايك؟"},{"t":"Oui, je suis de Sapporo.","ar":"نعم أنا من سابورو."},{"t":"Cette maison est grande.","ar":"ذاك البيت كبير."}],"focus":["graisse","prirent","craignait","rapporter","chassé","portons","supprimé","monstres","flic","gagnant"],"words":[{"word":"graisse","topic":"L422","difficulty":3,"meaning":"دُهْن"},{"word":"rapporter","topic":"L422","difficulty":3,"meaning":"وَصَفَ"},{"word":"flic","topic":"L422","difficulty":3,"meaning":"شُرْطِيّ","example":"T'as l'air d'un flic.","translation":"تبدو وكأنك شرطيٌّ."},{"word":"gagnant","topic":"L422","difficulty":3,"meaning":"فَائِز","example":"Dans une guerre, il n'y a pas de gagnant.","translation":"في الحرب، الجميع يخسر."}],"difficulty":3}}