{"theory":{"blocks":[{"btype":"text","text":"الدرس 434. الكلمات الجديدة: oturup، gitmen، nesi، patlak، yüzebilir، etmeli، edebilirsin، çalmaya، arkadaşına، saatimi."},{"btype":"example","text":"oturup","note":"مثال: Oturup bekliyoruz. — سنجلس و ننتظر."},{"btype":"example","text":"gitmen","note":"مثال: Gitmen iyi olur. — من الأفضل لك أن تغادر."},{"btype":"example","text":"nesi","note":"مثال: Bir elin nesi var, iki elin sesi var. — رأسان أفضل من رأس واحد."},{"btype":"example","text":"patlak","note":"مثال: Savaş aniden patlak verdi. — اِندلعت الحرب فجأة."},{"btype":"example","text":"yüzebilir","note":"مثال: O yüzebilir. — هو يستطيع أن يسبح."},{"btype":"example","text":"etmeli","note":"مثال: Kral terk etmeli. — الملك يجب أن يتنازل عن العرش."},{"btype":"example","text":"edebilirsin","note":"مثال: Beni yarın ziyaret edebilirsin. — بإمكانك زيارتي غداً."},{"btype":"example","text":"çalmaya","note":"مثال: Çalmaya devam et. — واصل اللّعب."},{"btype":"example","text":"arkadaşına","note":"مثال: Leyla mektubu yakın arkadaşına yazdı. — كتبت ليلى تلك الرّسائل لصديق مقرّب."},{"btype":"example","text":"saatimi","note":"مثال: Saatimi bulamıyorum. — لا أستطيع أن أجد ساعتي."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"O yüzebilir.","note":"هو يستطيع أن يسبح."},{"btype":"example","text":"Gitmen iyi olur.","note":"من الأفضل لك أن تغادر."},{"btype":"example","text":"Emily yüzebilir.","note":"تستطيع إيميلي أن تسبح."},{"btype":"example","text":"Kral terk etmeli.","note":"الملك يجب أن يتنازل عن العرش."},{"btype":"example","text":"Çalmaya devam et.","note":"واصل اللّعب."},{"btype":"example","text":"Oturup bekliyoruz.","note":"سنجلس و ننتظر."},{"btype":"example","text":"Sen yüzebilir misin?","note":"هل تستطيع السباحة؟"},{"btype":"example","text":"Saatimi bulamıyorum.","note":"لا أستطيع أن أجد ساعتي."},{"btype":"example","text":"O, sırt üstü yüzebilir.","note":"يعرف السباحة على ظهره."},{"btype":"example","text":"Ziri çalmaya devam etti.","note":"واصل زيري السرقة."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"O yüzebilir.","ar":"هو يستطيع أن يسبح."},{"t":"Gitmen iyi olur.","ar":"من الأفضل لك أن تغادر."},{"t":"Emily yüzebilir.","ar":"تستطيع إيميلي أن تسبح."},{"t":"Kral terk etmeli.","ar":"الملك يجب أن يتنازل عن العرش."},{"t":"Çalmaya devam et.","ar":"واصل اللّعب."},{"t":"Oturup bekliyoruz.","ar":"سنجلس و ننتظر."},{"t":"Sen yüzebilir misin?","ar":"هل تستطيع السباحة؟"},{"t":"Saatimi bulamıyorum.","ar":"لا أستطيع أن أجد ساعتي."},{"t":"O, sırt üstü yüzebilir.","ar":"يعرف السباحة على ظهره."},{"t":"Ziri çalmaya devam etti.","ar":"واصل زيري السرقة."},{"t":"Eve gitmen gerekmiyor mu?","ar":"يجب ان تذهب للبيت؟"},{"t":"Tom para çalmaya başladı.","ar":"بدأ توم يسرق المال."},{"t":"Savaş aniden patlak verdi.","ar":"اِندلعت الحرب فجأة."},{"t":"Gerçekten yüzebilir misin?","ar":"هل يمكنك أن تسبح حقاً؟"},{"t":"Savaş sonunda patlak verdi.","ar":"اِندلعت الحرب أخيراً."},{"t":"Umarım savaş patlak vermez.","ar":"آمل ألا تنشب الحرب."},{"t":"Ben çalar saatimi duymadım.","ar":"أنا لم أسمع المنبه."},{"t":"Tom, Mary'ye teşekkür etmeli.","ar":"ينبغي أن يشكر توم ماري."},{"t":"Onu açmak birkaç saatimi aldı.","ar":"احتجت لعدة ساعات كي أفتحه."},{"t":"Tom gitmen gerektiğini söyledi.","ar":"قال توم بانك تحتاج ان تذهب."},{"t":"Beni yarın ziyaret edebilirsin.","ar":"بإمكانك زيارتي غداً."},{"t":"Savaş 1941 yılında patlak verdi.","ar":"اِندلعت الحرب عام ١٩٤١م."},{"t":"Savaş 1939 yılında patlak verdi.","ar":"اِندلعت الحرب عام ١٩٣٩م."},{"t":"Dün gece bir yangın patlak verdi.","ar":"اندلع حريق الليلة الماضية."},{"t":"Kız kardeşim çok hızlı yüzebilir.","ar":"أختي تستطيع السباحة بسرعة كثيرة."},{"t":"Onun kadar hızlı yüzebilir misin?","ar":"أيمكنك أن تجاري سرعته في السباحة؟"},{"t":"Bunu tamir edebilirsin, değil mi?","ar":"تستطيع تصليحه، أليس كذلك؟"},{"t":"Onun tavsiyesini takip edebilirsin.","ar":"ينبغي أن تعمل بنصيحته."},{"t":"Bir elin nesi var, iki elin sesi var.","ar":"رأسان أفضل من رأس واحد."},{"t":"Leyla mektubu yakın arkadaşına yazdı.","ar":"كتبت ليلى تلك الرّسائل لصديق مقرّب."}],"focus":["oturup","gitmen","nesi","patlak","yüzebilir","etmeli","edebilirsin","çalmaya","arkadaşına","saatimi"],"words":[],"difficulty":4}}