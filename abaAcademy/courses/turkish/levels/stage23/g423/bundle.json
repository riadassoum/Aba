{"theory":{"blocks":[{"btype":"text","text":"الدرس 423. الكلمات الجديدة: saçımı، yaparız، görevi، benimki، İngilizcede، etmiyorsun، yazıyorum، çantası، duyduğunu، hatırlamıyor."},{"btype":"example","text":"saçımı","note":""},{"btype":"example","text":"yaparız","note":"مثال: Biz hatalar yaparız. — نحن نرتكب اخطاء."},{"btype":"example","text":"görevi","note":"مثال: Onlar görevi bize verdi. — كلفونا بهذا العمل."},{"btype":"example","text":"benimki","note":"مثال: O benimki. — هذه ملكي."},{"btype":"example","text":"İngilizcede","note":""},{"btype":"example","text":"etmiyorsun","note":"مثال: Bunu neden kabul etmiyorsun? — لم لا تقبل بذلك؟"},{"btype":"example","text":"yazıyorum","note":"مثال: Kitap yazıyorum. — أنا أكتب كتاباً."},{"btype":"example","text":"çantası","note":"مثال: Bu kimin çantası? — لمن هذه الحقيبة؟"},{"btype":"example","text":"duyduğunu","note":"مثال: Benim hakkımda ne duyduğunu bilmiyorum. — لا أعلم ما الذي سمعته عني."},{"btype":"example","text":"hatırlamıyor","note":"مثال: Onu hatırlamıyor musun? — ألا تتذكره؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"O benimki.","note":"هذه ملكي."},{"btype":"example","text":"Kitap yazıyorum.","note":"أنا أكتب كتاباً."},{"btype":"example","text":"Bu benimki değil.","note":"ليس ملكي."},{"btype":"example","text":"Ben ne yazıyorum?","note":"ماذا أكتب؟"},{"btype":"example","text":"Bu kimin çantası?","note":"لمن هذه الحقيبة؟"},{"btype":"example","text":"Biz hatalar yaparız.","note":"نحن نرتكب اخطاء."},{"btype":"example","text":"Bu ev benimki değil.","note":"هذا البيت ليس لي."},{"btype":"example","text":"Hepimiz hata yaparız.","note":"كلنا نخطئ."},{"btype":"example","text":"Bir makale yazıyorum.","note":"إني أكتب مقالا."},{"btype":"example","text":"Onu hatırlamıyor musun?","note":"ألا تتذكره؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"ph