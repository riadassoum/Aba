{"theory":{"blocks":[{"btype":"text","text":"الدرس 507. الكلمات الجديدة: zam، düşünemiyorum، endişeliydi، yapmamam، çılgınca، gördüğün، görünüyorum، süresi، kapatın، edilmiştir."},{"btype":"example","text":"zam","note":""},{"btype":"example","text":"düşünemiyorum","note":"مثال: Uygun bir örnek düşünemiyorum. — لا أستطيع أن أفكر في مثال مناسب."},{"btype":"example","text":"endişeliydi","note":"مثال: O, onun sağlığı hakkında endişeliydi. — كانت قلقة بشأن صحته."},{"btype":"example","text":"yapmamam","note":"مثال: Onu yapmamam için bir neden yok. — لا يوجد سبب لئلا أفعله."},{"btype":"example","text":"çılgınca","note":"مثال: O yeri çılgınca seviyorum. — أنا أعشق هذا المكان."},{"btype":"example","text":"gördüğün","note":""},{"btype":"example","text":"görünüyorum","note":"مثال: Nasıl görünüyorum? — كيف أبدو؟"},{"btype":"example","text":"süresi","note":""},{"btype":"example","text":"kapatın","note":"مثال: Lütfen kapıyı kapatın. — من فضلك أغلق الباب."},{"btype":"example","text":"edilmiştir","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Nasıl görünüyorum?","note":"كيف أبدو؟"},{"btype":"example","text":"Lütfen kapıyı kapatın.","note":"من فضلك أغلق الباب."},{"btype":"example","text":"Kapıyı kapatın, lütfen.","note":"أغلق الباب من فضلك."},{"btype":"example","text":"O yeri çılgınca seviyorum.","note":"أنا أعشق هذا المكان."},{"btype":"example","text":"Uygun bir örnek düşünemiyorum.","note":"لا أستطيع أن أفكر في مثال مناسب."},{"btype":"example","text":"Onu yapmamam için bir neden yok.","note":"لا يوجد سبب لئلا أفعله."},{"btype":"example","text":"Şaka yapıyor gibi mi görünüyorum?","note":"هل يبدو لك بأني أمزح؟"},{"btype":"example","text":"O, onun sağlığı hakkında endişeliydi.","note":"كانت قلقة بشأن صحته."},{"btype":"example","text":"Tom bana onu yapmamam gerektiğini söyledi.","note":"أخبرني توم بألّا أفعل ذلك أبدًا."},{"btype":"example","text":"\"Tom, ne yapıyorsun?\" \"Ne yapıyor gibi görünüyorum?\"","note":"\"توم، ماذا تفعل؟\" \"ماذا يبدو أنني أفعل؟\""}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Nasıl görünüyorum?","ar":"كيف أبدو؟"},{"t":"Lütfen kapıyı kapatın.","ar":"من فضلك أغلق الباب."},{"t":"Kapıyı kapatın, lütfen.","ar":"أغلق الباب من فضلك."},{"t":"O yeri çılgınca seviyorum.","ar":"أنا أعشق هذا المكان."},{"t":"Uygun bir örnek düşünemiyorum.","ar":"لا أستطيع أن أفكر في مثال مناسب."},{"t":"Onu yapmamam için bir neden yok.","ar":"لا يوجد سبب لئلا أفعله."},{"t":"Şaka yapıyor gibi mi görünüyorum?","ar":"هل يبدو لك بأني أمزح؟"},{"t":"O, onun sağlığı hakkında endişeliydi.","ar":"كانت قلقة بشأن صحته."},{"t":"Tom bana onu yapmamam gerektiğini söyledi.","ar":"أخبرني توم بألّا أفعل ذلك أبدًا."},{"t":"\"Tom, ne yapıyorsun?\" \"Ne yapıyor gibi görünüyorum?\"","ar":"\"توم، ماذا تفعل؟\" \"ماذا يبدو أنني أفعل؟\""}],"focus":["zam","düşünemiyorum","endişeliydi","yapmamam","çılgınca","gördüğün","görünüyorum","süresi","kapatın","edilmiştir"],"words":[],"difficulty":4}}