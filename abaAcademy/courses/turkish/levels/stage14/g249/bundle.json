n dikkatlice dinle.","ar":"ليس لدينا الكثير من الوقت لذا أنصت لي جيدا."},{"t":"Sen hiç Esperanto dilini konuşan birini duydun mu?","ar":"هل سبق و أن سمعت شخصا يتكلم بالإسبيرانتو؟"}],"focus":["zamanımız","geldiği","etmemi","izliyor","geriye","büyüdü","duydun","sessizce","kızım","Avrupa"],"words":[{"word":"geriye","topic":"L249","difficulty":3,"meaning":"إِلَى اَلْخَلْف"},{"word":"Avrupa","topic":"L249","difficulty":3,"meaning":"أُورُوبَّا"}],"difficulty":3}}