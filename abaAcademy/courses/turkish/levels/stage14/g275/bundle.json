فة."},{"t":"O, kapının arkasında duruyordu.","ar":"وقف وراء الباب."},{"t":"Leyla yolun ortasında duruyordu.","ar":"كانت ليلى واقفة وسط الطّريق."},{"t":"Sadece onu eve götürmek istiyoruz.","ar":"لا نريد إلا أخذها لبيتها."},{"t":"Fadıl, İslam hakkında hiçbir şey bilmiyordu.","ar":"لم يكن فاضل يعرف أيّ شيء عن الإسلام."},{"t":"Fadıl, İslam hakkındaki her şeyi öğrenmek istedi.","ar":"أراد فاضل أن يعرف كلّ شيء عن الإسلام."},{"t":"Sami, Leyla'yı hastaneye götürmek için ısrar etti.","ar":"ألحّ سامي على نقل ليلى للمستشفى."},{"t":"Çok geç olmadan önce onu hastaneye götürmek zorundayız.","ar":"علينا أن نوصله إلى المستشفى قبل أن يفوت الأوان."}],"focus":["dağ","duruyordu","götürmek","sahibiz","söylemelisin","paranın","sırt","İslam","mutlaka","söylememi"],"words":[{"word":"dağ","topic":"L275","difficulty":4,"meaning":"جَبَل","example":"Bu dağ çok yüksek değil.","translation":"هذا الجبل ليس عاليا جدا."},{"word":"götürmek","topic":"L275","difficulty":4,"meaning":"أَخَذَ","example":"Sadece onu eve götürmek istiyoruz.","translation":"لا نريد إلا أخذها لبيتها."},{"word":"sırt","topic":"L275","difficulty":4,"meaning":"ظَهْر"},{"word":"İslam","topic":"L275","difficulty":4,"meaning":"الْإِسْلَام","example":"İslam nedir?","translation":"ما هو الإسلام؟"}],"difficulty":4}}