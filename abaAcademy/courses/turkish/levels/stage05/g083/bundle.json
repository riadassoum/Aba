{"theory":{"blocks":[{"btype":"text","text":"الدرس 83. الكلمات الجديدة: ortak، altına، sene، sağlık، sınıfta، kendin، gazete، başlar، endişe، kişisel."},{"btype":"example","text":"ortak = شَرِيك","note":""},{"btype":"example","text":"altına = ذَهَب","note":"صيغة من altın (حالة المفعول غير المباشر)"},{"btype":"example","text":"sene = أَعْوَام","note":""},{"btype":"example","text":"sağlık = صِحَّة","note":""},{"btype":"example","text":"sınıfta = صِنْف، طَبَقَة","note":"صيغة من sınıf؛ مثال: Onlar sınıfta. — هم في القسم."},{"btype":"example","text":"kendin = نفسكَ","note":"مثال: Kendin ol! — كن نفسك!"},{"btype":"example","text":"gazete = جَرِيدَة","note":"مثال: Gazete nerede? — أَيْنَ الْجَرِيدَةُ؟"},{"btype":"example","text":"başlar = رَأْس","note":"صيغة من baş (الجمع)؛ مثال: Ne zaman başlar? — متى تبدأ؟"},{"btype":"example","text":"endişe = قَلَق","note":"مثال: Onu hakkında endişe ediyorum. — إنني قلق عليه."},{"btype":"example","text":"kişisel = شَخْصِيّ","note":"مثال: Kişisel olarak sizi ziyaret edeceğim. — سأزورك بنفسي."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Kendin ol!","note":"كن نفسك!"},{"btype":"example","text":"Onlar sınıfta.","note":"هم في القسم."},{"btype":"example","text":"Gazete nerede?","note":"أَيْنَ الْجَرِيدَةُ؟"},{"btype":"example","text":"Ne zaman başlar?","note":"متى تبدأ؟"},{"btype":"example","text":"Film ne zaman başlar?","note":"متى سيبدأ الفيلم؟"},{"btype":"example","text":"Yeni öğretmen sınıfta.","note":"المدرس الجديد في الفصل."},{"btype":"example","text":"Onu sınıfta yer misin?","note":"أتأكل في صفك؟"},{"btype":"example","text":"O, gazete okumayı sever.","note":"يحب قراءة الصحف."},{"btype":"example","text":"Bu sınıfta kaç çocuk var?","note":"كم ولداً موجود في هذا الصف؟"},{"btype":"example","text":"Sen sınıfta yemek yer misin?","note":"هل تأكل في الفصل؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data"