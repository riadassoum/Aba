{"theory":{"blocks":[{"btype":"text","text":"الدرس 96. الكلمات الجديدة: şeker، ediyorsun، şeyim، arasındaki، kapalı، sağ، çiçek، bilmediğini، oyunu، varsa."},{"btype":"example","text":"şeker = حَلْوَى","note":"مثال: Şeker almayı unuttum. — نسيتُ شراء السكّر."},{"btype":"example","text":"ediyorsun","note":"مثال: Onu hak ediyorsun. — تستحق ذلك."},{"btype":"example","text":"şeyim","note":"مثال: O benim her şeyim. — هذا كل ما املك"},{"btype":"example","text":"arasındaki","note":""},{"btype":"example","text":"kapalı = غائم","note":"مثال: Kapı kapalı. — الباب مغلق."},{"btype":"example","text":"sağ = يَمِين","note":""},{"btype":"example","text":"çiçek = زَهْرَة","note":"مثال: Çiçek kırmızı. — الزّهرة حمراء."},{"btype":"example","text":"bilmediğini","note":"مثال: Ne olduğunu bilmediğini mi demek istiyorsun? — هل تقصد أنك لا تعرف ماذا حدث؟"},{"btype":"example","text":"oyunu = لَعِب، مَسْرَحِيَّة","note":"صيغة من oyun (حالة المفعول به)؛ مثال: Futbol oyunu yarın. — ماتش كرة القدم غدا."},{"btype":"example","text":"varsa","note":"مثال: Su varsa, hayat var. — حيث يوجد الماء، توجد الحياة؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Kapı kapalı.","note":"الباب مغلق."},{"btype":"example","text":"Çiçek kırmızı.","note":"الزّهرة حمراء."},{"btype":"example","text":"Onu hak ediyorsun.","note":"تستحق ذلك."},{"btype":"example","text":"O benim her şeyim.","note":"هذا كل ما املك"},{"btype":"example","text":"Futbol oyunu yarın.","note":"ماتش كرة القدم غدا."},{"btype":"example","text":"Bu oyunu bilmiyorum.","note":"لا أعرفُ هذه اللعبَةَ."},{"btype":"example","text":"Su varsa, hayat var.","note":"حيث يوجد الماء، توجد الحياة؟"},{"btype":"example","text":"Şeker almayı unuttum.","note":"نسيتُ شراء السكّر."},{"btype":"example","text":"Yapacak çok şeyim var.","note":"لدي الكثير من الأشياء لأفعلها."},{"btype":"example","text":"Ne güzel bir çiçek bu!","note":"ما أجمل هذه الزهرة!"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Kapı kapalı.","ar":"الباب مغلق."},{"t":"Çiçek kırmızı.","ar":"الزّهرة حمراء."},{"t":"Onu hak ediyorsun.","ar":"تستحق ذلك."},{"t":"O benim her şeyim.","ar":"هذا كل ما املك"},{"t":"Futbol oyunu yarın.","ar":"ماتش كرة القدم غدا."},{"t":"Bu oyunu bilmiyorum.","ar":"لا أعرفُ هذه اللعبَةَ."},{"t":"Su varsa, hayat var.","ar":"حيث يوجد الماء، توجد الحياة؟"},{"t":"Şeker almayı unuttum.","ar":"نسيتُ شراء السكّر."},{"t":"Yapacak çok şeyim var.","ar":"لدي الكثير من الأشياء لأفعلها."},{"t":"Ne güzel bir çiçek bu!","ar":"ما أجمل هذه الزهرة!"},{"t":"Sen beni mutlu ediyorsun.","ar":"أنت تجعلني سعيداً."},{"t":"Her şeyden nefret ediyorsun","ar":"انت تكره كل شيء."},{"t":"Niçin öyle acele ediyorsun?","ar":"لم أنت مستعجل؟"},{"t":"Her şeyden nefret ediyorsun.","ar":"انت تكره كل شيء."},{"t":"Kapı bütün gün kapalı kaldı.","ar":"بقي الباب مغلقًا طوال اليوم."},{"t":"Bu güzel bir çiçek, değil mi?","ar":"هذه زهرة جميلة، اليس كذالك؟"},{"t":"Başarılı olmayı hak ediyorsun.","ar":"تستحق أن تنجح."},{"t":"Sana söyleyecek bir şeyim var.","ar":"أريد أن أقول لك شيئاً."},{"t":"Yapacak başka bir şeyim yoktu.","ar":"لم يكن لديّ أيّ شيء آخر أقوم به."},{"t":"Tom'a söyleyecek bir şeyim yok.","ar":"ليس عندي شيء أن أقوله لتوم."},{"t":"Her zaman sorunu tahmin ediyorsun.","ar":"دائماً ما تتوقع حدوث المشاكل."},{"t":"On kitap dışında hiçbir şeyim yok.","ar":"ليس عندي إلا عشرة كتب."},{"t":"Yapacak daha iyi hiçbir şeyim yok.","ar":"ليس لدي أي شيء أفضل للقيام به."},{"t":"Bir kapı ya kapalı ya da açık olmalı.","ar":"يجب أن يكون الباب إما مغلقا أو مفتوحا."},{"t":"Ne olduğunu bilmediğini mi demek istiyorsun?","ar":"هل تقصد أنك لا تعرف ماذا حدث؟"},{"t":"Mary, Tom'un bir kız arkadaşı varsa öğrenmek istedi.","ar":"أرادت ماري معرفة ما إن كان لِتوم حبيبة."},{"t":"\"O geliyor mu?\" \"Onun geldiğini sanmıyorum.\"","ar":"\"هل هو قادم؟\"، \"لا أظن أنه سيأتي.\""},{"t":"Bana bunun nasıl olduğunu söyleyebilir misin?","ar":"هل بإمكانك أن تخبرني كيف حدث هذا؟"},{"t":"Sizin güzel bir kız olduğunu söyleyebilir miyim?","ar":"أيمكنني القول بأنّك فتاة جميلة؟"},{"t":"Tom'un neden Boston'da olduğunu bana söyleyebilir misin?","ar":"هلّا أخبرتني عن سبب وجود توم في بوسطن؟"}],"focus":["şeker","ediyorsun","şeyim","arasındaki","kapalı","sağ","çiçek","bilmediğini","oyunu","varsa"],"words":[{"word":"şeker","topic":"L96","difficulty":2,"meaning":"حَلْوَى","example":"Şeker almayı unuttum.","translation":"نسيتُ شراء السكّر."},{"word":"kapalı","topic":"L96","difficulty":2,"meaning":"غائم","example":"Kapı kapalı.","translation":"الباب مغلق."},{"word":"sağ","topic":"L96","difficulty":2,"meaning":"يَمِين"},{"word":"çiçek","topic":"L96","difficulty":2,"meaning":"زَهْرَة","example":"Çiçek kırmızı.","translation":"الزّهرة حمراء."}],"difficulty":2}}