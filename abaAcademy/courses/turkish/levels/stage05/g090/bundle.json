{"theory":{"blocks":[{"btype":"text","text":"الدرس 90. الكلمات الجديدة: ilaç، gözden، sınavı، yazın، edersin، yürüyüş، kapının، yüzü، sandviç، istersin."},{"btype":"example","text":"ilaç = دَوَاء","note":"مثال: Leyla, Sami'ye ilaç verdi. — خدّرت ليلى سامي."},{"btype":"example","text":"gözden = عَيْن","note":"صيغة من göz"},{"btype":"example","text":"sınavı = اِمْتِحَان","note":"صيغة من sınav (حالة المفعول به)"},{"btype":"example","text":"yazın = كَتَبَ","note":"صيغة من yazmak (الجمع، المخاطب، الأمر)؛ مثال: Onu yazın. — اكتب ذلك."},{"btype":"example","text":"edersin = فَعَلَ","note":"صيغة من etmek (المخاطب)؛ مثال: Ne zaman kahvaltı edersin? — متى تتناول الافطار؟"},{"btype":"example","text":"yürüyüş = مَسِير","note":"مثال: Babam yürüyüş yapar. — أبي يمشي."},{"btype":"example","text":"kapının = أَبْوَاب","note":"صيغة من kapı (حالة الإضافة)"},{"btype":"example","text":"yüzü = وَجْه","note":"صيغة من yüz (حالة المفعول به)؛ مثال: Onun komik bir yüzü var. — وجهها مضحِك."},{"btype":"example","text":"sandviç = سَانْدَوِيتْش","note":"مثال: Sandviç için teşekkürler. — شكرًا على الشطيرة."},{"btype":"example","text":"istersin = أَرَادَ","note":"صيغة من istemek (المخاطب)؛ مثال: Ne yapmak istersin? — ماذا يريد أن يفعل؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Onu yazın.","note":"اكتب ذلك."},{"btype":"example","text":"Ne yapmak istersin?","note":"ماذا يريد أن يفعل؟"},{"btype":"example","text":"Babam yürüyüş yapar.","note":"أبي يمشي."},{"btype":"example","text":"Onun komik bir yüzü var.","note":"وجهها مضحِك."},{"btype":"example","text":"Nerede yaşamak istersin?","note":"أين تريد أن تعيش؟"},{"btype":"example","text":"Sandviç için teşekkürler.","note":"شكرًا على الشطيرة."},{"btype":"example","text":"Bugün ne yapmak istersin?","note":"ماذا تريد أن تفعل اليوم؟"},{"btype":"example","text":"Leyla, Sami'ye ilaç verdi.","note":"خدّرت ليلى سامي."},{"btype":"example","text":"Ne zaman kahvaltı edersin?","note":"متى تتناول الافطار؟"},{"btype":"example","text":"Önce nereye gitmek istersin?","note":"إلى أين تفضل أن تذهب أولاً؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Onu yazın.","ar":"اكتب ذلك."},{"t":"Ne yapmak istersin?","ar":"ماذا يريد أن يفعل؟"},{"t":"Babam yürüyüş yapar.","ar":"أبي يمشي."},{"t":"Onun komik bir yüzü var.","ar":"وجهها مضحِك."},{"t":"Nerede yaşamak istersin?","ar":"أين تريد أن تعيش؟"},{"t":"Sandviç için teşekkürler.","ar":"شكرًا على الشطيرة."},{"t":"Bugün ne yapmak istersin?","ar":"ماذا تريد أن تفعل اليوم؟"},{"t":"Leyla, Sami'ye ilaç verdi.","ar":"خدّرت ليلى سامي."},{"t":"Ne zaman kahvaltı edersin?","ar":"متى تتناول الافطار؟"},{"t":"Önce nereye gitmek istersin?","ar":"إلى أين تفضل أن تذهب أولاً؟"},{"t":"Bugün yemek için ne istersin?","ar":"ماذا تريد أن تأكل اليوم؟"},{"t":"Dan Linda'ya bir sandviç yaptı.","ar":"أعد دان سندويشا لليندة."},{"t":"Bütün aile bir yürüyüş için dışarıda.","ar":"خرجت العائلة كلّها لتتمشّى."},{"t":"Ben genellikle her sabah yürüyüş yaparım.","ar":"