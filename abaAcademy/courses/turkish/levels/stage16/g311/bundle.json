{"theory":{"blocks":[{"btype":"text","text":"الدرس 311. الكلمات الجديدة: hoşça، yaptırmak، sekizde، dene، ayakkabılar، türü، kurmak، gündü، döktü، istemek."},{"btype":"example","text":"hoşça","note":"مثال: Hoşça kalın. — مع السلامة!"},{"btype":"example","text":"yaptırmak","note":"مثال: Tom'un işi yaptırmak için kesinlikle yeterli zamanı var. — لا شك أن توم كان لديه وقت كاف لينجز العمل."},{"btype":"example","text":"sekizde","note":"مثال: Oyun saat sekizde. — ستبدأ المسرحية في الساعة الثامنة."},{"btype":"example","text":"dene = حَاوَلَ","note":"صيغة من denemek (المخاطب، الأمر)؛ مثال: Bir dene. — هاك، جرب."},{"btype":"example","text":"ayakkabılar = حِذَاء","note":"مثال: Ayakkabılar nerede? — أين الأحذية؟"},{"btype":"example","text":"türü = نوع","note":"صيغة من tür (حالة المفعول به)؛ مثال: En sevdiğin pizza türü nedir? — ما نوع البيتزا المفضّل لديك؟"},{"btype":"example","text":"kurmak = أَسَّسَ","note":"مثال: Hayal kurmak istiyorum. — أريد أن أحلم."},{"btype":"example","text":"gündü","note":"مثال: Dün iyi bir gündü. — كان البارحة يوما جيدا"},{"btype":"example","text":"döktü","note":""},{"btype":"example","text":"istemek = أَرَادَ","note":"مثال: Sadece onu istemek zorundasın. — ماعليك إلا ان تسأل."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Bir dene.","note":"هاك، جرب."},{"btype":"example","text":"Hoşça kalın.","note":"مع السلامة!"},{"btype":"example","text":"Hoşça kal dedi.","note":"قالت وداعا."},{"btype":"example","text":"Onu mutlaka dene.","note":"عليك أن تجربه."},{"btype":"example","text":"Oyun saat sekizde.","note":"ستبدأ المسرحية في الساعة الثامنة."},{"btype":"example","text":"Dün iyi bir gündü.","note":"كان البارحة يوما جيدا"},{"btype":"example","text":"Ayakkabılar nerede?","note":"أين الأحذية؟"},{"btype":"example","text":"Bu ayakkabılar onun.","note":"ذلك حذاءها."},{"btype":"example","text":"Hayal kurmak istiyorum.","note":"أريد أن أحلم."},{"btype":"example","text":"O, sabah sekizde kalktı.","note":"نهض من النوم في الساعة الثامنة صباحاً."}]}