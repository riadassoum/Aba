{"theory":{"blocks":[{"btype":"text","text":"الدرس 307. الكلمات الجديدة: denedi، yaşadığı، içtim، oğlunu، çalıştığı، sonuçları، itibaren، geldiğince، başından، mıydın."},{"btype":"example","text":"denedi","note":"مثال: O onu denedi. — لقد حاول ذلك."},{"btype":"example","text":"yaşadığı","note":"مثال: Bu onun yaşadığı yer. — هذا هو المكان الذي يعيش فيه."},{"btype":"example","text":"içtim","note":"مثال: Suyu içtim. — شربت الماء."},{"btype":"example","text":"oğlunu","note":"مثال: Tek oğlunu trafik kazasında kaybetti. — فقدتْ ابنها الوحيد في حادث مروري."},{"btype":"example","text":"çalıştığı","note":""},{"btype":"example","text":"sonuçları","note":""},{"btype":"example","text":"itibaren","note":""},{"btype":"example","text":"geldiğince","note":""},{"btype":"example","text":"başından","note":"مثال: O kitabı başından sonuna kadar okudu. — قرأ الكتاب من الجلدة إلى الجلدة."},{"btype":"example","text":"mıydın","note":"مثال: O zaman okulda mıydın? — أكنت في المدرسة في ذلك الوقت؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Suyu içtim.","note":"شربت الماء."},{"btype":"example","text":"O onu denedi.","note":"لقد حاول ذلك."},{"btype":"example","text":"Ben çay içtim.","note":"شربت شايً."},{"btype":"example","text":"Kahveyi içtim.","note":"شربت القهوة."},{"btype":"example","text":"Tom onu denedi.","note":"جرب توم ذلك."},{"btype":"example","text":"Mary onu denedi.","note":"جربت ماري ذلك."},{"btype":"example","text":"Onlar onu denedi.","note":"جربوا ذلك."},{"btype":"example","text":"Fadıl yine denedi.","note":"حاول فاضل مجدّدا."},{"btype":"example","text":"Bu onun yaşadığı yer.","note":"هذا هو المكان الذي يعيش فيه."},{"btype":"example","text":"O zaman okulda mıydın?","note":"أكنت في المدرسة في ذلك الوقت؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Suyu içtim.","ar":"شربت الماء."},{"t":"O onu denedi.","ar":"لقد حاول ذلك."},{"t":"Ben çay içtim.","ar":"شربت شايً."},{"t":"Kahveyi içtim.","ar":"شربت القهوة."},{"t":"Tom onu denedi.","ar":"جرب توم ذلك."},{"t":"Mary onu denedi.","ar":"جربت ماري ذلك."},{"t":"Onlar onu denedi.","ar":"جربوا ذلك."},{"t":"Fadıl yine denedi.","ar":"حاول فاضل مجدّدا."},{"t":"Bu onun yaşadığı yer.","ar":"هذا هو المكان الذي يعيش فيه."},{"t":"O zaman okulda mıydın?","ar":"أكنت في المدرسة في ذلك الوقت؟"},{"t":"Daha önce burada mıydın?","ar":"هل سبق وكنت هناك من قبل ؟"},{"t":"O, onu tekrar tekrar denedi.","ar":"جرّبها مرة بعد أخرى."},{"t":"Tom onu ne zaman yapmayı denedi?","ar":"متى حاول توم أن يفعل ذلك؟"},{"t":"Onun içinde yaşadığı bir evi yok.","ar":"ليس لديه بيت ليعيش فيه."},{"t":"Tek oğlunu trafik kazasında kaybetti.","ar":"فقدتْ ابنها الوحيد في حادث مروري."},{"t":"O kitabı başından sonuna kadar okudu.","ar":"قرأ الكتاب من الجلدة إلى الجلدة."},{"t":"Sami'nin, Leyla'nın yaşadığı yer hakkında hiç fikri yok.","ar":"ليست لدى سامي أدنى فكرة عن المكان الذي تعيش فيه ليلي."}],"focus":["denedi","yaşadığı","içtim","oğlunu","çalıştığı","sonuçları","itibaren","geldiğince","başından","mıydın"],"words":[],"difficulty":3}}