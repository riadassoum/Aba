im.","ar":"جون ليس أخي ، بل ابن عمي."}],"focus":["makinesini","ölecek","kararmadan","konuşabilirim","mektupları","kuzenim","diğerlerine","ödeyecek","mahkûm","geçtiğini"],"words":[{"word":"mahkûm","topic":"L535","difficulty":5,"meaning":"سَجِين","example":"Yargıç onu ölüme mahkûm etti.","translation":"حكم عليه القاضي بالإعدام."}],"difficulty":5}}