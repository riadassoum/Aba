":"Onların hepsi iyi öğretmen.","ar":"كلهم مدرّسون جيدون."},{"t":"O bir öğretmen olmak istedi.","ar":"أرادت أن تكون معلمةً."},{"t":"O, çalışmak zorunda değildir.","ar":"إنه لا يحتاج إلى أن يعمل."},{"t":"Dikkat et! Bir araba geliyor!","ar":"انتبه فثمّة سيارة قادمة!"},{"t":"Annem her zaman evde değildir.","ar":"أمي ليست موجودة في المنزل طيلة الوقت."},{"t":"Bunun ciddi olduğunu biliyorum.","ar":"أنا أعلم أنها كانت خطيرة"},{"t":"Belki o iyi bir öğretmen olacak.","ar":"لربما أصبح معلماً ماهراً."}],"focus":["gittim","annem","neydi","hoş","gelir","ciddi","çalışmak","dikkat","tavsiye","öğretmen"],"words":[{"word":"hoş","topic":"L45","difficulty":1,"meaning":"حَسَّن","example":"Tom çok hoş bir adam.","translation":"توم رجل ممتاز"},{"word":"gelir","topic":"L45","difficulty":1,"meaning":"دَخْل"},{"word":"ciddi","topic":"L45","difficulty":1,"meaning":"جِدِّيّ، جَدِّيّ","example":"O çok ciddi.","translation":"هذا جدي للغاية."},{"word":"çalışmak","topic":"L45","difficulty":1,"meaning":"عَمِلَ، سَارَ","example":"Çalışmak zorundayım.","translation":"عليّ أن أدرس."},{"word":"dikkat","topic":"L45","difficulty":1,"meaning":"اِهْتِمَام","example":"Dikkat!","translation":"انتباه !"},{"word":"tavsiye","topic":"L45","difficulty":1,"meaning":"تَوْصِيَة"},{"word":"öğretmen","topic":"L45","difficulty":1,"meaning":"مُعَلِّم","example":"O bir öğretmen.","translation":"هو مدرس."}],"difficulty":1}}