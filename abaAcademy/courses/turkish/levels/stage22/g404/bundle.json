.","ar":"أنا لست طبيباً."},{"t":"Doktor olmak istiyorum.","ar":"أريد أن أصير دكتورًا."},{"t":"Doktor sana ne söyledi?","ar":"ماذا أخبرك الطبيب؟"},{"t":"Sen bir doktor değilsin.","ar":"إنك لست طبيباً."},{"t":"Zengin olmak ister misin?","ar":"هل تريد أن تصبح غنياً؟"},{"t":"Tavsiye için teşekkürler.","ar":"شكرا على النصيحة."},{"t":"Tom ikna olmuş görünmüyor.","ar":"لا يبدو على توم أنه مقتنعٌ."},{"t":"Sami eve doğru yola çıktı.","ar":"توجّه سامي إلى المنزل."},{"t":"Neden tekrar yukarı çıktı?","ar":"لماذا عادت إلى الأعلى؟"},{"t":"Zengin olduğunu biliyorum.","ar":"أنا أعلم أنك غني"},{"t":"Zengin görünmek istiyorum.","ar":"أريد أن أبدو غنياً"},{"t":"O, zengin olmak istiyordu.","ar":"هو اراد ان يكون غنيا."},{"t":"Ben onu nadiren görüyorum.","ar":"أراها نادراً"}],"focus":["tepki","samimi","ters","sinir","çeviri","çalışan","boyu","değişiklik","enerji","proje"],"words":[{"word":"tepki","topic":"L404","difficulty":4,"meaning":"رَدّ فِعْل"},{"word":"samimi","topic":"L404","difficulty":4,"meaning":"مُخْلِص","example":"Çok az sayıda samimi arkadaşı var.","translation":"لها القليل من الأصدقاء المقربين."},{"word":"ters","topic":"L404","difficulty":4,"meaning":"عَكَسَ"},{"word":"sinir","topic":"L404","difficulty":4,"meaning":"عَصَب"},{"word":"çeviri","topic":"L404","difficulty":4,"meaning":"تَرْجَمَة","example":"Bu çeviri doğru mu?","translation":"هل هذه الترجمة صحيحة؟"},{"word":"çalışan","topic":"L404","difficulty":4,"meaning":"مُوَظَّف","example":"Bu çalışan bir sistem.","translation":"إنه نظامٌ يعمل."},{"word":"değişiklik","topic":"L404","difficulty":4,"meaning":"تَعْدِيل"},{"word":"enerji","topic":"L404","difficulty":4,"meaning":"طَاقَة","example":"Çocuklar enerji dolu.","translation":"الأطفالُ مفعمونَ بالطاقة."},{"word":"proje","topic":"L404","difficulty":4,"meaning":"مَشْرُوع","example":"Proje nasıl gidiyor?","translation":"كيف تسير أمور المشروع؟"}],"difficulty":4}}