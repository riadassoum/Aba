{"theory":{"blocks":[{"btype":"text","text":"الدرس 607. الكلمات الجديدة: vermiş، görüşünü، taraftan، fırsatım، gözüyle، patronu، odasının، heyecanlıydı، yeteneğine، birincilik."},{"btype":"example","text":"vermiş","note":""},{"btype":"example","text":"görüşünü","note":"مثال: Ben senin görüşünü istiyorum. — أريد أن أعرف رأيك."},{"btype":"example","text":"taraftan","note":"مثال: Bu taraftan. — من هنا."},{"btype":"example","text":"fırsatım","note":"مثال: Henüz filmi görme fırsatım olmadı. — لم تسنح لي الفرصة لمشاهدة الفيلم."},{"btype":"example","text":"gözüyle","note":""},{"btype":"example","text":"patronu","note":"مثال: Bu şirketin patronu kim? — من رئيس هذه الشركة؟"},{"btype":"example","text":"odasının","note":"مثال: Sami yatak odasının kapısını açtı. — فتح سامي باب غرفة النّوم."},{"btype":"example","text":"heyecanlıydı","note":"مثال: Sami çok heyecanlıydı. — سامي كان جداً متحمس."},{"btype":"example","text":"yeteneğine","note":"مثال: Ben gerçekten onun yeteneğine güveniyorum. — أنا حقاً أثق بقدرته."},{"btype":"example","text":"birincilik","note":"مثال: Birincilik ödülünü kazandım. — ربحت الجائزة الكبرى."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Bu taraftan.","note":"من هنا."},{"btype":"example","text":"Bu taraftan, efendim.","note":"من هنا، سيدي."},{"btype":"example","text":"Sami çok heyecanlıydı.","note":"سامي كان جداً متحمس."},{"btype":"example","text":"Bu şirketin patronu kim?","note":"من رئيس هذه الشركة؟"},{"btype":"example","text":"Araba sağ taraftan gelir.","note":"السيارة آتيه من ناحية اليمين."},{"btype":"example","text":"Birincilik ödülünü kazandım.","note":"ربحت الجائزة الكبرى."},{"btype":"example","text":"Ben senin görüşünü istiyorum.","note":"أريد أن أعرف رأيك."},{"btype":"example","text":"Henüz filmi görme fırsatım olmadı.","note":"لم تسنح لي الفرصة لمشاهدة الفيلم."},{"btype":"example","text":"Sami yatak odasının kapısını açtı.","note":"فتح سامي باب غرفة النّوم."},{"btype":"example","text":"Ben gerçekten onun yeteneğine güveniyorum.","note":"أنا حقاً أثق بقدرته."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Bu taraftan.","ar":"من هنا."},{"t":"Bu taraftan, efendim.","ar":"من هنا، سيدي."},{"t":"Sami çok heyecanlıydı.","ar":"سامي كان جداً متحمس."},{"t":"Bu şirketin patronu kim?","ar":"من رئيس هذه الشركة؟"},{"t":"Araba sağ taraftan gelir.","ar":"السيارة آتيه من ناحية اليمين."},{"t":"Birincilik ödülünü kazandım.","ar":"ربحت الجائزة الكبرى."},{"t":"Ben senin görüşünü istiyorum.","ar":"أريد أن أعرف رأيك."},{"t":"Henüz filmi görme fırsatım olmadı.","ar":"لم تسنح لي الفرصة لمشاهدة الفيلم."},{"t":"Sami yatak odasının kapısını açtı.","ar":"فتح سامي باب غرفة النّوم."},{"t":"Ben gerçekten onun yeteneğine güveniyorum.","ar":"أنا حقاً أثق بقدرته."},{"t":"Kitaplar onun odasının çoğunu meşgul ediyor.","ar":"تحتل الكتب أكبر مساحة في غرفته."},{"t":"Tom'un patronu onun çalışmasını takdir ediyor fakat ona zam vermek istemiyor.","ar":"يقدّر ربّ عمل سامي عمله ولكنه لا يريد أن يرفع أجره."}],"focus":["vermiş","görüşünü","taraftan","fırsatım","gözüyle","patronu","odasının","heyecanlıydı","yeteneğine","birincilik"],"words":[],"difficulty":5}}