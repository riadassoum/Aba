{"theory":{"blocks":[{"btype":"text","text":"الدرس 76. الكلمات الجديدة: arıyorum، işim، veriyorum، merhaba، sevmez، şirket، verdin، silah، fotoğraf، şanslı."},{"btype":"example","text":"arıyorum = دَعَا، اِتَّصَلَ بِـ","note":"صيغة من aramak (المتكلّم، المضارع)؛ مثال: Tom'u arıyorum. — أنا أبحث عن توم."},{"btype":"example","text":"işim = عَمَل","note":"صيغة من iş (المتكلّم)؛ مثال: Bu benim işim. — إن ذلك عملي."},{"btype":"example","text":"veriyorum = أَعْطَى","note":"صيغة من vermek (المتكلّم، المضارع)"},{"btype":"example","text":"merhaba = مرحبًا","note":"مثال: Merhaba Tom. — أهلا يا توم!"},{"btype":"example","text":"sevmez = أَحَبَّ","note":"صيغة من sevmek (الغائب، النفي)؛ مثال: O bizi sevmez. — إنه لا يحبنا."},{"btype":"example","text":"şirket = شَرِكَة","note":""},{"btype":"example","text":"verdin = أَعْطَى","note":"صيغة من vermek (الماضي، المخاطب)؛ مثال: Bana ne verdin? — ماذا أعطيتني؟"},{"btype":"example","text":"silah = سِلَاح","note":""},{"btype":"example","text":"fotoğraf = صُورَة","note":""},{"btype":"example","text":"şanslı = مَحْظُوظ","note":"مثال: Tom şanslı bir adam. — توم رجل محظوظ"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Merhaba Tom.","note":"أهلا يا توم!"},{"btype":"example","text":"Merhaba, Tom.","note":"مرحبا يا توم."},{"btype":"example","text":"Bu benim işim.","note":"إن ذلك عملي."},{"btype":"example","text":"O bizi sevmez.","note":"إنه لا يحبنا."},{"btype":"example","text":"Tom'u arıyorum.","note":"أنا أبحث عن توم."},{"btype":"example","text":"Kendi işim var.","note":"لديّ وظيفتي الخاصّة."},{"btype":"example","text":"Tekrar merhaba.","note":"مرحبا مجددا"},{"btype":"example","text":"Bana ne verdin?","note":"ماذا أعطيتني؟"},{"btype":"example","text":"Ben iş arıyorum.","note":"أبحث عن عمل."},{"btype":"example","text":"Ne cevap verdin?","note":"بماذا أجبت؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@