ak istemiyorum.","ar":"لا أريد قراءة أي شيء."},{"t":"Seni bu kadar emin yapan nedir?","ar":"ما الذي يجعلك واثق هكذا؟"},{"t":"Okumak için bir kitap istiyorum.","ar":"أريد كتاباً لأقرأ"},{"t":"Japon dili hakkında ne düşünüyorsun?","ar":"ما رأيك في اللغة اليابانية؟"},{"t":"Hangi kitabı okumak istediğini biliyor musun?","ar":"هل تعلم أي كتاب تريد أن تقرأه؟"},{"t":"Tom Mary'nin bildiğini bilir.","ar":"يعلم توم أن ماري تعلم."},{"t":"Sami, Leyla'nın önünde oturdu.","ar":"جلس سامي مقابل ليلى"},{"t":"Tom da Fransızca konuşuyor mu?","ar":"هل يتحدث توم الفرنسية ايضا؟"},{"t":"Otobüs iki dakika erken geldi.","ar":"وصل الباس بدقيقتان ابكر"},{"t":"O sadece şimdi onunla konuşuyor.","ar":"إنه يتحدث الأن معها."},{"t":"O bugün ders çalışmak istemiyor.","ar":"هو لا يريد الدراسة اليوم."},{"t":"Tom doğum günü için üç hediye aldı.","ar":"تلقى توم ثلاثة هدايا بمناسبة عيد مولده."}],"focus":["burası","içeri","bebek","yapan","dili","okumak","unutma","futbol","ikinci","vakit"],"words":[{"word":"burası","topic":"L64","difficulty":1,"meaning":"هُنَا","example":"Burası bir okul.","translation":"هذه مدرسة."},{"word":"içeri","topic":"L64","difficulty":1,"meaning":"قَلْب","example":"Mary içeri geldi.","translation":"دخلت ماري."},{"word":"bebek","topic":"L64","difficulty":1,"meaning":"رَضِيع، حَبِيبِي","example":"Bebek hala iyi.","translation":"الصّبيّ على ما يرام."},{"word":"okumak","topic":"L64","difficulty":1,"meaning":"قَرَأَ","example":"Onları okumak istedim.","translation":"أردت قراءتهم."},{"word":"futbol","topic":"L64","difficulty":1,"meaning":"كُرَةُ الْقَدَم","example":"Futbol sever misin?","translation":"هل تحب كره القدم؟"},{"word":"ikinci","topic":"L64","difficulty":1,"meaning":"ثَانٍ","example":"Tom ikinci geldi.","translation":"توم إنتهى الثاني."},{"word":"vakit","topic":"L64","difficulty":1,"meaning":"وَقْت، زَمَان"}],"difficulty":1}}