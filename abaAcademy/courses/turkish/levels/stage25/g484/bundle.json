{"theory":{"blocks":[{"btype":"text","text":"الدرس 484. الكلمات الجديدة: bitirdikten، birdenbire، bekledik، dişleri، kötüsü، etrafa، harcıyorsun، ilginçti، görünür، tanıdım."},{"btype":"example","text":"bitirdikten","note":"مثال: İşi bitirdikten sonra, yürüyüşe çıktım. — بعد أن أنهيت عملي، خرجت لأتنزه."},{"btype":"example","text":"birdenbire","note":"مثال: Sami'nin arabası birdenbire ortadan kayboldu. — فجأة اختفت سيّارة سامي."},{"btype":"example","text":"bekledik","note":""},{"btype":"example","text":"dişleri","note":""},{"btype":"example","text":"kötüsü","note":"مثال: En kötüsü için hazır olmalıyız. — علينا أن نستعد للأسوء."},{"btype":"example","text":"etrafa","note":"مثال: Senin hakkında etrafa sordum. — لقد سألت عنك."},{"btype":"example","text":"harcıyorsun","note":"مثال: Zaman harcıyorsun. — أنت تضيع الوقت."},{"btype":"example","text":"ilginçti","note":"مثال: Film beklediğim gibi ilginçti. — كان الفلم جديراً بالإهتمام كما توقعت."},{"btype":"example","text":"görünür","note":""},{"btype":"example","text":"tanıdım","note":"مثال: Onu hemen tanıdım. — عرفته مباشرة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Zaman harcıyorsun.","note":"أنت تضيع الوقت."},{"btype":"example","text":"Onu hemen tanıdım.","note":"عرفته مباشرة."},{"btype":"example","text":"Hemen tanıdım onu.","note":"عرفته مباشرة."},{"btype":"example","text":"Suyu boşa harcıyorsun.","note":"أنت تبذر الماء"},{"btype":"example","text":"Senin hakkında etrafa sordum.","note":"لقد سألت عنك."},{"btype":"example","text":"Film beklediğim gibi ilginçti.","note":"كان الفلم جديراً بالإهتمام كما توقعت."},{"btype":"example","text":"En kötüsü için hazır olmalıyız.","note":"علينا أن نستعد للأسوء."},{"btype":"example","text":"Sanırım zamanını boşa harcıyorsun.","note":"أظن أنك تضيع وقتك."},{"btype":"example","text":"İşi bitirdikten sonra, yürüyüşe çıktım.","note":"بعد أن أنهيت عملي، خرجت لأتنزه."},{"btype":"example","text":"Bu işi bitirdikten sonra eve gidebilirsin.","note":"يمكنك الذهاب للبيت بعد إنتهائك من هذا العمل."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Zaman harcıyorsun.","ar":"أنت تضيع الوقت."},{"t":"Onu hemen tanıdım.","ar":"عرفته مباشرة."},{"t":"Hemen tanıdım onu.","ar":"عرفته مباشرة."},{"t":"Suyu boşa harcıyorsun.","ar":"أنت تبذر الماء"},{"t":"Senin hakkında etrafa sordum.","ar":"لقد سألت عنك."},{"t":"Film beklediğim gibi ilginçti.","ar":"كان الفلم جديراً بالإهتمام كما توقعت."},{"t":"En kötüsü için hazır olmalıyız.","ar":"علينا أن نستعد للأسوء."},{"t":"Sanırım zamanını boşa harcıyorsun.","ar":"أظن أنك تضيع وقتك."},{"t":"İşi bitirdikten sonra, yürüyüşe çıktım.","ar":"بعد أن أنهيت عملي، خرجت لأتنزه."},{"t":"Bu işi bitirdikten sonra eve gidebilirsin.","ar":"يمكنك الذهاب للبيت بعد إنتهائك من هذا العمل."},{"t":"Sami'nin arabası birdenbire ortadan kayboldu.","ar":"فجأة اختفت سيّارة سامي."}],"focus":["bitirdikten","birdenbire","bekledik","dişleri","kötüsü","etrafa","harcıyorsun","ilginçti","görünür","tanıdım"],"words":[],"difficulty":5}}