{"theory":{"blocks":[{"btype":"text","text":"الماضي الشهودي (‎-di‎): yemek (أكل)، içmek (شرب)، okumak (قرأ)، yazmak (كتب)، konuşmak (تكلّم)، anlamak (فهم)، sevmek (أحبّ)، çalışmak (عمل، درس)، oturmak (جلس، سكن)، bakmak (نظر)."},{"btype":"example","text":"yemek","note":"ben yedim، sen yedin، o yedi، biz yedik، siz yediniz، onlar yediler"},{"btype":"example","text":"içmek","note":"ben içtim، sen içtin، o içti، biz içtik، siz içtiniz، onlar içtiler"},{"btype":"example","text":"okumak","note":"ben okudum، sen okudun، o okudu، biz okuduk، siz okudunuz، onlar okudular"},{"btype":"example","text":"yazmak","note":"ben yazdım، sen yazdın، o yazdı، biz yazdık، siz yazdınız، onlar yazdılar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"yemek","meaning":"أكل","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"yedim","sen":"yedin","o":"yedi","biz":"yedik","siz":"yediniz","onlar":"yediler"},"difficulty":2},{"infinitive":"içmek","meaning":"شرب","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"içtim","sen":"içtin","o":"içti","biz":"içtik","siz":"içtiniz","onlar":"içtiler"},"difficulty":2},{"infinitive":"okumak","meaning":"قرأ","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"okudum","sen":"okudun","o":"okudu","biz":"okuduk","siz":"okudunuz","onlar":"okudular"},"difficulty":2},{"infinitive":"yazmak","meaning":"كتب","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"yazdım","sen":"yazdın","o":"yazdı","biz":"yazdık","siz":"yazdınız","onlar":"yazdılar"},"difficulty":2},{"infinitive":"konuşmak","meaning":"تكلّم","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"konuştum","sen":"konuştun","o":"konuştu","biz":"konuştuk","siz":"konuştunuz","onlar":"konuştular"},"difficulty":2