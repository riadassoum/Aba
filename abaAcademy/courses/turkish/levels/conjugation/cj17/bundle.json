{"theory":{"blocks":[{"btype":"text","text":"الماضي الشهودي (‎-di‎): çıkmak (خرج)، girmek (دخل)، aramak (بحث، اتّصل)، bulmak (وجد)، duymak (سمع)، dinlemek (استمع)، gülmek (ضحك)، ağlamak (بكى)، yürümek (مشى)، oynamak (لعب)."},{"btype":"example","text":"çıkmak","note":"ben çıktım، sen çıktın، o çıktı، biz çıktık، siz çıktınız، onlar çıktılar"},{"btype":"example","text":"girmek","note":"ben girdim، sen girdin، o girdi، biz girdik، siz girdiniz، onlar girdiler"},{"btype":"example","text":"aramak","note":"ben aradım، sen aradın، o aradı، biz aradık، siz aradınız، onlar aradılar"},{"btype":"example","text":"bulmak","note":"ben buldum، sen buldun، o buldu، biz bulduk، siz buldunuz، onlar buldular"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"çıkmak","meaning":"خرج","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"çıktım","sen":"çıktın","o":"çıktı","biz":"çıktık","siz":"çıktınız","onlar":"çıktılar"},"difficulty":2},{"infinitive":"girmek","meaning":"دخل","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"girdim","sen":"girdin","o":"girdi","biz":"girdik","siz":"girdiniz","onlar":"girdiler"},"difficulty":2},{"infinitive":"aramak","meaning":"بحث، اتّصل","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"aradım","sen":"aradın","o":"aradı","biz":"aradık","siz":"aradınız","onlar":"aradılar"},"difficulty":2},{"infinitive":"bulmak","meaning":"وجد","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"buldum","sen":"buldun","o":"buldu","biz":"bulduk","siz":"buldunuz","onlar":"buldular"},"difficulty":2},{"infinitive":"duymak","meaning":"سمع","tense":"الماضي الشهودي (‎-di‎)","forms":{"ben":"duydum","sen":"duydun","o":"duydu","biz":"duyduk","siz":"duydunuz","onlar":"duydular"