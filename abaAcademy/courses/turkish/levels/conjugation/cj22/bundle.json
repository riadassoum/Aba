{"theory":{"blocks":[{"btype":"text","text":"المستقبل (‎-ecek‎): açmak (فتح)، kapatmak (أغلق)، satmak (باع)، tanımak (عرف (شخصًا))، unutmak (نسي)، hatırlamak (تذكّر)، sormak (سأل)، getirmek (أحضر)، binmek (ركب)، inmek (نزل)."},{"btype":"example","text":"açmak","note":"ben açacağım، sen açacaksın، o açacak، biz açacağız، siz açacaksınız، onlar açacaklar"},{"btype":"example","text":"kapatmak","note":"ben kapatacağım، sen kapatacaksın، o kapatacak، biz kapatacağız، siz kapatacaksınız، onlar kapatacaklar"},{"btype":"example","text":"satmak","note":"ben satacağım، sen satacaksın، o satacak، biz satacağız، siz satacaksınız، onlar satacaklar"},{"btype":"example","text":"tanımak","note":"ben tanıyacağım، sen tanıyacaksın، o tanıyacak، biz tanıyacağız، siz tanıyacaksınız، onlar tanıyacaklar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"açmak","meaning":"فتح","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"açacağım","sen":"açacaksın","o":"açacak","biz":"açacağız","siz":"açacaksınız","onlar":"açacaklar"},"difficulty":2},{"infinitive":"kapatmak","meaning":"أغلق","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"kapatacağım","sen":"kapatacaksın","o":"kapatacak","biz":"kapatacağız","siz":"kapatacaksınız","onlar":"kapatacaklar"},"difficulty":2},{"infinitive":"satmak","meaning":"باع","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"satacağım","sen":"satacaksın","o":"satacak","biz":"satacağız","siz":"satacaksınız","onlar":"satacaklar"},"difficulty":2},{"infinitive":"tanımak","meaning":"عرف (شخصًا)","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"tanıyacağım","sen":"tanıyacaksın","o":"tanıyacak","biz":"tanıyacağız","siz":"tanıyacaksınız","onlar":"tanıyacaklar"},"difficulty":2},{