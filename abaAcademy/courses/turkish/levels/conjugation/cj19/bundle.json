{"theory":{"blocks":[{"btype":"text","text":"المستقبل (‎-ecek‎): gelmek (أتى)، gitmek (ذهب)، yapmak (فعل)، olmak (كان، صار)، istemek (أراد)، bilmek (عرف)، görmek (رأى)، almak (أخذ، اشترى)، vermek (أعطى)، demek (قال)."},{"btype":"example","text":"gelmek","note":"ben geleceğim، sen geleceksin، o gelecek، biz geleceğiz، siz geleceksiniz، onlar gelecekler"},{"btype":"example","text":"gitmek","note":"ben gideceğim، sen gideceksin، o gidecek، biz gideceğiz، siz gideceksiniz، onlar gidecekler"},{"btype":"example","text":"yapmak","note":"ben yapacağım، sen yapacaksın، o yapacak، biz yapacağız، siz yapacaksınız، onlar yapacaklar"},{"btype":"example","text":"olmak","note":"ben olacağım، sen olacaksın، o olacak، biz olacağız، siz olacaksınız، onlar olacaklar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"gelmek","meaning":"أتى","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"geleceğim","sen":"geleceksin","o":"gelecek","biz":"geleceğiz","siz":"geleceksiniz","onlar":"gelecekler"},"difficulty":2},{"infinitive":"gitmek","meaning":"ذهب","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"gideceğim","sen":"gideceksin","o":"gidecek","biz":"gideceğiz","siz":"gideceksiniz","onlar":"gidecekler"},"difficulty":2},{"infinitive":"yapmak","meaning":"فعل","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"yapacağım","sen":"yapacaksın","o":"yapacak","biz":"yapacağız","siz":"yapacaksınız","onlar":"yapacaklar"},"difficulty":2},{"infinitive":"olmak","meaning":"كان، صار","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"olacağım","sen":"olacaksın","o":"olacak","biz":"olacağız","siz":"olacaksınız","onlar":"olacaklar"},"difficulty":2},{"infinitive":"istemek","meaning":"أراد","tense":"المستقبل (‎-ecek‎