{"theory":{"blocks":[{"btype":"text","text":"المستقبل (‎-ecek‎): çıkmak (خرج)، girmek (دخل)، aramak (بحث، اتّصل)، bulmak (وجد)، duymak (سمع)، dinlemek (استمع)، gülmek (ضحك)، ağlamak (بكى)، yürümek (مشى)، oynamak (لعب)."},{"btype":"example","text":"çıkmak","note":"ben çıkacağım، sen çıkacaksın، o çıkacak، biz çıkacağız، siz çıkacaksınız، onlar çıkacaklar"},{"btype":"example","text":"girmek","note":"ben gireceğim، sen gireceksin، o girecek، biz gireceğiz، siz gireceksiniz، onlar girecekler"},{"btype":"example","text":"aramak","note":"ben arayacağım، sen arayacaksın، o arayacak، biz arayacağız، siz arayacaksınız، onlar arayacaklar"},{"btype":"example","text":"bulmak","note":"ben bulacağım، sen bulacaksın، o bulacak، biz bulacağız، siz bulacaksınız، onlar bulacaklar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"çıkmak","meaning":"خرج","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"çıkacağım","sen":"çıkacaksın","o":"çıkacak","biz":"çıkacağız","siz":"çıkacaksınız","onlar":"çıkacaklar"},"difficulty":2},{"infinitive":"girmek","meaning":"دخل","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"gireceğim","sen":"gireceksin","o":"girecek","biz":"gireceğiz","siz":"gireceksiniz","onlar":"girecekler"},"difficulty":2},{"infinitive":"aramak","meaning":"بحث، اتّصل","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"arayacağım","sen":"arayacaksın","o":"arayacak","biz":"arayacağız","siz":"arayacaksınız","onlar":"arayacaklar"},"difficulty":2},{"infinitive":"bulmak","meaning":"وجد","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"bulacağım","sen":"bulacaksın","o":"bulacak","biz":"bulacağız","siz":"bulacaksınız","onlar":"bulacaklar"},"difficulty":2},{"infinitive":"duymak","meaning":"سمع