{"theory":{"blocks":[{"btype":"text","text":"المستقبل (‎-ecek‎): beklemek (انتظر)، düşünmek (فكّر)، söylemek (قال، أخبر)، başlamak (بدأ)، bitirmek (أنهى)، öğrenmek (تعلّم)، öğretmek (علّم)، uyumak (نام)، kalmak (بقي)، koşmak (ركض)."},{"btype":"example","text":"beklemek","note":"ben bekleyeceğim، sen bekleyeceksin، o bekleyecek، biz bekleyeceğiz، siz bekleyeceksiniz، onlar bekleyecekler"},{"btype":"example","text":"düşünmek","note":"ben düşüneceğim، sen düşüneceksin، o düşünecek، biz düşüneceğiz، siz düşüneceksiniz، onlar düşünecekler"},{"btype":"example","text":"söylemek","note":"ben söyleyeceğim، sen söyleyeceksin، o söyleyecek، biz söyleyeceğiz، siz söyleyeceksiniz، onlar söyleyecekler"},{"btype":"example","text":"başlamak","note":"ben başlayacağım، sen başlayacaksın، o başlayacak، biz başlayacağız، siz başlayacaksınız، onlar başlayacaklar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"beklemek","meaning":"انتظر","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"bekleyeceğim","sen":"bekleyeceksin","o":"bekleyecek","biz":"bekleyeceğiz","siz":"bekleyeceksiniz","onlar":"bekleyecekler"},"difficulty":2},{"infinitive":"düşünmek","meaning":"فكّر","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"düşüneceğim","sen":"düşüneceksin","o":"düşünecek","biz":"düşüneceğiz","siz":"düşüneceksiniz","onlar":"düşünecekler"},"difficulty":2},{"infinitive":"söylemek","meaning":"قال، أخبر","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"söyleyeceğim","sen":"söyleyeceksin","o":"söyleyecek","biz":"söyleyeceğiz","siz":"söyleyeceksiniz","onlar":"söyleyecekler"},"difficulty":2},{"infinitive":"başlamak","meaning":"بدأ","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"başlayacağım","sen":"başl