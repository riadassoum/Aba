{"theory":{"blocks":[{"btype":"text","text":"المضارع المستمرّ (‎-iyor‎): gelmek (أتى)، gitmek (ذهب)، yapmak (فعل)، olmak (كان، صار)، istemek (أراد)، bilmek (عرف)، görmek (رأى)، almak (أخذ، اشترى)، vermek (أعطى)، demek (قال)."},{"btype":"example","text":"gelmek","note":"ben geliyorum، sen geliyorsun، o geliyor، biz geliyoruz، siz geliyorsunuz، onlar geliyorlar"},{"btype":"example","text":"gitmek","note":"ben gidiyorum، sen gidiyorsun، o gidiyor، biz gidiyoruz، siz gidiyorsunuz، onlar gidiyorlar"},{"btype":"example","text":"yapmak","note":"ben yapıyorum، sen yapıyorsun، o yapıyor، biz yapıyoruz، siz yapıyorsunuz، onlar yapıyorlar"},{"btype":"example","text":"olmak","note":"ben oluyorum، sen oluyorsun، o oluyor، biz oluyoruz، siz oluyorsunuz، onlar oluyorlar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"gelmek","meaning":"أتى","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"geliyorum","sen":"geliyorsun","o":"geliyor","biz":"geliyoruz","siz":"geliyorsunuz","onlar":"geliyorlar"},"difficulty":2},{"infinitive":"gitmek","meaning":"ذهب","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"gidiyorum","sen":"gidiyorsun","o":"gidiyor","biz":"gidiyoruz","siz":"gidiyorsunuz","onlar":"gidiyorlar"},"difficulty":2},{"infinitive":"yapmak","meaning":"فعل","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"yapıyorum","sen":"yapıyorsun","o":"yapıyor","biz":"yapıyoruz","siz":"yapıyorsunuz","onlar":"yapıyorlar"},"difficulty":2},{"infinitive":"olmak","meaning":"كان، صار","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"oluyorum","sen":"oluyorsun","o":"oluyor","biz":"oluyoruz","siz":"oluyorsunuz","onlar":"oluyorlar"},"difficulty":2},{"infinitive":"istemek","me