{"theory":{"blocks":[{"btype":"text","text":"المضارع المستمرّ (‎-iyor‎): beklemek (انتظر)، düşünmek (فكّر)، söylemek (قال، أخبر)، başlamak (بدأ)، bitirmek (أنهى)، öğrenmek (تعلّم)، öğretmek (علّم)، uyumak (نام)، kalmak (بقي)، koşmak (ركض)."},{"btype":"example","text":"beklemek","note":"ben bekliyorum، sen bekliyorsun، o bekliyor، biz bekliyoruz، siz bekliyorsunuz، onlar bekliyorlar"},{"btype":"example","text":"düşünmek","note":"ben düşünüyorum، sen düşünüyorsun، o düşünüyor، biz düşünüyoruz، siz düşünüyorsunuz، onlar düşünüyorlar"},{"btype":"example","text":"söylemek","note":"ben söylüyorum، sen söylüyorsun، o söylüyor، biz söylüyoruz، siz söylüyorsunuz، onlar söylüyorlar"},{"btype":"example","text":"başlamak","note":"ben başlıyorum، sen başlıyorsun، o başlıyor، biz başlıyoruz، siz başlıyorsunuz، onlar başlıyorlar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"beklemek","meaning":"انتظر","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"bekliyorum","sen":"bekliyorsun","o":"bekliyor","biz":"bekliyoruz","siz":"bekliyorsunuz","onlar":"bekliyorlar"},"difficulty":2},{"infinitive":"düşünmek","meaning":"فكّر","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"düşünüyorum","sen":"düşünüyorsun","o":"düşünüyor","biz":"düşünüyoruz","siz":"düşünüyorsunuz","onlar":"düşünüyorlar"},"difficulty":2},{"infinitive":"söylemek","meaning":"قال، أخبر","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"söylüyorum","sen":"söylüyorsun","o":"söylüyor","biz":"söylüyoruz","siz":"söylüyorsunuz","onlar":"söylüyorlar"},"difficulty":2},{"infinitive":"başlamak","meaning":"بدأ","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"başlıyorum","sen":"başlıyorsun","o":"başlıyor