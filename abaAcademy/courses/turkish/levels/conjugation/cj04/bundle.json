{"theory":{"blocks":[{"btype":"text","text":"المضارع المستمرّ (‎-iyor‎): açmak (فتح)، kapatmak (أغلق)، satmak (باع)، tanımak (عرف (شخصًا))، unutmak (نسي)، hatırlamak (تذكّر)، sormak (سأل)، getirmek (أحضر)، binmek (ركب)، inmek (نزل)."},{"btype":"example","text":"açmak","note":"ben açıyorum، sen açıyorsun، o açıyor، biz açıyoruz، siz açıyorsunuz، onlar açıyorlar"},{"btype":"example","text":"kapatmak","note":"ben kapatıyorum، sen kapatıyorsun، o kapatıyor، biz kapatıyoruz، siz kapatıyorsunuz، onlar kapatıyorlar"},{"btype":"example","text":"satmak","note":"ben satıyorum، sen satıyorsun، o satıyor، biz satıyoruz، siz satıyorsunuz، onlar satıyorlar"},{"btype":"example","text":"tanımak","note":"ben tanıyorum، sen tanıyorsun، o tanıyor، biz tanıyoruz، siz tanıyorsunuz، onlar tanıyorlar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"açmak","meaning":"فتح","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"açıyorum","sen":"açıyorsun","o":"açıyor","biz":"açıyoruz","siz":"açıyorsunuz","onlar":"açıyorlar"},"difficulty":2},{"infinitive":"kapatmak","meaning":"أغلق","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"kapatıyorum","sen":"kapatıyorsun","o":"kapatıyor","biz":"kapatıyoruz","siz":"kapatıyorsunuz","onlar":"kapatıyorlar"},"difficulty":2},{"infinitive":"satmak","meaning":"باع","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"satıyorum","sen":"satıyorsun","o":"satıyor","biz":"satıyoruz","siz":"satıyorsunuz","onlar":"satıyorlar"},"difficulty":2},{"infinitive":"tanımak","meaning":"عرف (شخصًا)","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"tanıyorum","sen":"tanıyorsun","o":"tanıyor","biz":"tanıyoruz","siz":"tanıyorsunuz","onlar":"tanıyorlar"},"