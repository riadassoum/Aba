{"theory":{"blocks":[{"btype":"text","text":"المستقبل (‎-ecek‎): yemek (أكل)، içmek (شرب)، okumak (قرأ)، yazmak (كتب)، konuşmak (تكلّم)، anlamak (فهم)، sevmek (أحبّ)، çalışmak (عمل، درس)، oturmak (جلس، سكن)، bakmak (نظر)."},{"btype":"example","text":"yemek","note":"ben yiyeceğim، sen yiyeceksin، o yiyecek، biz yiyeceğiz، siz yiyeceksiniz، onlar yiyecekler"},{"btype":"example","text":"içmek","note":"ben içeceğim، sen içeceksin، o içecek، biz içeceğiz، siz içeceksiniz، onlar içecekler"},{"btype":"example","text":"okumak","note":"ben okuyacağım، sen okuyacaksın، o okuyacak، biz okuyacağız، siz okuyacaksınız، onlar okuyacaklar"},{"btype":"example","text":"yazmak","note":"ben yazacağım، sen yazacaksın، o yazacak، biz yazacağız، siz yazacaksınız، onlar yazacaklar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"yemek","meaning":"أكل","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"yiyeceğim","sen":"yiyeceksin","o":"yiyecek","biz":"yiyeceğiz","siz":"yiyeceksiniz","onlar":"yiyecekler"},"difficulty":2},{"infinitive":"içmek","meaning":"شرب","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"içeceğim","sen":"içeceksin","o":"içecek","biz":"içeceğiz","siz":"içeceksiniz","onlar":"içecekler"},"difficulty":2},{"infinitive":"okumak","meaning":"قرأ","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"okuyacağım","sen":"okuyacaksın","o":"okuyacak","biz":"okuyacağız","siz":"okuyacaksınız","onlar":"okuyacaklar"},"difficulty":2},{"infinitive":"yazmak","meaning":"كتب","tense":"المستقبل (‎-ecek‎)","forms":{"ben":"yazacağım","sen":"yazacaksın","o":"yazacak","biz":"yazacağız","siz":"yazacaksınız","onlar":"yazacaklar"},"difficulty":2},{"infinitive":"konuşmak","meaning":"تكلّم","tense":"المست