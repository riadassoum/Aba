{"theory":{"blocks":[{"btype":"text","text":"المضارع المستمرّ (‎-iyor‎): çıkmak (خرج)، girmek (دخل)، aramak (بحث، اتّصل)، bulmak (وجد)، duymak (سمع)، dinlemek (استمع)، gülmek (ضحك)، ağlamak (بكى)، yürümek (مشى)، oynamak (لعب)."},{"btype":"example","text":"çıkmak","note":"ben çıkıyorum، sen çıkıyorsun، o çıkıyor، biz çıkıyoruz، siz çıkıyorsunuz، onlar çıkıyorlar"},{"btype":"example","text":"girmek","note":"ben giriyorum، sen giriyorsun، o giriyor، biz giriyoruz، siz giriyorsunuz، onlar giriyorlar"},{"btype":"example","text":"aramak","note":"ben arıyorum، sen arıyorsun، o arıyor، biz arıyoruz، siz arıyorsunuz، onlar arıyorlar"},{"btype":"example","text":"bulmak","note":"ben buluyorum، sen buluyorsun، o buluyor، biz buluyoruz، siz buluyorsunuz، onlar buluyorlar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"çıkmak","meaning":"خرج","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"çıkıyorum","sen":"çıkıyorsun","o":"çıkıyor","biz":"çıkıyoruz","siz":"çıkıyorsunuz","onlar":"çıkıyorlar"},"difficulty":2},{"infinitive":"girmek","meaning":"دخل","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"giriyorum","sen":"giriyorsun","o":"giriyor","biz":"giriyoruz","siz":"giriyorsunuz","onlar":"giriyorlar"},"difficulty":2},{"infinitive":"aramak","meaning":"بحث، اتّصل","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"arıyorum","sen":"arıyorsun","o":"arıyor","biz":"arıyoruz","siz":"arıyorsunuz","onlar":"arıyorlar"},"difficulty":2},{"infinitive":"bulmak","meaning":"وجد","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"buluyorum","sen":"buluyorsun","o":"buluyor","biz":"buluyoruz","siz":"buluyorsunuz","onlar":"buluyorlar"},"difficulty":2},{"infinitive":"duymak