{"theory":{"blocks":[{"btype":"text","text":"المضارع المستمرّ (‎-iyor‎): yemek (أكل)، içmek (شرب)، okumak (قرأ)، yazmak (كتب)، konuşmak (تكلّم)، anlamak (فهم)، sevmek (أحبّ)، çalışmak (عمل، درس)، oturmak (جلس، سكن)، bakmak (نظر)."},{"btype":"example","text":"yemek","note":"ben yiyorum، sen yiyorsun، o yiyor، biz yiyoruz، siz yiyorsunuz، onlar yiyorlar"},{"btype":"example","text":"içmek","note":"ben içiyorum، sen içiyorsun، o içiyor، biz içiyoruz، siz içiyorsunuz، onlar içiyorlar"},{"btype":"example","text":"okumak","note":"ben okuyorum، sen okuyorsun، o okuyor، biz okuyoruz، siz okuyorsunuz، onlar okuyorlar"},{"btype":"example","text":"yazmak","note":"ben yazıyorum، sen yazıyorsun، o yazıyor، biz yazıyoruz، siz yazıyorsunuz، onlar yazıyorlar"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","verbs":[{"infinitive":"yemek","meaning":"أكل","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"yiyorum","sen":"yiyorsun","o":"yiyor","biz":"yiyoruz","siz":"yiyorsunuz","onlar":"yiyorlar"},"difficulty":2},{"infinitive":"içmek","meaning":"شرب","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"içiyorum","sen":"içiyorsun","o":"içiyor","biz":"içiyoruz","siz":"içiyorsunuz","onlar":"içiyorlar"},"difficulty":2},{"infinitive":"okumak","meaning":"قرأ","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"okuyorum","sen":"okuyorsun","o":"okuyor","biz":"okuyoruz","siz":"okuyorsunuz","onlar":"okuyorlar"},"difficulty":2},{"infinitive":"yazmak","meaning":"كتب","tense":"المضارع المستمرّ (‎-iyor‎)","forms":{"ben":"yazıyorum","sen":"yazıyorsun","o":"yazıyor","biz":"yazıyoruz","siz":"yazıyorsunuz","onlar":"yazıyorlar"},"difficulty":2},{"infinitive":"konuşmak","meaning":"تكلّم","tense":"المضارع المست