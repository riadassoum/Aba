{"theory":{"blocks":[{"btype":"text","text":"الدرس 333. الكلمات الجديدة: izlemekten، haksız، yaklaştı، mudur، ulaşmak، sevdiğiniz، geçer، kimseyle، şaşırmıştı، paket."},{"btype":"example","text":"izlemekten","note":""},{"btype":"example","text":"haksız","note":"مثال: Tom, Mary'ye haksız davranıyor. — توم يضايق ماري."},{"btype":"example","text":"yaklaştı","note":"مثال: Sami yaklaştı. — اقترب سامي أكثر."},{"btype":"example","text":"mudur","note":"مثال: Arapça zor mudur? — هل العربيّة صعبة؟"},{"btype":"example","text":"ulaşmak = بَلَغَ","note":""},{"btype":"example","text":"sevdiğiniz","note":"مثال: En sevdiğiniz hayvan hangisidir? — ما هو حيوانك المفضل؟"},{"btype":"example","text":"geçer = عَبَرَ","note":"صيغة من geçmek (الغائب)"},{"btype":"example","text":"kimseyle","note":""},{"btype":"example","text":"şaşırmıştı","note":"مثال: Dan bile şaşırmıştı. — حتى دان دهش."},{"btype":"example","text":"paket = حُزْمَة","note":"مثال: Burada mı, paket mi? — هنا أم تأخذها معك؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sami yaklaştı.","note":"اقترب سامي أكثر."},{"btype":"example","text":"Arapça zor mudur?","note":"هل العربيّة صعبة؟"},{"btype":"example","text":"O bir doktor mudur?","note":"هل هي طبيبة؟"},{"btype":"example","text":"Dan bile şaşırmıştı.","note":"حتى دان دهش."},{"btype":"example","text":"Burada mı, paket mi?","note":"هنا أم تأخذها معك؟"},{"btype":"example","text":"Tom, Mary'ye haksız davranıyor.","note":"توم يضايق ماري."},{"btype":"example","text":"En sevdiğiniz hayvan hangisidir?","note":"ما هو حيوانك المفضل؟"},{"btype":"example","text":"Sence o hala beni düşünüyor mudur?","note":"أتعتقد أنها لا تزال تفكر في؟"},{"btype":"example","text":"En sevdiğiniz TV programı hangisi?","note":"ما هو برنامجك التفزيوني المفضل ؟"},{"btype":"example","text":"Sence o hala beni hatırlıyor mudur?","note":"أتعتقد أنها لا تزال تذكرني؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generat