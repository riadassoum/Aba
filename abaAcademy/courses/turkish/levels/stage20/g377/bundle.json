{"theory":{"blocks":[{"btype":"text","text":"الدرس 377. الكلمات الجديدة: ağlayacak، yüzün، üretim، kuzu، cumhurbaşkanı، mantık، beyaza، unutur، bütçe، reçel، dağlar، işlem، ölme، erkeği، göğüs، programını، mermi، trenleri، anlıyoruz."},{"btype":"example","text":"ağlayacak = بَكَى","note":"صيغة من ağlamak (الغائب، المستقبل)"},{"btype":"example","text":"yüzün = وَجْه","note":"صيغة من yüz (حالة الإضافة)"},{"btype":"example","text":"üretim = إِنْتَاج","note":""},{"btype":"example","text":"kuzu = حَمَل، لَحْم اَلضَّأْن","note":""},{"btype":"example","text":"cumhurbaşkanı = رَئِيس","note":""},{"btype":"example","text":"mantık = مَنْطِق","note":""},{"btype":"example","text":"beyaza = أَبْيَض، قَوْقَازِيّ","note":"صيغة من beyaz (حالة المفعول غير المباشر)؛ مثال: Leyla beyaza döndü. — ابيضّ وجه ليلى."},{"btype":"example","text":"unutur = نَسِيَ","note":"صيغة من unutmak (الغائب)؛ مثال: Babam her şeyi unutur. — أبي ينسى كل شيء."},{"btype":"example","text":"bütçe = مِيزَانِيَّة","note":""},{"btype":"example","text":"reçel = مُرَبًّى","note":"مثال: Ben ekmek ve reçel istiyorum. — أريد خبزا و مربّى."},{"btype":"example","text":"dağlar = جَبَل","note":"صيغة من dağ (الجمع)"},{"btype":"example","text":"işlem = عَمَلِيَّة","note":""},{"btype":"example","text":"ölme = مَاتَ","note":"صيغة من ölmek؛ مثال: Şimdi ölme zamanı. — الآن حان وقت الموت"},{"btype":"example","text":"erkeği = ذَكَر","note":"صيغة من erkek (حالة المفعول به)؛ مثال: Senin gibi bir kadın benim gibi bir erkeği hak etmiyor. — امرأةً مثلك لا تستحق رجلاً مثلي."},{"btype":"example","text":"göğüs = صَدْر","note":""},{"btype":"example","text":"programını = بَرْنَامَج","note":"صيغة من program (المخاطب، حالة المفعول به، الملكية)"},{"btype":"example","text":"mermi = رَصَاصَة","note":""},{"btype":"example","text":"trenleri = قِطَار","note":"صيغة من tren (الجمع، حالة المفعول به)؛ مثال: O trenleri sever. — إنه يحب القطارات."},{"btype":"example","text":"anlıyoruz = فَهِمَ","note":"صيغة من anlamak (الجمع، المتكلّم، المضارع)؛ مثال: Anlıyoruz. — نحن نفهم"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Anlıyoruz.","note":"نحن نفهم"},{"btype":"example","text":"Onu anlıyoruz.","note":"نفهم ذلك."},{"btype":"example","text":"O trenleri sever.","note":"إنه يحب القطارات."},{"btype":"example","text":"Şimdi ölme zamanı.","note":"الآن حان وقت الموت"},{"btype":"example","text":"Leyla beyaza döndü.","note":"ابيضّ وجه ليلى."},{"btype":"example","text":"Tom trenleri sever.","note":"يحب توم القطارات"},{"btype":"example","text":"Babam her şeyi unutur.","note":"أبي ينسى كل شيء."},{"btype":"example","text":"Ben ekmek ve reçel istiyorum.","note":"أريد خبزا و مربّى."},{"btype":"example","text":"Senin gibi bir kadın benim gibi bir erkeği hak etmiyor.","note":"امرأةً مثلك لا تستحق رجلاً مثلي."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Anlıyoruz.","ar":"نحن نفهم"},{"t":"Onu anlıyoruz.","ar":"نفهم ذلك."},{"t":"O trenleri sever.","ar":"إنه يحب القطارات."},{"t"