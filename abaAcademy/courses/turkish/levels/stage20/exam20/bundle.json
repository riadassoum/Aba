{"theory":{"blocks":[{"btype":"text","text":"اختبار شامل للمرحلة 20: جمل من كل دروسها. انجح فيه قبل الانتقال."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":4,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":5,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"O, kafasını kullandı.","ar":"لقد إستخدم رأسه."},{"t":"O, araba sürebilir.","ar":"بإمكانه قيادة السيارة."},{"t":"Sami'nin başı dertte idi.","ar":"كان سامي في مشكلة."},{"t":"Tıbbi yardıma ihtiyacım var.","ar":"أحتاج مساعدة طبية."},{"t":"Fadıl, Mısırlı bir Müslüman kadına derinden aşık oldu.","ar":"وقع فاضل بشكل عميق في حبّ فتاة مسلمة من مصر."},{"t":"Ben seninle dışarıda buluşacağım.","ar":"سأقابلك في الخارج."},{"t":"Tom Mary'ye evde olup olmadığını sordu.","ar":"سأل توم ماري إن كانت في المنزل."},{"t":"Bana bittiğini söyledi.","ar":"أخبرني أن الأمر انتهى."},{"t":"Akşam yemeği getirdin, değil mi?","ar":"لقد أحضرتم العشاء، أليس كذلك؟"},{"t":"O, zaman kaybedecek.","ar":"سيضيّع الوقت."},{"t":"Ken daha önce İngiltere'de bulundu.","ar":"زار كِن إنجلترا من قبل."},{"t":"Fadil başka birine aşık.","ar":"إنّ فاضل مغرم بامرأة أخرى."},{"t":"Ne gerekiyorsa yapın.","ar":"افعل كل ما يحتاجه الأمر."},{"t":"Çiçekler su olmadan ölür.","ar":"تموت الأزهار بدون ماء."},{"t":"Sami Leyla'ya anahtarları verdi.","ar":"قدّم سامي المفاتيح لليلى."},{"t":"O, onun kişisel yaşamı hakkında hiçbir şey bilmek istemiyordu.","ar":"لم تكن ترغب في معرفة أي شيئ عن حياته الشخصية."},{"t":"Tom benim dostum.","ar":"توم صديقي."},{"t":"Onun suçlu olmadığını düşünen sadece biz değiliz.","ar":"نحنُ لسنا الوحيدين الذين يعتقدون أنهُ غير مذنب."},{"t":"Günaydın.","ar":"صباح الخير."},{"t":"Tom matematikte iyi değildi.","ar":"لم يكن توم جيد بالمباره"},{"t":"Onun deneyimi yok.","ar":"هو يفتقر إلى الخبرة"},{"t":"Onlar onun dürüst olduğuna inanıyordu.","ar":"ظنوا أنه صادق."},{"t":"O sana güveniyor.","ar":"هو يثق بك."},{"t":"Herkese günaydın.","ar":"صَبَاح الْخَيْر جَمِيْعاً."},{"t":"Mutfak zemin katta.","ar":"المطبخ موجود في الطابق الأرضي."},{"t":"Tom bir şey görmediğini söyledi.","ar":"قال توم بأنه لم يرى شيئا."},{"t":"Tom eve gidecek son çocuktu.","ar":"كان توم آخر طفل يذهب إلى منزله."},{"t":"Tom'u benim yaptığım aynı hataları yapmaktan durdurmaya çalışıyorum.","ar":"أحاول منع توم من الوقوع في نفس الأخطاء التي وقعت فيها."},{"t":"Erkek kardeşim bir araba sürebilir.","ar":"يستطيع أخي أن يقود سيارة."},{"t":"Bu oda fazla güneş almaz.","ar":"لا تشع الشمس على هذه الغرفة كثيراً."},{"t":"Sadece hiç kimsenin beni görmediğini umuyorum!","ar":"أتمنى أن لا يكون أحد رآني."},{"t":"Portekizce de konuşabiliyor musun?","ar":"هل بإمكانك التّكلّم بالبرتغاليّة؟"},{"t":"Herhangi bir yardıma ihtiyacın var mı, dostum?","ar":"أتحتاج لمساعدة يا صاح؟"},{"t":"Leyla geceleyin eve geldi.","ar":"عادت ليلى إلى المنزل ليلا."},{"t":"Bu kitap okumaya değmez.","ar":"هذا الكتاب لا يستحق أن يُقرأ."},{"t":"Bir sandalye yerine lütfen bu ahşap kutuyu kullan.","ar":"استعمل هذا الصندوق الخشبي ككرسي من فضلك."},{"t":"Mağazaya gittin mi?","ar":"هل ذهبت إلى المتجر؟"},{"t":"Kazandım!","ar":"أنا فُزت!"},{"t":"Ben onu şaka olarak söylemiştim.","ar":"قَصَدْتُهُ مِِثلَ نُكتَةٍ."},{"t":"Tom gerçekten bitkin olduğunu söyledi.","ar":"قال توم أنه كان حقا مرهقا."},{"t":"Tom'un neden onu söylediğini merak ediyorum.","ar":"أتساءل لماذا قال توم ذلك"},{"t":"Leyla saçlarını yapıyordu.","ar":"كانت ليلى تصفّف شعرها."},{"t":"Onların beklemesini istiyor musun?","ar":"هل تريد انتظارهم؟"},{"t":"Beşinci kata indi.","ar":"نزلت إلى الطابق الخامس."},{"t":"Tom okumayı bıraktı ve yattı.","ar":"ترك توم القراءة ونام."},{"t":"Annen araba sürebilir mi?","ar":"هل تستطيع أمك أن تقود سيارة؟"},{"t":"Öğretmeni ile yattı.","ar":"ضاجع مدرّسته."},{"t":"O siyah evrak çantası senin mi?","ar":"هل تلك الحقيبة السوداء لك؟"},{"t":"Onun cevabını asla unutmayacağım.","ar":"لن أنس جوابها أبدا."},{"t":"Tom bu öğleden sonra kent merkezine gitti.","ar":"ذهب توم لمركز المدينة بعد الظهر."},{"t":"Sami ev yaşamı hakkında konuştu.","ar":"تحدّث سامي عن حياته في المنزل."},{"t":"Bunu seveceğini düşünüyordum.","ar":"ظننتك ستحبه."},{"t":"Kaybedecek bir şeyi olmayan birine meydan okuma.","ar":"لا تتحدى من ليس لديه ما يخسره."},{"t":"Kötü olmayın.","ar":"لا تكن شرّيرا."},{"t":"Herkes bir şair olamaz.","ar":"ليس بإمكان أي إنسان أن يصبح شاعرا."},{"t":"Haber orman yangını gibi yayıldı.","ar":"انتشر الخبر بسرعة."},{"t":"Tom'a güveniyor musun?","ar":"ألا تثق بتوم؟"},{"t":"Fadil kayıp.","ar":"لقد اختفى فاضل."},{"t":"Genellikle kahve içmem.","ar":"بالعادة لا أشرب القهوة."},{"t":"Hiçbir şey okumadım.","ar":"لم أقرأ شيئا."},{"t":"Beni bir yalancı olmakla suçladı.","ar":"اتهمتني بالكذب."},{"t":"Onun hastalığı kanser olabilir.","ar":"قد يكون مرضها السرطان."},{"t":"Biz zar zor başladık.","ar":"بالكاد بدأنا."},{"t":"Tenis oynamak eğlencelidir.","ar":"لعب التنس أمر ممتع."},{"t":"Herkes ölür.","ar":"الجميع يموت."},{"t":"Sami, bilgisayarını Leyla'ya verdi.","ar":"قدّم سامي حاسوبه لليلى."},{"t":"O hemen mutfağa gitti.","ar":"ذهبت فورا إلى المطبخ."},{"t":"Onun başı dertte.","ar":"إنهُ في مشكلة."},{"t":"O, mağazaya gitti.","ar":"ذهب إلى الدكان."},{"t":"Dün yaşadığım deneyimi asla unutmayacağım.","ar":"لن أنس أبدا التّجربة التي عشتها البارحة."},{"t":"Günaydın. Bugün hava güzel.","ar":"صباح الخير, اليوم لدينا طقسُ جميل."},{"t":"Fadil şiir yazmayı severdi.","ar":"كان فاضل يحبّ كتابة القصائد."},{"t":"Ben resim eğitimi almak için Fransa'ya gideceğim.","ar":"سأذهب إلى فرنسا لأدرس الرسم."},{"t":"Bir araba sürebilir misin?","ar":"أيمكنك أن تقود سيارة؟"},{"t":"Mağazaya benimle gelecek misin?","ar":"هلا أتيت معي إلى المتجر؟"},{"t":"Günaydın, doktor!","ar":"صباح الخير, أيها الطبيب!"},{"t":"Mağazaya git.","ar":"اذهب إلى الدكان."},{"t":"Mary bize güveniyor.","ar":"ماري تثق بنا."},{"t":"Tenis oynamak çok eğlencelidir.","ar":"إن لعب كرة المضرب ممتع."},{"t":"Seyahat etmek eğlencelidir.","ar":"السياحة ممتعة"}],"difficulty":5}}