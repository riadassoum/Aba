r.","ar":"إنه آخر شخصٍ أود رؤيته."},{"t":"Aç bir adam, kızgın bir adamdır.","ar":"الجوعُ كافرٌ."},{"t":"Çok ileri gittiğini düşünüyorum.","ar":"أعتقد أنك ذهبت بعيدا."},{"t":"Dan telefonu Linda'ya vermeyi reddetti.","ar":"رفض دات تقديم الهاتف لليندة."},{"t":"\"Birisi bana yardımcı olabilir mi?\" \"Ben olurum.\"","ar":"\"هل يستطيع أحدٌ مساعدتي؟\" \"سأفعل\"."}],"focus":["adamdır","dondurma","cümleyi","ayda","etmeyecek","olurum","katı","vermeyi","ileri","şüpheliyim"],"words":[{"word":"dondurma","topic":"L179","difficulty":3,"meaning":"بُوظَة","example":"O dondurma seviyor.","translation":"إنها تحب المثلجات ."},{"word":"katı","topic":"L179","difficulty":3,"meaning":"صُلْب","example":"Tom katı.","translation":"توم قاس"},{"word":"ileri","topic":"L179","difficulty":3,"meaning":"فِي الْمُقَدِّمَة","example":"Şimdi çok ileri gidiyorsun.","translation":"إنك تذهب بعيدا الآن."}],"difficulty":3}}