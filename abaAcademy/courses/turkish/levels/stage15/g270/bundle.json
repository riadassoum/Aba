{"theory":{"blocks":[{"btype":"text","text":"الدرس 270. الكلمات الجديدة: belediye، annen، doldurdu، uğradı، kaldırdı، hizmet، yanımda، edilir، söylüyorlar، durdurdu."},{"btype":"example","text":"belediye = بَلَدِيَّة","note":""},{"btype":"example","text":"annen","note":"مثال: Annen evde mi? — هل والدتك في المنزل"},{"btype":"example","text":"doldurdu","note":"مثال: Benim için bir fincan çay doldurdu. — صبت لي كأساً من الشاي."},{"btype":"example","text":"uğradı","note":""},{"btype":"example","text":"kaldırdı","note":"مثال: O elini kaldırdı. — رفع يده."},{"btype":"example","text":"hizmet = خِدْمَة","note":""},{"btype":"example","text":"yanımda","note":"مثال: O benim yanımda. — هو بجانبي."},{"btype":"example","text":"edilir","note":"مثال: Sadece öğrenciler kabul edilir. — يسمح بالدخول للطلاب فقط لا غير."},{"btype":"example","text":"söylüyorlar","note":"مثال: Onlar yalan söylüyorlar. — هما تكذبان."},{"btype":"example","text":"durdurdu","note":"مثال: O onu durdurdu. — لقد أوففه."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Annen evde mi?","note":"هل والدتك في المنزل"},{"btype":"example","text":"O onu durdurdu.","note":"لقد أوففه."},{"btype":"example","text":"O benim yanımda.","note":"هو بجانبي."},{"btype":"example","text":"Onu ne durdurdu?","note":"ماذا أوقفها؟"},{"btype":"example","text":"O senin annen mi?","note":"هل تلك أمك؟"},{"btype":"example","text":"O elini kaldırdı.","note":"رفع يده."},{"btype":"example","text":"Yanımda para yok.","note":"لا أملك المال."},{"btype":"example","text":"Tom onu durdurdu.","note":"أوقفه توم."},{"btype":"example","text":"Mary onu durdurdu.","note":"أوقفته ماري."},{"btype":"example","text":"Şimdi annen evde mi?","note":"هل أمك في البيت الآن؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generato