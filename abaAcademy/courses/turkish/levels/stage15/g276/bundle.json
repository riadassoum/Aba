{"theory":{"blocks":[{"btype":"text","text":"الدرس 276. الكلمات الجديدة: kiliseye، yapılacağını، olmadığından، gidiyorlar، dikkatle، yapıp، olduğunuzu، izledim، konuşurken، kuralları."},{"btype":"example","text":"kiliseye","note":"مثال: Onlar kiliseye gittiler. — ذهبوا إلى الكنسية."},{"btype":"example","text":"yapılacağını","note":"مثال: Ne yapılacağını bilmiyorum. — لا أعرف ماذا أفعل."},{"btype":"example","text":"olmadığından","note":"مثال: Tom hazır olup olmadığından emin değil. — توم غير متأكد من أنه جاهز أم لا."},{"btype":"example","text":"gidiyorlar","note":"مثال: Bir bara gidiyorlar. — ذهبوا إلى حانة."},{"btype":"example","text":"dikkatle","note":"مثال: Tom Mary'yi dikkatle izledi. — راقب توم ماري عن كثب."},{"btype":"example","text":"yapıp","note":"مثال: Onu benim için yapıp yapmadığını bilmiyorum. — لا أدري إن كان ليفعلها لأجلي."},{"btype":"example","text":"olduğunuzu","note":"مثال: Ben ona hoş bir kız olduğunuzu söyledim. — أخبرتها أنك فتاة لطيفة."},{"btype":"example","text":"izledim","note":"مثال: Bu sabah TV izledim. — شاهدت التلفاز هذا الصباح."},{"btype":"example","text":"konuşurken","note":""},{"btype":"example","text":"kuralları","note":"مثال: Tom o kuralları bilir. — توم يَعرِفُ القوانينَ."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Bir bara gidiyorlar.","note":"ذهبوا إلى حانة."},{"btype":"example","text":"Bu sabah TV izledim.","note":"شاهدت التلفاز هذا الصباح."},{"btype":"example","text":"Ben otobüsü izledim.","note":"لاحقت الحافلة."},{"btype":"example","text":"Tom o kuralları bilir.","note":"توم يَعرِفُ القوانينَ."},{"btype":"example","text":"Onlar kiliseye gittiler.","note":"ذهبوا إلى الكنسية."},{"btype":"example","text":"Onlar nereye gidiyorlar?","note":"أين هم ذاهبون؟"},{"btype":"example","text":"Onu odaya kadar izledim.","note":"تَبِعْتُها إلى الغرفَة."},{"btype":"example","text":"Biz aynı kiliseye gittik.","note":"ذهبنا إلى ذات الكنيسة."},{"btype":"example","text":"Bu sabah kiliseye gittim.","note":"ذهبت هذا الصباح إلى الكنسية."},{"btype":"example","text":"Kuralları takip etmelisin.","note":"عليك التقيد بالقوانين."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Bir bara gidiyorlar.","ar":"ذهبوا إلى حانة."},{"t":"Bu sabah TV izledim.","ar":"شاهدت التلفاز هذا الصباح."},{"t":"Ben otobüsü izledim.","ar":"لاحقت الحافلة."},{"t":"Tom o kuralları bilir.","ar":"توم يَعرِفُ القوانينَ."},{"t":"Onlar kiliseye gittiler.","ar":"ذهبوا إلى الكنسية."},{"t":"Onlar nereye gidiyorlar?","ar":"أين هم ذاهبون؟"},{"t":"Onu odaya kadar izledim.","ar":"تَبِعْتُها إلى الغرفَة."},{"t":"Biz aynı kiliseye gittik.","ar":"ذهبنا إلى ذات الكنيسة."},{"t":"Bu sabah kiliseye gittim.","ar":"ذهبت هذا الصباح إلى الكنسية."},{"t":"Kuralları takip etmelisin.","ar":"عليك التقيد بالقوانين."},{"t":"Ne yapılacağını bilmiyorum.","ar":"لا أعرف ماذا أفعل."},{"t":"Tom Mary'yi dikkatle izledi.","ar":"راقب توم ماري عن كثب."},{"t":"Tom kutuyu dikkatle kaldırdı.","ar":"رفع توم الصندوق بحذر."},{"t":"Sami kiliseye gitmiyor çünkü Müslüman.","ar":"سامي لا يذهب إلى الكنيسة لأنّه مسلم."},{"t":"Tom hazır olup olmadığından emin değil.","ar":"توم غير متأكد من أنه جاهز أم لا."},{"t":"Ben ona hoş bir kız olduğunuzu söyledim.","ar":"أخبرت