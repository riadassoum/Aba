{"theory":{"blocks":[{"btype":"text","text":"الدرس 222. الكلمات الجديدة: fabrika، kaynağı، lanet، izle، bedava، kutunun، belirli، aktör، yanan، koşarak، kitaptan، güller، yağmurlu."},{"btype":"example","text":"fabrika = مَصْنَع","note":""},{"btype":"example","text":"kaynağı = عَيْن","note":"صيغة من kaynak (حالة المفعول به)؛ مثال: Sahara dünyada en büyük toz kaynağı. — الصحراء الكبرى هي أكبر مصدر للغبار في العالم."},{"btype":"example","text":"lanet = لَعْنَة","note":""},{"btype":"example","text":"izle = شَاهَدَ، رَصَدَ","note":"صيغة من izlemek (المخاطب، الأمر)؛ مثال: Sadece beni izle. — اتبعني فحسب."},{"btype":"example","text":"bedava = مَجَّانًا","note":""},{"btype":"example","text":"kutunun = صَفِيحَة","note":"صيغة من kutu (حالة الإضافة)"},{"btype":"example","text":"belirli = مُحَدَّد","note":""},{"btype":"example","text":"aktör = مُمَثِّل","note":""},{"btype":"example","text":"yanan = اِحْتَرَقَ","note":"صيغة من yanmak (الماضي المستمرّ، اسم المفعول)"},{"btype":"example","text":"koşarak = رَكْض","note":"مثال: Çocuk koşarak geldi. — أتى الولد راكضاً."},{"btype":"example","text":"kitaptan = كِتَاب","note":"صيغة من kitap؛ مثال: Bu iki kitaptan hangisi daha iyi? — أي من هذين الكتابين أفضل؟"},{"btype":"example","text":"güller = وَرْدَة","note":"صيغة من gül (الجمع)"},{"btype":"example","text":"yağmurlu = مَطِر","note":"مثال: Hava yağmurlu. — يهطل المطر."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Hava yağmurlu.","note":"يهطل المطر."},{"btype":"example","text":"Sadece beni izle.","note":"اتبعني فحسب."},{"btype":"example","text":"Yağmurlu bir gün.","note":"اليوم ممطر."},{"btype":"example","text":"Çocuk koşarak geldi.","note":"أتى الولد راكضاً."},{"btype":"example","text":"Hava bugün yağmurlu.","note":"الجو ممطر اليوم."},{"btype":"example","text":"Onu nasıl yaptığımı izle.","note":"انظر كيف أقوم بذلك"},{"btype":"example","text":"Bu iki kitaptan hangisi daha iyi?","note":"أي من هذين الكتابين أفضل؟"},{"btype":"example","text":"Sahara dünyada en büyük toz kaynağı.","note":"الصحراء الكبرى هي أكبر مصدر للغبار في العالم."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Hava yağmurlu.","ar":"يهطل المطر."},{"t":"Sadece beni izle.","ar":"اتبعني فحسب."},{"t":"Yağmurlu bir gün.","ar":"اليوم ممطر."},{"t":"Çocuk koşarak geldi.","ar":"أتى الولد راكضاً."},{"t":"Hava bugün yağmurlu.","ar":"الجو ممطر اليوم."},{"t":"Onu nasıl yaptığımı izle.","ar":"انظر كيف أقوم بذلك"},{"t":"Bu iki kitaptan hangisi daha iyi?","ar":"أي من هذين الكتابين أفضل؟"},{"t":"Sahara dünyada en büyük toz kaynağı.","ar":"الصحراء الكبرى هي أكبر مصدر للغبار في العالم."}],"focus":["fabrika","kaynağı","lanet","izle","bedava","kutunun","belirli","aktör","yanan","koşarak","kitaptan","güller","yağmurlu"],"words":[{"word":"fabrika","topic":"L222","difficulty":2,"meaning":"مَصْنَع"},{"word":"lanet","topic":"L222","difficulty":2,"meaning":"لَعْنَة"},{"word":"bedava","topic":"L222","difficulty":2,"meaning":"مَجَّانًا"},{"word":"beli