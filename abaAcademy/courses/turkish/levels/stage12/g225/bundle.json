{"theory":{"blocks":[{"btype":"text","text":"الدرس 225. الكلمات الجديدة: durma، koşmak، varmak، okuyun، şekli، aklına، kitaplardan، ip، düzeltmek، paraları، edeceksin، elden، bahşiş، alana، izni، geleneksel، yazarı، karşılamak، gözlerin."},{"btype":"example","text":"durma = وَقَفَ، تَوَقَّفَ","note":"صيغة من durmak"},{"btype":"example","text":"koşmak = رَكَضَ","note":"مثال: Burada koşmak tehlikeli mi? — هل الركض هنا خطر ؟ ."},{"btype":"example","text":"varmak = وَصَلَ","note":""},{"btype":"example","text":"okuyun = قَرَأَ","note":"صيغة من okumak (الجمع، المخاطب، الأمر)؛ مثال: Onu bir kez daha okuyun, lütfen. — إقرأها مرة أخرى من فضلك."},{"btype":"example","text":"şekli = صُورَة","note":"صيغة من şekil (حالة المفعول به)"},{"btype":"example","text":"aklına = عَقْل","note":"صيغة من akıl (المخاطب، المضارع، حالة المفعول غير المباشر)"},{"btype":"example","text":"kitaplardan = كِتَاب","note":"صيغة من kitap (الجمع)"},{"btype":"example","text":"ip = وَتَر","note":""},{"btype":"example","text":"düzeltmek = صَحَّحَ","note":""},{"btype":"example","text":"paraları = نُقُود","note":"صيغة من para (الجمع، حالة المفعول به)"},{"btype":"example","text":"edeceksin = فَعَلَ","note":"صيغة من etmek (المخاطب، المستقبل)؛ مثال: Bana yardım edeceksin. — أنت ستساعدني!"},{"btype":"example","text":"elden = يَد","note":"صيغة من el"},{"btype":"example","text":"bahşiş = بَقْشِيش","note":""},{"btype":"example","text":"alana = مِسَاحَة، مِنْطَقَة","note":"صيغة من alan (حالة المفعول غير المباشر)"},{"btype":"example","text":"izni = إِجَازَة","note":"صيغة من izin (حالة المفعول به)"},{"btype":"example","text":"geleneksel = تَقْلِيدِيّ","note":""},{"btype":"example","text":"yazarı = مُؤَلِّف","note":"صيغة من yazar (حالة المفعول به)؛ مثال: Bu kitabın yazarı hâlâ genç. — مؤلف الكتاب لساته صغير بالعمر"},{"btype":"example","text":"karşılamak = رَحَّبَ","note":""},{"btype":"example","text":"gözlerin = عَيْن","note":"صيغة من göz (الجمع، حالة الإضافة)؛ مثال: Gözlerin nerede? — أين عيناك حين تحتاجهما؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Gözlerin nerede?","note":"أين عيناك حين تحتاجهما؟"},{"btype":"example","text":"Bana yardım edeceksin.","note":"أنت ستساعدني!"},{"btype":"example","text":"Bence gözlerin çok güzel.","note":"أعتقد أن عينيك جميلة جدّا."},{"btype":"example","text":"Burada koşmak tehlikeli mi?","note":"هل الركض هنا خطر ؟ ."},{"btype":"example","text":"Bu kitabın yazarı hâlâ genç.","note":"مؤلف الكتاب لساته صغير بالعمر"},{"btype":"example","text":"Bu kitabın yazarı siz misiniz?","note":"أأنت مؤلف هذا الكتاب؟"},{"btype":"example","text":"Onu bir kez daha okuyun, lütfen.","note":"إقرأها مرة أخرى من فضلك."},{"btype":"example","text":"Bize yardım edeceksin, değil mi?","note":"ستساعدنا، أليس كذلك؟"},{"btype":"example","text":"Lütfen bu kelimeyi tekrar okuyun.","note":"من فضلك إقرأ هذه الكلمة مرة أخرى."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Gözlerin nerede?","ar":"أين عيناك حين تحتاجهما؟"},{"t