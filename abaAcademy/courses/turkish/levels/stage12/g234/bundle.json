{"theory":{"blocks":[{"btype":"text","text":"الدرس 234. الكلمات الجديدة: muyuz، duygularını، aldığım، takıyor، şaşırttı، taze، enerji، öfkeli، yarışı، gününde."},{"btype":"example","text":"muyuz","note":""},{"btype":"example","text":"duygularını","note":""},{"btype":"example","text":"aldığım","note":""},{"btype":"example","text":"takıyor","note":""},{"btype":"example","text":"şaşırttı","note":"مثال: O beni şaşırttı. — لقد فاجأني."},{"btype":"example","text":"taze = طَازَج","note":"مثال: Ekmek taze. — الخبز طازج."},{"btype":"example","text":"enerji = طَاقَة","note":"مثال: Çocuklar enerji dolu. — الأطفالُ مفعمونَ بالطاقة."},{"btype":"example","text":"öfkeli = غَاضِب","note":"مثال: O öfkeli. — إنه غاضب."},{"btype":"example","text":"yarışı","note":"مثال: Yarışı izlemek eğlenceli. — مشاهدة السباق ممتعة."},{"btype":"example","text":"gününde","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"O öfkeli.","note":"إنه غاضب."},{"btype":"example","text":"Ekmek taze.","note":"الخبز طازج."},{"btype":"example","text":"O niçin öfkeli?","note":"لماذا هي غاضبة؟"},{"btype":"example","text":"O beni şaşırttı.","note":"لقد فاجأني."},{"btype":"example","text":"Sanırım o öfkeli.","note":"أنا أعتقد انهُ غاضب."},{"btype":"example","text":"Tom şu anda öfkeli.","note":"توم غاضب الآن."},{"btype":"example","text":"Onlar niçin öfkeli?","note":"لم هم غاضبين؟"},{"btype":"example","text":"Çocuklar enerji dolu.","note":"الأطفالُ مفعمونَ بالطاقة."},{"btype":"example","text":"Tom, Mary'yi şaşırttı.","note":"فاجأ توم ماري."},{"btype":"example","text":"Karanlık enerji nedir?","note":"ما هي الطاقة السوداء؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"O öfkeli.","ar":"إنه غاضب."},{"t":"Ekmek taze.","ar":"الخبز طازج."},{"t":"O niçin öfkeli?","ar":"لماذا هي غاضبة؟"},{"t":"O beni şaşırttı.","ar":"لقد فاجأني."},{"t":"Sanırım o öfkeli.","ar":"أنا أعتقد انهُ غاضب."},{"t":"Tom şu anda öfkeli.","ar":"توم غاضب الآن."},{"t":"Onlar niçin öfkeli?","ar":"لم هم غاضبين؟"},{"t":"Çocuklar enerji dolu.","ar":"الأطفالُ مفعمونَ بالطاقة."},{"t":"Tom, Mary'yi şaşırttı.","ar":"فاجأ توم ماري."},{"t":"Karanlık enerji nedir?","ar":"ما هي الطاقة السوداء؟"},{"t":"Yarışı izlemek eğlenceli.","ar":"مشاهدة السباق ممتعة."},{"t":"Bu birçok kişiyi şaşırttı.","ar":"فاجأ ذلك الكثير."},{"t":"Onun kararı herkesi şaşırttı.","ar":"صدم الجميع بقرارها."},{"t":"Onun niçin çok öfkeli olduğunu biliyor musun?","ar":"هل تعلم لماذا هي غاضبة؟"},{"t":"Babanın kim olduğunu biliyorum.","ar":"أنا أعرف من هو والدك."},{"t":"Sami bir Arapça öğretmeni oldu.","ar":"أصبح سامي مدرّسا للعربيّة."},{"t":"Sami, Arapça konuşmayı öğrendi.","ar":"تعلّم سامي العربيّة."},{"t":"Layla onun evinde arapça konuşur.","ar":"تتكلّم ليلى العربيّة في منزلها."},{"t":"Kendinizi emin hissediyor musunuz?","ar":"هل تشعر بالثقة في النفس؟"},{"t":"Neden Arapça öğrenmeye karar verdin?","ar":"لماذا قرّرت أن تتعلّم العربيّة؟"},{"t":"Biraz daha yavaşça konuşabilir misin?","ar":"أيمكنك أن تتحدث ببطئ من فضلك؟"},{"t":"O, bize yolun kapalı olduğunu söyledi.","ar":"أخبرتنا بأن الطريق مغلق."},{"t":"Annen bile babanın kim olduğunu bilmiyor.","ar":"حتى أمك لا تعلم من هو أبوك."},{"t":"Sen babanın kim olduğunu bile bilmiyorsun.","ar":"انت لا تعرف حتى من هو ابوك."},{"t":"Hangi yolun en kısa olduğunu merak ediyorum.","ar":"أتساءل أيّ طريق هو الأقصر."},{"t":"Senin annen sana babanın kim olduğunu söyleyebilir.","ar":"أنت لا تعرف حتى من هو أبوك."},{"t":"Buradan Tom'un evine gitmek için en iyi yolun hangisi olduğunu düşünüyorsun?","ar":"ماذا تعتقد أفضل وسيلة للوصول إلى منزل توم من هنا؟"},{"t":"Tom'u daha çok çalışmaya teşvik etmek için en iyi yolun ne olduğunu düşünüyorsunuz?","ar":"ماذا تعتقد أفضل طريقة لتشجيع توم علىَ دراسة المزيد؟"}],"focus":["muyuz","duygularını","aldığım","takıyor","şaşırttı","taze","enerji","öfkeli","yarışı","gününde"],"words":[{"word":"taze","topic":"L234","difficulty":3,"meaning":"طَازَج","example":"Ekmek taze.","translation":"الخبز طازج."},{"word":"enerji","topic":"L234","difficulty":3,"meaning":"طَاقَة","example":"Çocuklar enerji dolu.","translation":"الأطفالُ مفعمونَ بالطاقة."},{"word":"öfkeli","topic":"L234","difficulty":3,"meaning":"غَاضِب","example":"O öfkeli.","translation":"إنه غاضب."}],"difficulty":3}}