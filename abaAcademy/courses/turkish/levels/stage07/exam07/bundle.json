{"theory":{"blocks":[{"btype":"text","text":"اختبار شامل للمرحلة 7: جمل من كل دروسها. انجح فيه قبل الانتقال."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":4,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":5,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Kendin ol!","ar":"كن نفسك!"},{"t":"Tom geçen sene Avustralya'ya gitti mi?","ar":"هل ذهب توم إلى أستراليا العام الماضي؟"},{"t":"İlk önce kadınlar ve çocuklar!","ar":"النساء و الأطفال أولا!"},{"t":"O, hastanede çalışmak istiyor.","ar":"إنها تريد أن تعمل في المستشفى."},{"t":"Hoş geldin!","ar":"أهلًا وسهلًا!"},{"t":"Onunla ilgili düşünmek istemiyorum.","ar":"لا أريد التّفكير فيه."},{"t":"Bize katıldı.","ar":"لقد لحق بنا."},{"t":"Sakin ol, oğlum.","ar":"اهدأ يا بني."},{"t":"Mary yazar olmak istiyordu.","ar":"ماري أرادت أن تكون كاتبة."},{"t":"Sami orada bekledi.","ar":"انتظر سامي هناك."},{"t":"Tanıdığım hiç kimse artık Tom'u sevmiyor.","ar":"لا أحد أعرفهُ يحب توم بعد الآن."},{"t":"Beş sene Japonca çalıştım.","ar":"درست ياباني خمس سنين"},{"t":"O da Japonca öğrendi mi?","ar":"هل تَعَلَمَ اليابانية أيضاً؟"},{"t":"Sinemaya gitmek ister misiniz?","ar":"هل تريد الذهاب إلى السينما؟"},{"t":"Tom bir hastanede çalışıyor.","ar":"توم يعمل في مستشفى"},{"t":"Sana yeterince teşekkür edemem.","ar":"لا أستطيع أن أشكركَ كفاية."},{"t":"Sami on altı yaşına girdi.","ar":"بلغ سامي السّادسة عشر."},{"t":"Bir taksi için yeterli param yok.","ar":"لم أملك فلوساً كافيَّا لِتاكسيٍ."},{"t":"Tom'un şu an çalışmak istediğini düşünmüyorum.","ar":"لا أظن أن توم بمزاج العمل حاليا."},{"t":"Tom ve Mary aynı fikirde değiller.","ar":"توم و ماري ليسا متفقان."},{"t":"Japonca konuşma.","ar":"لا تتكلم باليابانية."},{"t":"Az önce sana söylediğim şeyi unutma.","ar":"لا تنس ما قلته لك للتّو."},{"t":"Sana verecek bir şeyim yok.","ar":"لا شيء معي لأعطيك إياه."},{"t":"O bir pencereyi açtı.","ar":"فتحت نافذة."},{"t":"Tom o kadar uzun boylu değil.","ar":"توم ليس طويلاً جداً."},{"t":"Onun hayatta mı ya da ölü mü olup olmadığını bilmiyorum.","ar":"لا أعلم فيما إذا كان حيا أم ميتا."},{"t":"Lütfen onu bana tekrar göster.","ar":"من فضلك أرني إياها مرة أخرى."},{"t":"Sami'nin korkunç gözleri vardı.","ar":"كانت عينا سامي مخيفتان."},{"t":"O okuyor.","ar":"هو يقرأ."},{"t":"Ken Tom'u yakaladı.","ar":"أمسك كان بتوم."},{"t":"Sana hemen yardım edemem.","ar":"لا أستطيع أن أساعدك حالا."},{"t":"Babam çok iyi araba sürer.","ar":"أبي ماهر في قيادة السيارة."},{"t":"Tom uzun süre Mary'yi bekledi ama o asla gelmedi.","ar":"انتظر توم ماري وقتا طويلا، لكنها لم تأتِ."},{"t":"O çok hızlı araba sürer.","ar":"إنه يقود بسرعة عالية."},{"t":"Tatoeba nedir?","ar":"ما هو تاتوبا؟"},{"t":"Okul ne zaman başlıyor?","ar":"متى تبدأ الدراسة؟"},{"t":"Bir dakika bekle, Mary!","ar":"إنتظري دقيقة, ماري!"},{"t":"Sami polise orada bile olmadığını söyledi.","ar":"أخبر سامي الشّرطة أنّه لم يكن هناك حتّى."},{"t":"O, kitapları nerede satın aldı?","ar":"أين اشترت كتبا؟"},{"t":"Otobüs bizi saat kaçta alacak?","ar":"متى ستصل الحافلة؟"},{"t":"Orada büyük bir yangın var.","ar":"يوجد حريق هائل هناك."},{"t":"Tom'un gitmesine izin verdi.","ar":"هو تركَ توم يذهب."},{"t":"Bunları unutma.","ar":"لا تنس هذه."},{"t":"Bana bir fincan kahve getir, lütfen.","ar":"أحضر لي فنجاناً من القهوة؟"},{"t":"Tom'un nasıl hissettiğini biliyorum.","ar":"اعرف كيف يشعر توم."},{"t":"Kitabın var mı?","ar":"هل تملك كتاباً؟"},{"t":"Tom, Mary'nin nerede olduğunu nasıl öğrendi?","ar":"كيف عَلِم توم مكان ماري؟"},{"t":"Onu yere koy.","ar":"ضعها أرضاً."},{"t":"Ne güzel çiçekler!","ar":"يا لها من أزهار جميلة!"},{"t":"Tom hâlâ hastanede.","ar":"ما زال توم في المستشفى."},{"t":"Ben açık mıyım?","ar":"هل هذا واضح؟"},{"t":"İki tane oğlum var.","ar":"عندي ابنان."},{"t":"Öğle yemeğinden sonra alışverişe gideceğim.","ar":"سوف اذهب للتسوق بعد الغداء."},{"t":"Neden buradayım?","ar":"لماذا أنا هنا؟"},{"t":"O, ikinci el bir araba aldığını söyledi.","ar":"قال أنه اشترى سيارة مستخدمة."},{"t":"Onu yapmak için zamanım olup olmayacağını bilmiyorum.","ar":"لا أعلم إن كنت سأملك الوقت لفعله."},{"t":"Bekle. Seninle konuşmak istiyorum.","ar":"انتظر. أريد الحديث معك."},{"t":"Gitmesine izin verdi.","ar":"هي تركتها تذهب."},{"t":"Biz sinemaya gidiyoruz.","ar":"نحن ذاهبون إلى السينما."},{"t":"Birçok kitabın var.","ar":"لديك الكثير من الكتب."},{"t":"Japonca öğrenmek zorundayım.","ar":"يَجِبُ عليَّ أن أتعلم اللغة اليابانية."},{"t":"Tom, Mary'nin yanına oturdu.","ar":"جلس توم بجنب ماري."},{"t":"Bunu bıraktım.","ar":"تركت هذا."},{"t":"Senin hakkında sevdiğim budur.","ar":"هذا ما أحبه فيك."},{"t":"Seninle evlenmek istiyorum.","ar":"أُريد أن أتزوجكِ."},{"t":"Söylediği mantıklı değil.","ar":"ما يقوله ليس له أي معنى."},{"t":"Niçin buradayım?","ar":"لماذا أنا هنا؟"},{"t":"Sami bütün öğleden sonra seni bekledi.","ar":"انتظرك سامي طيلة الظّهيرة."},{"t":"Bekle. Sana bir şey söylemek istiyorum.","ar":"انتظر، أريد إخبارك بأمر ما."},{"t":"Polise yalan söyledi.","ar":"كذبت على ذلك الشرطي."},{"t":"Onun çok sayıda kitapları var mı?","ar":"هل لديه كتب كثيرة؟"},{"t":"Leyla gelip beni aldı.","ar":"أتت ليلى و أقلّتني."},{"t":"Onu bana neden söylüyorsun?","ar":"لم تقول ذلك لي؟"},{"t":"Lucy tenis oynamayı seviyor.","ar":"تحب لوسي لعب التنس."},{"t":"Başkan Roosevelt yardım etmeyi kabul etti.","ar":"وافق الرئيس روزفلت على المساعدة."},{"t":"Sami, Leyla'yı hastanede ziyaret etmedi.","ar":"لم يزر سامي ليلى عندما كانت في المستشفى."},{"t":"Tom hariç herkes geldi.","ar":"أتى الجميع باستثناء توم."},{"t":"Biraz daha kibar olmalısın.","ar":"عليك أن تكون مهذباً أكثر."},{"t":"Kitabı sipariş ettin mi?","ar":"هل طلبت الكتاب؟"},{"t":"Gitme zamanı olduğunu biliyorum ama biraz daha kalmak istiyorum.","ar":"أعلم أن وقت الرحيل قد حان و لكنّي أريد البقاء فترة أطول."}],"difficulty":2}}