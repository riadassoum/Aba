":"Onu her zaman söylüyorsun.","ar":"أنتَ تقولُ ذلك كل مرة."},{"t":"Tom, Mary'yi tanıyor muydu?","ar":"هل كان توم يعرف ماري؟"},{"t":"Japonca öğrenmek istiyorum.","ar":"أريد تعلم اليابانية."},{"t":"Onu bana neden söylüyorsun?","ar":"لم تقول ذلك لي؟"},{"t":"Japonca çalışmak zorundayım.","ar":"عليّ أن أدرس اليابانية."},{"t":"Japonca öğrenmek zorundayım.","ar":"يَجِبُ عليَّ أن أتعلم اللغة اليابانية."},{"t":"Yalan söylüyorsun, değil mi?","ar":"أنت تكذب، أليس كذلك؟"},{"t":"Onu hakkında endişe ediyorum.","ar":"إنني قلق عليه."},{"t":"Yaptığın hakkında endişe etme.","ar":"لا تقلق بشأن ما فعلته."},{"t":"Tom Mary'ye çiçekler gönderdi.","ar":"أرسل توم أزهارا لماري."},{"t":"Onu sevmediğini mi söylüyorsun?","ar":"هل تعني أنّك لا تحبّه؟"},{"t":"Neden onun için yalan söylüyorsun?","ar":"لم تكذب من أجلها؟"},{"t":"Kişisel olarak sizi ziyaret edeceğim.","ar":"سأزورك بنفسي."},{"t":"Ben kişisel bir bilgisayar istiyorum.","ar":"أريد حاسوبًا شخصيًّا."},{"t":"Bu şeyleri neden söylüyorsun, kardeşim?","ar":"لم تقول هذا يا أخي؟"},{"t":"Leyla çiçekler için Sami'ye teşekkür etti.","ar":"شكرت ليلى سامي على الورود."}],"focus":["kayak","muydu","endişe","kişisel","yaşına","alıyorum","çiçekler","kazanmak","Japonca","söylüyorsun"],"words":[{"word":"kayak","topic":"L134","difficulty":2,"meaning":"تَزَلُّج","example":"Kayak yapmayı severim.","translation":"أحب التزحلق على الثلج."},{"word":"endişe","topic":"L134","difficulty":2,"meaning":"قَلَق","example":"Onu hakkında endişe ediyorum.","translation":"إنني قلق عليه."},{"word":"kişisel","topic":"L134","difficulty":2,"meaning":"شَخْصِيّ","example":"Kişisel olarak sizi ziyaret edeceğim.","translation":"سأزورك بنفسي."},{"word":"kazanmak","topic":"L134","difficulty":2,"meaning":"رَبِحَ","example":"Kazanmak zorundayız.","translation":"يجب أن ننجح."},{"word":"Japonca","topic":"L134","difficulty":2,"meaning":"اَلْيَابَانِيَّة","example":"Japonca konuşma.","translation":"لا تتكلم باليابانية."}],"difficulty":2}}