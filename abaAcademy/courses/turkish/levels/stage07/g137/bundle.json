 أنه اشترى سيارة مستخدمة."},{"t":"Sami Müslümanlara dair fikrini değiştirdi.","ar":"غيّر سامي رأيه بخصوص المسلمين."},{"t":"Bizim yalnızca biraz zamana ihtiyacımız var.","ar":"نحتاج فقط قليلا من الوقت."},{"t":"Erkek kardeşlerin her ikisi de hâlâ hayatta.","ar":"لا يزال كلا الأخوين على قيد الحياة."},{"t":"Sadece onunla birlikte daha fazla zamana ihtiyacım var.","ar":"أحتاج قضاء المزيد من الوقت معه فحسب."}],"focus":["zamana","edemem","aldığını","kırk","kesti","değiştirdi","kardeşlerin","başladım","yapmaz","İspanyolca"],"words":[{"word":"kırk","topic":"L137","difficulty":2,"meaning":"أَرْبَعُونَ","example":"Sami artık kırk altı yaşında.","translation":"عمر سامي الآن خمس و أربعون عاما."},{"word":"İspanyolca","topic":"L137","difficulty":2,"meaning":"إسبانية","example":"O benimle İspanyolca konuştu.","translation":"كلمتني بالإسبانية."}],"difficulty":2}}