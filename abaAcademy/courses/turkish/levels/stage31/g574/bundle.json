{"theory":{"blocks":[{"btype":"text","text":"الدرس 574. الكلمات الجديدة: bulacaksın، yazabilir، konudan، ofisime، geçmeye، istediğinizi، takıyordu، bunalımlı، söylemesine، ilgileneceğim."},{"btype":"example","text":"bulacaksın","note":"مثال: Bence uygun bulacaksın. — أظنك ستوافق."},{"btype":"example","text":"yazabilir","note":"مثال: İngilizce bir mektup yazabilir misin? — أيمكنك كتابة رسالة بالإنجليزية؟"},{"btype":"example","text":"konudan","note":"مثال: Ama bu konudan bana hiç söz etmedin! — لكنك لم تخبرني عن هذا قط!"},{"btype":"example","text":"ofisime","note":"مثال: Ofisime gidelim. — هيا بنا نذهب إلى مكتبي."},{"btype":"example","text":"geçmeye","note":"مثال: Yolu geçmeye korktu. — خافت من عبور الشارع."},{"btype":"example","text":"istediğinizi","note":"مثال: Doktor olmak istediğinizi biliyorum. — أعلم أنّك تريد أن تصبح طبيبا."},{"btype":"example","text":"takıyordu","note":"مثال: Sami gözlük takıyordu. — كان سامي يرتدي نظّارات."},{"btype":"example","text":"bunalımlı","note":"مثال: Bunalımlı hissediyor musun? — هل تشعر بالإحباط؟"},{"btype":"example","text":"söylemesine","note":"مثال: Onun bir şey söylemesine izin vermeyin. — لا تدعه يقول شيئا."},{"btype":"example","text":"ilgileneceğim","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ofisime gidelim.","note":"هيا بنا نذهب إلى مكتبي."},{"btype":"example","text":"Yolu geçmeye korktu.","note":"خافت من عبور الشارع."},{"btype":"example","text":"Sami gözlük takıyordu.","note":"كان سامي يرتدي نظّارات."},{"btype":"example","text":"Bence uygun bulacaksın.","note":"أظنك ستوافق."},{"btype":"example","text":"Bunalımlı hissediyor musun?","note":"هل تشعر بالإحباط؟"},{"btype":"example","text":"Onları bulacaksın, değil mi?","note":"ستجدهم، أليس كذلك؟"},{"btype":"example","text":"Ama bu konudan bana hiç söz etmedin!","note":"لكنك لم تخبرني عن هذا قط!"},{"btype":"example","text":"Doktor olmak istediğinizi biliyorum.","note":"أعلم أنّك تريد أن تصبح طبيبا."},{"btype":"example","text":"İngilizce bir mektup yazabilir misin?","note":"أيمكنك كتابة رسالة بالإنجليزية؟"},{"btype":"example","text":"Onun bir şey söylemesine izin vermeyin.","note":"لا تدعه يقول شيئا."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Ofisime gidelim.","ar":"هيا بنا نذهب إلى مكتبي."},{"t":"Yolu geçmeye korktu.","ar":"خافت من عبور الشارع."},{"t":"Sami gözlük takıyordu.","ar":"كان سامي يرتدي نظّارات."},{"t":"Bence uygun bulacaksın.","ar":"أظنك ستوافق."},{"t":"Bunalımlı hissediyor musun?","ar":"هل تشعر بالإحباط؟"},{"t":"Onları bulacaksın, değil mi?","ar":"ستجدهم، أليس كذلك؟"},{"t":"Ama bu konudan bana hiç söz etmedin!","ar":"لكنك لم تخبرني عن هذا قط!"},{"t":"Doktor olmak istediğinizi biliyorum.","ar":"أعلم أنّك تريد أن تصبح طبيبا."},{"t":"İngilizce bir mektup yazabilir misin?","ar":"أيمكنك كتابة رسالة بالإنجليزية؟"},{"t":"Onun bir şey söylemesine izin vermeyin.","ar":"لا تدعه يقول شيئا."}],"focus":["bulacaksın","yazabilir","konudan","ofisime","geçmeye","istediğinizi","takıyordu","bunalımlı","söylemesine","ilgileneceğim"],"words":[],"difficulty":5}}