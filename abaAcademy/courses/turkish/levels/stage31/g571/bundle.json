{"theory":{"blocks":[{"btype":"text","text":"الدرس 571. الكلمات الجديدة: babana، oynayacak، binaya، yaşamaktan، varacak، saçlı، gayret، görmemiştim، yiyoruz، arkadaşlarla."},{"btype":"example","text":"babana","note":"مثال: Babana benziyorsun. — أنت تشبه والدك."},{"btype":"example","text":"oynayacak","note":"مثال: O, arkadaşlarıyla tenis oynayacak. — سوف يلعب كرة المضرب مع أصدقائه."},{"btype":"example","text":"binaya","note":"مثال: Tom binaya girdi. — دخل توم المبنى."},{"btype":"example","text":"yaşamaktan","note":"مثال: Gerçekten yaşamaktan bıktım. — لقد سأمت من الحياة إلى أبعد الحدود."},{"btype":"example","text":"varacak","note":"مثال: O yarın Paris'e varacak. — سوف يصل الى باريس غداً."},{"btype":"example","text":"saçlı","note":"مثال: O çocuk siyah saçlı. — شعر ذاك الولد أسود."},{"btype":"example","text":"gayret","note":""},{"btype":"example","text":"görmemiştim","note":"مثال: Ben daha önce böyle güzel bir kız hiç görmemiştim. — لم يسبق لي و أن رأيت فتاة جميلة مثل هذه."},{"btype":"example","text":"yiyoruz","note":"مثال: Biz elma yiyoruz. — إننا نأكل التفاح."},{"btype":"example","text":"arkadaşlarla","note":"مثال: Ben arkadaşlarla konuştum. — تحدثتُ إلى الأصدقاء."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Tom binaya girdi.","note":"دخل توم المبنى."},{"btype":"example","text":"Biz elma yiyoruz.","note":"إننا نأكل التفاح."},{"btype":"example","text":"Babana benziyorsun.","note":"أنت تشبه والدك."},{"btype":"example","text":"O çocuk siyah saçlı.","note":"شعر ذاك الولد أسود."},{"btype":"example","text":"Şu kırmızı binaya bak.","note":"أنظر إلى ذاك البناء الأحمر."},{"btype":"example","text":"Ne zaman yemek yiyoruz?","note":"متى سنأكل؟"},{"btype":"example","text":"O yarın Paris'e varacak.","note":"سوف يصل الى باريس غداً."},{"btype":"example","text":"Ben arkadaşlarla konuştum.","note":"تحدثتُ إلى الأصدقاء."},{"btype":"example","text":"Ne zaman yiyoruz? Ben açım!","note":"متى سنأكل اني اشعر بالجوع."},{"btype":"example","text":"Gerçekten yaşamaktan bıktım.","note":"لقد سأمت من الحياة إلى أبعد الحدود."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Tom binaya girdi.","ar":"دخل توم المبنى."},{"t":"Biz elma yiyoruz.","ar":"إننا نأكل التفاح."},{"t":"Babana benziyorsun.","ar":"أنت تشبه والدك."},{"t":"O çocuk siyah saçlı.","ar":"شعر ذاك الولد أسود."},{"t":"Şu kırmızı binaya bak.","ar":"أنظر إلى ذاك البناء الأحمر."},{"t":"Ne zaman yemek yiyoruz?","ar":"متى سنأكل؟"},{"t":"O yarın Paris'e varacak.","ar":"سوف يصل الى باريس غداً."},{"t":"Ben arkadaşlarla konuştum.","ar":"تحدثتُ إلى الأصدقاء."},{"t":"Ne zaman yiyoruz? Ben açım!","ar":"متى سنأكل اني اشعر بالجوع."},{"t":"Gerçekten yaşamaktan bıktım.","ar":"لقد سأمت من الحياة إلى أبعد الحدود."},{"t":"Uçak Tokyo'ya saat kaçta varacak?","ar":"متى ستصل الطائرة إلى طوكيو؟"},{"t":"O, arkadaşlarıyla tenis oynayacak.","ar":"سوف يلعب كرة المضرب مع أصدقائه."},{"t":"Bu gece akşam yemeği için ne yiyoruz?","ar":"ما عشاؤنا الليلة؟"},{"t":"Ben daha önce böyle güzel bir kız hiç görmemiştim.","ar":"لم يسبق لي و أن رأيت فتاة جميلة مثل هذه."},{"t":"Benim birçok arkadaşlarla konuşmak için bol bol vaktim vardı.","ar":"كان لدي ما يكفي من الوقت كي أتحدث مع العديد من الأصدقاء."}],"focus":