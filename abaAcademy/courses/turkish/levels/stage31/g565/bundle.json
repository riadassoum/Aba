{"theory":{"blocks":[{"btype":"text","text":"الدرس 565. الكلمات الجديدة: oturur، bozucu، tanınmış، mutluydum، yüzerek، lâzım، konuşmalıyım، kalabilirsin، rafa، kelimesi."},{"btype":"example","text":"oturur","note":""},{"btype":"example","text":"bozucu","note":"مثال: Bu sinir bozucu. — إنهُ مزعج."},{"btype":"example","text":"tanınmış","note":""},{"btype":"example","text":"mutluydum","note":"مثال: Dün mutluydum. — كنت سعيدًا بالأمس."},{"btype":"example","text":"yüzerek","note":"مثال: Tom nehri yüzerek geçti. — قطع توم النهر سباحة."},{"btype":"example","text":"lâzım","note":"مثال: Seninle hemen konuşmam lâzım. — احتاج ان اتحدث معك الآن."},{"btype":"example","text":"konuşmalıyım","note":"مثال: Sanırım Tom'la konuşmalıyım. — أعتقد أنني أحتاج إلى التحدّث مع توم."},{"btype":"example","text":"kalabilirsin","note":"مثال: Belki de bizimle kalabilirsin. — بإمكانك ربّما أن تبق معنا."},{"btype":"example","text":"rafa","note":"مثال: O, kitabı rafa koydu. — وضع الكتاب على الرف."},{"btype":"example","text":"kelimesi","note":"مثال: \"Barış\" kelimesi her dilde güzeldir. — الكلمة سلام جميلة بأي لغة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Dün mutluydum.","note":"كنت سعيدًا بالأمس."},{"btype":"example","text":"Çok mutluydum.","note":"كنت سعيدا جدا."},{"btype":"example","text":"Bu sinir bozucu.","note":"إنهُ مزعج."},{"btype":"example","text":"O, kitabı rafa koydu.","note":"وضع الكتاب على الرف."},{"btype":"example","text":"Ben o zaman mutluydum.","note":"كنت سعيداً يومها."},{"btype":"example","text":"Tom nehri yüzerek geçti.","note":"قطع توم النهر سباحة."},{"btype":"example","text":"Sanırım Tom'la konuşmalıyım.","note":"أعتقد أنني أحتاج إلى التحدّث مع توم."},{"btype":"example","text":"Seninle hemen konuşmam lâzım.","note":"احتاج ان اتحدث معك الآن."},{"btype":"example","text":"Belki de bizimle kalabilirsin.","note":"بإمكانك ربّما أن تبق معنا."},{"btype":"example","text":"Akşam yemeği için kalabilirsin.","note":"بإمكانك البقاء لتناول العشاء."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Dün mutluydum.","ar":"كنت سعيدًا بالأمس."},{"t":"Çok mutluydum.","ar":"كنت سعيدا جدا."},{"t":"Bu sinir bozucu.","ar":"إنهُ مزعج."},{"t":"O, kitabı rafa koydu.","ar":"وضع الكتاب على الرف."},{"t":"Ben o zaman mutluydum.","ar":"كنت سعيداً يومها."},{"t":"Tom nehri yüzerek geçti.","ar":"قطع توم النهر سباحة."},{"t":"Sanırım Tom'la konuşmalıyım.","ar":"أعتقد أنني أحتاج إلى التحدّث مع توم."},{"t":"Seninle hemen konuşmam lâzım.","ar":"احتاج ان اتحدث معك الآن."},{"t":"Belki de bizimle kalabilirsin.","ar":"بإمكانك ربّما أن تبق معنا."},{"t":"Akşam yemeği için kalabilirsin.","ar":"بإمكانك البقاء لتناول العشاء."},{"t":"\"Barış\" kelimesi her dilde güzeldir.","ar":"الكلمة سلام جميلة بأي لغة."},{"t":"Yeni plan hakkında onunla konuşmalıyım.","ar":"لا بد لي من التحدث معها حول الخطة الجديدة."},{"t":"Buna neden ihtiyacın olduğunu bilmem lâzım.","ar":"يجب أن أعرف لماذا تحتاج هذا."},{"t":"Her zaman bir kahraman olmak imkansızdır ama her zaman bir erkek kalabilirsin.","ar":"من المستحيل أن تكون دائمًا بطلاً، ولكن يمكنك أن تظل رجلاً دائمًا."}],"focus":["oturur","bozucu","tanınmış","mutluydum","yüzerek","lâzım","konuşmalıyım","kalabilirsin","rafa","kel