ylediğinde Mary'ye inanmadı.","ar":"لم يصدّق توم ماري عندما أخبرته عن حبها له."}],"focus":["olayı","kızını","inanmadı","dedin","gelenin","ederken","görünüyorlar","mağazada","havaalanında","şiddetle"],"words":[],"difficulty":4}}