{"theory":{"blocks":[{"btype":"text","text":"الدرس 443. الكلمات الجديدة: öldürdüğünü، canını، yaşamıyor، odamda، civarında، vermezdi، arttı، seçimi، çıkalım، izlemekten."},{"btype":"example","text":"öldürdüğünü","note":"مثال: Tom Mary'yi öldürdüğünü itiraf etti. — اعترف توم بقتل ماري."},{"btype":"example","text":"canını","note":""},{"btype":"example","text":"yaşamıyor","note":"مثال: Orada kimse yaşamıyor. — لا أحد يسكن هناك."},{"btype":"example","text":"odamda","note":"مثال: Odamda uyuyorsun. — أنت تنام في حجرتي."},{"btype":"example","text":"civarında","note":"مثال: Tom 2.30 civarında geldi. — وصل توم حوالي 2:30."},{"btype":"example","text":"vermezdi","note":"مثال: Tom Mary'nin onu yapmasına izin vermezdi. — لم يكن توم ليسمح لماري بفعل ذلك."},{"btype":"example","text":"arttı","note":""},{"btype":"example","text":"seçimi","note":""},{"btype":"example","text":"çıkalım","note":"مثال: Hadi dışarı çıkalım — هيا. دعنا نخرج من هنا."},{"btype":"example","text":"izlemekten","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Odamda uyuyorsun.","note":"أنت تنام في حجرتي."},{"btype":"example","text":"Hadi dışarı çıkalım","note":"هيا. دعنا نخرج من هنا."},{"btype":"example","text":"Orada kimse yaşamıyor.","note":"لا أحد يسكن هناك."},{"btype":"example","text":"Odamda bir telefon var.","note":"يوجد هاتف في غرفتي."},{"btype":"example","text":"Kimse benimle yaşamıyor.","note":"لا أحد يعيش معي."},{"btype":"example","text":"O, artık orada yaşamıyor.","note":"لم تعد تسكن هناك."},{"btype":"example","text":"O artık burada yaşamıyor.","note":"لم يعد يسكن هنا."},{"btype":"example","text":"Tom 2.30 civarında geldi.","note":"وصل توم حوالي 2:30."},{"btype":"example","text":"Bu evde hiç kimse yaşamıyor.","note":"لا يعيش أحد في هذا المنزل."},{"btype":"example","text":"Tom artık benimle yaşamıyor.","note":"لم يعد توم يعيش معي."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Odamda uyuyorsun.","ar":"أنت تنام في حجرتي."},{"t":"Hadi dışarı çıkalım","ar":"هيا. دعنا نخرج من هنا."},{"t":"Orada kimse yaşamıyor.","ar":"لا أحد يسكن هناك."},{"t":"Odamda bir telefon var.","ar":"يوجد هاتف في غرفتي."},{"t":"Kimse benimle yaşamıyor.","ar":"لا أحد يعيش معي."},{"t":"O, artık orada yaşamıyor.","ar":"لم تعد تسكن هناك."},{"t":"O artık burada yaşamıyor.","ar":"لم يعد يسكن هنا."},{"t":"Tom 2.30 civarında geldi.","ar":"وصل توم حوالي 2:30."},{"t":"Bu evde hiç kimse yaşamıyor.","ar":"لا يعيش أحد في هذا المنزل."},{"t":"Tom artık benimle yaşamıyor.","ar":"لم يعد توم يعيش معي."},{"t":"Benim odamda bir sürü kitap var.","ar":"هناك الكثير من الكتب في غرفتي."},{"t":"Artık burada hiç kimse yaşamıyor.","ar":"لا أحد يعيش هنا بعد الآن."},{"t":"Birkaç günlük bir tatile çıkalım.","ar":"لنأخذ استراحة قصيرة."},{"t":"Orada yirmi civarında insan vardı.","ar":"كان هناك حوالي عشرون شخصاً."},{"t":"Tom Mary'yi öldürdüğünü itiraf etti.","ar":"اعترف توم بقتل ماري."},{"t":"Tom Mary'nin onu yapmasına izin vermezdi.","ar":"لم يكن توم ليسمح لماري بفعل ذلك."},{"t":"Tom Mary'nin içeri girmesine izin vermezdi.","ar":"توم لم يسمح لميري بالدخول."},{"t":"Polis, Tom'un birkaç kişiyi öldürdüğünü düşünüyor.","ar":"تظنّ الشرطة بأن توم قتل عدة أشخاص."}],"focus":["öldürdüğünü","canı