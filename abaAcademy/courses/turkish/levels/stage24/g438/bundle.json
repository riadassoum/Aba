{"theory":{"blocks":[{"btype":"text","text":"الدرس 438. الكلمات الجديدة: gidebilirim، sınıfa، yaşadığım، kazanacak، paul، üvey، gömleği، sözlerini، caddenin، uğradım."},{"btype":"example","text":"gidebilirim","note":"مثال: Trenle gidebilirim. — أستطيع الذهاب بالقطار."},{"btype":"example","text":"sınıfa","note":"مثال: Bob sınıfa koştu. — أسرع بوب إلى الفصل."},{"btype":"example","text":"yaşadığım","note":"مثال: Yaşadığım sürece o bayramı unutmayacağım. — لن أنس ذلك الحفل ما دمت حيّا."},{"btype":"example","text":"kazanacak","note":"مثال: Sami kazanacak. — سيفوز سامي."},{"btype":"example","text":"paul","note":"مثال: Paul hemen kaçtı. — فر بول فورا."},{"btype":"example","text":"üvey","note":"مثال: O benim üvey kız kardeşim. — هي أختي غير الشقيقة."},{"btype":"example","text":"gömleği","note":"مثال: Tom o gömleği ne zaman satın aldı? — متى اشترى توم هذا القميص؟"},{"btype":"example","text":"sözlerini","note":""},{"btype":"example","text":"caddenin","note":""},{"btype":"example","text":"uğradım","note":"مثال: Hayal kırıklığına uğradım. — لقد أُصبت بالخيبة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sami kazanacak.","note":"سيفوز سامي."},{"btype":"example","text":"Bob sınıfa koştu.","note":"أسرع بوب إلى الفصل."},{"btype":"example","text":"Paul hemen kaçtı.","note":"فر بول فورا."},{"btype":"example","text":"Trenle gidebilirim.","note":"أستطيع الذهاب بالقطار."},{"btype":"example","text":"Oraya nasıl gidebilirim?","note":"كيف بإمكاني الوصول إلى هناك؟"},{"btype":"example","text":"Bill kazanacak, değil mi?","note":"سيفوز بيل، أليس كذلك؟"},{"btype":"example","text":"O benim üvey kız kardeşim.","note":"هي أختي غير الشقيقة."},{"btype":"example","text":"Hayal kırıklığına uğradım.","note":"لقد أُصبت بالخيبة."},{"btype":"example","text":"Tom benim üvey erkek kardeşim.","note":"توم أخي من أمّي."},{"btype":"example","text":"Paul artık Rima'dan hoşlanmıyor.","note":"لم يعد بول يحب ريمة."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Sami kazanacak.","ar":"سيفوز سامي."},{"t":"Bob sınıfa koştu.","ar":"أسرع بوب إلى الفصل."},{"t":"Paul hemen kaçtı.","ar":"فر بول فورا."},{"t":"Trenle gidebilirim.","ar":"أستطيع الذهاب بالقطار."},{"t":"Oraya nasıl gidebilirim?","ar":"كيف بإمكاني الوصول إلى هناك؟"},{"t":"Bill kazanacak, değil mi?","ar":"سيفوز بيل، أليس كذلك؟"},{"t":"O benim üvey kız kardeşim.","ar":"هي أختي غير الشقيقة."},{"t":"Hayal kırıklığına uğradım.","ar":"لقد أُصبت بالخيبة."},{"t":"Tom benim üvey erkek kardeşim.","ar":"توم أخي من أمّي."},{"t":"Paul artık Rima'dan hoşlanmıyor.","ar":"لم يعد بول يحب ريمة."},{"t":"Tom o gömleği ne zaman satın aldı?","ar":"متى اشترى توم هذا القميص؟"},{"t":"Yaşadığım sürece o bayramı unutmayacağım.","ar":"لن أنس ذلك الحفل ما دمت حيّا."}],"focus":["gidebilirim","sınıfa","yaşadığım","kazanacak","paul","üvey","gömleği","sözlerini","caddenin","uğradım"],"words":[],"difficulty":4}}