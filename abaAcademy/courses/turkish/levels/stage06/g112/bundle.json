r.","ar":"لدي الكثير لأفعله اليوم."},{"t":"Merhaba? Hâlâ burada mısın?","ar":"مرحباً، هل ما زلت هنا؟"},{"t":"Kedi masanın üzerinde uyuyor.","ar":"القط ينام على الطاولة."},{"t":"O senden nefret etmiyor, Tom.","ar":"هي لا تكرهكَ يا توم."},{"t":"Babam için bir hediye arıyorum.","ar":"أبحث عن هدية لأبي."}],"focus":["uyuyor","i̇nsan","arıyorum","etmiyor","işim","veriyorum","elini","merhaba","sevmez","şirket"],"words":[{"word":"merhaba","topic":"L112","difficulty":2,"meaning":"مرحبًا","example":"Merhaba Tom.","translation":"أهلا يا توم!"},{"word":"şirket","topic":"L112","difficulty":2,"meaning":"شَرِكَة"}],"difficulty":2}}