 ولد و ابنتين."},{"t":"Onun bir oğlu ve bir kızı vardır.","ar":"لديها ابن وابنة."},{"t":"Bir sonraki yıl o onunla evlendi.","ar":"تزوجته في السنة التالية"},{"t":"Fadıl yanlış zamanda yanlış yerde idi.","ar":"كان فاضل في المكان الخطأ في الوقت الخطأ."},{"t":"Ona bunun acil bir durum olduğunu söyle.","ar":"قل لها أنه أمر مستجل."},{"t":"\"Fakat bütün sahip olduğum üç milyon\" dedi Dima. \"Ne daha çok ne daha az.\"","ar":"قال ديما: \"لكن الثلاثة ملايين هي كل ما عندي، لا أكثر، ولا أقل\"."}],"focus":["zeki","anlattı","hangisi","bayan","soruyu","yatak","yumurta","meyve","hızla","kış"],"words":[{"word":"zeki","topic":"L110","difficulty":2,"meaning":"ذَكِيّ","example":"O çok zeki.","translation":"إنها ذكية جداً."},{"word":"bayan","topic":"L110","difficulty":2,"meaning":"آنِسَة"},{"word":"yatak","topic":"L110","difficulty":2,"meaning":"سَرِير"},{"word":"yumurta","topic":"L110","difficulty":2,"meaning":"بَيْض، بَيْضَة","example":"Hepsi on yumurta vardı.","translation":"كانت هناك عشرة بيضات بالإجمال."},{"word":"meyve","topic":"L110","difficulty":2,"meaning":"ثَمَرَة، فَاكِهَة","example":"Meyve severim.","translation":"أحب الفواكه."},{"word":"kış","topic":"L110","difficulty":2,"meaning":"شِتَاء","example":"Bu kış çok soğuk.","translation":"الجوّ بارد جداً هذا الشتاء."}],"difficulty":2}}