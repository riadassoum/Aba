{"theory":{"blocks":[{"btype":"text","text":"الدرس 601. الكلمات الجديدة: vermiyorum، istediğimizi، konuşmamı، banyoya، kapatır، sürmeye، Rusya'da، ayağını، ekleyin، gencim."},{"btype":"example","text":"vermiyorum","note":"مثال: Tom'un gitmesine izin vermiyorum. — لن أدع توما يذهب."},{"btype":"example","text":"istediğimizi","note":"مثال: O bize ne istediğimizi sordu. — هو سألنا ماذا نريد."},{"btype":"example","text":"konuşmamı","note":"مثال: O bu konuda konuşmamı istemiyor. — هي لا تريد مني التحدث عن هذه المسألة."},{"btype":"example","text":"banyoya","note":"مثال: Banyoya gitmem gerekiyor. — يَجِبُ أَنْ أَذْهبَ إلى الحمّامِ."},{"btype":"example","text":"kapatır","note":"مثال: Kapıyı kapatır mısın? — هل لك أن تغلق الباب؟"},{"btype":"example","text":"sürmeye","note":"مثال: O hızlı sürmeye devam etti. — واصلت السياقة بسرعة."},{"btype":"example","text":"Rusya'da","note":"مثال: Rusya'da yaşıyorum. — أعيش في روسيا."},{"btype":"example","text":"ayağını","note":""},{"btype":"example","text":"ekleyin","note":"مثال: Sadece su ekleyin. — فقط أضف الماء"},{"btype":"example","text":"gencim","note":"مثال: Senden üç yaş daha gencim. — أنا أصغر منك بثلاث سنين."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sadece su ekleyin.","note":"فقط أضف الماء"},{"btype":"example","text":"Rusya'da yaşıyorum.","note":"أعيش في روسيا."},{"btype":"example","text":"Kapıyı kapatır mısın?","note":"هل لك أن تغلق الباب؟"},{"btype":"example","text":"Banyoya gitmem gerekiyor.","note":"يَجِبُ أَنْ أَذْهبَ إلى الحمّامِ."},{"btype":"example","text":"Senden üç yaş daha gencim.","note":"أنا أصغر منك بثلاث سنين."},{"btype":"example","text":"O hızlı sürmeye devam etti.","note":"واصلت السياقة بسرعة."},{"btype":"example","text":"O bize ne istediğimizi sordu.","note":"هو سألنا ماذا نريد."},{"btype":"example","text":"Leyla araç sürmeye devam etti.","note":"واصلت ليلى السّياقة."},{"btype":"example","text":"Lütfen pencereyi kapatır mısın?","note":"هلّا أغلقت النافذة من فضلك؟"},{"btype":"example","text":"O bu konuda konuşmamı istemiyor.","note":"هي لا تريد مني التحدث عن هذه المسألة."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"Sadece su ekleyin.","ar":"فقط أضف الماء"},{"t":"Rusya'da yaşıyorum.","ar":"أعيش في روسيا."},{"t":"Kapıyı kapatır mısın?","ar":"هل لك أن تغلق الباب؟"},{"t":"Banyoya gitmem gerekiyor.","ar":"يَجِبُ أَنْ أَذْهبَ إلى الحمّامِ."},{"t":"Senden üç yaş daha gencim.","ar":"أنا أصغر منك بثلاث سنين."},{"t":"O hızlı sürmeye devam etti.","ar":"واصلت السياقة بسرعة."},{"t":"O bize ne istediğimizi sordu.","ar":"هو سألنا ماذا نريد."},{"t":"Leyla araç sürmeye devam etti.","ar":"واصلت ليلى السّياقة."},{"t":"Lütfen pencereyi kapatır mısın?","ar":"هلّا أغلقت النافذة من فضلك؟"},{"t":"O bu konuda konuşmamı istemiyor.","ar":"هي لا تريد مني التحدث عن هذه المسألة."},{"t":"Onlarla konuşmamı istiyor musun?","ar":"هل تريدني أن اتحدث إليهم؟"},{"t":"Rusya'da kaç tane azınlık yaşar?","ar":"كم من أقلية إثنية تعيش في روسيا؟"},{"t":"Tom'un gitmesine izin vermiyorum.","ar":"لن أدع توما يذهب."},{"t":"Bunu yapmak için daha çok gencim.","ar":"مازلت صغيرا جدا لافعل ذلك."},{"t":"Leyla sahile doğru sürmeye başladı.","ar":"بدأت ليلى تتّجه بسيّارتها نحو الشّاطئ."},{"t":"O bu konu hakkında konuşmamı istemiyor.","ar":"هي لا تريدني أن أتحدث حول هذه المسألة."},{"t":"Lütfen dışarı çıkarken kapıyı kapatır mısın?","ar":"الرجاء إغلاق الباب عند الخروج."}],"focus":["vermiyorum","istediğimizi","konuşmamı","banyoya","kapatır","sürmeye","Rusya'da","ayağını","ekleyin","gencim"],"words":[],"difficulty":5}}