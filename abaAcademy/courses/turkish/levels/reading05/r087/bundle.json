 mahvoldu.","ar":"محركه متلف."},{"t":"Mary, Tom'un tek kızıdır.","ar":"ليلى هي الابنة الوحيدة لسامي."},{"t":"Onun nerede saklandığını merak ediyorum.","ar":"أتساءل أين يختبئ."},{"t":"Tom'un nerede saklandığını biliyor musun?","ar":"أتعلم أين اختبأ توم؟"},{"t":"Perdenin arkasında saklandığını biliyorum.","ar":"أعلم أنك مختبئ خلف الستار."}],"focus":["eminiz","getirmesini","dinleyelim","açıklamasını","sonuçlara","kalmalısın","girişimi","başarısızlıkla","sonuçlandı","randevuya","yüzeysel","suçlar","oynamasına","depremi","mesafesinde","hatamdı","düşmanıdır","insanlığın","işiniz","kaçar"],"difficulty":5}}