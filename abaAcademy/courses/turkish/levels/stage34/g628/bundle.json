{"theory":{"blocks":[{"btype":"text","text":"الدرس 628. الكلمات الجديدة: kulübüne، komşunun، söylemeyeceğine، yapmamanı، isteksizce، sorunlarım، bizzat، evleniyor، komşum، kutusunu."},{"btype":"example","text":"kulübüne","note":"مثال: Dan yerel bir gece kulübüne gitti. — اتّجه دان نحو نادي ليلي محلّي."},{"btype":"example","text":"komşunun","note":""},{"btype":"example","text":"söylemeyeceğine","note":"مثال: Tom kimseye söylemeyeceğine dair Mary'ye söz verdi. — توم وعد ماري أنه لن يخبر أحدا بالأمر."},{"btype":"example","text":"yapmamanı","note":"مثال: Bunu yapmamanı öneririm. — أفترض أن لا تفعلها."},{"btype":"example","text":"isteksizce","note":"مثال: Tom isteksizce Mary'yi izledi. — تبع توم ماري بتحفظ."},{"btype":"example","text":"sorunlarım","note":"مثال: Doktor, hafıza sorunlarım var. — أيها الطبيب، عندي مشاكل في الذاكرة."},{"btype":"example","text":"bizzat","note":"مثال: O bizzat geldi. — لقد أتى بنفسه"},{"btype":"example","text":"evleniyor","note":"مثال: Tom nihayet evleniyor. — سيتزوج توم أخيرا."},{"btype":"example","text":"komşum","note":"مثال: Yahudi bir komşum var. — أنا لدي جار يهودي."},{"btype":"example","text":"kutusunu","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"O bizzat geldi.","note":"لقد أتى بنفسه"},{"btype":"example","text":"Tom nihayet evleniyor.","note":"سيتزوج توم أخيرا."},{"btype":"example","text":"Yahudi bir komşum var.","note":"أنا لدي جار يهودي."},{"btype":"example","text":"Bunu yapmamanı öneririm.","note":"أفترض أن لا تفعلها."},{"btype":"example","text":"Eşcinsel bir komşum var.","note":"أنا لدي جار مثلي الجنس."},{"btype":"example","text":"Müslüman bir komşum var.","note":"لديّ جار مسلم."},{"btype":"example","text":"Onu yapmamanı istemedim mi?","note":"ألم أطلب منك عدم فعل ذلك؟"},{"btype":"example","text":"Tom Pazartesi günü evleniyor.","note":"سيتزوج توم يوم الاثنين."},{"btype":"example","text":"Benim Fransız bir komşum var.","note":"أنا لدي جار فرنسي."},{"btype":"example","text":"Tom isteksizce Mary'yi izledi.","note":"تبع توم ماري بتحفظ."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"O bizzat geldi.","ar":"لقد أتى بنفسه"},{"t":"Tom nihayet evleniyor.","ar":"سيتزوج توم أخيرا."},{"t":"Yahudi bir komşum var.","ar":"أنا لدي جار يهودي."},{"t":"Bunu yapmamanı öneririm.","ar":"أفترض أن لا تفعلها."},{"t":"Eşcinsel bir komşum var.","ar":"أنا لدي جار مثلي الجنس."},{"t":"Müslüman bir komşum var.","ar":"لديّ جار مسلم."},{"t":"Onu yapmamanı istemedim mi?","ar":"ألم أطلب منك عدم فعل ذلك؟"},{"t":"Tom Pazartesi günü evleniyor.","ar":"سيتزوج توم يوم الاثنين."},{"t":"Benim Fransız bir komşum var.","ar":"أنا لدي جار فرنسي."},{"t":"Tom isteksizce Mary'yi izledi.","ar":"تبع توم ماري بتحفظ."},{"t":"Doktor, hafıza sorunlarım var.","ar":"أيها الطبيب، عندي مشاكل في الذاكرة."},{"t":"Sami yarın Leyla ile evleniyor.","ar":"سامي وليلى سيتزوّجان غدًا."},{"t":"Dan yerel bir gece kulübüne gitti.","ar":"اتّجه دان نحو نادي ليلي محلّي."},{"t":"Tom kimseye söylemeyeceğine dair Mary'ye söz verdi.","ar":"توم وعد ماري أنه لن يخبر أحدا بالأمر."}],"focus":["kulübüne","komşunun","söylemeyeceğine","yapmamanı","isteksizce","sorunlarım","bizzat","evleniyor","komşum","kutusunu"],"words":[],"difficult