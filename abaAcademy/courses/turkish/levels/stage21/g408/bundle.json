ız","eğleniyor","telefonumu"],"words":[{"word":"kazara","topic":"L408","difficulty":5,"meaning":"عَنْ غَيْرِ قَصْدٍ","example":"Sami kazara öldü.","translation":"مات سامي بحادثة."},{"word":"ticaret","topic":"L408","difficulty":5,"meaning":"تِجَارَة","example":"Ticaret yapalım.","translation":"دعنا نصنع تجارة."},{"word":"apartman","topic":"L408","difficulty":5,"meaning":"شَقَّة"},{"word":"dinlenmek","topic":"L408","difficulty":5,"meaning":"اِسْتَرَاحَ"},{"word":"sudan","topic":"L408","difficulty":5,"meaning":"السُّودَان","example":"Köpeğim sudan korkuyor.","translation":"كلبي خائف من الماء."},{"word":"harita","topic":"L408","difficulty":5,"meaning":"خَرِيطَة","example":"İşte harita.","translation":"ها هي الخريطة."},{"word":"acımasız","topic":"L408","difficulty":5,"meaning":"قَاسٍ","example":"Acımasız olun.","translation":"كُن عديم الرحمة."}],"difficulty":5}}