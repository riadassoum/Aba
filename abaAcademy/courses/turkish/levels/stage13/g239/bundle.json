{"theory":{"blocks":[{"btype":"text","text":"الدرس 239. الكلمات الجديدة: ellerini، miydi، verildi، yıllardır، imkansız، yılda، öğretti، kullanıyor، almadım، şeydir."},{"btype":"example","text":"ellerini","note":""},{"btype":"example","text":"miydi","note":"مثال: Bu deprem miydi? — هل كان ذلك زلزالا؟"},{"btype":"example","text":"verildi","note":"مثال: Bana yeni bir ceket verildi. — أُعطيت معطفاً جديداً."},{"btype":"example","text":"yıllardır","note":"مثال: Yıllardır seni görmedim. — لم أرك منذ سنوات."},{"btype":"example","text":"imkansız","note":"مثال: O imkansız. — إن ذلك مستحيل."},{"btype":"example","text":"yılda","note":"مثال: Bir yılda on iki ay var. — هناك اثنا عشر شهرًا في السنة."},{"btype":"example","text":"öğretti","note":"مثال: O, bana tarih öğretti. — درّسني التاريخ."},{"btype":"example","text":"kullanıyor","note":""},{"btype":"example","text":"almadım","note":""},{"btype":"example","text":"şeydir","note":"مثال: Para hiçbir şeydir. — المال ليس شيئا."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"O imkansız.","note":"إن ذلك مستحيل."},{"btype":"example","text":"Bu deprem miydi?","note":"هل كان ذلك زلزالا؟"},{"btype":"example","text":"Ken dün evde miydi?","note":"هل كان كين في البيت البارحة؟"},{"btype":"example","text":"Para hiçbir şeydir.","note":"المال ليس شيئا."},{"btype":"example","text":"O belli değil miydi?","note":"الم یکن هذا واضحا؟"},{"btype":"example","text":"Bu hiç imkansız değil.","note":"إنها ليست مستحيلة على الإطلاق."},{"btype":"example","text":"O, bana tarih öğretti.","note":"درّسني التاريخ."},{"btype":"example","text":"Ölüm doğal bir şeydir.","note":"الموت أمر طبيعي."},{"btype":"example","text":"Aşk önemli bir şeydir.","note":"الحب شيء مهم."},{"btype":"example","text":"Yıllardır seni görmedim.","note":"لم أرك منذ سنوات."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"tr","lang_name":"التركية","sentences":[{"t":"O imkansız.","ar":"إن ذلك مستحيل."},{"t":"Bu deprem miydi?","ar":"هل كان ذلك زلزالا؟"},{"t":"Ken dün evde miydi?","ar":"هل كان كين في البيت البارحة؟"},{"t":"Para hiçbir şeydir.","ar":"المال ليس شيئا."},{"t":"O belli değil miydi?","ar":"الم یکن هذا واضحا؟"},{"t":"Bu hiç imkansız değil.","ar":"إنها ليست مستحيلة على الإطلاق."},{"t":"O, bana tarih öğretti.","ar":"درّسني التاريخ."},{"t":"Ölüm doğal bir şeydir.","ar":"الموت أمر طبيعي."},{"t":"Aşk önemli bir şeydir.","ar":"الحب شيء مهم."},{"t":"Yıllardır seni görmedim.","ar":"لم أرك منذ سنوات."},{"t":"Bir yılda on iki ay var.","ar":"هناك اثنا عشر شهرًا في السنة."},{"t":"Üzgünüm, ama bu imkansız.","ar":"أنا آسف لكن ذلك مستحيل."},{"t":"Savaş korkunç bir şeydir.","ar":"الحرب هو شيءٌ فظيع."},{"t":"Bana yeni bir ceket verildi.","ar":"أُعطيت معطفاً جديداً."},{"t":"Kesin olarak söylemek imkansız.","ar":"من المستحيل القول بشكلٍ قطعي."},{"t":"Uzun yıllardır burada çalışırım.","ar":"لقد عملت هنا لسنوات عديدة."},{"t":"O, yılda bir kez Tokyo'ya gelir.","ar":"هو يأتي إلى طوكيو مرة في العام."},{"t":"Sanırım hayat onu yaptığın şeydir.","ar":"اعتقد ان الحياة هي ما تصنعه."},{"t":"Hayatım sen olmadan hiçbir şeydir.","ar":"لا قيمة لحياتي دونك."},{"t":"Bir haftada raporu bitirmek imkansız.","ar":"يستحيل إنهاء التقرير في أسبوع."},{"t":"Aşık olmak dünyadaki en doğal şeydir.","ar":"لا شيء طبيعي أكثر من الوقوع في الحب."},{"t":"Bilmek bir şey değildir, hayal gücü her şeydir.","ar":"المعرفة لا تمثل شيئا، و الخيال هو كل شيء."},{"t":"\" Olabilir miydi...? Dima merak etti. Sonunda doğru Al-Sayib aldım mı?","ar":"تساءل ديما: \"أيمكن أن يكون...؟\". \"هل وجدت \"الصائب\" الصحيح أخيرًا؟\""},{"t":"Bir şeyi kendisi yapmak zorunda olmayan biri için hiçbir şey imkansız değildir.","ar":"لا شيء مستحيل على الرجل الذي لا يجب عليه عمله بنفسه."},{"t":"Tom ve Mary birlikte seyahat etti.","ar":"سافر توم وماري معا."},{"t":"Leyla, Sami'ye doğru hareket etti.","ar":"تحرّكت ليلى نحو سامي."},{"t":"Onlar onu hastaneye kabul ettiler.","ar":"قبلوها بالمشفى"},{"t":"Dünyayı olduğu gibi kabul etmeyin.","ar":"لا تقبل بالعالم كما هو."},{"t":"Merak etme. Bu bir daha olmayacak.","ar":"لا تقلق. لن يحدث هذا ثانية."},{"t":"Sami'nin Müslüman adı Abdullah'tır.","ar":"الإسم المسلم لسامي هو عبد الله."}],"focus":["ellerini","miydi","verildi","yıllardır","imkansız","yılda","öğretti","kullanıyor","almadım","şeydir"],"words":[],"difficulty":3}}