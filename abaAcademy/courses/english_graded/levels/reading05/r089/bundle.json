{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Do you speak dog?","note":"هل تتكلم لغة الكلاب؟"},{"btype":"example","text":"Where is your dog?","note":"اين كلبك؟"},{"btype":"example","text":"Sami wanted a dog.","note":"أراد سامي كلبا."},{"btype":"example","text":"Is that Tom's dog?","note":"أهذا كلب توم ؟"},{"btype":"example","text":"This is Mary's dog.","note":"ذلك كلب ماري."},{"btype":"example","text":"Sami found his dog.","note":"وجد سامي كلبه."},{"btype":"example","text":"Take your dog away.","note":"أبعد كلبك."},{"btype":"example","text":"Is your dog all right?","note":"هل كلبك بخير؟"},{"btype":"example","text":"Sami had a little dog.","note":"كان عند سامي كلب صغير."},{"btype":"example","text":"Sami should have a dog.","note":"ينبغي أن يملك سامي كلبا."},{"btype":"example","text":"Why does he want a dog?","note":"لماذا يريد كلبا؟"},{"btype":"example","text":"Tom doesn't like my dog.","note":"طوم لا يحبّ كلبي."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Do you speak dog?","ar":"هل تتكلم لغة الكلاب؟"},{"t":"Where is your dog?","ar":"اين كلبك؟"},{"t":"Sami wanted a dog.","ar":"أراد سامي كلبا."},{"t":"Is that Tom's dog?","ar":"أهذا كلب توم ؟"},{"t":"This is Mary's dog.","ar":"ذلك كلب ماري."},{"t":"Sami found his dog.","ar":"وجد سامي كلبه."},{"t":"Take your dog away.