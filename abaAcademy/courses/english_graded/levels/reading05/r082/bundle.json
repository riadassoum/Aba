{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"You must tell us.","note":"يجب أن تخبرنا."},{"btype":"example","text":"You must help her.","note":"عليك أن تساعدها."},{"btype":"example","text":"He must find work.","note":"هوَ لابد أن يجد عملاً."},{"btype":"example","text":"He must leave now.","note":"عليه الرّحيل الآن."},{"btype":"example","text":"You must work more.","note":"عليك أن تعمل بجهد أكبر."},{"btype":"example","text":"You must find work.","note":"أنتَ لابد أن تجد عملاً."},{"btype":"example","text":"She must find work.","note":"هىَ لابد أن تجد عملاً."},{"btype":"example","text":"Do what must be done.","note":"إفعل ما يجب فعله."},{"btype":"example","text":"You must go to school.","note":"يجب عليك أن تذهب إلى المدرسة."},{"btype":"example","text":"Something must be done!","note":"يجب القيام بشيء."},{"btype":"example","text":"This Ziri must be new here.","note":"لا بد من أن زيري هذا جديد هنا."},{"btype":"example","text":"You must not go out at night.","note":"لا يجب أن تخرج في الليل."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"You must tell us.","ar":"يجب أن تخبرنا."},{"t":"You must help her.","ar":"عليك أن تساعدها."},{"t":"He must find work.","ar":"هوَ لابد أن يجد عملاً."},{"t":"He must leave now.","ar":"عليه الرّحيل الآن."},{"t":"You must work more.","ar":"عليك