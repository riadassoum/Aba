{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"He's new around here.","note":"هو جديد هنا."},{"btype":"example","text":"See you around, Yanni.","note":"إلى اللّقاء بعد حين يا يانّي."},{"btype":"example","text":"I asked around about you.","note":"لقد سألت عنك."},{"btype":"example","text":"We love our children.","note":"نحن نحب أولادنا."},{"btype":"example","text":"Do you have children?","note":"هل لديك أطفال؟"},{"btype":"example","text":"Your children need you.","note":"أولادك بحاجة لك."},{"btype":"example","text":"They are still children.","note":"ما زالوا صغارًا."},{"btype":"example","text":"Layla can't have children.","note":"لا يمكن لليلى أن تنجب أطفالا."},{"btype":"example","text":"I didn't see any children.","note":"ما رأيت أطفالاََ."},{"btype":"example","text":"Sami couldn't have children.","note":"لم يكن بإمكان سامي أن ينجب أطفالا."},{"btype":"example","text":"She wanted her children back.","note":"أرادت استرجاع أطفالها."},{"btype":"example","text":"Dan didn't even have children.","note":"دان لم يكن عنده أولاد حتى."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"He's new around here.","ar":"هو جديد هنا."},{"t":"See you around, Yanni.","ar":"إلى اللّقاء بعد حين يا يانّي."},{"t":"I asked around about you.","ar":"لقد سألت عنك."},{"t":"We love our children.","ar":"نحن نحب أولادنا."},{"t":"Do you have children?","ar":"هل لديك أطفال؟"},{"t":"Your children need you.","ar":"أولادك بحاجة لك."},{"t":"They are still children.","ar":"ما زالوا صغارًا."},{"t":"Layla can't have children.","ar":"لا يمكن لليلى أن تنجب أطفالا."},{"t":"I didn't see any children.","ar":"ما رأيت أطفالاََ."},{"t":"Sami couldn't have children.","ar":"لم يكن بإمكان سامي أن ينجب أطفالا."},{"t":"She wanted her children back.","ar":"أرادت استرجاع أطفالها."},{"t":"Dan didn't even have children.","ar":"دان لم يكن عنده أولاد حتى."},{"t":"The children have an old book.","ar":"الأطفال عندهم كتاب قديم."},{"t":"Our children still go to school.","ar":"ما زال طفلانا يذهبان إلى المدرسة."},{"t":"Sami left the children in the house.","ar":"سامي ترك الأطفال في البيت."},{"t":"Do you want to talk to the children?","ar":"هل تريد أن تتكلم مع الأطفال؟"},{"t":"Tom, Mary, John and Alice are all children.","ar":"توم وماري وجون كلهم أطفال."},{"t":"Do you know any of the children in the room?","ar":"هل تعرف أيًا من الأطفال في الغرفة؟"},{"t":"What's going on?","ar":"ما الذي يحدث؟"},{"t":"What's all this?","ar":"ما كلّ هذا؟"},{"t":"So what's all this?","ar":"ما كل هذا؟"},{"t":"What's Ken doing now?","ar":"ما الذي يفعله كين الآن؟"},{"t":"What's Tom doing now?","ar":"ماذا يفعل الآن توم؟"},{"t":"What's that you have?","ar":"ماذا يوجد عندك؟"},{"t":"No, I don't. What's he like?","ar":"لا، لا أعلم. كيف يبدو؟"},{"t":"I don't like what's going on.","ar":"لا أحب ما يجري."},{"t":"What's Tom doing in his room?","ar":"ماذا يفعل توم في غرفته؟"},{"t":"\"What's that?\" \"It's a book.\"","ar":"\"ما هذا؟\" \"هذا كتاب.\""},{"t":"I'd love to know what's going on here.","ar":"أودّ أن أعلم ما يحدث هنا."},{"t":"Would you tell me what's going on here?","ar":"أيمكنك إخباري بما يحدث هنا؟"}],"focus":[],"difficulty":5}}