xt":"Think lightly of yourself and deeply of the world.","note":"إذا نظرت إلى نفسك فانظر إليها نظرة استخفاف، وإذا نظرت إلى العالم فانظر إليه نظرة تَدَبُّر."},{"btype":"example","text":"A considerable number of students want to go to college.","note":"يرغب عدد كبير من الطلاب بدخول الجامعة."},{"btype":"example","text":"Go to school.","note":"اذهب الى المدرسة."},{"btype":"example","text":"Ziri said it.","note":"زيري من قال ذلك."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Ziri has a lamb.","ar":"زيري لديه خروف."},{"t":"He held a session.","ar":"عقد حصّة."},{"t":"Ziri paused his game.","ar":"اوقف زيري لعبته مؤقتا."},{"t":"Sami raised some suspicion.","ar":"أثار سامي بعض الشّكوك."},{"t":"Ziri kept messing with Rima.","ar":"واصل زيري ممازحة ريمة."},{"t":"Yanni encountered many problems.","ar":"صادف ياني العديد من المشاكل."},{"t":"Think lightly of yourself and deeply of the world.","ar":"إذا نظرت إلى نفسك فانظر إليها نظرة استخف