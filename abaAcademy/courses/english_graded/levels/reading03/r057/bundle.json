{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Why are you two still up?","note":"لماذا لا تزالان مستيقظان؟"},{"btype":"example","text":"She didn't come before two.","note":"لم تأت قبل الثانية."},{"btype":"example","text":"He will be back in a day or two.","note":"سيعود خلال يوم أو يومين."},{"btype":"example","text":"How do I look?","note":"كيف أبدو؟"},{"btype":"example","text":"Look after Tom.","note":"اعتني بتوم"},{"btype":"example","text":"Don't look back.","note":"لا تنظر إلى الوراء."},{"btype":"example","text":"Does it look OK?","note":"هل تبدو بخير؟"},{"btype":"example","text":"Don't look at me!","note":"لا تنظر إلي!"},{"btype":"example","text":"I look up to you.","note":"أنا احترمك."},{"btype":"example","text":"How does it look?","note":"ما شكله ؟"},{"btype":"example","text":"Please look at me.","note":"انظر إليّ من فضلك."},{"btype":"example","text":"Don't look at her!","note":"لا تنظر إليها!"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Why are you two still up?","ar":"لماذا لا تزالان مستيقظان؟"},{"t":"She didn't come before two.","ar":"لم تأت قبل الثانية."},{"t":"He will be back in a day or two.","ar":"سيعود خلال يوم أو يومين."},{"t":"How do I look?","ar":"كيف أبدو؟"},{"t":"Look after Tom.","ar":"اعتني بتوم"},{"t":"Don't look back.","ar":"لا تنظر إلى الوراء."},{"t":"Does it look OK?","ar":"هل تبدو بخير؟"},{"t":"Don't look at me!","ar":"لا تنظر إلي!"},{"t":"I look up to you.","ar":"أنا احترمك."},{"t":"How does it look?","ar":"ما شكله ؟"},{"t":"Please look at me.","ar":"انظر إليّ من فضلك."},{"t":"Don't look at her!","ar":"لا تنظر إليها!"},{"t":"Don't look at him!","ar":"لا تنظر إليه!"},{"t":"Don't look for me.","ar":"لا تبحث عني"},{"t":"Look at that house.","ar":"أنظر إلى هذا المنزل."},{"t":"They look American.","ar":"يبدون أمريكيين."},{"t":"You look very good.","ar":"أنتَ تبدو بحالة جيداً جداً."},{"t":"Don't look at this!","ar":"لا تنظر إلى هذا!"},{"t":"Look at my new car.","ar":"انظر إلى سيارتي الجديدة"},{"t":"Let me look at you.","ar":"دعني أنظر إليك."},{"t":"Take a look at that.","ar":"انظر إلى ذلك"},{"t":"Take a look in there.","ar":"ألق نظرة هناك"},{"t":"Why don't you look up?","ar":"لماذا لا تنظر إلى الأعلى؟"},{"t":"Sami should look there.","ar":"على سامي أن يبحث هناك."},{"t":"Yanni didn't look back.","ar":"لم ينظر ياني إلى الخلف."},{"t":"He doesn't look Muslim.","ar":"هو لا يبدو مسلما."},{"t":"Doesn't this look good?","ar":"ألا يبدو هذا جيدا؟"},{"t":"Tom, look at what I made!","ar":"توم. شاهد مافعلته."},{"t":"Don't look at me that way!","ar":"لا تحدّق بي هكذا!"},{"t":"Where should we look first?","ar":"أين نبحث أولا؟"}],"focus":[],"difficulty":5}}