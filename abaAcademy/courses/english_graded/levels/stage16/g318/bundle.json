ر."},{"btype":"example","text":"Sami phoned the police.","note":"اتّصل سامي بالشّرطة."},{"btype":"example","text":"Ziri is scared of bees.","note":"زيري يخاف النحل."},{"btype":"example","text":"These bottles are empty.","note":"هذه القارورات فارغة."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Bees make honey.","ar":"يصنع النحل العسل."},{"t":"A girl phoned me.","ar":"اتصلت بي فتاة."},{"t":"Stop bothering me!","ar":"كُفّ عن إزعاجي!"},{"t":"Sami phoned Layla.","ar":"اتّصل سامي بليلى."},{"t":"Old habits die hard.","ar":"الطَبعْ يغلبُ التطبّع."},{"t":"Ziri loves spaghetti.","ar":"زيري يحب الاسباغيتي."},{"t":"Bees can kill people.","ar":"يمكن للنحل أن يقتل البشر."},{"t":"Sami phoned the police.","ar":"اتّصل سامي بالشّرطة."},{"t":"Ziri is scared of bees.","ar":"زيري يخاف النحل."},{"t":"These bottles are empty.","ar":"هذه القارورات فارغة."},{"t":"Ziri hired a new waiter.","ar":"وظف زيري نادلا جديدا."},{"t":"Ziri thanked the wait