{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"I think you're right.","note":"أعتقد أنك صائب."},{"btype":"example","text":"I will be right back!","note":"سأرجع حالا !"},{"btype":"example","text":"I think Tom is right.","note":"أظن أن توم على حق."},{"btype":"example","text":"Go get her right now.","note":"اذهب لإحضارها في الحين."},{"btype":"example","text":"Are you all right now?","note":"هل أنتَ بخير الآن؟"},{"btype":"example","text":"All right, I'll do it.","note":"لا بأس، سأتولى أنا الأمر."},{"btype":"example","text":"He's at home right now.","note":"إنه موجود في البيت الآن."},{"btype":"example","text":"I'll be right with you.","note":"سأكون معك حالًا."},{"btype":"example","text":"Sami will be right back.","note":"سيعود سامي فورا."},{"btype":"example","text":"Tom and Mary were right.","note":"كان توم و ماري محقّان."},{"btype":"example","text":"Ziri will be right back.","note":"سيعود زيري للتو."},{"btype":"example","text":"Layla will be right back.","note":"ستعود ليلى حالا."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"I think you're right.","ar":"أعتقد أنك صائب."},{"t":"I will be right back!","ar":"سأرجع حالا !"},{"t":"I think Tom is right.","ar":"أظن أن توم على حق."},{"t":"Go get her right now.","ar":"اذهب لإحضارها في الحين."},{"t":"Are you all right now?","ar":"هل أنتَ بخير الآن؟"},{"t":"All right, I'll do it.","ar":"لا بأس، سأتولى أنا الأمر."},{"t":"He's at home right now.","ar":"إنه موجود في البيت الآن."},{"t":"I'll be right with you.","ar":"سأكون معك حالًا."},{"t":"Sami will be right back.","ar":"سيعود سامي فورا."},{"t":"Tom and Mary were right.","ar":"كان توم و ماري محقّان."},{"t":"Ziri will be right back.","ar":"سيعود زيري للتو."},{"t":"Layla will be right back.","ar":"ستعود ليلى حالا."},{"t":"Come back here right now !","ar":"ارجع إلى هنا حالا."},{"t":"You don't have that, right?","ar":"ليس لديك ذلك، أهذا صحيح؟"},{"t":"She told him that he was right.","ar":"قالت له أنه كان محقا."},{"t":"Do you want to do it right now?","ar":"هل تريد أن تفعلها الآن؟"},{"t":"Why don't we do that right now?","ar":"لم لا نقوم بذلك للتّو؟"},{"t":"We don't have the right to do this.","ar":"ليس لدينا حق بالقيام بهذا."},{"t":"Sami doesn't have the right to do that.","ar":"لا يملك سامي الحقّ في فعل هذا."},{"t":"Do you really want me to go there right now?","ar":"هل تريدني حقاً أن أذهب إلى هناك الأن؟"},{"t":"You know that we don't have much time right now.","ar":"ليس أمامنا وقت لهذا كما تعلم."},{"t":"If only I knew!","ar":"لو أنّني كنت أعرف!"},{"t":"No one knew it.","ar":"لا أحد علم بذلك."},{"t":"Sami knew that.","ar":"كان سامي يعرف ذلك."},{"t":"Ziri knew that.","ar":"كان زيري يعلم ذلك."},{"t":"Ziri knew Rima.","ar":"كان زيري يعرف ريمة."},{"t":"Skura knew her.","ar":"كانت سكورا تعرفها."},{"t":"I knew it was you.","ar":"كنت أعلم أنه أنت."},{"t":"He knew the Quran.","ar":"كان يعرف القرآن."},{"t":"Tom said he knew Mary.","ar":"توم قال أنه يعرف ماري"}],"focus":[],"difficulty":5}}