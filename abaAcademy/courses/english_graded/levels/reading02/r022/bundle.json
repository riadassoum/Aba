{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Why do you want to come with me?","note":"لم تريد مجيء معي؟"},{"btype":"example","text":"Come and see me when you have time.","note":"تعال لتراني عندما يكون لديك وقت."},{"btype":"example","text":"I thought you would never come here.","note":"اعتقدت انك لن تأتي الى هنا."},{"btype":"example","text":"Do you want me to come to Japan to see you?","note":"هل تريدني أن آتي إلى اليابان لرؤيتك؟"},{"btype":"example","text":"If Tom didn't want to be here, he would not have come.","note":"لو لم يشأ توم أن يكون هنا، لما أتى."},{"btype":"example","text":"Where are you?","note":"أين أنت؟"},{"btype":"example","text":"Where is this?","note":"أين هذا؟"},{"btype":"example","text":"Where is Ziri?","note":"أين هو زيري؟"},{"btype":"example","text":"Where is Paris?","note":"أين تقع باريس؟"},{"btype":"example","text":"Where are they?","note":"أين هم؟"},{"btype":"example","text":"Where did he go?","note":"أين ذهب؟"},{"btype":"example","text":"Where did you go?","note":"إلى أين ذهبت؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Why do you want to come with me?","ar":"لم تريد مجيء معي؟"},{"t":"Come and see me when you have time.","ar":"تعال لتراني عندما يكون لديك وقت."},{"t":"I thought you would never come here.","ar":"اعتقدت انك لن تأتي الى هنا."},{"t":"Do you want me to come to Japan to see you?","ar":"هل تريدني أن آتي إلى اليابان لرؤيتك؟"},{"t":"If Tom didn't want to be here, he would not have come.","ar":"لو لم يشأ توم أن يكون هنا، لما أتى."},{"t":"Where are you?","ar":"أين أنت؟"},{"t":"Where is this?","ar":"أين هذا؟"},{"t":"Where is Ziri?","ar":"أين هو زيري؟"},{"t":"Where is Paris?","ar":"أين تقع باريس؟"},{"t":"Where are they?","ar":"أين هم؟"},{"t":"Where did he go?","ar":"أين ذهب؟"},{"t":"Where did you go?","ar":"إلى أين ذهبت؟"},{"t":"Where did she go?","ar":"اين هى ذهبت؟"},{"t":"Where will we go?","ar":"أين سنذهب؟"},{"t":"Where is Ziri now?","ar":"أين زيري الآن؟"},{"t":"Where are you from?","ar":"مِنْ أَيْنَ أَنْتُمْ؟"},{"t":"Where are we going?","ar":"إلى أين نحن ذاهبون؟"},{"t":"Where have you been?","ar":"أين كنت؟"},{"t":"Where are you going?","ar":"إلى أين ستذهب؟"},{"t":"Where can I see you?","ar":"أين يمكنني أن أراك؟"},{"t":"Where were you going?","ar":"أين كنت ذاهب؟"},{"t":"Where are they going?","ar":"أين هم ذاهبون؟"},{"t":"I know where you are.","ar":"أنا أعلم أين أنت"},{"t":"Where was Ziri going?","ar":"إلى أين كان زيري ذاهبا؟"},{"t":"Where did you see it?","ar":"أين رأيته؟"},{"t":"Where did you see Tom?","ar":"أين رأيت توم؟"},{"t":"Where were all of you?","ar":"أين كنتم جميعكم؟"},{"t":"Where did she do that?","ar":"أين قامت بذلك؟"},{"t":"Where did she do time?","ar":"أين دخلت السجن؟"},{"t":"Where did she see him?","ar":"أين رأته؟"}],"focus":[],"difficulty":5}}