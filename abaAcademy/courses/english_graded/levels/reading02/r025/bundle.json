{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Take what you need.","note":"خذ ما تحتاجهُ."},{"btype":"example","text":"Take what you want.","note":"خذ ما تريد"},{"btype":"example","text":"This will take time.","note":"سيأخذ هذا وقتا."},{"btype":"example","text":"You have to take this.","note":"عليك أن تأخذ هذا."},{"btype":"example","text":"Can you take us there?","note":"أيمكنك أخذنا إلى هناك؟"},{"btype":"example","text":"Can I take this with me?","note":"هل أستطيع أن آخذ هذهِ معي؟"},{"btype":"example","text":"Where did she take them?","note":"إلى أين أخذتهم؟"},{"btype":"example","text":"Take as much as you want.","note":"خذ قدر ما تريد."},{"btype":"example","text":"Were you to take it back?","note":"هل كنت ستعيدها؟"},{"btype":"example","text":"Take all the time you want.","note":"خذ ما تشاء من الوقت."},{"btype":"example","text":"Take all the time you need.","note":"خذ ما تحتاج من الوقت."},{"btype":"example","text":"Tom didn't take it with him.","note":"توم لم يأخذها معه."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Take what you need.","ar":"خذ ما تحتاجهُ."},{"t":"Take what you want.","ar":"خذ ما تريد"},{"t":"This will take time.","ar":"سيأخذ هذا وقتا."},{"t":"You have to take this.","ar":"عليك أن تأخذ هذا."},{"t":"Can you take us there?","ar":"أيمكنك أخذنا إلى هناك؟"},{"t":"Can I take this with me?","ar":"هل أستطيع أن آخذ هذهِ معي؟"},{"t":"Where did she take them?","ar":"إلى أين أخذتهم؟"},{"t":"Take as much as you want.","ar":"خذ قدر ما تريد."},{"t":"Were you to take it back?","ar":"هل كنت ستعيدها؟"},{"t":"Take all the time you want.","ar":"خذ ما تشاء من الوقت."},{"t":"Take all the time you need.","ar":"خذ ما تحتاج من الوقت."},{"t":"Tom didn't take it with him.","ar":"توم لم يأخذها معه."},{"t":"This is all I have. Take it.","ar":"هذا كل ما عندي. خذه."},{"t":"She didn't take it with her.","ar":"لم تأخذه معها"},{"t":"Yanni will take you to Skura.","ar":"سيأخذك ياني إلى سكورة."},{"t":"Ziri can't take Rima with him.","ar":"لا يمكن لزيري أن يأخذ ريمة معه."},{"t":"I can take you there to see it.","ar":"بإمكاني أن آخذك إلى هناك كي تراه."},{"t":"Yanni can't take back what he said.","ar":"لا يمكن لياني سحب كلامه."},{"t":"Tom isn't home.","ar":"توم ليس في البيت"},{"t":"We are at home.","ar":"نحن في المنزل"},{"t":"Are you at home?","ar":"هل أنت في البيت؟"},{"t":"See you at home.","ar":"أراك في البيت"},{"t":"This is my home.","ar":"هذا بيتي"},{"t":"Ziri is at home.","ar":"زيري في المنزل."},{"t":"I want to go home.","ar":"ارید الذهاب الی المنزل."},{"t":"Tom isn't at home.","ar":"توم ليس في البيت."},{"t":"Can I go home now?","ar":"أيمكنني الذهاب إلى البيت الآن؟"},{"t":"I have to go home.","ar":"يجب أن أذهب إلى البيت"},{"t":"Go home with Ziri.","ar":"عد للمنزل مع زيري."},{"t":"You can go home now.","ar":"بإمكانك العودة إلى المنزل الآن."}],"focus":[],"difficulty":5}}