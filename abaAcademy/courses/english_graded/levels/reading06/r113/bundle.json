{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"They were still together.","note":"كانا لا يزالان معا."},{"btype":"example","text":"You have only to put them together.","note":"ماعليك إلا أن تجمعها."},{"btype":"example","text":"Why don't you and I do that together?","note":"لم لا نقوم بهذا سويّا."},{"btype":"example","text":"This is something that we need to work on together.","note":"هذه الأمر علينا أن نعمل سويّاً لحلّه."},{"btype":"example","text":"They call you Tom.","note":"إنهم يدعونك توم."},{"btype":"example","text":"Just call me Ziri.","note":"فقط نادني زيري."},{"btype":"example","text":"Can you call Ziri?","note":"هل بٱمكانك أن تتصل زيري؟"},{"btype":"example","text":"Can I call you Bob?","note":"أيمكنني أن أناديك بوب؟"},{"btype":"example","text":"I have to call Tom.","note":"أحتاج إلى أن اتّصل بتوم."},{"btype":"example","text":"Let's call him now.","note":"لنتّصل به الآن."},{"btype":"example","text":"You can call me Tom.","note":"أنتَ يمكنكَ أن تناديني توم."},{"btype":"example","text":"Never call me again.","note":"لا تتصل بي أبدا بعد الآن."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"They were still together.","ar":"كانا لا يزالان معا."},{"t":"You have only to put them together.","ar":"ماعليك إلا أن تجمعها."},{"t":"Why don't you and I do that together?","ar":"لم لا نقوم بهذا سويّا."},{"t":"This is something that we need to work on together.","ar":"هذه الأمر علينا أن نعمل سويّاً لحلّه."},{"t":"They call you Tom.","ar":"إنهم يدعونك توم."},{"t":"Just call me Ziri.","ar":"فقط نادني زيري."},{"t":"Can you call Ziri?","ar":"هل بٱمكانك أن تتصل زيري؟"},{"t":"Can I call you Bob?","ar":"أيمكنني أن أناديك بوب؟"},{"t":"I have to call Tom.","ar":"أحتاج إلى أن اتّصل بتوم."},{"t":"Let's call him now.","ar":"لنتّصل به الآن."},{"t":"You can call me Tom.","ar":"أنتَ يمكنكَ أن تناديني توم."},{"t":"Never call me again.","ar":"لا تتصل بي أبدا بعد الآن."},{"t":"Yanni will call you.","ar":"سيتصل بك ياني."},{"t":"Ziri will call Rima.","ar":"سيتصل زيري بريمة."},{"t":"Ziri will call them.","ar":"سيتصل بهم زيري."},{"t":"He didn't even call.","ar":"لم يتصل حتى."},{"t":"What do you call this?","ar":"ماذا تسمي هذا ؟"},{"t":"Sami should call Layla.","ar":"ينبغي على سامي أن يتّصل بليلى."},{"t":"Could you call me back?","ar":"هل بإمكانك الاتصال بي مجددا؟"},{"t":"Don't let him call her.","ar":"لا تدعه يتصل بها."},{"t":"I call her up every day.","ar":"أتصل بها كل يوم."},{"t":"Where did you call them?","ar":"أين اتصلت بهم؟"},{"t":"Ziri will call you back.","ar":"سيتصل بك زيري مجددا."},{"t":"Ziri will call Rima back.","ar":"سيتصل زيري بريمة مجددا."},{"t":"I'll call you every night.","ar":"سأتصل بك كل ليلة."},{"t":"Why did she call him that?","ar":"لماذا نادته بذلك الإسم؟"},{"t":"I can call Tom if you want.","ar":"أَقْدَرُ أَن أَتَّصِلَ بتوم إن أَرَدْتَ."},{"t":"If you want a job, call me.","ar":"إن أردت عملا، فاتصل بي."},{"t":"Sami didn't call Layla back.","ar":"لم يتّصل سامي بليلى مجدّدا."},{"t":"Call him up if you want him.","ar":"اتصل به إن احتجته."}],"focus":[],"difficulty":5}}