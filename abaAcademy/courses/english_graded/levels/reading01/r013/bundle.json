{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"What good will that do?","note":"ما الفائدة من ذلك؟"},{"btype":"example","text":"Sami was a good Muslim.","note":"كان سامي مسلما جيّدا."},{"btype":"example","text":"Layla was a good Christian.","note":"كانت ليلى مسيحيّة جيّدة."},{"btype":"example","text":"This will do Yanni no good.","note":"لن ينفع ذلك ياني في شيء."},{"btype":"example","text":"What is good for you is good for me.","note":"ما هو جيد لك، جيد لي أيضا."},{"btype":"example","text":"You should go.","note":"من الأفضل أن تذهب."},{"btype":"example","text":"Ziri should go.","note":"ينبغي على زيري أن يرحل."},{"btype":"example","text":"What should I do?","note":"ماذا عليّ أن أفعل؟"},{"btype":"example","text":"How should I know?","note":"كيف لي أن أعرف؟"},{"btype":"example","text":"All of us should go.","note":"علينا جميعا أن نذهب."},{"btype":"example","text":"You should be Muslim.","note":"ينبغي أن تكون مسلما."},{"btype":"example","text":"You should not go there.","note":"عليك ألا تذهب إلى هناك."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"What good will that do?","ar":"ما الفائدة من ذلك؟"},{"t":"Sami was a good Muslim.","ar":"كان سامي مسلما جيّدا."},{"t":"Layla was a good Christian.","ar":"كانت ليلى مسيحيّة جيّدة."},{"t":"This will do Yanni no good.","ar":"لن ينفع ذلك ياني في شيء."},{"t":"What is good for you is good for me.","ar":"ما هو جيد لك، جيد لي أيضا."},{"t":"You should go.","ar":"من الأفضل أن تذهب."},{"t":"Ziri should go.","ar":"ينبغي على زيري أن يرحل."},{"t":"What should I do?","ar":"ماذا عليّ أن أفعل؟"},{"t":"How should I know?","ar":"كيف لي أن أعرف؟"},{"t":"All of us should go.","ar":"علينا جميعا أن نذهب."},{"t":"You should be Muslim.","ar":"ينبغي أن تكون مسلما."},{"t":"You should not go there.","ar":"عليك ألا تذهب إلى هناك."},{"t":"You need this.","ar":"ستحتاج إلى ذلك."},{"t":"I need her here.","ar":"أحتاجها هنا."},{"t":"No, you need not.","ar":"لا ، لن تحتاج."},{"t":"What do you need?","ar":"ماذا تحتاج؟"},{"t":"I don't need that.","ar":"لا أحتاج لهذا."},{"t":"What did Tom need?","ar":"ماذا احتاج توم؟"},{"t":"We need you, Ziri.","ar":"نحن بحاجة لك يا زيري."},{"t":"You don't need him.","ar":"أنت لا تحتاجه."},{"t":"I need to be going.","ar":"علي الرحيل."},{"t":"You don't need to go.","ar":"ليس عليك الذهاب."},{"t":"He didn't need to go.","ar":"لم يكن بحاجة للذهاب."},{"t":"Why do they need this?","ar":"لما يحتاجون هذا؟"},{"t":"It's just what we need.","ar":"إنه تماماً ما نحتاج."},{"t":"Why did she need to go?","ar":"لماذا اضطرت للذهاب؟"},{"t":"Why do I need to do this?","ar":"ما الذي يطالبني بهذا؟"},{"t":"You don't need to know why.","ar":"لا تحتاج لمعرفة السّبب."},{"t":"Why did she need to do that?","ar":"لماذا اضطرت لفعل ذلك؟"},{"t":"There was no need to do that.","ar":"لم يكن من الضروري القيام بذلك."}],"focus":[],"difficulty":5}}