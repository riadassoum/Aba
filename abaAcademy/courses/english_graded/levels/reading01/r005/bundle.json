{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Ziri is from Ford.","note":"زيري من شركة فورد."},{"btype":"example","text":"I know it from him.","note":"أنا أعرف هذا منه."},{"btype":"example","text":"Tom is from Boston.","note":"توم هو من بوستون."},{"btype":"example","text":"Sami is from Egypt.","note":"سامي من مصر."},{"btype":"example","text":"Sami is from Cairo.","note":"سامي من القاهرة."},{"btype":"example","text":"I'm from Kurdistan.","note":"انا من كردستان."},{"btype":"example","text":"Ziri is from Google.","note":"زيري من شركة غوغل."},{"btype":"example","text":"Lucy is from America.","note":"لوسي من أمريكا."},{"btype":"example","text":"I'm from Tokyo, Japan.","note":"أنا من طوكيو عاصمة اليابان."},{"btype":"example","text":"Ziri was there.","note":"كان زيري هناك."},{"btype":"example","text":"Ziri was in there.","note":"كان زيري بالداخل."},{"btype":"example","text":"Ziri will be there.","note":"سيكون زيري هناك."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Ziri is from Ford.","ar":"زيري من شركة فورد."},{"t":"I know it from him.","ar":"أنا أعرف هذا منه."},{"t":"Tom is from Boston.","ar":"توم هو من بوستون."},{"t":"Sami is from Egypt.","ar":"سامي من مصر."},{"t":"Sami is from Cairo.","ar":"سامي من القاهرة."},{"t":"I'm from Kurdistan.","ar":"انا من كردستان."},{"t":"Ziri is from Google.","ar":"زيري من شركة غوغل."},{"t":"Lucy is from America.","ar":"لوسي من أمريكا."},{"t":"I'm from Tokyo, Japan.","ar":"أنا من طوكيو عاصمة اليابان."},{"t":"Ziri was there.","ar":"كان زيري هناك."},{"t":"Ziri was in there.","ar":"كان زيري بالداخل."},{"t":"Ziri will be there.","ar":"سيكون زيري هناك."},{"t":"Yanni is there with Skura.","ar":"ياني متواجد هناك مع سكورا."},{"t":"He will not go.","ar":"لن يذهب."},{"t":"You have to go.","ar":"عليك أن تذهب."},{"t":"It didn't go OK.","ar":"لم تسر الأمور على ما يرام."},{"t":"Will you go with Tom?","ar":"هل ستذهب مع توم؟"},{"t":"I want to go to Tokyo.","ar":"أريد الذهاب إلى طوكيو."},{"t":"I want to go to Japan.","ar":"أريد أن أذهب إلى اليابان."},{"t":"I want to go with you.","ar":"أريد الذهاب معك."},{"t":"They don't want to go.","ar":"لا يريدون أن يذهبو."},{"t":"I want you to go with me.","ar":"أُرِيدُ أَن تَذهَبَ مَعي."},{"t":"He didn't go to Shanghai.","ar":"لم يذهب إلى شانغهاي."},{"t":"Ziri will not go with Rima.","ar":"لن يذهب زيري مع ريمة."},{"t":"Sami is going to be OK.","ar":"سيكون سامي بخير."},{"t":"What are you going to do?","ar":"ماذا ستفعل؟"},{"t":"I didn't know what was going on.","ar":"لم أعلم ماذا كان يحدث."},{"t":"What are you going to do with it?","ar":"ماذا ستفعل بها؟"},{"t":"Tom and I were in Boston in October.","ar":"كنت انا وتوم في بوسطن في شهر أكتوبر."},{"t":"As if I didn't know that!","ar":"كأنني لم أعرف هذا!"}],"focus":[],"difficulty":5}}