{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"There was just me and him.","note":"لم يكن إلاّ سوانا."},{"btype":"example","text":"Will you go with us?","note":"هل ستذهب معنا؟"},{"btype":"example","text":"Are you going with us?","note":"أذاهب أنت معنا؟"},{"btype":"example","text":"Tom told us what to do.","note":"أخبرنا توم بما علينا فعله."},{"btype":"example","text":"He told us what you did.","note":"هو أخبرنا بما فعلته."},{"btype":"example","text":"One of us will have to go.","note":"واحد منّا سيضطر للرحيل."},{"btype":"example","text":"I don't really know.","note":"حقيقةً لا أعلم."},{"btype":"example","text":"Can you really do it?","note":"أحقّا تستطيع فعلها؟"},{"btype":"example","text":"What do you really like?","note":"ماذا تحبه في الحقيقة؟"},{"btype":"example","text":"He didn't really like her.","note":"لَمْ تُعجِبهُ حَقاً"},{"btype":"example","text":"You really don't want to know.","note":"أنتَ حقاً لا تريد أن تعرف."},{"btype":"example","text":"What! You didn't really do that?","note":"ماذا! هل فعلت ذلك حقًا؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"There was just me and him.","ar":"لم يكن إلاّ سوانا."},{"t":"Will you go with us?","ar":"هل ستذهب معنا؟"},{"t":"Are you going with us?","ar":"أذاهب أنت معنا؟"},{"t":"Tom told us what to do.","ar":"أخبرنا توم بما علينا فعله."},{"t":"He told us what you did.","ar":"هو أخبرنا بما فعلته."},{"t":"One of us will have to go.","ar":"واحد منّا سيضطر للرحيل."},{"t":"I don't really know.","ar":"حقيقةً لا أعلم."},{"t":"Can you really do it?","ar":"أحقّا تستطيع فعلها؟"},{"t":"What do you really like?","ar":"ماذا تحبه في الحقيقة؟"},{"t":"He didn't really like her.","ar":"لَمْ تُعجِبهُ حَقاً"},{"t":"You really don't want to know.","ar":"أنتَ حقاً لا تريد أن تعرف."},{"t":"What! You didn't really do that?","ar":"ماذا! هل فعلت ذلك حقًا؟"},{"t":"Do you really want me to do that?","ar":"هل تريدني حقاً أن أفعل هذا؟"},{"t":"Do you really want Tom to do that?","ar":"أتريد حقا من توم أن يفعل ذلك؟"},{"t":"Do you really think Tom will do that?","ar":"أحقا تظن أن توم سيفعل ذلك؟"},{"t":"He never told me.","ar":"لم يخبرني قط."},{"t":"You never said so.","ar":"لم تقل هذا أبدا."},{"t":"He never told me why.","ar":"لم يخبرني أبدا لماذا."},{"t":"Ziri will never know.","ar":"زيري لن يعلم أبدا."},{"t":"He never told me that.","ar":"لم يخبرني أبدا بذلك."},{"t":"Tom will never do that.","ar":"لن يقوم توم بفعل ذلك أبدا."},{"t":"Sami was never a Christian.","ar":"لم يكن سامي مسيحيّا قطّ."},{"t":"She has never been to Hokkaido.","ar":"لم يسبق لها أن زارت هوكايدو."},{"t":"Ziri is good.","ar":"زيري شخص جيد."},{"t":"Ziri did good.","ar":"كان أداء زيري جيدا."},{"t":"It's very good.","ar":"هذا جيد جدا"},{"t":"Good to be here.","ar":"جيد أن تكون هنا."},{"t":"Are we good to go?","ar":"هل نحن مستعدون للذهاب"},{"t":"I'm no good for you.","ar":"أنا لست من تبحثين عنه"},{"t":"What you did is good.","ar":"الشيء الذي فعلته جيد"}],"focus":[],"difficulty":5}}