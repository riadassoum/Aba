{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Here you go, Jim.","note":"تفضّل يا جيم."},{"btype":"example","text":"I'm not from here.","note":"أنا لست من هنا."},{"btype":"example","text":"I want to be here.","note":"أريد أن أكون هنا"},{"btype":"example","text":"Ziri will be here.","note":"سيكون زيري هنا."},{"btype":"example","text":"Yanni will be here.","note":"سيكون ياني هنا."},{"btype":"example","text":"What is going on here?","note":"ماذا يحدث هنا؟"},{"btype":"example","text":"I don't want Sami here.","note":"لا أريد سامي هنا."},{"btype":"example","text":"When did you go there?","note":"متى ذهبت إلى هناك؟"},{"btype":"example","text":"When are you going to do that?","note":"متى ستقوم بذلك؟"},{"btype":"example","text":"When did you have time to do that?","note":"متى كان لديك الوقت لتفعل ذلك؟"},{"btype":"example","text":"Have you been to London?","note":"هل سبق لك أن ذهبت إلى لندن؟"},{"btype":"example","text":"But I don't want to.","note":"لكن لا أريد"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Here you go, Jim.","ar":"تفضّل يا جيم."},{"t":"I'm not from here.","ar":"أنا لست من هنا."},{"t":"I want to be here.","ar":"أريد أن أكون هنا"},{"t":"Ziri will be here.","ar":"سيكون زيري هنا."},{"t":"Yanni will be here.","ar":"سيكون ياني هنا."},{"t":"What is going on here?","ar":"ماذا يحدث هنا؟"},{"t":"I don't want Sami here.","ar":"لا أريد سامي هنا."},{"t":"When did you go there?","ar":"متى ذهبت إلى هناك؟"},{"t":"When are you going to do that?","ar":"متى ستقوم بذلك؟"},{"t":"When did you have time to do that?","ar":"متى كان لديك الوقت لتفعل ذلك؟"},{"t":"Have you been to London?","ar":"هل سبق لك أن ذهبت إلى لندن؟"},{"t":"But I don't want to.","ar":"لكن لا أريد"},{"t":"All but for he are here.","ar":"كلنا هنا إلا هو."},{"t":"I don't know how, but I did it.","ar":"لا أعرف كيف، لكنّي فعلتها."},{"t":"Tom isn't here.","ar":"توم ليس هنا"},{"t":"Jack isn't here.","ar":"جاك ليس موجوداً."},{"t":"This isn't French.","ar":"هذه ليست فرنسية"},{"t":"He isn't here, is he?","ar":"إنه ليس هنا ، أليس كذلك؟"},{"t":"Tom isn't going to do that.","ar":"لن يفعل توم ذلك."},{"t":"This isn't like him at all.","ar":"هذا ليس من عاداته أبدا."},{"t":"Who is Emily?","ar":"من إيميلي؟"},{"t":"Who said that?","ar":"من قال هذا؟"},{"t":"Who told Ziri?","ar":"من أخبر زيري؟"},{"t":"Who told Skura?","ar":"من أخبر سكورة؟"},{"t":"Who was with you?","ar":"من كان معك؟"},{"t":"We know who he is.","ar":"نعلم من يكون."},{"t":"I know who she is.","ar":"أعلم من هي."},{"t":"Who told Ziri that?","ar":"من قال هذا لزيري؟"},{"t":"We know who she is.","ar":"نعلم من تكون."},{"t":"Who is Muslim here?","ar":"من هو المسلم هنا؟"}],"focus":[],"difficulty":5}}