{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Who, if not us? When, if not now?","note":"من, إذا لم يكن نحن؟ متى, إذا لم يكن الأن؟"},{"btype":"example","text":"Do you know them?","note":"هل تعرفهم؟"},{"btype":"example","text":"I don't like them.","note":"لا احبهم."},{"btype":"example","text":"I don't want them.","note":"لا أريدهم."},{"btype":"example","text":"Ziri doesn't like them.","note":"زيري لا يحبهم."},{"btype":"example","text":"People like me.","note":"الناس يحبونني."},{"btype":"example","text":"People are people.","note":"الناس هم الناس."},{"btype":"example","text":"But they are all people.","note":"لكنهم كلهم بشر."},{"btype":"example","text":"People know who you are.","note":"الناس يعلمون من تكون."},{"btype":"example","text":"Tom was good with people.","note":"كان توم طيبا مع الناس."},{"btype":"example","text":"Why don't people like Tom?","note":"لماذا لا يروق توم للناس؟"},{"btype":"example","text":"Ziri got people to like him.","note":"جعل زيري الناس يحبونه."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Who, if not us? When, if not now?","ar":"من, إذا لم يكن نحن؟ متى, إذا لم يكن الأن؟"},{"t":"Do you know them?","ar":"هل تعرفهم؟"},{"t":"I don't like them.","ar":"لا احبهم."},{"t":"I don't want them.","ar":"لا أريدهم."},{"t":"Ziri doesn't like them.","ar":"زيري لا يحبهم."},{"t":"People like me.","ar":"الناس يحبونني."},{"t":"People are people.","ar":"الناس هم الناس."},{"t":"But they are all people.","ar":"لكنهم كلهم بشر."},{"t":"People know who you are.","ar":"الناس يعلمون من تكون."},{"t":"Tom was good with people.","ar":"كان توم طيبا مع الناس."},{"t":"Why don't people like Tom?","ar":"لماذا لا يروق توم للناس؟"},{"t":"Ziri got people to like him.","ar":"جعل زيري الناس يحبونه."},{"t":"There are people who do that.","ar":"يوجد ناس يفعلون ذلك."},{"t":"Mary had some.","ar":"كان لدى باية القليل من ذلك."},{"t":"I need some \"me\" time.","ar":"أحتاج لبعض الوقت أجلس فيه لوحدي."},{"t":"I think we should do some more.","ar":"أعتقد أننا يجب أن نفعل المزيد."},{"t":"I'm going to need some more time.","ar":"سأحتاج إلى المزيد من الوقت."},{"t":"I did see him.","ar":"قد رأيته."},{"t":"Do you see that?","ar":"هل تري هذا؟"},{"t":"Ziri can see you.","ar":"بإمكان زيري رؤيتك."},{"t":"I have to see Jim.","ar":"علي أن أرى جيم."},{"t":"How can I see you?","ar":"كيف يمكنني أن أراك؟"},{"t":"He didn't see him.","ar":"لم يره."},{"t":"He didn't see her.","ar":"لم يراها."},{"t":"Can I see this one?","ar":"أيمكنك أن تُرِيَني ذلك؟"},{"t":"Sami didn't see me.","ar":"لم يرني سامي."},{"t":"See you there, Ziri.","ar":"سأراك هناك يا زيري."},{"t":"When did you see her?","ar":"متى قابلتها؟"},{"t":"Did you see her there?","ar":"أرأيتها هناك؟"},{"t":"We will see you there.","ar":"سنراك هناك."}],"focus":[],"difficulty":5}}