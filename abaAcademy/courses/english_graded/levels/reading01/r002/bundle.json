{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"I'm with you.","note":"أنا معك."},{"btype":"example","text":"I'm in Dubai.","note":"أنا في دبي."},{"btype":"example","text":"I'm in Egypt.","note":"أنا في مصر."},{"btype":"example","text":"I'm Brazilian.","note":"أنا برازيلي."},{"btype":"example","text":"I'm Ukrainian.","note":"أنا أوكراني."},{"btype":"example","text":"What do you think?","note":"ماذا تعتقدون؟"},{"btype":"example","text":"I like that.","note":"انا احب ذلک."},{"btype":"example","text":"I like Mary.","note":"أحب ماري."},{"btype":"example","text":"We like Mary.","note":"أعجبتنا ماري."},{"btype":"example","text":"I like French.","note":"أنا أحب الفرنسية"},{"btype":"example","text":"Do you like it?","note":"هل يعجبك ذلك؟"},{"btype":"example","text":"They like Mary.","note":"هم يحبون ماري."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"I'm with you.","ar":"أنا معك."},{"t":"I'm in Dubai.","ar":"أنا في دبي."},{"t":"I'm in Egypt.","ar":"أنا في مصر."},{"t":"I'm Brazilian.","ar":"أنا برازيلي."},{"t":"I'm Ukrainian.","ar":"أنا أوكراني."},{"t":"What do you think?","ar":"ماذا تعتقدون؟"},{"t":"I like that.","ar":"انا احب ذلک."},{"t":"I like Mary.","ar":"أحب ماري."},{"t":"We like Mary.","ar":"أعجبتنا ماري."},{"t":"I like French.","ar":"أنا أحب الفرنسية"},{"t":"Do you like