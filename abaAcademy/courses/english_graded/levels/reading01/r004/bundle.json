{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Think about it.","note":"فكر في ذلك."},{"btype":"example","text":"What about Tom?","note":"ماذا عن \"توم\"؟"},{"btype":"example","text":"What about Ziri?","note":"ماذا عن زيري؟"},{"btype":"example","text":"Is this about me?","note":"هل هذا عني؟"},{"btype":"example","text":"I like that about you.","note":"احب هذا الشيء بك"},{"btype":"example","text":"What do you like about me?","note":"ما الذي يعجبك بشأني؟"},{"btype":"example","text":"What do you like about her?","note":"ما الذي يعجبك بشأنها؟"},{"btype":"example","text":"What do you think about that?","note":"ما رأيك في ذلك؟"},{"btype":"example","text":"Think about what I said to you.","note":"فكر فيما قلته لك."},{"btype":"example","text":"That is all I have.","note":"هذا كل ما لدي"},{"btype":"example","text":"They know all that.","note":"هم يعلمون هذا كله."},{"btype":"example","text":"Boston is not at all like Chicago.","note":"بوسطن ليست مثل شيكاغو على الإطلاق."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Think about it.","ar":"فكر في ذلك."},{"t":"What about Tom?","ar":"ماذا عن \"توم\"؟"},{"t":"What about Ziri?","ar":"ماذا عن زيري؟"},{"t":"Is this about me?","ar":"هل هذا عني؟"},{"t":"I like that about you.","ar":"احب هذا الشيء بك"},{"t":"What do you like about me?","ar"