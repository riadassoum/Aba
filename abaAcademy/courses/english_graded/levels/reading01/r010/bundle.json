{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Why is Yanni here?","note":"لماذا ياني هنا؟"},{"btype":"example","text":"Why were you there?","note":"لماذا كنت هناك؟"},{"btype":"example","text":"Why did you do that?","note":"لماذا فعلت ذلك؟"},{"btype":"example","text":"We want to know why.","note":"نريد معرفة السبب."},{"btype":"example","text":"Why don't I do that?","note":"لماذا لا أفعل ذلك؟"},{"btype":"example","text":"Why is Tom not here?","note":"لماذا توم ليس هنا؟"},{"btype":"example","text":"Why do they like it?","note":"ما سبب إعجابهم به؟"},{"btype":"example","text":"Why do they want it?","note":"لماذا يريدونه؟"},{"btype":"example","text":"Why do you know that?","note":"لماذا تعلم ذلك؟"},{"btype":"example","text":"Sami didn't know why.","note":"لم يعلم سامي لماذا."},{"btype":"example","text":"Why don't we do this?","note":"لماذا لا نفعل هذا؟"},{"btype":"example","text":"Why don't you like me?","note":"لماذا لا تحبني"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Why is Yanni here?","ar":"لماذا ياني هنا؟"},{"t":"Why were you there?","ar":"لماذا كنت هناك؟"},{"t":"Why did you do that?","ar":"لماذا فعلت ذلك؟"},{"t":"We want to know why.","ar":"نريد معرفة السبب."},{"t":"Why don't I do that?","ar":"لماذا لا أفعل ذلك؟"},{"t":"Why is Tom not here?","ar":"لماذا توم ليس هنا؟"},{"t":"Why do they like it?","ar":"ما سبب إعجابهم به؟"},{"t":"Why do they want it?","ar":"لماذا يريدونه؟"},{"t":"Why do you know that?","ar":"لماذا تعلم ذلك؟"},{"t":"Sami didn't know why.","ar":"لم يعلم سامي لماذا."},{"t":"Why don't we do this?","ar":"لماذا لا نفعل هذا؟"},{"t":"Why don't you like me?","ar":"لماذا لا تحبني"},{"t":"Why do they have this?","ar":"لماذا عندهم هذا؟"},{"t":"Why was Ziri in there?","ar":"لماذا كان زيري في الداخل؟"},{"t":"Why did she have to go?","ar":"لماذا اضطرت على الذهاب؟"},{"t":"Why did she want to go?","ar":"لماذا أرادت الذهاب؟"},{"t":"Why did you go to Tokyo?","ar":"لماذا ذهبت إلى طوكيو؟"},{"t":"Why don't you want this?","ar":"لم لا تريد هذا؟"},{"t":"Why did she do all this?","ar":"لماذا قامت بكل هذا؟"},{"t":"Do you know why I'm here?","ar":"هل تعلم لماذا انا هنا؟"},{"t":"We know why you did that.","ar":"نعلم لم قمت بذلك."},{"t":"Don't you want to know why?","ar":"الا تريد أن تعرف لماذا؟"},{"t":"I want to know why I'm here.","ar":"أنا أريد أن أعرف لماذا أنا هنا."},{"t":"Why do you want to know that?","ar":"لماذا تريد أن تعرف ذلك؟"},{"t":"Why would we want to do that?","ar":"لم سنرغب بعمل ذلك؟"},{"t":"Is that why you don't like her?","ar":"ألهذا السبب لا تحبها؟"},{"t":"I want to know why you did that.","ar":"أودّ معرفة سبب فعلك لذلك."},{"t":"I don't know why we have to do that.","ar":"لا أعلم لم ينبغي أن نقوم بذلك."},{"t":"Why do you think I told her about it?","ar":"لم تظن أنني أخبرتها بذلك؟"},{"t":"I know why you don't want to do that.","ar":"أعلم لماذا لا تريد القيام بذلك."}],"focus":[],"difficulty":5}}