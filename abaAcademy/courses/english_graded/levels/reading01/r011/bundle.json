{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Why do you think you have to do that?","note":"لم تعتقد أنّه يجب أن تقوم بذلك؟"},{"btype":"example","text":"You know why I don't have to do that, don't you?","note":"تعلم لم أنا لست مضطرّا للقيام بهذا، أليس كذلك؟"},{"btype":"example","text":"You said no.","note":"أنت من رفضت."},{"btype":"example","text":"Sami said no.","note":"قال سامي لا."},{"btype":"example","text":"No one will know.","note":"لن يعرف أحد."},{"btype":"example","text":"No I'm not; you are!","note":"ليس أنا ، بل أنت!"},{"btype":"example","text":"Ziri said no to Rima.","note":"قال زيري لا لريمة."},{"btype":"example","text":"No, I don't have it with me.","note":"لا ليس معي."},{"btype":"example","text":"\"Do you know me?\" \"No, I don't.\"","note":"هل تعرفني؟ - لا أعرفك."},{"btype":"example","text":"Do you think so?","note":"أتعتقد ذلك؟"},{"btype":"example","text":"I don't think so.","note":"لا أظن ذلك."},{"btype":"example","text":"So what was that about?","note":"بما تعلق الأمر إذن؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Why do you think you have to do that?","ar":"لم تعتقد أنّه يجب أن تقوم بذلك؟"},{"t":"You know why I don't have to do that, don't you?","ar":"تعلم لم أنا لست مضطرّا للقيام بهذا، أليس كذلك؟"},{"t":"You said no.","ar":"أنت من رفضت."},{"t":"Sami said no.","ar":"قال سامي لا."},{"t":"No one will know.","ar":"لن يعرف أحد."},{"t":"No I'm not; you are!","ar":"ليس أنا ، بل أنت!"},{"t":"Ziri said no to Rima.","ar":"قال زيري لا لريمة."},{"t":"No, I don't have it with me.","ar":"لا ليس معي."},{"t":"\"Do you know me?\" \"No, I don't.\"","ar":"هل تعرفني؟ - لا أعرفك."},{"t":"Do you think so?","ar":"أتعتقد ذلك؟"},{"t":"I don't think so.","ar":"لا أظن ذلك."},{"t":"So what was that about?","ar":"بما تعلق الأمر إذن؟"},{"t":"He told me to do it, so I did it.","ar":"أمرني أن أقوم بهذا، فقمت به."},{"t":"Tom doesn't know.","ar":"توم لا يعلم."},{"t":"Ziri doesn't know.","ar":"ياني لا يعلم."},{"t":"He doesn't like it.","ar":"لم يعجبه."},{"t":"Tom doesn't like me.","ar":"توم لا يحبني."},{"t":"Tom doesn't know me.","ar":"توم لا يعرفني"},{"t":"Tom doesn't want me.","ar":"توم لا يريدني."},{"t":"Sami doesn't want me.","ar":"سامي لا يريدني؟"},{"t":"Yanni doesn't do that.","ar":"ياني لا يفعل ذلك."},{"t":"Yanni doesn't want that.","ar":"ياني لا يريد ذلك."},{"t":"Tom doesn't know I'm here.","ar":"لا يعرف توم انني هنا."},{"t":"Ziri doesn't want to know.","ar":"زيري لا يريد أن يعلم."},{"t":"Sami doesn't want to be on TV.","ar":"لا يُريد سامي أن يظهر على التّلفاز."},{"t":"Tom doesn't want to go with you.","ar":"لا يريد توم الذهاب معك."},{"t":"Ziri doesn't want to be with Rima.","ar":"لا يريد زيري أن يكون مع ريمة."},{"t":"He just told me.","ar":"لقد أخبرني للتّو."},{"t":"I'm just like you.","ar":"أنا مثلك تماما."},{"t":"What did Ziri just do?","ar":"ماذا فعل زيري للتو؟"}],"focus":[],"difficulty":5}}