{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"What will you do tomorrow?","note":"ماذا ستفعل غدا؟"},{"btype":"example","text":"We have no school tomorrow.","note":"نحن مجازون من المدرسة غدًا."},{"btype":"example","text":"Ziri will be here tomorrow.","note":"سيكون زيري هناك غدا."},{"btype":"example","text":"He will be at home tomorrow.","note":"سوف يكون في البيت غداً."},{"btype":"example","text":"Will you come back tomorrow?","note":"هل ستعود غدا؟"},{"btype":"example","text":"I will go to Tokyo tomorrow.","note":"سأذهب إلى طوكيو غدا."},{"btype":"example","text":"I will go to America tomorrow.","note":"سأذهب إلى أمريكا غداً."},{"btype":"example","text":"Tomorrow I'll buy what I need.","note":"سأبتاع غدا ما أحتاج."},{"btype":"example","text":"Why won't you be here tomorrow?","note":"لم لن تكون هنا غدا؟"},{"btype":"example","text":"You don't have to come tomorrow.","note":"ليس عليك أن تأتي غدًا."},{"btype":"example","text":"He doesn't have school tomorrow.","note":"لن يدرس غدا."},{"btype":"example","text":"Will he be able to come tomorrow?","note":"هل سيتمكن من القدوم غداً؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"What will you do tomorrow?","ar":"ماذا ستفعل غدا؟"},{"t":"We have no school tomorrow.","ar":"نحن مجازون من المدرسة غدًا."},{"t":"Ziri will be here tomorrow.","ar":"سيكون زيري هناك غدا."},{"t":"He will be at home tomorrow.","ar":"سوف يكون في البيت غداً."},{"t":"Will you come back tomorrow?","ar":"هل ستعود غدا؟"},{"t":"I will go to Tokyo tomorrow.","ar":"سأذهب إلى طوكيو غدا."},{"t":"I will go to America tomorrow.","ar":"سأذهب إلى أمريكا غداً."},{"t":"Tomorrow I'll buy what I need.","ar":"سأبتاع غدا ما أحتاج."},{"t":"Why won't you be here tomorrow?","ar":"لم لن تكون هنا غدا؟"},{"t":"You don't have to come tomorrow.","ar":"ليس عليك أن تأتي غدًا."},{"t":"He doesn't have school tomorrow.","ar":"لن يدرس غدا."},{"t":"Will he be able to come tomorrow?","ar":"هل سيتمكن من القدوم غداً؟"},{"t":"I don't know what to do tomorrow.","ar":"لا أعرف ما أفعلُهُ غداً."},{"t":"Tomorrow is my first day of work.","ar":"غدا هو أول يوم عمل لي."},{"t":"We have to do this again tomorrow.","ar":"علينا تكرار هذا غدا."},{"t":"He will go to Tokyo tomorrow, won't he?","ar":"سيذهب إلى طوكيو غداً، أليس ذلك صحيحاً؟"},{"t":"I'll come back to Australia the day after tomorrow.","ar":"سأعود إلى أستراليا بعد غد."},{"t":"I have a lot of things I have to do before tomorrow.","ar":"لدي الكثير من الاعمال يتوجب علي القيام بها قبل الغد."},{"t":"I stay in Osaka.","ar":"أسكن في أوساكا."},{"t":"Stay in the car.","ar":"إبقى في السيارة"},{"t":"Stay home, Ziri.","ar":"ابق في المنزل يا زيري."},{"t":"Can we stay here?","ar":"هل يمكننا البقاء هنا؟"},{"t":"Why did you stay?","ar":"لم بقيت؟"},{"t":"Why did she stay?","ar":"لماذا بقت هناك؟"},{"t":"Stay here with us.","ar":"ابق هنا معنا."},{"t":"Stay where you are.","ar":"ابق مكانك."},{"t":"I will stay at home.","ar":"سوف أبقى في المنزل."},{"t":"Don't stay too long!","ar":"لا تطل البقاء!"},{"t":"Ziri will stay here.","ar":"سيبقى زيري هنا."},{"t":"He didn't stay long.","ar":"لم يبقى طويلا."}],"focus":[],"difficulty":5}}