{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Yanni needs more.","note":"ياني يحتاج المزيد."},{"btype":"example","text":"Sami needs to eat.","note":"يحتاج سامي للأكل."},{"btype":"example","text":"He needs to leave.","note":"عليه المغادرة."},{"btype":"example","text":"Mennad needs help.","note":"منّاد بحاجة للمساعدة."},{"btype":"example","text":"Yanni needs Skura.","note":"ياني بحاجة لسكورة."},{"btype":"example","text":"He just needs help.","note":"هو بحاجة للمساعدة فحسب."},{"btype":"example","text":"He needs that money.","note":"هو بحاجة لذلك المال."},{"btype":"example","text":"Sami needs something.","note":"سامي بحاجة لشيء ما."},{"btype":"example","text":"Ziri needs that time.","note":"زيري بحاجة لذلك الوقت."},{"btype":"example","text":"Ziri needs to have time.","note":"زيري بحاجة إلى وقت."},{"btype":"example","text":"Ziri needs Rima right now.","note":"زيري يحتاج لريمة في الحين."},{"btype":"example","text":"Ziri needs to think again.","note":"على زيري أن يفكر مجددا."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Yanni needs more.","ar":"ياني يحتاج المزيد."},{"t":"Sami needs to eat.","ar":"يحتاج سامي للأكل."},{"t":"He needs to leave.","ar":"عليه المغادرة."},{"t":"Mennad needs help.","ar":"منّاد بحاجة للمساعدة."},{"t":"Yanni needs Skura.","ar":"ياني بحاجة لسكورة."},{"