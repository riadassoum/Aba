{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"We live in Cairo.","note":"نسكن في القاهرة."},{"btype":"example","text":"Where do you live?","note":"أين تسكن؟"},{"btype":"example","text":"Do you live there?","note":"هل تسكن هناك؟"},{"btype":"example","text":"I don't live here.","note":"أنا لا أسكن هنا"},{"btype":"example","text":"Where will I live?","note":"أين سأعيش؟"},{"btype":"example","text":"I live in America.","note":"أعيش في أمريكا."},{"btype":"example","text":"I want to live here.","note":"أريد العيش هنا."},{"btype":"example","text":"Where does Tom live?","note":"أين يسكن توم؟"},{"btype":"example","text":"Let me live my life.","note":"دعني أعيش حياتي."},{"btype":"example","text":"Where does John live?","note":"أين يسكن جون؟"},{"btype":"example","text":"He used to live here.","note":"كان يعيش هنا."},{"btype":"example","text":"So where does he live?","note":"فأين يسكن؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"We live in Cairo.","ar":"نسكن في القاهرة."},{"t":"Where do you live?","ar":"أين تسكن؟"},{"t":"Do you live there?","ar":"هل تسكن هناك؟"},{"t":"I don't live here.","ar":"أنا لا أسكن هنا"},{"t":"Where will I live?","ar":"أين سأعيش؟"},{"t":"I live in America.","ar":"أعيش في أمريكا."},{"t":"I want to live here.","ar":"أريد العيش هنا."},{"t":"Where does Tom l