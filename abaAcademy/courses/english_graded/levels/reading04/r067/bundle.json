{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Tom is about to leave.","note":"توم على وشك المغادرة."},{"btype":"example","text":"She is about to leave.","note":"هي على وشك المغادرة."},{"btype":"example","text":"Layla wanted to leave.","note":"أرادت ليلى الرّحيل."},{"btype":"example","text":"You should leave, too.","note":"أنت أيضا ينبغي أن تذهب."},{"btype":"example","text":"Ziri won't leave Rima.","note":"لن يتخلى زيري عن ريمة."},{"btype":"example","text":"What time do you leave?","note":"متى تغادر؟"},{"btype":"example","text":"You should leave, Ziri.","note":"عليك أن تذهب يا زيري."},{"btype":"example","text":"Sami will have to leave.","note":"سيكون على سامي المغادرة."},{"btype":"example","text":"He didn't want to leave.","note":"لم يكن راغبا في المغادرة."},{"btype":"example","text":"What time will you leave?","note":"متى ستغادر؟"},{"btype":"example","text":"Tom didn't have to leave.","note":"لم يكن على توم الذهاب."},{"btype":"example","text":"I'm going to leave school.","note":"سأترك المدرسة."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Tom is about to leave.","ar":"توم على وشك المغادرة."},{"t":"She is about to leave.","ar":"هي على وشك المغادرة."},{"t":"Layla wanted to leave.","ar":"أرادت ليلى الرّحيل."},{"t":"You should leave, too.","ar":"أنت أيضا ينبغي أن تذهب."}