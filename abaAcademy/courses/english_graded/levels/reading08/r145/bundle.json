{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Wait. Come back.","note":"انتظر. عد إلى هنا."},{"btype":"example","text":"Sami can't wait.","note":"لا يستطيع سامي الانتظار."},{"btype":"example","text":"Wait for Mennad.","note":"انتظر منّاد."},{"btype":"example","text":"Ziri can't wait.","note":"زيري لا يستطيع الانتظار."},{"btype":"example","text":"Tell him to wait.","note":"أخبره بأن ينتظر"},{"btype":"example","text":"You need to wait.","note":"يجب ان تنتظر."},{"btype":"example","text":"Sami should wait.","note":"ينبغي على سامي أن ينتظر."},{"btype":"example","text":"Yanni didn't wait.","note":"ياني لم يتنظر."},{"btype":"example","text":"Wait, what is this?","note":"لحظة! ما هذا؟"},{"btype":"example","text":"Let's wait a while.","note":"لننتظر قليلا."},{"btype":"example","text":"Sami couldn't wait.","note":"لم يكن باستطاعة سامي الانتظار."},{"btype":"example","text":"Just wait right here.","note":"فقط انتظر هنا."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Wait. Come back.","ar":"انتظر. عد إلى هنا."},{"t":"Sami can't wait.","ar":"لا يستطيع سامي الانتظار."},{"t":"Wait for Mennad.","ar":"انتظر منّاد."},{"t":"Ziri can't wait.","ar":"زيري لا يستطيع الانتظار."},{"t":"Tell him to wait.","ar":"أخبره بأن ينتظر"},{"t":"You need to wait.","ar":"يجب ان تنتظر."},{"t":"Sami should wait.","ar":"ينبغي على سامي أن ينتظر."},{"t":"Yanni didn't wait.","ar":"ياني لم يتنظر."},{"t":"Wait, what is this?","ar":"لحظة! ما هذا؟"},{"t":"Let's wait a while.","ar":"لننتظر قليلا."},{"t":"Sami couldn't wait.","ar":"لم يكن باستطاعة سامي الانتظار."},{"t":"Just wait right here.","ar":"فقط انتظر هنا."},{"t":"How long did you wait?","ar":"منذ متى وأنت تنتظر؟"},{"t":"We can't wait for you.","ar":"لا نستطيع الانتظار من أجلك."},{"t":"All you can do is wait.","ar":"كل ما يمكنك فعله هو الانتظار."},{"t":"Sami was going to wait.","ar":"كان سامي سينتظر."},{"t":"You don't need to wait.","ar":"لست مضطرّا للانتظار."},{"t":"Can I wait for Tom here?","ar":"هل يمكنني إنتظار توم هنا؟"},{"t":"Sami told Layla to wait.","ar":"طلب سامي من ليلى أن تنتظر."},{"t":"He can't wait to see you.","ar":"لا يطيق صبرا ليراك."},{"t":"Do you want them to wait?","ar":"هل تريد انتظارهم؟"},{"t":"Why did she wait so long?","ar":"لماذا انتظرت كل هذه المدة؟"},{"t":"Sami can't wait that long.","ar":"لا يستطيع سامي انتظار كلّ تلك المدّة."},{"t":"All you need to do is wait.","ar":"كل ما عليك القيام به هو الإنتظار."},{"t":"Sami has to wait for Layla.","ar":"على سامي انتظار ليلى."},{"t":"Yanni doesn't need to wait.","ar":"لا يحتاج ياني للانتظار."},{"t":"How long do we have to wait?","ar":"كم من الوقت علينا أن ننتظر؟"},{"t":"Tell Tom not to wait for me.","ar":"أخبر توم أن لا ينتظرني."},{"t":"Where did you wait for them?","ar":"أين انتظرتهم؟"},{"t":"How long did you wait for me?","ar":"كم من الوقت أنتظرتني؟"}],"focus":[],"difficulty":5}}