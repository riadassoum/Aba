{"theory":{"blocks":[{"btype":"text","text":"جمل أطول ومفردات أقلّ شيوعًا. الكلمات الجديدة في معظمها مشروحة أدناه."},{"btype":"example","text":"Is Yanni coming with us?","note":"هل سيأتي ياني معنا؟"},{"btype":"example","text":"Ziri is coming home soon.","note":"سيعود زيري إلى المنزل قريبا."},{"btype":"example","text":"Are you coming back to me?","note":"هل ستعود إلي؟"},{"btype":"example","text":"Sami was coming from there.","note":"كان سامي آتيًا من هناك."},{"btype":"example","text":"When is Mennad coming back?","note":"متى سيعود ميناد ؟"},{"btype":"example","text":"Ziri didn't see that coming.","note":"لم يتوقع زيري ذلك."},{"btype":"example","text":"Why aren't you coming with us?","note":"لم لن تأتِ معنا؟"},{"btype":"example","text":"Father is coming home tomorrow.","note":"الأب عائد إلى البيت غداَ."},{"btype":"example","text":"Layla was coming back to Cairo.","note":"كانت ليلى عائدة إلى القاهرة."},{"btype":"example","text":"She is coming back from school.","note":"رجعت من المدرسة."},{"btype":"example","text":"\"Is he coming?\" \"No, I think not.\"","note":"\"هل سيأتي؟\"، \"لا، لا أعتقد ذلك\"."},{"btype":"example","text":"I want to know who is coming with us.","note":"أريد أن أعرف من سيأتي معنا."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":6,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"}]},"data":{"lang":"en","lang_name":"الإنجليزية","sentences":[{"t":"Is Yanni coming with us?","ar":"هل سيأتي ياني معنا؟"},{"t":"Ziri is coming home soon.","ar":"سيعود زيري إلى المنزل قريبا."},{"t":"Are you coming back to me?","ar":"هل ستعود إلي؟"},{"t":"Sami was coming from there.","ar":"كان سامي آتيًا من هناك."},{"t":"When is Mennad coming back?","ar":"متى سيعود ميناد ؟"},{"t":"Ziri didn't see that coming.","ar":"لم يتوقع زيري ذلك."},{"t":"Why aren't you coming with us?","ar":"لم لن تأتِ معنا؟"},{"t":"Father is coming home tomorrow.","ar":"الأب عائد إلى البيت غداَ."},{"t":"Layla was coming back to Cairo.","ar":"كانت ليلى عائدة إلى القاهرة."},{"t":"She is coming back from school.","ar":"رجعت من المدرسة."},{"t":"\"Is he coming?\" \"No, I think not.\"","ar":"\"هل سيأتي؟\"، \"لا، لا أعتقد ذلك\"."},{"t":"I want to know who is coming with us.","ar":"أريد أن أعرف من سيأتي معنا."},{"t":"\"Is he coming?\" \"No, I don't think so.\"","ar":"\"هل هو قادم؟\"، \"لا أظن أنه سيأتي.\""},{"t":"Do you know if he's coming to the party?","ar":"هل تعرف إن كان سيحضر الحفل؟"},{"t":"You know I'm not coming back, don't you?","ar":"أنت تعرف أنني لن أعود، أليس كذلك؟"},{"t":"Tell Tom and Mary I'm coming to see them.","ar":"أخبر توم وماري أنني قادم لرؤيتهما"},{"t":"Did you know they were coming here today?","ar":"أعلمت أنهم كانوا سيأتون اليوم إلى هنا؟"},{"t":"They're coming to our house. We aren't going to their house.","ar":"إنهم أتون إلي منزلنا, نحن لن نذهب إلي منزلهم."},{"t":"I am a teacher.","ar":"أنا مدرس."},{"t":"Is he a teacher?","ar":"هل هو معلم؟"},{"t":"I was a teacher.","ar":"كنت معلماً."},{"t":"He is a teacher.","ar":"هو مدرس."},{"t":"She is a teacher.","ar":"هي معلمة."},{"t":"He is my teacher.","ar":"إنه معلمي."},{"t":"I'm not a teacher.","ar":"أنا لست مدرساً."},{"t":"Ziri is a teacher.","ar":"زيري مدرس."},{"t":"She is my teacher.","ar":"إنها معلمتي."},{"t":"The teacher saw me.","ar":"لقد رآني المدرّس."},{"t":"Who is your teacher?","ar":"من مدرسك؟"},{"t":"I am a teacher, too.","ar":"أنا مدرس أيضاً."}],"focus":[],"difficulty":5}}