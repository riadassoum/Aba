از."},{"t":"No debes esperar aquí.","ar":"يستحسن ألا تنتظر هنا."},{"t":"Sami no podía esperar.","ar":"لم يكن باستطاعة سامي الانتظار."},{"t":"No hay suficiente café.","ar":"ليس هناك قهوة كافية."},{"t":"¿De qué estás hablando?","ar":"عما تتحدث؟"},{"t":"Tom vio otra vez a Mary.","ar":"رأى توم ماري مجددا."},{"t":"¿Estás hablando conmigo?","ar":"هل تحدثني؟"},{"t":"Él ve televisión a veces.","ar":"يشاهد التلفاز أحياناً."},{"t":"¡Qué viejo es este libro!","ar":"ما أقدم هذا الكتاب!"},{"t":"Esto es suficiente para mí.","ar":"هذا يكفيني."},{"t":"¿Es esto suficiente dinero?","ar":"أيكفي هذا المال؟"},{"t":"Está hablando por teléfono.","ar":"إنه يتحدث على الهاتف."},{"t":"Él puede leer lo suficiente.","ar":"يمكنه القراءة بشكل جيد."}],"focus":["vio","habéis","caso","suficiente","juntos","hablando","televisión","viejo","ventana","esperar"],"words":[{"word":"caso","topic":"L46","difficulty":1,"meaning":"قَضِيَّة، حَالَات"},{"word":"suficiente","topic":"L46","difficulty":1,"meaning":"مُرِيح","example":"No es suficiente.","translation":"انها ليست كافيه."},{"word":"televisión","topic":"L46","difficulty":1,"meaning":"تِلْفَاز","example":"Tom vio la televisión ayer.","translation":"شاهد توم التلفاز بالأمس."},{"word":"viejo","topic":"L46","difficulty":1,"meaning":"شَيْخ","example":"Este libro es viejo.","translation":"هذا الكتاب قديم."},{"word":"ventana","topic":"L46","difficulty":1,"meaning":"نَافِذَة"},{"word":"esperar","topic":"L46","difficulty":1,"meaning":"أَمَلَ","example":"Sólo puedo esperar.","translation":"كل ما أستطيع فعله هو الإنتظار."}],"difficulty":1}}