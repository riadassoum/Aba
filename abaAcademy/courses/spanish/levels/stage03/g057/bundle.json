{"theory":{"blocks":[{"btype":"text","text":"الدرس 57. الكلمات الجديدة: significa، aquella، boca، buenos، necesitamos، asunto، abuela، acaba، malo، deberíamos."},{"btype":"example","text":"significa = إِسْتَنَدَ","note":"صيغة من significar (الغائب، المضارع)؛ مثال: ¿Qué significa? — ماذا يعني ذلك؟"},{"btype":"example","text":"aquella = ذَاكَ، اَلَّذِي","note":"صيغة من aquel (المؤنث)؛ مثال: Aquella casa es grande. — ذاك البيت كبير."},{"btype":"example","text":"boca = فَم","note":""},{"btype":"example","text":"buenos = حَسَن، صِحِّيّ","note":"صيغة من bueno (الجمع، المذكّر)؛ مثال: Buenos días. — صباح الخير"},{"btype":"example","text":"necesitamos = حَاجَة","note":"صيغة من necesitar (الجمع، المتكلّم، الماضي التامّ)؛ مثال: Necesitamos agua. — نحتاج الماء"},{"btype":"example","text":"asunto = أَمْر، قَضِيَّة","note":""},{"btype":"example","text":"abuela = جَدَّة","note":"مثال: Mi abuela vive por sí sola. — تعيش جدتي وحدها."},{"btype":"example","text":"acaba = اِنْتَهَى، أَنْهَى","note":"صيغة من acabar (الغائب، المضارع)؛ مثال: ¿Cuándo se acaba la escuela? — متى ينتهي الدوام المدرسيّ؟"},{"btype":"example","text":"malo = سَيِّئ، شَرِير","note":"مثال: Ziri es malo. — زيري سيء."},{"btype":"example","text":"deberíamos = يَنْبَغِي أَنْ","note":"صيغة من deber (الجمع، المتكلّم، الشرطي)؛ مثال: ¿Qué deberíamos decir? — ماذا يجب أن نقول؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Buenos días.","note":"صباح الخير"},{"btype":"example","text":"¡Buenos días!","note":"صباح الخير."},{"btype":"example","text":"Ziri es malo.","note":"زيري سيء."},{"btype":"example","text":"Ziri era malo.","note":"كان زيري سيئا."},{"btype":"example","text":"¿Qué significa?","note":"ماذا يعني ذلك؟"},{"btype":"example","text":"Necesitamos agua.","note":"نحتاج الماء"},{"btype":"example","text":"Buenos días, Mike.","note":"صباح الخير، يا مايك"},{"btype":"example","text":"Necesitamos ayuda.","note":"نحن نحتاج إلى مساعدة"},{"btype":"example","text":"No sé qué significa.","note":"لا أدري ماذا تعني."},{"btype":"example","text":"Buenos días a todos.","note":"صَبَاح الْخَيْر جَمِيْعاً."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Buenos días.","ar":"صباح الخير"},{"t":"¡Buenos días!","ar":"صباح الخير."},{"t":"Ziri es malo.","ar":"زيري سيء."},{"t":"Ziri era malo.","ar":"كان زيري سيئا."},{"t":"¿Qué significa?","ar":"ماذا يعني ذلك؟"},{"t":"Necesitamos agua.","ar":"نحتاج الماء"},{"t":"Buenos días, Mike.","ar":"صباح الخير، يا مايك"},{"t":"Necesitamos ayuda.","ar":"نحن نحتاج إلى مساعدة"},{"t":"No sé qué significa.","ar":"لا أدري ماذا تعني."},{"t":"Buenos días a todos.","ar":"صَبَاح الْخَيْر جَمِيْعاً."},{"t":"Necesitamos un coche.","ar":"نحتاج إلى سيارة."},{"t":"Te necesitamos, Ziri.","ar":"نحن بحاجة لك يا زيري."},{"t":"Necesitamos la lluvia.","ar":"نحن نحتاج إلي المطر."},{"t":"¿Qué deberíamos decir?","ar":"ماذا يجب أن نقول؟"},{"t":"Aquella casa es grande.","ar":"ذاك البيت كبير."},{"t":"No es ni bueno ni malo.","ar":"انها لا جيدة ولا سيئة."},{"t":"No necesitamos tu ayuda.","ar":"لا نحتاج مساعدتك."},{"t":"¿Quién es aquella persona?","ar":"من ذلك الشخص؟"},{"t":"Mi abuela vive por sí sola.","ar":"تعيش جدتي وحدها."},{"t":"¿Qué significa esta palabra?","ar":"ما معنى هذه الكلمة؟"},{"t":"¿Cuándo se acaba la escuela?","ar":"متى ينتهي الدوام المدرسيّ؟"},{"t":"¿Sabes lo que esto significa?","ar":"أتعلم ما يعني هذا؟"},{"t":"No se acaba el mundo por eso.","ar":"ليست نهاية العالم."},{"t":"Todos nosotros deberíamos ir.","ar":"علينا جميعا أن نذهب."},{"t":"Aquella mujer mayor vive sola.","ar":"تلك المرأة العجوز تعيش لوحدها."},{"t":"¿A qué hora se acaba tu clase?","ar":"في أي وقت ينتهي صفك؟"},{"t":"Mi hermana se parece a mi abuela.","ar":"أختي تشبه جدتي."},{"t":"¿Realmente puede ser así de malo?","ar":"هل بإمكانه أن يكون سيئا إلى هذه الدرجة؟"},{"t":"Su hija y mi hijo son buenos amigos.","ar":"ابنته وابني صديقان جيدان."},{"t":"Deberíamos haber tenido más cuidado.","ar":"كان من المفترض أن نكون حذرين أكثر."}],"focus":["significa","aquella","boca","buenos","necesitamos","asunto","abuela","acaba","malo","deberíamos"],"words":[{"word":"boca","topic":"L57","difficulty":1,"meaning":"فَم"},{"word":"asunto","topic":"L57","difficulty":1,"meaning":"أَمْر، قَضِيَّة"},{"word":"abuela","topic":"L57","difficulty":1,"meaning":"جَدَّة","example":"Mi abuela vive por sí sola.","translation":"تعيش جدتي وحدها."},{"word":"malo","topic":"L57","difficulty":1,"meaning":"سَيِّئ، شَرِير","example":"Ziri es malo.","translation":"زيري سيء."}],"difficulty":1}}