{"theory":{"blocks":[{"btype":"text","text":"الدرس 274. الكلمات الجديدة: contarle، intentaba، pagué، creciendo، mire، nublado، trabajé، tuviste، muñecas، catorce."},{"btype":"example","text":"contarle = عَدَّ","note":"صيغة من contar (المصدر)"},{"btype":"example","text":"intentaba = حَاوَلَ","note":"صيغة من intentar (الغائب، الماضي المستمرّ)"},{"btype":"example","text":"pagué = دَفَعَ","note":"صيغة من pagar (المتكلّم، الماضي التامّ)؛ مثال: Yo pagué las entradas. — دفعتُ ثمن التذاكر."},{"btype":"example","text":"creciendo = نَمَى","note":"صيغة من crecer (صيغة المصدر الجاري)؛ مثال: Estoy creciendo rápido. — إني أنمو بسرعة كبيرة."},{"btype":"example","text":"mire = نَظَرَ","note":"صيغة من mirar (الغائب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Deja que te mire. — دعني أنظر إليك."},{"btype":"example","text":"nublado = غائم","note":"مثال: Ayer estaba nublado. — كان أمس غائما."},{"btype":"example","text":"trabajé = عَمِلَ","note":"صيغة من trabajar (المتكلّم، الماضي التامّ)؛ مثال: Trabajé duro el último mes. — عملت كثيرا الشهر الفائت."},{"btype":"example","text":"tuviste = مَلَكَ، تَنَاوَلَ","note":"صيغة من tener (المخاطب، الماضي التامّ)"},{"btype":"example","text":"muñecas = دُمْيَة","note":"صيغة من muñeca (الجمع)؛ مثال: Los niños no juegan con muñecas. — الأولاد لا يلعبون بالدّمى."},{"btype":"example","text":"catorce = أَرْبَعَةَ عَشَرَ","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Deja que te mire.","note":"دعني أنظر إليك."},{"btype":"example","text":"Ayer estaba nublado.","note":"كان أمس غائما."},{"btype":"example","text":"Mire cómo lo hago yo.","note":"انظر كيف أقوم بذلك"},{"btype":"example","text":"Yo pagué las entradas.","note":"دفعتُ ثمن التذاكر."},{"btype":"example","text":"Le pagué cinco dólares.","note":"دفعت له خمسة دولارات."},{"btype":"example","text":"Estoy creciendo rápido.","note":"إني أنمو بسرعة كبيرة."},{"btype":"example","text":"Trabajé duro el último mes.","note":"عملت كثيرا الشهر الفائت."},{"btype":"example","text":"Yo trabajé en esta fábrica.","note":"أنا عملت في هذا المصنع."},{"btype":"example","text":"¿Estaba nublado en Tokio ayer?","note":"أكان الجو غائماً في طوكيو البارحة؟"},{"btype":"example","text":"Los niños no juegan con muñecas.","note":"الأولاد لا يلعبون بالدّمى."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Deja que te mire.","ar":"دعني أنظر إليك."},{"t":"Ayer estaba nublado.","ar":"كان أمس غائما."},{"t":"Mire cómo lo hago yo.","ar":"انظر كيف أقوم بذلك"},{"t":"Yo pagué las entradas.","ar":"دفعتُ ثمن التذاكر."},{"t":"Le pagué cinco dólares.","ar":"دفعت له خمسة دولارات."},{"t":"Estoy creciendo rápido.","ar":"إني أنمو بسرعة كبيرة."},{"t":"Trabajé duro el último mes.","ar":"عملت كثيرا الشهر الفائت."},{"t":"Yo trabajé en esta fábrica.","ar":"أنا عملت في هذا المصنع."},{"t":"¿Estaba nublado en Tokio ayer?","ar":"أكان الجو غائماً في طوكيو البارحة؟"},{"t":"Los niños no juegan con muñecas.","ar":"الأولاد لا يلعبون بالدّمى."}],"focus":["contarle","intentaba","pagué","creciendo","mire","nublado","trabajé","tuviste","muñecas","catorce"],"words":[{"word":"nublado","topic":"L274","difficulty":2,"meaning":"غائم","example":"Ayer estaba nublado.","translation":"كان أمس غائم