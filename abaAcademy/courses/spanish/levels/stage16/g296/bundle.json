{"theory":{"blocks":[{"btype":"text","text":"الدرس 296. الكلمات الجديدة: pronunciación، grita، cazador، pusimos، empecemos، pides، corazones، confuso، ponerlo، oírlo."},{"btype":"example","text":"pronunciación = نُطْق، لَفْظ","note":""},{"btype":"example","text":"grita = دَعَا","note":"صيغة من gritar (الغائب، المضارع)؛ مثال: Grita mucho. — إنه يصرخ كثيراً."},{"btype":"example","text":"cazador = صَيَّاد","note":""},{"btype":"example","text":"pusimos = وَضَعَ","note":"صيغة من poner (الجمع، المتكلّم، الماضي التامّ)؛ مثال: Nos pusimos de acuerdo en compartir las tareas del hogar. — اتفقنا على توزيع مهام تنظيف البيت فيما بيننا."},{"btype":"example","text":"empecemos = بَدَأَ","note":"صيغة من empezar (الجمع، المتكلّم، صيغة الالتماس (الشرطية))؛ مثال: ¡Empecemos! — هيا لنبدأ."},{"btype":"example","text":"pides = سَأَلَ","note":"صيغة من pedir (المخاطب، المضارع)؛ مثال: Me pides que haga lo imposible. — أنت تطلب مني أن أفعل المستحيل."},{"btype":"example","text":"corazones = كُبَّا","note":""},{"btype":"example","text":"confuso = اِرْتَبَكَ","note":"مثال: Estoy confuso. — انا محتار."},{"btype":"example","text":"ponerlo = وَضَعَ","note":"صيغة من poner (المصدر)؛ مثال: Puedes ponerlo en cualquier sitio. — بإمكانك وضعها في أي مكان."},{"btype":"example","text":"oírlo = سَمِعَ، سَمِع","note":"صيغة من oír (المصدر)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"¡Empecemos!","note":"هيا لنبدأ."},{"btype":"example","text":"Grita mucho.","note":"إنه يصرخ كثيراً."},{"btype":"example","text":"Estoy confuso.","note":"انا محتار."},{"btype":"example","text":"Él grita mucho.","note":"هو يصرخ كثيرا."},{"btype":"example","text":"OK, ¡empecemos!","note":"حسناً، دعونا نبدأ!"},{"btype":"example","text":"Tom parece confuso.","note":"يبدو توم في حيرة."},{"btype":"example","text":"Me pides que haga lo imposible.","note":"أنت تطلب مني أن أفعل المستحيل."},{"btype":"example","text":"Puedes ponerlo en cualquier sitio.","note":"بإمكانك وضعها في أي مكان."},{"btype":"example","text":"Tom siempre grita cuando está enfadado.","note":"توم دائماً يصرخ عندما يكون غاضباً."},{"btype":"example","text":"Nos pusimos de acuerdo en compartir las tareas del hogar.","note":"اتفقنا على توزيع مهام تنظيف البيت فيما بيننا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"¡Empecemos!","ar":"هيا لنبدأ."},{"t":"Grita mucho.","ar":"إنه يصرخ كثيراً."},{"t":"Estoy confuso.","ar":"انا محتار."},{"t":"Él grita mucho.","ar":"هو يصرخ كثيرا."},{"t":"OK, ¡empecemos!","ar":"حسناً، دعونا نبدأ!"},{"t":"Tom parece confuso.","ar":"يبدو توم في حيرة."},{"t":"Me pides que haga lo imposible.","ar":"أنت تطلب مني أن أفعل المستحيل."},{"t":"Puedes ponerlo en cualquier sitio.","ar":"بإمكانك وضعها في أي مكان."},{"t":"Tom siempre grita cuando está enfadado.","ar":"توم دائماً يصرخ عندما يكون غاضباً."},{"t":"Nos pusimos de acuerdo en compartir las tareas del hogar.","ar":"اتفقنا على توزيع مهام تنظيف البيت فيما بيننا."}],"focus":["pronunciación","grita","cazad