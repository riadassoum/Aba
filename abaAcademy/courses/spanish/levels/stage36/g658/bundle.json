{"theory":{"blocks":[{"btype":"text","text":"الدرس 658. الكلمات الجديدة: costosos، afilados، resfriados، callara، universitarias، cuelgues، tosió، arruinaste، memorizando، aullando."},{"btype":"example","text":"costosos","note":"مثال: Los sombreros de mujer son costosos. — قبعات النساء غالية."},{"btype":"example","text":"afilados","note":"مثال: Tus lápices necesitan ser afilados. — تحتاج أقلامك إلى بري."},{"btype":"example","text":"resfriados","note":"مثال: Limón caliente con miel es un buen remedio para los resfriados. — يمثل الليمون الساخن مع العسل علاجا جيدا للزكام."},{"btype":"example","text":"callara","note":"مثال: Papá dijo que me callara. — أمرني أبي أن أسكت."},{"btype":"example","text":"universitarias","note":"مثال: Son estudiantes universitarias. — هن طالبات جامعيات."},{"btype":"example","text":"cuelgues","note":"مثال: No cuelgues todavía, por favor. — لا تقفل الخط من فضلك."},{"btype":"example","text":"tosió","note":"مثال: Ziri tosió. — سعل زيري."},{"btype":"example","text":"arruinaste","note":"مثال: Arruinaste todo. — لقد أفسدت كل شيء."},{"btype":"example","text":"memorizando","note":"مثال: Me estoy memorizando el himno nacional. — انا احفظ النشيد الوطني."},{"btype":"example","text":"aullando","note":"مثال: El chacal está aullando. — ابن آوى يعوي."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ziri tosió.","note":"سعل زيري."},{"btype":"example","text":"Arruinaste todo.","note":"لقد أفسدت كل شيء."},{"btype":"example","text":"Arruinaste mi vida.","note":"لقد دمرتم حياتي."},{"btype":"example","text":"El chacal está aullando.","note":"ابن آوى يعوي."},{"btype":"example","text":"Papá dijo que me callara.","note":"أمرني أبي أن أسكت."},{"btype":"example","text":"Son estudiantes universitarias.","note":"هن طالبات جامعيات."},{"btype":"example","text":"No cuelgues todavía, por favor.","note":"لا تقفل الخط من فضلك."},{"btype":"example","text":"Tus lápices necesitan ser afilados.","note":"تحتاج أقلامك إلى بري."},{"btype":"example","text":"Los sombreros de mujer son costosos.","note":"قبعات النساء غالية."},{"btype":"example","text":"Me estoy memorizando el himno nacional.","note":"انا احفظ النشيد الوطني."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Ziri tosió.","ar":"سعل زيري."},{"t":"Arruinaste todo.","ar":"لقد أفسدت كل شيء."},{"t":"Arruinaste mi vida.","ar":"لقد دمرتم حياتي."},{"t":"El chacal está aullando.","ar":"ابن آوى يعوي."},{"t":"Papá dijo que me callara.","ar":"أمرني أبي أن أسكت."},{"t":"Son estudiantes universitarias.","ar":"هن طالبات جامعيات."},{"t":"No cuelgues todavía, por favor.","ar":"لا تقفل الخط من فضلك."},{"t":"Tus lápices necesitan ser afilados.","ar":"تحتاج أقلامك إلى بري."},{"t":"Los sombreros de mujer son costosos.","ar":"قبعات النساء غالية."},{"t":"Me estoy memorizando el himno nacional.","ar":"انا احفظ النشيد الوطني."},{"t":"Limón caliente con miel es un buen remedio para los resfriados.","ar":"يمثل الليمون الساخن مع العسل علاجا جيدا للزكام."}],"focus":["costosos","afilados","resfriados","callara","universitarias","cuelgues","tosió","arruinaste","memorizando","aullando"],"words":[],"difficulty":5}}