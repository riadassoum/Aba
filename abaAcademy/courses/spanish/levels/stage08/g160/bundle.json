{"theory":{"blocks":[{"btype":"text","text":"الدرس 160. الكلمات الجديدة: importancia، dedos، quince، extraña، dulces، invitados، vuelva، temperatura، responsable، extranjeros."},{"btype":"example","text":"importancia = أَهَمِّيَّة","note":""},{"btype":"example","text":"dedos = إِصْبَع","note":"صيغة من dedo (الجمع)؛ مثال: El pie tiene cinco dedos. — للقدم خمسة أصابع."},{"btype":"example","text":"quince = خَمْسَةَ عَشَرَ","note":"مثال: Sólo quince minutos. — خمس عشرة دقيقة فقط."},{"btype":"example","text":"extraña = غَرِيب","note":"مثال: ¡Qué extraña es la vida! — ما أغرب الحياة!"},{"btype":"example","text":"dulces = حَلْوَى","note":"صيغة من dulce (الجمع)؛ مثال: Buenas noches. Dulces sueños. — طاب مساؤك. أحلام سعيدة."},{"btype":"example","text":"invitados","note":"مثال: Tenemos invitados. — لدينا ضيوف."},{"btype":"example","text":"vuelva = جَعَلَ","note":"صيغة من volver (الغائب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Espera aquí hasta que vuelva. — إنتظر هنا حتى أعود."},{"btype":"example","text":"temperatura = دَرَجَةْ الْحَرَارَة","note":"مثال: Mi madre me tomó la temperatura. — قاست أمي حرارتي."},{"btype":"example","text":"responsable = مَسْؤُول، مُلام","note":""},{"btype":"example","text":"extranjeros = غَرِيب، أَجْنَبِيّ","note":"صيغة من extranjero (الجمع، المذكّر)؛ مثال: ¡Me gustan los idiomas extranjeros! — أحبّ اللّغات الأجنبيّة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Tenemos invitados.","note":"لدينا ضيوف."},{"btype":"example","text":"Sólo quince minutos.","note":"خمس عشرة دقيقة فقط."},{"btype":"example","text":"¡Qué extraña es la vida!","note":"ما أغرب الحياة!"},{"btype":"example","text":"Tom extraña a su esposa.","note":"توم يفتقد لزوجته."},{"btype":"example","text":"El pie tiene cinco dedos.","note":"للقدم خمسة أصابع."},{"btype":"example","text":"Una mano tiene cinco dedos.","note":"لليد خمسة أصابع."},{"btype":"example","text":"Buenas noches. Dulces sueños.","note":"طاب مساؤك. أحلام سعيدة."},{"btype":"example","text":"Espera aquí hasta que vuelva.","note":"إنتظر هنا حتى أعود."},{"btype":"example","text":"Buenas noches y dulces sueños.","note":"ليلة سعيدة و أحلام أسعد."},{"btype":"example","text":"Tus invitados están esperando.","note":"ضيوفك ينتظرون."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Tenemos invitados.","ar":"لدينا ضيوف."},{"t":"Sólo quince minutos.","ar":"خمس عشرة دقيقة فقط."},{"t":"¡Qué extraña es la vida!","ar":"ما أغرب الحياة!"},{"t":"Tom extraña a su esposa.","ar":"توم يفتقد لزوجته."},{"t":"El pie tiene cinco dedos.","ar":"للقدم خمسة أصابع."},{"t":"Una mano tiene cinco dedos.","ar":"لليد خمسة أصابع."},{"t":"Buenas noches. Dulces sueños.","ar":"طاب مساؤك. أحلام سعيدة."},{"t":"Espera aquí hasta que vuelva.","ar":"إنتظر هنا حتى أعود."},{"t":"Buenas noches y dulces sueños.","ar":"ليلة سعيدة و أحلام أسعد."},{"t":"Tus invitados están esperando.","ar":"ضيوفك ينتظرون."},{"t":"Mi padre sólo tiene quince años.","ar":"عمر أبي خمسةَ عشر عامً