ío.","ar":"كان يسكن بجانب عمه."},{"t":"De niño, Bob vivía en Boston.","ar":"عاش بوب طفولته في بوسطن."},{"t":"Escucha lo que tengo que decir.","ar":"اسمع لما عندي ان اقول."},{"t":"¿A qué hora te vas a dormir a diario?","ar":"متى تنام؟"},{"t":"El ruso es muy difícil para aprender.","ar":"اللغة الروسية صعبة جدًا للتعلم."},{"t":"La paciencia es la madre de la ciencia.","ar":"الصبر أُمُّ العلوم."},{"t":"El profesor de la escuela de conducir dice que debería tener más paciencia.","ar":"معلمي في القيادة يقول بأني يجب أن أكون صبوراً أكثر من ذلك."},{"t":"A Linda le encanta el chocolate.","ar":"لندا تحب الشوكولاتة."},{"t":"¿Conoces a alguien en Australia?","ar":"أتعرف أحدًا في أستراليا؟"},{"t":"Fue divertido jugar en el parque.","ar":"كان اللعب في الحديقة ممتعا."},{"t":"Llama a un médico inmediatamente.","ar":"اتّصل بطبيب في الحال!"},{"t":"Estará aquí en cualquier segundo.","ar":"سيكون هنا في أي ثانية"},{"t":"¿Ha estado alguna vez en Londres?","ar":"هل سبق لك أن ذهبت إلى لندن؟"}],"focus":["diario","matar","escucha","paciencia","acabar","vivía","oí","hielo","ruso","creen"],"words":[{"word":"diario","topic":"L125","difficulty":2,"meaning":"يَوْمِيّ","example":"Tengo tu diario.","translation":"دفتر يومياتك عندي."},{"word":"matar","topic":"L125","difficulty":2,"meaning":"قَتَلَ"},{"word":"escucha","topic":"L125","difficulty":2,"meaning":"اِسْتِمَاع","example":"Escucha a Tom.","translation":"استمع إلى توم"},{"word":"paciencia","topic":"L125","difficulty":2,"meaning":"صَبْر","example":"En todo caso ten paciencia.","translation":"أهم شيء أن تكن صبوراً."},{"word":"acabar","topic":"L125","difficulty":2,"meaning":"اِنْتَهَى، أَنْهَى"},{"word":"hielo","topic":"L125","difficulty":2,"meaning":"جَلِيد","example":"Es tan frío como el hielo.","translation":"بارد كالثلج."},{"word":"ruso","topic":"L125","difficulty":2,"meaning":"رُوسِيّ، الرُّوسِيَّة","example":"¿Hablas ruso?","translation":"هل تتكلم الروسية؟"}],"difficulty":2}}