{"theory":{"blocks":[{"btype":"text","text":"الدرس 131. الكلمات الجديدة: darte، empezando، difíciles، consigo، esperamos، cortó، asuntos، intento، escritor، durmió."},{"btype":"example","text":"darte = أَعْطَى","note":"صيغة من dar (المصدر)؛ مثال: Tienes que darte prisa. — عليك أن تسرع."},{"btype":"example","text":"empezando = بَدَأَ","note":"صيغة من empezar (صيغة المصدر الجاري)"},{"btype":"example","text":"difíciles = صَعْب","note":"صيغة من difícil (الجمع)"},{"btype":"example","text":"consigo = اِسْتَلَمَ","note":"صيغة من conseguir (المتكلّم، المضارع)؛ مثال: No consigo recordar su nombre. — ما أقدر أتذكر اسمها."},{"btype":"example","text":"esperamos = أَمَلَ","note":"صيغة من esperar (الجمع، المتكلّم، الماضي التامّ)"},{"btype":"example","text":"cortó = قَطَعَ، جَرَحَ","note":"صيغة من cortar (الغائب، الماضي التامّ)؛ مثال: Tom le cortó el pelo a Mary. — قص توم شعر ماري."},{"btype":"example","text":"asuntos = أَمْر، قَضِيَّة","note":"صيغة من asunto (الجمع)"},{"btype":"example","text":"intento = مُحَاوَلَة","note":"مثال: Intento dormir. — أحاول النوم."},{"btype":"example","text":"escritor = كَاتِب","note":"مثال: Él se gana la vida como escritor. — يكسب قوته بالكتابة."},{"btype":"example","text":"durmió = نَامَ","note":"صيغة من dormir (الغائب، الماضي التامّ)؛ مثال: Él durmió en la cama. — كان ينام في الفراش."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Intento dormir.","note":"أحاول النوم."},{"btype":"example","text":"Él durmió en la cama.","note":"كان ينام في الفراش."},{"btype":"example","text":"Él durmió en el coche.","note":"لقد نام في السيارة."},{"btype":"example","text":"Tienes que darte prisa.","note":"عليك أن تسرع."},{"btype":"example","text":"Yo tengo algo que darte.","note":"لدي شيء أقدمه لك."},{"btype":"example","text":"No tengo nada para darte.","note":"لا شيء معي لأعطيك إياه."},{"btype":"example","text":"Tom le cortó el pelo a Mary.","note":"قص توم شعر ماري."},{"btype":"example","text":"Él se durmió a las diez ayer.","note":"هو نام في الساعة العاشرة أمس."},{"btype":"example","text":"No consigo recordar su nombre.","note":"ما أقدر أتذكر اسمها."},{"btype":"example","text":"Mi hermano durmió en el jardín.","note":"نام أخي في البستان."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Intento dormir.","ar":"أحاول النوم."},{"t":"Él durmió en la cama.","ar":"كان ينام في الفراش."},{"t":"Él durmió en el coche.","ar":"لقد نام في السيارة."},{"t":"Tienes que darte prisa.","ar":"عليك أن تسرع."},{"t":"Yo tengo algo que darte.","ar":"لدي شيء أقدمه لك."},{"t":"No tengo nada para darte.","ar":"لا شيء معي لأعطيك إياه."},{"t":"Tom le cortó el pelo a Mary.","ar":"قص توم شعر ماري."},{"t":"Él se durmió a las diez ayer.","ar":"هو نام في الساعة العاشرة أمس."},{"t":"No consigo recordar su nombre.","ar":"ما أقدر أتذكر اسمها."},{"t":"Mi hermano durmió en el jardín.","ar":"نام أخي في البستان."},{"t":"Ella se durmió a las diez ayer.","ar":"هي نامت في الساعة العاشرة أمس."},{"t":"Él se gana la vida como escritor.","ar":"يكسب قوته بالكتابة."},{"t":"Olvidé darte lo que Tom me dio para darte a ti.","ar":"أنا نسيت أن أعطيك ما أعطانيه توم لأعطيه لك."}],"focus":["darte","empezando","difíciles","consigo","esperamos","cortó",