{"theory":{"blocks":[{"btype":"text","text":"الدرس 133. الكلمات الجديدة: podés، abre، alegría، carrera، programa، últimos، fondo، mirar، sacar، inteligencia."},{"btype":"example","text":"podés = جَزَّ","note":"صيغة من podar (المخاطب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Podés usar mi bicicleta. — يمكنك استخدام دراجتي."},{"btype":"example","text":"abre = فَتَحَ، اِنْفَتَحَ","note":"صيغة من abrir (الغائب، المضارع)؛ مثال: Abre la bolsa. — افتح الكيس."},{"btype":"example","text":"alegría = سُرُور","note":""},{"btype":"example","text":"carrera = سِبَاق","note":"مثال: Ella salió del cuarto de una carrera. — خرجت من غرفتها مسرعة."},{"btype":"example","text":"programa = بَرْنَامَج","note":"مثال: ¿Cuál es su programa de televisión favorito? — ما هو برنامجك التلفزيوني المفضل؟"},{"btype":"example","text":"últimos = آخِر، مَاضٍ","note":"صيغة من último (الجمع، المذكّر)؛ مثال: No te hemos visto en los últimos cuatro años. — لم يرك أحد منذ أربع سنوات."},{"btype":"example","text":"fondo = قَاع","note":"مثال: ¡Hasta el fondo! — الى القاع ."},{"btype":"example","text":"mirar = نَظَرَ","note":"مثال: Deja de mirar. — كف عن التحديق."},{"btype":"example","text":"sacar = حَجَزَ","note":"مثال: No olvides sacar la basura. — لا تنس إخراج القمامة."},{"btype":"example","text":"inteligencia = ذَكَاء، جِهَاز مُخَابَرَات","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Abre la bolsa.","note":"افتح الكيس."},{"btype":"example","text":"Deja de mirar.","note":"كف عن التحديق."},{"btype":"example","text":"¡Abre la puerta!","note":"افتح الباب."},{"btype":"example","text":"Abre la ventana.","note":"افتح النافذة."},{"btype":"example","text":"¡Hasta el fondo!","note":"الى القاع ."},{"btype":"example","text":"Podés usar mi bicicleta.","note":"يمكنك استخدام دراجتي."},{"btype":"example","text":"Podés venir con nosotros.","note":"أنتِ يمكنكِ أن تأتي معنا."},{"btype":"example","text":"No olvides sacar la basura.","note":"لا تنس إخراج القمامة."},{"btype":"example","text":"Abre la boca y cierra los ojos.","note":"افتح فمك وأغلق عينيك."},{"btype":"example","text":"Me gusta mirar a niños jugando.","note":"أحب أن أشاهد الأطفال يلعبون."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Abre la bolsa.","ar":"افتح الكيس."},{"t":"Deja de mirar.","ar":"كف عن التحديق."},{"t":"¡Abre la puerta!","ar":"افتح الباب."},{"t":"Abre la ventana.","ar":"افتح النافذة."},{"t":"¡Hasta el fondo!","ar":"الى القاع ."},{"t":"Podés usar mi bicicleta.","ar":"يمكنك استخدام دراجتي."},{"t":"Podés venir con nosotros.","ar":"أنتِ يمكنكِ أن تأتي معنا."},{"t":"No olvides sacar la basura.","ar":"لا تنس إخراج القمامة."},{"t":"Abre la boca y cierra los ojos.","ar":"افتح فمك وأغلق عينيك."},{"t":"Me gusta mirar a niños jugando.","ar":"أحب أن أشاهد الأطفال يلعبون."},{"t":"Esta es la llave que abre esa puerta.","ar":"هذا هو المفتاح الذي يفتح الباب."},{"t":"Ella salió del cuarto de una carrera.","ar":"خرجت من غرفتها مسرعة."},{"t":"¿Cuál es su progr