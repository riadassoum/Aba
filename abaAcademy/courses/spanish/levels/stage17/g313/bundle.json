{"theory":{"blocks":[{"btype":"text","text":"الدرس 313. الكلمات الجديدة: empiece، negativo، preciso، enseñaré، marcas، añade، abriendo، suenan، vestir، resultan، sabrá، sonando، soñado."},{"btype":"example","text":"empiece = نَجْمَة","note":""},{"btype":"example","text":"negativo = صُورَة سَالِبَة","note":""},{"btype":"example","text":"preciso = مَضْبُوط","note":"مثال: Es preciso. — هذا صحيح."},{"btype":"example","text":"enseñaré = عَلَّمَ","note":"صيغة من enseñar (المتكلّم، المستقبل)؛ مثال: Te enseñaré cómo conducir un carro. — سأعلمك كيف تقود السيارة."},{"btype":"example","text":"marcas = عَلَامَة، مَارْكَة","note":"صيغة من marca (الجمع)"},{"btype":"example","text":"añade = أَضَافَ","note":"صيغة من añadir (الغائب، المضارع)؛ مثال: Añade carne. — أضف اللحم."},{"btype":"example","text":"abriendo = فَتَحَ، اِنْفَتَحَ","note":"صيغة من abrir (صيغة المصدر الجاري)؛ مثال: Estoy abriendo una caja. — أفتح صندوقاً."},{"btype":"example","text":"suenan = صَوَّتَ","note":"صيغة من sonar (الجمع، الغائب، المضارع)"},{"btype":"example","text":"vestir = لَبِسَ","note":"مثال: Uno se debería vestir bien. — يجب على المرء أن يهندم نفسه جيداً."},{"btype":"example","text":"resultan = تَسَبَّب","note":"صيغة من resultar (الجمع، الغائب، المضارع)"},{"btype":"example","text":"sabrá = عَلِمَ، دَرَى","note":"صيغة من saber (الغائب، المستقبل)؛ مثال: Nadie sabrá. — لن يعرف أحد."},{"btype":"example","text":"sonando = صَوَّتَ","note":"صيغة من sonar (صيغة المصدر الجاري)"},{"btype":"example","text":"soñado = حَلَمَ","note":"صيغة من soñar (اسم المفعول (التصريف الثالث))؛ مثال: He soñado que era un pájaro. — تخيلت أني طير."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Es preciso.","note":"هذا صحيح."},{"btype":"example","text":"Añade carne.","note":"أضف اللحم."},{"btype":"example","text":"Nadie sabrá.","note":"لن يعرف أحد."},{"btype":"example","text":"Estoy abriendo una caja.","note":"أفتح صندوقاً."},{"btype":"example","text":"Uno se debería vestir bien.","note":"يجب على المرء أن يهندم نفسه جيداً."},{"btype":"example","text":"He soñado que era un pájaro.","note":"تخيلت أني طير."},{"btype":"example","text":"Te enseñaré cómo conducir un carro.","note":"سأعلمك كيف تقود السيارة."},{"btype":"example","text":"Si así lo deseas, te enseñaré a jugar ajedrez.","note":"إن أحببت، فسأعلمك كيف تلعب الشطرنج."},{"btype":"example","text":"Voy a la escuela cada mañana.","note":"أذهب إلى المدرسة كل صباح."},{"btype":"example","text":"Eso es porque eres una chica.","note":"هذا لأنكِ فتاة."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Es preciso.","ar":"هذا صحيح."},{"t":"Añade carne.","ar":"أضف اللحم."},{"t":"Nadie sabrá.","ar":"لن يعرف أحد."},{"t":"Estoy abriendo una caja.","ar":"أفتح صندوقاً."},{"t":"Uno se debería vestir bien.","ar":"يجب على المرء أن يهندم نفسه جيداً."},{"t":"He soñado que era un pájaro.","ar":"تخيلت أني طير."},{"t":"Te enseñaré cómo conducir un carro.","ar":"سأعلمك كيف تقود السيارة."},{"t":"Si así lo deseas