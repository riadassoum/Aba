{"theory":{"blocks":[{"btype":"text","text":"الدرس 361. الكلمات الجديدة: casaron، valla، miro، villa، condujo، acera، sientas، orgullosos، engañado، aventuras."},{"btype":"example","text":"casaron = زَوَّجَ، تَزَوَّجَ","note":"صيغة من casar (الجمع، الغائب، الماضي التامّ)؛ مثال: Se casaron hace tres meses. — تزوّجوا منذ ثلاثة أشهر."},{"btype":"example","text":"valla = حَاجِز، عَقَبَة","note":"مثال: Hay una valla alrededor de la casa. — هناك سياج حول المنزل."},{"btype":"example","text":"miro = نَظَرَ","note":"صيغة من mirar (المتكلّم، المضارع)"},{"btype":"example","text":"villa = فِيلَا","note":"مثال: Al fin llegamos a la villa. — و أخيراً وصلنا إلى القرية."},{"btype":"example","text":"condujo = قَادَ، سَاقَ","note":"صيغة من conducir (الغائب، الماضي التامّ)؛ مثال: Tom condujo el coche. — قاد توم السيارة."},{"btype":"example","text":"acera = رَصِيف","note":""},{"btype":"example","text":"sientas = مَقْعَد","note":"صيغة من sentar (المخاطب، المضارع)"},{"btype":"example","text":"orgullosos = فَخُور","note":"صيغة من orgulloso (الجمع، المذكّر)؛ مثال: Ellos están orgullosos de su hija. — إنهما فخوران بابنتهما."},{"btype":"example","text":"engañado = خَدَعَ","note":"صيغة من engañar (اسم المفعول (التصريف الثالث))؛ مثال: Te han engañado. — لقد خدعت."},{"btype":"example","text":"aventuras = مُخَاطَرَة، مُغَامَرَة","note":"صيغة من aventura (الجمع)؛ مثال: Él se fue de viaje en busca de aventuras. — سافر بحثاً عن مغامرة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Te han engañado.","note":"لقد خدعت."},{"btype":"example","text":"Tom condujo el coche.","note":"قاد توم السيارة."},{"btype":"example","text":"Tom condujo a Mary a casa.","note":"أوصل توم ماري إلى المنزل."},{"btype":"example","text":"Se casaron hace tres meses.","note":"تزوّجوا منذ ثلاثة أشهر."},{"btype":"example","text":"Al fin llegamos a la villa.","note":"و أخيراً وصلنا إلى القرية."},{"btype":"example","text":"Ellos están orgullosos de su hija.","note":"إنهما فخوران بابنتهما."},{"btype":"example","text":"Hay una valla alrededor de la casa.","note":"هناك سياج حول المنزل."},{"btype":"example","text":"Él se fue de viaje en busca de aventuras.","note":"سافر بحثاً عن مغامرة."},{"btype":"example","text":"Tengo un perro y un gato.","note":"أملك كلباً وقطة."},{"btype":"example","text":"Dios no es el más grande.","note":"الله ليس الأكبر."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Te han engañado.","ar":"لقد خدعت."},{"t":"Tom condujo el coche.","ar":"قاد توم السيارة."},{"t":"Tom condujo a Mary a casa.","ar":"أوصل توم ماري إلى المنزل."},{"t":"Se casaron hace tres meses.","ar":"تزوّجوا منذ ثلاثة أشهر."},{"t":"Al fin llegamos a la villa.","ar":"و أخيراً وصلنا إلى القرية."},{"t":"Ellos están orgullosos de su hija.","ar":"إنهما فخوران بابنتهما."},{"t":"Hay una valla alrededor de la casa.","ar":"هناك سياج حول المنزل."},{"t":"Él se fue de viaje en busca de aventuras.","ar":"سافر بحثاً عن مغامرة."},{"t":"Tengo un perro y un gato.","ar":"أملك كلباً وقطة."},{"t":"Dios no es el más grande.","ar":"الله ليس الأكبر."},{"t":"Deberías decir la verdad.","ar":"عليك أن تقول الحقيقة."},{"t":"Yo no trabajo para nadie.","ar":"أنا لا أعمل لأي أحد."}],"focus":["casaron","valla","miro","villa","condujo","acera","sientas","orgullosos","engañado","aventuras"],"words":[{"word":"valla","topic":"L361","difficulty":5,"meaning":"حَاجِز، عَقَبَة","example":"Hay una valla alrededor de la casa.","translation":"هناك سياج حول المنزل."},{"word":"villa","topic":"L361","difficulty":5,"meaning":"فِيلَا","example":"Al fin llegamos a la villa.","translation":"و أخيراً وصلنا إلى القرية."},{"word":"acera","topic":"L361","difficulty":5,"meaning":"رَصِيف"}],"difficulty":5}}