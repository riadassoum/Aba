{"theory":{"blocks":[{"btype":"text","text":"الدرس 248. الكلمات الجديدة: antiguos، amas، mata، realizar، verás، secretos، mantiene، deseos، alcanzó، trabajaba."},{"btype":"example","text":"antiguos = قَدِيم","note":"صيغة من antiguo (الجمع، المذكّر)؛ مثال: Me gusta aprender idiomas antiguos. — أُحب تعلم اللغات القديمة."},{"btype":"example","text":"amas = رَبَّة","note":"صيغة من ama (الجمع)؛ مثال: ¿Amas a tu madre? — ‫هل تحب أمك؟‬‎"},{"btype":"example","text":"mata = قَتَلَ","note":"صيغة من matar (الغائب، المضارع)"},{"btype":"example","text":"realizar = أَدْرَكَ، حَقَّقَ","note":""},{"btype":"example","text":"verás = رَأَى","note":"صيغة من ver (المخاطب، المستقبل)؛ مثال: Algún día me verás. — يوما ما، ستراني."},{"btype":"example","text":"secretos = سِرّ","note":"صيغة من secreto (الجمع، المذكّر)؛ مثال: Tom odia los secretos. — توم يكره الأسرار."},{"btype":"example","text":"mantiene = حَافَظَ","note":"صيغة من mantener (الغائب، المضارع)؛ مثال: Ella se mantiene en contacto con él. — هي تبقى على إتصال معه."},{"btype":"example","text":"deseos = أُمْنِيَّة","note":"صيغة من deseo (الجمع)؛ مثال: Tienes tres deseos. — لك ٣ أمنيات."},{"btype":"example","text":"alcanzó = أَصَابَ","note":"صيغة من alcanzar (الغائب، الماضي التامّ)؛ مثال: Él alcanzó la manzana. — مدّ يده إلى التفاحة."},{"btype":"example","text":"trabajaba = عَمِلَ","note":"صيغة من trabajar (الغائب، الماضي المستمرّ)؛ مثال: Entonces Sami no trabajaba. — لم يكن سامي يعمل آنذاك."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"¿Amas a tu madre?","note":"‫هل تحب أمك؟‬‎"},{"btype":"example","text":"¿De verdad me amas?","note":"أتحبني بحق؟"},{"btype":"example","text":"Algún día me verás.","note":"يوما ما، ستراني."},{"btype":"example","text":"Tienes tres deseos.","note":"لك ٣ أمنيات."},{"btype":"example","text":"Verás la diferencia.","note":"سترى الفرق."},{"btype":"example","text":"Tom odia los secretos.","note":"توم يكره الأسرار."},{"btype":"example","text":"Él alcanzó la manzana.","note":"مدّ يده إلى التفاحة."},{"btype":"example","text":"Tus deseos son órdenes.","note":"طلباتك أوامر."},{"btype":"example","text":"Yanni alcanzó su sueño.","note":"حقق ياني حلمه."},{"btype":"example","text":"Entonces Sami no trabajaba.","note":"لم يكن سامي يعمل آنذاك."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"¿Amas a tu madre?","ar":"‫هل تحب أمك؟‬‎"},{"t":"¿De verdad me amas?","ar":"أتحبني بحق؟"},{"t":"Algún día me verás.","ar":"يوما ما، ستراني."},{"t":"Tienes tres deseos.","ar":"لك ٣ أمنيات."},{"t":"Verás la diferencia.","ar":"سترى الفرق."},{"t":"Tom odia los secretos.","ar":"توم يكره الأسرار."},{"t":"Él alcanzó la manzana.","ar":"مدّ يده إلى التفاحة."},{"t":"Tus deseos son órdenes.","ar":"طلباتك أوامر."},{"t":"Yanni alcanzó su sueño.","ar":"حقق ياني حلمه."},{"t":"Entonces Sami no trabajaba.","ar":"لم يكن سامي يعمل آنذاك."},{"t":"¿Podrías decirme por qué la amas?","ar":"أيمكنك إخباري عن سبب حبك لها؟"},{"t":"Me gusta aprender idiomas antiguos.","ar":"أُحب تعلم اللغات القديمة."},{"t":"Ella se mantiene en contacto con él.","ar":"هي تبقى على إتصال معه."},{"t":"Voy a añadir eso a mi lista de deseos.","ar":"سأضيف ذلك إلى قائمة أمنياتي."},{"t":"Ella siempre mantiene su cuar