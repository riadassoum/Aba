{"theory":{"blocks":[{"btype":"text","text":"الدرس 244. الكلمات الجديدة: equipaje، lograr، vela، aman، sienta، crea، horno، española، reconocer، aquellas."},{"btype":"example","text":"equipaje = أَمْتِعَة","note":""},{"btype":"example","text":"lograr = حَقَّقَ","note":"مثال: Ziri puede lograr eso. — بإمكان زيري إنجاز ذلك."},{"btype":"example","text":"vela = شَمْعَة","note":"مثال: Esta vela no es blanca. — ليست هذه شمعة بيضاء."},{"btype":"example","text":"aman = أَحَبَّ","note":"صيغة من amar (الجمع، الغائب، المضارع)؛ مثال: Todos la aman. — الكل يحبها."},{"btype":"example","text":"sienta = مَقْعَد","note":"صيغة من sentar (الغائب، المضارع)؛ مثال: Ese vestido te sienta bien. — ذلك الفستان يبدو جميلاً عليك."},{"btype":"example","text":"crea = خَلَقَ","note":"صيغة من crear (الغائب، المضارع)"},{"btype":"example","text":"horno = فُرْن","note":"مثال: Hay pan en el horno. — يوجد خبز في الفرن."},{"btype":"example","text":"española = إِسْبَانِيّ","note":"مثال: La casa de papel es la mejor serie española. — البروفيسور هو أفضل مسلسل إسباني."},{"btype":"example","text":"reconocer = تَعَرَّفَ","note":"مثال: Tienes que reconocer este hecho. — عليك أن تعترف بهذا الأمر."},{"btype":"example","text":"aquellas = ذَاكَ، اَلَّذِي","note":"صيغة من aquel (الجمع، المؤنث)؛ مثال: Conozco a aquellas chicas. — أعرف أولئك الفتيات."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Todos la aman.","note":"الكل يحبها."},{"btype":"example","text":"Ellos se aman.","note":"يحبان بعضهما."},{"btype":"example","text":"Todos lo aman.","note":"الكل يحبونه."},{"btype":"example","text":"¿Ellos se aman?","note":"أتحبان بعضكما؟"},{"btype":"example","text":"Hay pan en el horno.","note":"يوجد خبز في الفرن."},{"btype":"example","text":"Ziri puede lograr eso.","note":"بإمكان زيري إنجاز ذلك."},{"btype":"example","text":"Esta vela no es blanca.","note":"ليست هذه شمعة بيضاء."},{"btype":"example","text":"Conozco a aquellas chicas.","note":"أعرف أولئك الفتيات."},{"btype":"example","text":"Ese vestido te sienta bien.","note":"ذلك الفستان يبدو جميلاً عليك."},{"btype":"example","text":"Los padres aman a sus hijos.","note":"الآباء يحبون أولادهم."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Todos la aman.","ar":"الكل يحبها."},{"t":"Ellos se aman.","ar":"يحبان بعضهما."},{"t":"Todos lo aman.","ar":"الكل يحبونه."},{"t":"¿Ellos se aman?","ar":"أتحبان بعضكما؟"},{"t":"Hay pan en el horno.","ar":"يوجد خبز في الفرن."},{"t":"Ziri puede lograr eso.","ar":"بإمكان زيري إنجاز ذلك."},{"t":"Esta vela no es blanca.","ar":"ليست هذه شمعة بيضاء."},{"t":"Conozco a aquellas chicas.","ar":"أعرف أولئك الفتيات."},{"t":"Ese vestido te sienta bien.","ar":"ذلك الفستان يبدو جميلاً عليك."},{"t":"Los padres aman a sus hijos.","ar":"الآباء يحبون أولادهم."},{"t":"Tienes que reconocer este hecho.","ar":"عليك أن تعترف بهذا الأمر."},{"t":"La casa de papel es la mejor serie española.","ar":"البروفيسور هو أفضل مسلسل إسباني."}],"focus":["equipaje","lograr","vela",