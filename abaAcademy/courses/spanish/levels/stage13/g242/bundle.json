{"theory":{"blocks":[{"btype":"text","text":"الدرس 242. الكلمات الجديدة: tráeme، pimienta، ratas، escrita، crece، cuya، mutuamente، cumplió، bienvenidos، largos."},{"btype":"example","text":"tráeme = أَحْضَرَ","note":"صيغة من traer (المخاطب، الأمر)؛ مثال: Tráeme mi ropa. — أحضر لي ملابسي."},{"btype":"example","text":"pimienta = فِلْفِل","note":""},{"btype":"example","text":"ratas = جُرَذ","note":"صيغة من rata (الجمع)"},{"btype":"example","text":"escrita = تَزَلُّج، شِفْنِين","note":"مثال: La carta fue escrita. — كُتبت الرّسالة."},{"btype":"example","text":"crece = نَمَى","note":"صيغة من crecer (الغائب، المضارع)"},{"btype":"example","text":"cuya = اَلَّذِي","note":""},{"btype":"example","text":"mutuamente = بَعْضُهُ الْبَعْض","note":"مثال: Mis padres se aman mutuamente. — أبواي يتحابان."},{"btype":"example","text":"cumplió = أَدَّى","note":"صيغة من cumplir (الغائب، الماضي التامّ)؛ مثال: Cumplió ochenta y uno. — أصبح عمرها واحداً و ثمانين سنة."},{"btype":"example","text":"bienvenidos = أَهْلًا وَسَهْلًا","note":"مثال: ¡Bienvenidos! — أهلًا وسهلًا!"},{"btype":"example","text":"largos = طَوِيل","note":"صيغة من largo (الجمع، المذكّر)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"¡Bienvenidos!","note":"أهلًا وسهلًا!"},{"btype":"example","text":"Tráeme mi ropa.","note":"أحضر لي ملابسي."},{"btype":"example","text":"Tráeme algo de comer.","note":"أحضر لي شيئاً لآكله."},{"btype":"example","text":"La carta fue escrita.","note":"كُتبت الرّسالة."},{"btype":"example","text":"Cumplió ochenta y uno.","note":"أصبح عمرها واحداً و ثمانين سنة."},{"btype":"example","text":"Tráeme una silla, por favor.","note":"أحضر لي كرسياً من فضلك."},{"btype":"example","text":"Mis padres se aman mutuamente.","note":"أبواي يتحابان."},{"btype":"example","text":"Tráeme el periódico, por favor.","note":"أحضر لي الجريدة من فضلك."},{"btype":"example","text":"Tráeme una taza de café, ¿quieres?","note":"أحضر لي فنجاناً من القهوة؟"},{"btype":"example","text":"Tráeme el periódico de hoy, por favor.","note":"من فضلك أحضر لي جريدة اليوم."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"¡Bienvenidos!","ar":"أهلًا وسهلًا!"},{"t":"Tráeme mi ropa.","ar":"أحضر لي ملابسي."},{"t":"Tráeme algo de comer.","ar":"أحضر لي شيئاً لآكله."},{"t":"La carta fue escrita.","ar":"كُتبت الرّسالة."},{"t":"Cumplió ochenta y uno.","ar":"أصبح عمرها واحداً و ثمانين سنة."},{"t":"Tráeme una silla, por favor.","ar":"أحضر لي كرسياً من فضلك."},{"t":"Mis padres se aman mutuamente.","ar":"أبواي يتحابان."},{"t":"Tráeme el periódico, por favor.","ar":"أحضر لي الجريدة من فضلك."},{"t":"Tráeme una taza de café, ¿quieres?","ar":"أحضر لي فنجاناً من القهوة؟"},{"t":"Tráeme el periódico de hoy, por favor.","ar":"من فضلك أحضر لي جريدة اليوم."},{"t":"¿Esta carta debe ser escrita en inglés?","ar":"هل يجب ان تُكتْب هذه الرسالة بالإنجليزية"}],"focus":["tráeme","pimienta","ratas","escrita","crece","cuya","mutuamente","cumplió","bienvenidos","largos"],"words":[{"w