{"theory":{"blocks":[{"btype":"text","text":"المضارع (presente): formar (شَكَّلَ)، llegar (وَصَلَ)، caminar (مَشَى)، esperar (أَمَلَ)، dormir (نَامَ)، dejar (تَرَكَ)، llevar (أَخَذَ)، quedar (مَكَثَ)، jugar (لَعِبَ)، escribir (َأَلَّف، كَتَبَ)."},{"btype":"example","text":"formar","note":"yo formo، tú formas، él/ella/usted forma، nosotros formamos، vosotros formáis، ellos/ustedes forman"},{"btype":"example","text":"llegar","note":"yo llego، tú llegas، él/ella/usted llega، nosotros llegamos، vosotros llegáis، ellos/ustedes llegan"},{"btype":"example","text":"caminar","note":"yo camino، tú caminas، él/ella/usted camina، nosotros caminamos، vosotros camináis، ellos/ustedes caminan"},{"btype":"example","text":"esperar","note":"yo espero، tú esperas، él/ella/usted espera، nosotros esperamos، vosotros esperáis، ellos/ustedes esperan"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":10,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"lang.conjugate","count":6,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","verbs":[{"infinitive":"formar","meaning":"شَكَّلَ","tense":"المضارع (presente)","forms":{"yo":"formo","tú":"formas","él/ella/usted":"forma","nosotros":"formamos","vosotros":"formáis","ellos/ustedes":"forman"},"difficulty":2},{"infinitive":"llegar","meaning":"وَصَلَ","tense":"المضارع (presente)","forms":{"yo":"llego","tú":"llegas","él/ella/usted":"llega","nosotros":"llegamos","vosotros":"llegáis","ellos/ustedes":"llegan"},"difficulty":2},{"infinitive":"caminar","meaning":"مَشَى","tense":"المضارع (presente)","forms":{"yo":"camino","tú":"caminas","él/ella/usted":"camina","nosotros":"caminamos","vosotros":"camináis","ellos/ustedes":"caminan"},"difficulty":2},{"infinitive":"esperar","meaning":"أَمَلَ","tense":"المضارع (presente)","forms":{"yo":"espero","tú":"esperas","él/ella/usted":"espera","nosotros":"