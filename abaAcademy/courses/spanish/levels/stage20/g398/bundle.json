{"theory":{"blocks":[{"btype":"text","text":"الدرس 398. الكلمات الجديدة: cuchillos، prestas، inconsciente، comercio، ahorros، exige، seguiré، atreves، permanente، tarjetas."},{"btype":"example","text":"cuchillos = سِكِّين، خَنْجَر","note":"صيغة من cuchillo (الجمع)"},{"btype":"example","text":"prestas = يالا بنا","note":"صيغة من presto (الجمع، المؤنث)؛ مثال: ¿Me prestas tu cuchillo? — أيمكنني أن أستعير سِكّينَك؟"},{"btype":"example","text":"inconsciente","note":"مثال: Ella está inconsciente. — إنّها فاقدة الوعي."},{"btype":"example","text":"comercio = تِجَارَة","note":"مثال: La compañía está por el libre comercio. — الشركة تدعم التجارة الحرة."},{"btype":"example","text":"ahorros = مُدَخَرَات","note":"مثال: Si tenemos problemas de dinero siempre podemos echar mano de nuestros ahorros. — اذا كانت لدينا مشاكل مالية ، نستطيع دائماً الاستعانة بمدخراتنا."},{"btype":"example","text":"exige = طَلَبَ","note":"صيغة من exigir (الغائب، المضارع)؛ مثال: Exige lo mejor. — أصِرَّ على الأفضل."},{"btype":"example","text":"seguiré = تَبِعَ، خَلَفَ","note":"صيغة من seguir (المتكلّم، المستقبل)"},{"btype":"example","text":"atreves","note":"مثال: ¡Cómo te atreves! — كيف تجرؤ؟"},{"btype":"example","text":"permanente = دَائِم","note":""},{"btype":"example","text":"tarjetas = بِطَاقَة","note":"صيغة من tarjeta (الجمع)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Exige lo mejor.","note":"أصِرَّ على الأفضل."},{"btype":"example","text":"¡Cómo te atreves!","note":"كيف تجرؤ؟"},{"btype":"example","text":"Ella está inconsciente.","note":"إنّها فاقدة الوعي."},{"btype":"example","text":"¿Me prestas tu cuchillo?","note":"أيمكنني أن أستعير سِكّينَك؟"},{"btype":"example","text":"¿Me prestas tu bicicleta?","note":"هل بإمكاني استعارة دراجتك؟"},{"btype":"example","text":"¿Me prestas tu diccionario?","note":"أيمكنك أن تعيرني قاموسك؟"},{"btype":"example","text":"¿Cómo te atreves a decir eso?","note":"كيف تجرؤ أن تقول ذلك؟"},{"btype":"example","text":"¿Me prestas tu auto esta noche?","note":"هل يُمكنني استعارة سيارتك لهذه الليلة؟"},{"btype":"example","text":"¿Cómo te atreves a decirme algo así?","note":"كيف تجرؤ على قول شيء كهذا لي؟"},{"btype":"example","text":"La compañía está por el libre comercio.","note":"الشركة تدعم التجارة الحرة."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Exige lo mejor.","ar":"أصِرَّ على الأفضل."},{"t":"¡Cómo te atreves!","ar":"كيف تجرؤ؟"},{"t":"Ella está inconsciente.","ar":"إنّها فاقدة الوعي."},{"t":"¿Me prestas tu cuchillo?","ar":"أيمكنني أن أستعير سِكّينَك؟"},{"t":"¿Me prestas tu bicicleta?","ar":"هل بإمكاني استعارة دراجتك؟"},{"t":"¿Me prestas tu diccionario?","ar":"أيمكنك أن تعيرني قاموسك؟"},{"t":"¿Cómo te atreves a decir eso?","ar":"كيف تجرؤ أن تقول ذلك؟"},{"t":"¿Me prestas tu auto esta noche?","ar":"هل يُمكنني استعارة سيارتك لهذه الليلة؟"},{"t":"¿Cómo te atreves a decirme algo así?","ar":"كيف تجرؤ على قول شيء كهذا لي؟"},{"t":"La compañía está por el libre comercio.","ar":"ال