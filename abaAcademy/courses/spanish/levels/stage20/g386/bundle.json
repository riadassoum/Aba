{"theory":{"blocks":[{"btype":"text","text":"الدرس 386. الكلمات الجديدة: ignoró، pides، corazones، impresionado، confuso، ponerlo، idiotas، oírlo، despertado، limpias."},{"btype":"example","text":"ignoró = تَجَاهَلَ","note":"صيغة من ignorar (الغائب، الماضي التامّ)"},{"btype":"example","text":"pides = سَأَلَ","note":"صيغة من pedir (المخاطب، المضارع)؛ مثال: Me pides que haga lo imposible. — أنت تطلب مني أن أفعل المستحيل."},{"btype":"example","text":"corazones = كُبَّا","note":""},{"btype":"example","text":"impresionado","note":"مثال: Estaba impresionado. — كنتُ متعجِّبا."},{"btype":"example","text":"confuso = اِرْتَبَكَ","note":"مثال: Estoy confuso. — انا محتار."},{"btype":"example","text":"ponerlo = وَضَعَ","note":"صيغة من poner (المصدر)؛ مثال: Puedes ponerlo en cualquier sitio. — بإمكانك وضعها في أي مكان."},{"btype":"example","text":"idiotas = أَحْمَق","note":"صيغة من idiota (الجمع)؛ مثال: Ustedes son idiotas. — أنتم أغباء."},{"btype":"example","text":"oírlo = سَمِعَ، سَمِع","note":"صيغة من oír (المصدر)؛ مثال: Apenas puedo oírlo. — لا أكاد أسمعه."},{"btype":"example","text":"despertado = أَيْقَظَ","note":"صيغة من despertar (اسم المفعول (التصريف الثالث))؛ مثال: Te he despertado. — لقد أيقظتُك."},{"btype":"example","text":"limpias = نَظِيف","note":"صيغة من limpio (الجمع، المؤنث)؛ مثال: ¿Tienes las manos limpias? — هل يداك نظيفتان؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Estoy confuso.","note":"انا محتار."},{"btype":"example","text":"Te he despertado.","note":"لقد أيقظتُك."},{"btype":"example","text":"Tom parece confuso.","note":"يبدو توم في حيرة."},{"btype":"example","text":"Apenas puedo oírlo.","note":"لا أكاد أسمعه."},{"btype":"example","text":"Estaba impresionado.","note":"كنتُ متعجِّبا."},{"btype":"example","text":"Ustedes son idiotas.","note":"أنتم أغباء."},{"btype":"example","text":"¿Qué te ha despertado?","note":"ما الذي أيقظك؟"},{"btype":"example","text":"¿Tienes las manos limpias?","note":"هل يداك نظيفتان؟"},{"btype":"example","text":"Me pides que haga lo imposible.","note":"أنت تطلب مني أن أفعل المستحيل."},{"btype":"example","text":"Puedes ponerlo en cualquier sitio.","note":"بإمكانك وضعها في أي مكان."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Estoy confuso.","ar":"انا محتار."},{"t":"Te he despertado.","ar":"لقد أيقظتُك."},{"t":"Tom parece confuso.","ar":"يبدو توم في حيرة."},{"t":"Apenas puedo oírlo.","ar":"لا أكاد أسمعه."},{"t":"Estaba impresionado.","ar":"كنتُ متعجِّبا."},{"t":"Ustedes son idiotas.","ar":"أنتم أغباء."},{"t":"¿Qué te ha despertado?","ar":"ما الذي أيقظك؟"},{"t":"¿Tienes las manos limpias?","ar":"هل يداك نظيفتان؟"},{"t":"Me pides que haga lo imposible.","ar":"أنت تطلب مني أن أفعل المستحيل."},{"t":"Puedes ponerlo en cualquier sitio.","ar":"بإمكانك وضعها في أي مكان."},{"t":"¿Por qué no te disculpas y pides perdón?","ar":"لم لا تعتذر و تطلب منه أن يسامحك؟"}],"focus":["ignoró","pides","corazones","impresionado","confuso","ponerlo","idiotas","oírlo","despertado","limpias"],"words":[{"word":"corazones","topic":"L386","difficulty":5,"meaning":"كُبَّا"},{"word":"confuso","topic":"L386","difficulty":5,"meaning":"اِرْتَبَكَ","example":"Estoy confuso.","translation":"ا