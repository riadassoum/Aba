{"theory":{"blocks":[{"btype":"text","text":"الدرس 252. الكلمات الجديدة: llamamos، produjo، tierras، bola، tomes، entrevista، trabajamos، altas، guerras، consigue، salen، compraré."},{"btype":"example","text":"llamamos = دَعَا، اِتَّصَلَ بِـ","note":"صيغة من llamar (الجمع، المتكلّم، الماضي التامّ)؛ مثال: Lo llamamos Mike. — نناديه مايك."},{"btype":"example","text":"produjo = صَنَعَ","note":"صيغة من producir (الغائب، الماضي التامّ)؛ مثال: Anoche se produjo un fuego. — اندلع حريق الليلة الماضية."},{"btype":"example","text":"tierras = تُرْبَة","note":"صيغة من tierra (الجمع)"},{"btype":"example","text":"bola = كُرَة","note":"مثال: Tiró la bola. — رمى الكرة."},{"btype":"example","text":"tomes = أَخَذَ","note":"صيغة من tomar (المخاطب، صيغة الالتماس (الشرطية)، المضارع)"},{"btype":"example","text":"entrevista = مُقَابَلَة","note":"مثال: ¿Cómo te fue en la entrevista? — كيف كانت المقابلة؟"},{"btype":"example","text":"trabajamos = عَمِلَ","note":"صيغة من trabajar (الجمع، المتكلّم، الماضي التامّ)؛ مثال: Trabajamos en una fábrica. — نعمل في مصنع."},{"btype":"example","text":"altas = عَالٍ","note":"صيغة من alto (الجمع، المؤنث)"},{"btype":"example","text":"guerras = حَرْب","note":"صيغة من guerra (الجمع)"},{"btype":"example","text":"consigue = اِسْتَلَمَ","note":"صيغة من conseguir (الغائب، المضارع)؛ مثال: Nada se consigue sin esfuerzo. — لا إنجاز بلا جهد ."},{"btype":"example","text":"salen = مَلَّحَ","note":"صيغة من salar (الجمع، الغائب، صيغة الالتماس (الشرطية))"},{"btype":"example","text":"compraré = اِشْتَرَى","note":"صيغة من comprar (المتكلّم، المستقبل)؛ مثال: Lo compraré. — سأشتري ذلك."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Lo compraré.","note":"سأشتري ذلك."},{"btype":"example","text":"Tiró la bola.","note":"رمى الكرة."},{"btype":"example","text":"Lo llamamos Mike.","note":"نناديه مايك."},{"btype":"example","text":"Le compraré un lápiz.","note":"سأشتري له قلماً."},{"btype":"example","text":"Trabajamos en una fábrica.","note":"نعمل في مصنع."},{"btype":"example","text":"Anoche se produjo un fuego.","note":"اندلع حريق الليلة الماضية."},{"btype":"example","text":"¿Cómo te fue en la entrevista?","note":"كيف كانت المقابلة؟"},{"btype":"example","text":"Nada se consigue sin esfuerzo.","note":"لا إنجاز بلا جهد ."},{"btype":"example","text":"Le compraré un reloj a mi hijo.","note":"سأشتري ساعةً لابني."},{"btype":"example","text":"Se produjo un incendio cerca de mi casa.","note":"اندلع حريق قرب منزلي."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Lo compraré.","ar":"سأشتري ذلك."},{"t":"Tiró la bola.","ar":"رمى الكرة."},{"t":"Lo llamamos Mike.","ar":"نناديه مايك."},{"t":"Le compraré un lápiz.","ar":"سأشتري له قلماً."},{"t":"Trabajamos en una fábrica.","ar":"نعمل في مصنع."},{"t":"Anoche se produjo un fuego.","ar":"اندلع حريق الليلة الماضية."},{"t":"¿Cómo te fue en la entrevista?","ar":"كيف كانت المقابلة؟"},{"t":"Nada se consigue sin esfuerzo.","ar":"لا إنجاز بلا جهد ."},{"t":"Le compraré un reloj a mi hijo.","ar":"سأشتري ساعةً لابني."},{"t":"Se produjo un incendio cerca de mi casa.","ar":"اندلع حريق قرب منزلي."}],"focus":["llamamos","produjo","tierras","bola","tomes","entrevista","trabajamos","altas","guer