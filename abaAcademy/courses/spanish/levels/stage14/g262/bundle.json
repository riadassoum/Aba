{"theory":{"blocks":[{"btype":"text","text":"الدرس 262. الكلمات الجديدة: ausente، practicar، hablemos، familiar، juzgar، descubierto، contenta، meter، darse، iban."},{"btype":"example","text":"ausente = غَائِب، شارِد","note":"مثال: Tom está ausente. — توم غائب."},{"btype":"example","text":"practicar = تَدْرِيب","note":""},{"btype":"example","text":"hablemos = تَكَلَّمَ","note":"صيغة من hablar (الجمع، المتكلّم، صيغة الالتماس (الشرطية))؛ مثال: Hablemos en inglés. — لنتحدث بالإنجليزية."},{"btype":"example","text":"familiar = مَأْلُوف","note":"مثال: Me pareces familiar. — تبدو مألوفاً."},{"btype":"example","text":"juzgar = حَاكَمَ","note":"مثال: No puedes juzgar a una persona si no la conoces bien. — لا تستطيع الحكم على شخص إن لم تعرفه جيدا."},{"btype":"example","text":"descubierto = اِكْتَشَفَ","note":"صيغة من descubrir (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"contenta = فَرِح","note":"صيغة من contento (المؤنث)؛ مثال: ¿Estás contenta? — هل أنت سعيدة؟"},{"btype":"example","text":"meter = إِصَابَة، دَرَجَة","note":"مثال: No puedo meter ruido. La bebé está durmiendo. — أنا لا أستطيع أن أضج. ينام الطفل."},{"btype":"example","text":"darse = أَعْطَى","note":"صيغة من dar (المصدر)"},{"btype":"example","text":"iban = ذَهَبَ","note":"صيغة من ir (الجمع، الغائب، الماضي المستمرّ)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"¿Estás contenta?","note":"هل أنت سعيدة؟"},{"btype":"example","text":"Tom está ausente.","note":"توم غائب."},{"btype":"example","text":"Yo estaba ausente.","note":"كنت غائبا."},{"btype":"example","text":"Hablemos en inglés.","note":"لنتحدث بالإنجليزية."},{"btype":"example","text":"Me pareces familiar.","note":"تبدو مألوفاً."},{"btype":"example","text":"Yanni estaba ausente.","note":"كان ياني غائبا."},{"btype":"example","text":"Estaré ausente mañana.","note":"سأغيب غداً."},{"btype":"example","text":"¿Hay alguien ausente hoy?","note":"هل غاب أحد اليوم؟"},{"btype":"example","text":"Hablemos de por qué estás aquí.","note":"لنتحدث عن سبب وجودك هنا."},{"btype":"example","text":"No puedo meter ruido. La bebé está durmiendo.","note":"أنا لا أستطيع أن أضج. ينام الطفل."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"¿Estás contenta?","ar":"هل أنت سعيدة؟"},{"t":"Tom está ausente.","ar":"توم غائب."},{"t":"Yo estaba ausente.","ar":"كنت غائبا."},{"t":"Hablemos en inglés.","ar":"لنتحدث بالإنجليزية."},{"t":"Me pareces familiar.","ar":"تبدو مألوفاً."},{"t":"Yanni estaba ausente.","ar":"كان ياني غائبا."},{"t":"Estaré ausente mañana.","ar":"سأغيب غداً."},{"t":"¿Hay alguien ausente hoy?","ar":"هل غاب أحد اليوم؟"},{"t":"Hablemos de por qué estás aquí.","ar":"لنتحدث عن سبب وجودك هنا."},{"t":"No puedo meter ruido. La bebé está durmiendo.","ar":"أنا لا أستطيع أن أضج. ينام الطفل."},{"t":"No puedes juzgar a una persona si no la conoces bien.","ar":"لا تستطيع الحكم على شخص إن لم تعرفه جيدا."}],"focus":["ausente","practicar","hablemos","familiar","juzgar","descubierto","