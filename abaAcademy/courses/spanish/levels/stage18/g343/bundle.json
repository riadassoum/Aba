":["vendedor","estantería","crecido","prometido","collar","empezamos","alcance","cogí","sentirse","pasto"],"words":[{"word":"vendedor","topic":"L343","difficulty":5,"meaning":"بَيَّاع"},{"word":"estantería","topic":"L343","difficulty":5,"meaning":"مَكْتَبَة","example":"Él puso el libro en la estantería.","translation":"وضع الكتاب على الرف."},{"word":"prometido","topic":"L343","difficulty":5,"meaning":"خَطِيب","example":"Él hizo lo que había prometido hacer.","translation":"لقد فعل ما وعد ان يقوم به"},{"word":"collar","topic":"L343","difficulty":5,"meaning":"قِلَادَة"},{"word":"alcance","topic":"L343","difficulty":5,"meaning":"مدى"},{"word":"sentirse","topic":"L343","difficulty":5,"meaning":"شَعَرَ بِ","example":"Empezó a sentirse mal.","translation":"بدأ يشعر بالمرض."},{"word":"pasto","topic":"L343","difficulty":5,"meaning":"حَشِيش","example":"Hay que cortar el pasto.","translation":"يحتاج العشب إلى التشذيب."}],"difficulty":5}}