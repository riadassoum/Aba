{"theory":{"blocks":[{"btype":"text","text":"الدرس 439. الكلمات الجديدة: corrige، tijera، suceden، hembra، besando، juzgues، huelo، sentirás، oyendo، suaves."},{"btype":"example","text":"corrige = صَحَّحَ","note":"صيغة من corregir (الغائب، المضارع)؛ مثال: Corrige los errores. — صحّح الأخطاء."},{"btype":"example","text":"tijera = مِقَصّ","note":""},{"btype":"example","text":"suceden = حَدَثَ","note":"صيغة من suceder (الجمع، الغائب، المضارع)؛ مثال: Los accidentes suceden. — إنّ الحوادث تحدث."},{"btype":"example","text":"hembra = أُنْثَى","note":""},{"btype":"example","text":"besando = قَبَّلَ","note":"صيغة من besar (صيغة المصدر الجاري)؛ مثال: Tom está besando a Mary. — توم يقبل ماري."},{"btype":"example","text":"juzgues = حَاكَمَ","note":"صيغة من juzgar (المخاطب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: No juzgues por las apariencias. — لا تحكم بظواهر الأمور."},{"btype":"example","text":"huelo = شَمَّ، شَمَّمَ","note":"صيغة من oler (المتكلّم، المضارع)؛ مثال: Huelo a gas. — أنا أشم الغاز."},{"btype":"example","text":"sentirás = شَعَرَ","note":"صيغة من sentir (المخاطب، المستقبل)"},{"btype":"example","text":"oyendo = سَمِعَ، سَمِع","note":"صيغة من oír (صيغة المصدر الجاري)؛ مثال: ¿Me estás oyendo? — هل تستمع؟"},{"btype":"example","text":"suaves = نَاعِم","note":"صيغة من suave (الجمع)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Huelo a gas.","note":"أنا أشم الغاز."},{"btype":"example","text":"¿Me estás oyendo?","note":"هل تستمع؟"},{"btype":"example","text":"Corrige los errores.","note":"صحّح الأخطاء."},{"btype":"example","text":"Los accidentes suceden.","note":"إنّ الحوادث تحدث."},{"btype":"example","text":"Tom está besando a Mary.","note":"توم يقبل ماري."},{"btype":"example","text":"¿Estás oyendo lo que digo?","note":"هل تسمع ما أقول ؟"},{"btype":"example","text":"No juzgues por las apariencias.","note":"لا تحكم بظواهر الأمور."},{"btype":"example","text":"Por favor corrige mi pronunciación.","note":"صحح نطقي من فضلك."},{"btype":"example","text":"Corrige los errores, si es que hay.","note":"صَحِح الأخطاء, إذا كان هناك أي منها."},{"btype":"example","text":"Él escribió un libro sobre China.","note":"كتب كتاباً عن الصين."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Huelo a gas.","ar":"أنا أشم الغاز."},{"t":"¿Me estás oyendo?","ar":"هل تستمع؟"},{"t":"Corrige los errores.","ar":"صحّح الأخطاء."},{"t":"Los accidentes suceden.","ar":"إنّ الحوادث تحدث."},{"t":"Tom está besando a Mary.","ar":"توم يقبل ماري."},{"t":"¿Estás oyendo lo que digo?","ar":"هل تسمع ما أقول ؟"},{"t":"No juzgues por las apariencias.","ar":"لا تحكم بظواهر الأمور."},{"t":"Por favor corrige mi pronunciación.","ar":"صحح نطقي من فضلك."},{"t":"Corrige los errores, si es que hay.","ar":"صَحِح الأخطاء, إذا كان هناك أي منها."},{"t":"Él escribió un libro sobre China.","ar":"كتب كتاباً عن الصين."},{"t":"Los animales son nuestros amigos.","ar":"الحيوانات أصدقاؤنا."},{"t":"No entiendo lo que quieres decir.","ar":"لا أفهم ما تقصده."}],"focus":["corrige","tijera","suceden","hembra","besando","juzgues","huelo","sentirás","oyendo","suaves"],"words":[{"word":"tijera","topic":"L439","difficulty":3,"meaning":"مِقَصّ"},{"word":"hembra","topic":"L439","