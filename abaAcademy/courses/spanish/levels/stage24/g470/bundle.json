{"theory":{"blocks":[{"btype":"text","text":"الدرس 470. الكلمات الجديدة: Polo، fase، soñó، arrepentirás، felizmente، escúchame، frecuentes، Gabriel، principiante، quedaste."},{"btype":"example","text":"Polo = قُطْب","note":""},{"btype":"example","text":"fase = مَرْحَلَة","note":""},{"btype":"example","text":"soñó = حَلَمَ","note":"صيغة من soñar (الغائب، الماضي التامّ)؛ مثال: Tom soñó acerca de Mary. — حلم توم بماري."},{"btype":"example","text":"arrepentirás = تَابَ","note":"صيغة من arrepentirse (المخاطب، المستقبل)؛ مثال: ¡Ya te arrepentirás de ello! — ستندم على ذلك!"},{"btype":"example","text":"felizmente = بِسَعَادَة","note":"مثال: Nancy sonrió felizmente. — ابتسمت نانسي بسعادة."},{"btype":"example","text":"escúchame = أَصْغَى، أَنْصَتَ","note":"صيغة من escuchar (المخاطب، الأمر)؛ مثال: Escúchame. — استمع إلي"},{"btype":"example","text":"frecuentes = مُتَكَرِّر","note":"صيغة من frecuente (الجمع)؛ مثال: Los terremotos son frecuentes en Japón. — تضرب الزلازل اليابان بكثرة."},{"btype":"example","text":"Gabriel = جِبْرِيل","note":""},{"btype":"example","text":"principiante = مُبْتَدِئ","note":"مثال: Él es un principiante. — إنهُ مبتدىء."},{"btype":"example","text":"quedaste = مَكَثَ","note":"صيغة من quedar (المخاطب، الماضي التامّ)؛ مثال: ¿Por qué te quedaste? — لم بقيت؟"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Escúchame.","note":"استمع إلي"},{"btype":"example","text":"¿Por qué te quedaste?","note":"لم بقيت؟"},{"btype":"example","text":"Él es un principiante.","note":"إنهُ مبتدىء."},{"btype":"example","text":"Tom soñó acerca de Mary.","note":"حلم توم بماري."},{"btype":"example","text":"Nancy sonrió felizmente.","note":"ابتسمت نانسي بسعادة."},{"btype":"example","text":"Deja de hablar y escúchame.","note":"اسكت و اسمعني."},{"btype":"example","text":"¡Ya te arrepentirás de ello!","note":"ستندم على ذلك!"},{"btype":"example","text":"¿Por qué te quedaste ayer en casa?","note":"لماذا بقيت في المنزل بالأمس."},{"btype":"example","text":"Los terremotos son frecuentes en Japón.","note":"تضرب الزلازل اليابان بكثرة."},{"btype":"example","text":"¡Tenemos muy poco tiempo, así que escúchame bien!","note":"ليس لدينا الكثير من الوقت لذا أنصت لي جيدا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Escúchame.","ar":"استمع إلي"},{"t":"¿Por qué te quedaste?","ar":"لم بقيت؟"},{"t":"Él es un principiante.","ar":"إنهُ مبتدىء."},{"t":"Tom soñó acerca de Mary.","ar":"حلم توم بماري."},{"t":"Nancy sonrió felizmente.","ar":"ابتسمت نانسي بسعادة."},{"t":"Deja de hablar y escúchame.","ar":"اسكت و اسمعني."},{"t":"¡Ya te arrepentirás de ello!","ar":"ستندم على ذلك!"},{"t":"¿Por qué te quedaste ayer en casa?","ar":"لماذا بقيت في المنزل بالأمس."},{"t":"Los terremotos son frecuentes en Japón.","ar":"تضرب الزلازل اليابان بكثرة."},{"t":"¡Tenemos muy poco tiempo, así que escúchame bien!","ar":"ليس لدينا الكثير من الوقت لذا أنصت لي جيدا."},{"t":"Hace mucho, mucho tiempo en India, un mono, un zorro y un cone