{"theory":{"blocks":[{"btype":"text","text":"الدرس 436. الكلمات الجديدة: abandonan، civiles، apretar، noción، dijisteis، fortalece، envío، golpeando، ayudaste، molestarte، déjala، creativa."},{"btype":"example","text":"abandonan = تَرَكَ","note":"صيغة من abandonar (الجمع، الغائب، المضارع)"},{"btype":"example","text":"civiles = مَدَنِيّ","note":"صيغة من civil (الجمع)"},{"btype":"example","text":"apretar = شَدَّ","note":"مثال: Sólo tienes que apretar el botón. — ماعليك إلا أن تضغط على الزر."},{"btype":"example","text":"noción = مَفْهُوم","note":"مثال: Perdí la noción del tiempo. — لَقَد نَسَيتُ فِكْرَةَ اْلزَّمَنِ."},{"btype":"example","text":"dijisteis = أَخْبَرَ","note":"صيغة من decir (الجمع، المخاطب، الماضي التامّ)؛ مثال: ¿Qué dijisteis ayer? — ماذا قلت أمس؟"},{"btype":"example","text":"fortalece = قَوَّى","note":"صيغة من fortalecer (الغائب، المضارع)؛ مثال: Lo que no me mata, me fortalece. — ما لا يقتلني يجعلني أقوى."},{"btype":"example","text":"envío = أَرْسَلَ","note":"صيغة من enviar (المتكلّم، المضارع)"},{"btype":"example","text":"golpeando = ضَرَبَ","note":"صيغة من golpear (صيغة المصدر الجاري)؛ مثال: Tom está golpeando a Mary. — توم يضرب ماري."},{"btype":"example","text":"ayudaste = سَاعَدَ","note":"صيغة من ayudar (المخاطب، الماضي التامّ)؛ مثال: Nos ayudaste. — لقد ساعدتنا."},{"btype":"example","text":"molestarte = أزْعَجَ","note":"صيغة من molestar (المصدر)"},{"btype":"example","text":"déjala = تَرَكَ","note":"صيغة من dejar (المخاطب، الأمر)؛ مثال: ¡Déjala irse! — دعها تذهب!"},{"btype":"example","text":"creativa = إِبْداعِيّ","note":"صيغة من creativo (المؤنث)؛ مثال: Sé creativa. — كوني مبدعة."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sé creativa.","note":"كوني مبدعة."},{"btype":"example","text":"Nos ayudaste.","note":"لقد ساعدتنا."},{"btype":"example","text":"¡Déjala irse!","note":"دعها تذهب!"},{"btype":"example","text":"¿Qué dijisteis ayer?","note":"ماذا قلت أمس؟"},{"btype":"example","text":"Tom está golpeando a Mary.","note":"توم يضرب ماري."},{"btype":"example","text":"Perdí la noción del tiempo.","note":"لَقَد نَسَيتُ فِكْرَةَ اْلزَّمَنِ."},{"btype":"example","text":"Lo que no me mata, me fortalece.","note":"ما لا يقتلني يجعلني أقوى."},{"btype":"example","text":"Sólo tienes que apretar el botón.","note":"ماعليك إلا أن تضغط على الزر."},{"btype":"example","text":"Tengo algunas preguntas para ti.","note":"لدي بعض الأسئلة لك."},{"btype":"example","text":"Estoy estudiando varios idiomas.","note":"أنا أدرس عدّة لغات."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Sé creativa.","ar":"كوني مبدعة."},{"t":"Nos ayudaste.","ar":"لقد ساعدتنا."},{"t":"¡Déjala irse!","ar":"دعها تذهب!"},{"t":"¿Qué dijisteis ayer?","ar":"ماذا قلت أمس؟"},{"t":"Tom está golpeando a Mary.","ar":"توم يضرب ماري."},{"t":"Perdí la noción del tiempo.","ar":"لَقَد نَسَيتُ فِكْرَةَ اْلزَّمَنِ."},{"t":"Lo que no me mata, me fortalece.","ar":"ما لا يقتلني يجعلني أقوى."},{"t":"Sólo tienes que apretar el botón.","ar":"ماعليك إلا أن تضغط على الزر."},{"t":"Tengo algunas preguntas para ti.","ar":"لدي بعض الأسئلة لك."},{"t":"Estoy estudiando varios idiomas.","ar":"أنا أدرس عدّة لغات."},{"t":"Piensa antes de hacer las cosas.","ar":"