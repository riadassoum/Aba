{"theory":{"blocks":[{"btype":"text","text":"الدرس 216. الكلمات الجديدة: descubrir، principalmente، teme، profunda، oficial، petróleo، apellido، robar، pasos، locos، habilidad، billetera، oeste."},{"btype":"example","text":"descubrir = اِكْتَشَفَ","note":""},{"btype":"example","text":"principalmente = غَالِبًا","note":""},{"btype":"example","text":"teme = خَافَ","note":"صيغة من temer (الغائب، المضارع)"},{"btype":"example","text":"profunda = عَمِيق","note":"صيغة من profundo (المؤنث)"},{"btype":"example","text":"oficial = رَسْمِيّ، مَسْؤُول","note":""},{"btype":"example","text":"petróleo = نَفْط","note":""},{"btype":"example","text":"apellido = لَقَب","note":""},{"btype":"example","text":"robar = سَرَقَ","note":"مثال: Robar es malo. — السرقة خطأ."},{"btype":"example","text":"pasos = طَريق","note":"صيغة من paso (الجمع، المذكّر)"},{"btype":"example","text":"locos = مَجْنُون","note":"صيغة من loco (الجمع، المذكّر)"},{"btype":"example","text":"habilidad = قُدْرَة، مَوْهِبَة","note":"مثال: El hombre tiene la habilidad de hablar. — الإنسان لديه القدرة على الكلام."},{"btype":"example","text":"billetera = مِحْفَظَة","note":"مثال: Alguien me robó la billetera. — أحدهم سرق محفظتي."},{"btype":"example","text":"oeste = غَرْب","note":"مثال: El sol se pone en el oeste. — تغرب الشمس في الغرب."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Robar es malo.","note":"السرقة خطأ."},{"btype":"example","text":"El sol se pone en el oeste.","note":"تغرب الشمس في الغرب."},{"btype":"example","text":"Alguien me robó la billetera.","note":"أحدهم سرق محفظتي."},{"btype":"example","text":"Ayer me robaron mi billetera.","note":"سُرقت محفظتي بالأمس."},{"btype":"example","text":"La isla está al oeste de Japón.","note":"تقع الجزيرة على غرب اليابان."},{"btype":"example","text":"La estación está al oeste del hotel.","note":"تقع المحطة غرب الفندق."},{"btype":"example","text":"El hombre tiene la habilidad de hablar.","note":"الإنسان لديه القدرة على الكلام."},{"btype":"example","text":"A él se le cayó su billetera, y ahora es mía.","note":"أوقع محفظته و الآن هي ملكي."},{"btype":"example","text":"Lo que está en cuestión no es su habilidad sino su carácter.","note":"ليست المشكلة في قدرته، بل في شخصيته."},{"btype":"example","text":"Cuando llegué a casa, me di cuenta de que había perdido la billetera.","note":"عندما عدت إلى المنزل ، اكتشفت أني أضعت محفظتي."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Robar es malo.","ar":"السرقة خطأ."},{"t":"El sol se pone en el oeste.","ar":"تغرب الشمس في الغرب."},{"t":"Alguien me robó la billetera.","ar":"أحدهم سرق محفظتي."},{"t":"Ayer me robaron mi billetera.","ar":"سُرقت محفظتي بالأمس."},{"t":"La isla está al oeste de Japón.","ar":"تقع الجزيرة على غرب اليابان."},{"t":"La estación está al oeste del hotel.","ar":"تقع المحطة غرب الفندق."},{"t":"El hombre tiene la habilidad de hablar.","ar":"الإنسان لديه القدرة على الكلام."},{"t":"A él se le cayó su billetera, y ahora es mía.",