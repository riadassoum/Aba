 es el punto más profundo del lago.","ar":"هذه أعمق نقطة في البحيرة."},{"t":"¿Ella irá a los Estados Unidos el año próximo?","ar":"هل ستذهب إلى أمريكا العام المقبل؟"}],"focus":["prohibido","hecha","irá","semejante","enseguida","conversación","japonesa","armas","enseñar","profundo"],"words":[{"word":"prohibido","topic":"L168","difficulty":3,"meaning":"مَمْنُوع","example":"Prohibido nadar.","translation":"ممنوع السباحة"},{"word":"hecha","topic":"L168","difficulty":3,"meaning":"عَمَل، وَثِيقَة"},{"word":"semejante","topic":"L168","difficulty":3,"meaning":"مِثْل"},{"word":"enseguida","topic":"L168","difficulty":3,"meaning":"حَالاً","example":"Enseguida estoy contigo.","translation":"سأكون معك حالًا."},{"word":"conversación","topic":"L168","difficulty":3,"meaning":"مُحَادَثَة","example":"Sami terminó la conversación.","translation":"أنهى سامي الحوار."},{"word":"japonesa","topic":"L168","difficulty":3,"meaning":"يَابَانِيّ","example":"¿Eres japonesa?","translation":"هل أنت يبانية؟"},{"word":"armas","topic":"L168","difficulty":3,"meaning":"سِلَاح"},{"word":"enseñar","topic":"L168","difficulty":3,"meaning":"عَلَّمَ","example":"Enseñar es aprender.","translation":"التعليم تعلم."},{"word":"profundo","topic":"L168","difficulty":3,"meaning":"عَمِيق","example":"El lago es muy profundo.","translation":"البحيرة عميقة جداً."}],"difficulty":3}}