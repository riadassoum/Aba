{"theory":{"blocks":[{"btype":"text","text":"الدرس 158. الكلمات الجديدة: juez، hermosas، des، visitado، llovió، mono، vea، regaló، amarilla، acabas."},{"btype":"example","text":"juez = قَاضٍ","note":""},{"btype":"example","text":"hermosas = جَمِيل","note":"صيغة من hermoso (الجمع، المؤنث)؛ مثال: Las estrellas son hermosas. — النجوم جميلة."},{"btype":"example","text":"des = مِنْ، لِـ","note":"صيغة من de (الجمع)؛ مثال: No des de comer al perro. — لا تُطعم الكلب."},{"btype":"example","text":"visitado = زَارَ","note":"صيغة من visitar (اسم المفعول (التصريف الثالث))"},{"btype":"example","text":"llovió = أَمْطَرَ","note":"صيغة من llover (الغائب، الماضي التامّ)؛ مثال: Llovió toda la noche. — لقد امطرت طوال الليل"},{"btype":"example","text":"mono = سَعْدَان","note":"مثال: ¿Quién hizo el mono de nieve? — من صنع رجل الثلج ذاك؟"},{"btype":"example","text":"vea = رَأَى","note":"صيغة من ver (الغائب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: No dejes que él vea esta película. — لا تدعه يشاهد هذا الفيلم."},{"btype":"example","text":"regaló = أَهْدَى","note":"صيغة من regalar (الغائب، الماضي التامّ)؛ مثال: Mi papá me regaló un juego. — أعطاني أبي لعبةً."},{"btype":"example","text":"amarilla = أَصْفَر","note":"صيغة من amarillo (المؤنث)؛ مثال: Aquí hay una rosa amarilla. — هذه وردة صفراء."},{"btype":"example","text":"acabas = اِنْتَهَى، أَنْهَى","note":"صيغة من acabar (المخاطب، المضارع)"},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Llovió toda la noche.","note":"لقد امطرت طوال الليل"},{"btype":"example","text":"No des de comer al perro.","note":"لا تُطعم الكلب."},{"btype":"example","text":"Las estrellas son hermosas.","note":"النجوم جميلة."},{"btype":"example","text":"El mes pasado llovió mucho.","note":"أمطرت كثيراً الشهر الماضي ."},{"btype":"example","text":"Mi papá me regaló un juego.","note":"أعطاني أبي لعبةً."},{"btype":"example","text":"Aquí hay una rosa amarilla.","note":"هذه وردة صفراء."},{"btype":"example","text":"Será mejor que te des prisa.","note":"من الأفضل لك أن تسرع."},{"btype":"example","text":"Mi tío me regaló una cámara.","note":"أعطاني عمي كاميرا."},{"btype":"example","text":"Mi tío me regaló este reloj.","note":"عَمّي أعطاني هذه السّاعة."},{"btype":"example","text":"¿Quién hizo el mono de nieve?","note":"من صنع رجل الثلج ذاك؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Llovió toda la noche.","ar":"لقد امطرت طوال الليل"},{"t":"No des de comer al perro.","ar":"لا تُطعم الكلب."},{"t":"Las estrellas son hermosas.","ar":"النجوم جميلة."},{"t":"El mes pasado llovió mucho.","ar":"أمطرت كثيراً الشهر الماضي ."},{"t":"Mi papá me regaló un juego.","ar":"أعطاني أبي لعبةً."},{"t":"Aquí hay una rosa amarilla.","ar":"هذه وردة صفراء."},{"t":"Será mejor que te des prisa.","ar":"من الأفضل لك أن تسرع."},{"t":"Mi tío me regaló una cámara.","ar":"أعطاني عمي كاميرا."},{"t":"Mi tío me regaló este reloj.","ar":"عَمّي أعطاني هذه السّاعة."},{"t":"¿Quién hizo el mono de nieve?","ar":"من صنع رجل الثلج ذاك؟"},{"t":"No dejes que él vea esta película.","ar":"لا تدعه يشاهد هذا الفيلم."}],"focus":["juez","hermosas","des","visitado","llovió","mono","vea","regaló","amarilla","acabas"],"words":[{"word":"juez","topic":"L158","d