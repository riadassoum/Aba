{"theory":{"blocks":[{"btype":"text","text":"الدرس 161. الكلمات الجديدة: verás، deseos، trabajaba، ratones، paredes، acercó، negras، quedaré، echa، nadando."},{"btype":"example","text":"verás = رَأَى","note":"صيغة من ver (المخاطب، المستقبل)؛ مثال: Algún día me verás. — يوما ما، ستراني."},{"btype":"example","text":"deseos = أُمْنِيَّة","note":"صيغة من deseo (الجمع)؛ مثال: Tus deseos son órdenes. — طلباتك أوامر."},{"btype":"example","text":"trabajaba = عَمِلَ","note":"صيغة من trabajar (الغائب، الماضي المستمرّ)؛ مثال: Entonces Sami no trabajaba. — لم يكن سامي يعمل آنذاك."},{"btype":"example","text":"ratones = فَأْرَة","note":"صيغة من ratón (الجمع)"},{"btype":"example","text":"paredes = جِدَار، حَائِط","note":"صيغة من pared (الجمع)"},{"btype":"example","text":"acercó = قَرُبَ","note":"صيغة من acercar (الغائب، الماضي التامّ)؛ مثال: Sami se acercó. — اقترب سامي أكثر."},{"btype":"example","text":"negras = زِنْجِيّ، أَسْوَد","note":"صيغة من negro (الجمع، المؤنث)؛ مثال: Mira esas nubes negras. — أنظر إلى تلك الغيوم السوداء."},{"btype":"example","text":"quedaré = مَكَثَ","note":"صيغة من quedar (المتكلّم، المستقبل)؛ مثال: Me quedaré en casa. — سأبقى في البيت."},{"btype":"example","text":"echa = طَرَدَ","note":"صيغة من echar (الغائب، المضارع)"},{"btype":"example","text":"nadando = سَبَحَ","note":"صيغة من nadar (صيغة المصدر الجاري)؛ مثال: El niño está nadando con sus amigos. — الصبي يسبح مع أصدقائه."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Sami se acercó.","note":"اقترب سامي أكثر."},{"btype":"example","text":"Algún día me verás.","note":"يوما ما، ستراني."},{"btype":"example","text":"Me quedaré en casa.","note":"سأبقى في البيت."},{"btype":"example","text":"Verás la diferencia.","note":"سترى الفرق."},{"btype":"example","text":"Tus deseos son órdenes.","note":"طلباتك أوامر."},{"btype":"example","text":"Mira esas nubes negras.","note":"أنظر إلى تلك الغيوم السوداء."},{"btype":"example","text":"Me quedaré hasta la tarde.","note":"سأبقى حتى المساء."},{"btype":"example","text":"Entonces Sami no trabajaba.","note":"لم يكن سامي يعمل آنذاك."},{"btype":"example","text":"Ziri se acercó a la puerta.","note":"اقترب زيري من الباب."},{"btype":"example","text":"Solo me quedaré algunos días.","note":"سأبقى لعدة أيام فحسب."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Sami se acercó.","ar":"اقترب سامي أكثر."},{"t":"Algún día me verás.","ar":"يوما ما، ستراني."},{"t":"Me quedaré en casa.","ar":"سأبقى في البيت."},{"t":"Verás la diferencia.","ar":"سترى الفرق."},{"t":"Tus deseos son órdenes.","ar":"طلباتك أوامر."},{"t":"Mira esas nubes negras.","ar":"أنظر إلى تلك الغيوم السوداء."},{"t":"Me quedaré hasta la tarde.","ar":"سأبقى حتى المساء."},{"t":"Entonces Sami no trabajaba.","ar":"لم يكن سامي يعمل آنذاك."},{"t":"Ziri se acercó a la puerta.","ar":"اقترب زيري من الباب."},{"t":"Solo me quedaré algunos días.","ar":"سأبقى لعدة أيام فحسب."},{"t":"Me quedaré allí hasta las seis.","ar":"سأبقى هناك حتى الساعة السادسة."},{"t":"Me quedaré hasta que se vaya Tom.","ar":"سأظل حتى يرحل توم."},{"t":"El niño está nadando con sus amigos.","ar":"الصبي يسبح مع أصدقائه."},{"t":"Si llueve mañana, me quedaré en casa.","ar":"إذا أمطرت غداً سأبقى ف