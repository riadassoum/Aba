{"theory":{"blocks":[{"btype":"text","text":"الدرس 95. الكلمات الجديدة: sois، cartas، público، piso، diferente، grupo، parecen، digo، decisión، peso."},{"btype":"example","text":"sois = كَانَ، كَانَ هُوَ","note":"صيغة من ser (الجمع، المخاطب، المضارع)"},{"btype":"example","text":"cartas = رِسَالَة","note":"صيغة من carta (الجمع)؛ مثال: Ya he escrito tres cartas. — لقد كتبت ثلاث رسائل."},{"btype":"example","text":"público = عَامَّة","note":"مثال: ¿Hay algún teléfono público por acá? — هل هناك هاتف عمومي في هذه المنطقة؟"},{"btype":"example","text":"piso = أَرْضِيَّة، طَابِق","note":"مثال: La biblioteca está en el cuarto piso. — المكتبة في الطابق الرابع."},{"btype":"example","text":"diferente = مُخْتَلِف، آٰخَر","note":"مثال: Tengo una opinión diferente. — اعتقد خلاف ذلك."},{"btype":"example","text":"grupo = مَجْمُوعَة","note":""},{"btype":"example","text":"parecen = بَدَا","note":"صيغة من parecer (الجمع، الغائب، المضارع)؛ مثال: Algunos parecen estar de acuerdo contigo. — يبدو أن بعض الأناس يتفقون معك."},{"btype":"example","text":"digo = يعني","note":"مثال: ¡Yo sólo lo digo! — كنت أقول فحسب!"},{"btype":"example","text":"decisión = قَرَار","note":""},{"btype":"example","text":"peso = وَزْن، ثِقْل","note":"مثال: No tengo un peso. — ليس لدي مال."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"¡Yo sólo lo digo!","note":"كنت أقول فحسب!"},{"btype":"example","text":"No tengo un peso.","note":"ليس لدي مال."},{"btype":"example","text":"Haz lo que te digo.","note":"افعل كما أقول"},{"btype":"example","text":"Tom, lo digo en serio.","note":"أنا جادٌّ يا توم."},{"btype":"example","text":"Lo que digo es la verdad.","note":"ما أقوله حقيقة."},{"btype":"example","text":"Yo digo esto del corazón.","note":"أقول ذلك من قلبي."},{"btype":"example","text":"Ya he escrito tres cartas.","note":"لقد كتبت ثلاث رسائل."},{"btype":"example","text":"Tengo una opinión diferente.","note":"اعتقد خلاف ذلك."},{"btype":"example","text":"Él cree todo lo que le digo.","note":"هو يصدق أى شئ أقوله."},{"btype":"example","text":"¿Tienes una opinión diferente?","note":"هل عندك رأي مختلف؟"}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"¡Yo sólo lo digo!","ar":"كنت أقول فحسب!"},{"t":"No tengo un peso.","ar":"ليس لدي مال."},{"t":"Haz lo que te digo.","ar":"افعل كما أقول"},{"t":"Tom, lo digo en serio.","ar":"أنا جادٌّ يا توم."},{"t":"Lo que digo es la verdad.","ar":"ما أقوله حقيقة."},{"t":"Yo digo esto del corazón.","ar":"أقول ذلك من قلبي."},{"t":"Ya he escrito tres cartas.","ar":"لقد كتبت ثلاث رسائل."},{"t":"Tengo una opinión diferente.","ar":"اعتقد خلاف ذلك."},{"t":"Él cree todo lo que le digo.","ar":"هو يصدق أى شئ أقوله."},{"t":"¿Tienes una opinión diferente?","ar":"هل عندك رأي مختلف؟"},{"t":"Tom está jugando cartas con Mary.","ar":"توم يلعب الورق مع ماري."},{"t":"¿Quién escribe cartas hoy en día?","ar":"من يكتب الرسائل اليوم؟"},{"t":"¿Hay algún teléfono público por acá?","ar":"هل هناك هاتف عمومي في هذه المنطقة؟"},{"t