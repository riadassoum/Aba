ne veinte años.","translation":"هي في العشرين من العمر."},{"word":"deseo","topic":"L88","difficulty":2,"meaning":"أُمْنِيَّة","example":"Deseo ver.","translation":"أتمنى أن أرى."},{"word":"duda","topic":"L88","difficulty":2,"meaning":"شَكّ، شُبْهَة","example":"¡Sin duda!","translation":"لا يوجد أسئلة حول هذا!"},{"word":"uso","topic":"L88","difficulty":2,"meaning":"اِسْتِعْمَال","example":"Yo uso Twitter.","translation":"أنا أستخدم تويتر."}],"difficulty":2}}