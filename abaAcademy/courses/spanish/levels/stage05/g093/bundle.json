{"theory":{"blocks":[{"btype":"text","text":"الدرس 93. الكلمات الجديدة: hablan، escribe، fuimos، azúcar، vuelto، prisa، delante، sistema، ordenador، estudiando."},{"btype":"example","text":"hablan = تَكَلَّمَ","note":"صيغة من hablar (الجمع، الغائب، المضارع)؛ مثال: Ellos no hablan español. — هم لا يتكلمون الإسبانية."},{"btype":"example","text":"escribe = َأَلَّف، كَتَبَ","note":"صيغة من escribir (الغائب، المضارع)؛ مثال: Escribe lo que sabes. — اُكْتُبْ ما تَعْرِفُهُ."},{"btype":"example","text":"fuimos = ذَهَبَ","note":"صيغة من ir (الجمع، المتكلّم، الماضي التامّ)؛ مثال: Fuimos a Boston. — نحن ذاهبون إلى بوسطن."},{"btype":"example","text":"azúcar = سُكَّر","note":"مثال: Estamos sin azúcar. — لم يعد لدينا سكر."},{"btype":"example","text":"vuelto = تَغَيَّرَƒ، غَيَّرَ","note":"مثال: ¿Te has vuelto loco? — هل أنت مجنونة؟"},{"btype":"example","text":"prisa = عَجَلَة","note":"مثال: No tengo prisa. — أنا لست مستعجلاً."},{"btype":"example","text":"delante","note":"مثال: Tienes aún toda la vida por delante. — ما زالت الحياة أمامك."},{"btype":"example","text":"sistema = نِظَام","note":"مثال: Es un sistema que funciona. — إنه نظامٌ يعمل."},{"btype":"example","text":"ordenador = حَاسُوب","note":"مثال: Tengo un ordenador. — عندي كمبيوتر."},{"btype":"example","text":"estudiando = ذَاكَرَ، دَرَسَ","note":"صيغة من estudiar (صيغة المصدر الجاري)؛ مثال: Estoy estudiando inglés. — أدرس اللغة الإنجليزية."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"No tengo prisa.","note":"أنا لست مستعجلاً."},{"btype":"example","text":"Fuimos a Boston.","note":"نحن ذاهبون إلى بوسطن."},{"btype":"example","text":"Nos fuimos en tren.","note":"غادرنا بالقطار."},{"btype":"example","text":"Estamos sin azúcar.","note":"لم يعد لدينا سكر."},{"btype":"example","text":"Tengo un ordenador.","note":"عندي كمبيوتر."},{"btype":"example","text":"Ya no tienen azúcar.","note":"الآن قد نَفِد السكر منهم."},{"btype":"example","text":"¿Te has vuelto loco?","note":"هل أنت مجنونة؟"},{"btype":"example","text":"Escribe lo que sabes.","note":"اُكْتُبْ ما تَعْرِفُهُ."},{"btype":"example","text":"¿Tienes un ordenador?","note":"هل تمتلك كمبيوتر؟"},{"btype":"example","text":"Este es mi ordenador.","note":"هٰذَا حَاسِبِيٌّ."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"No tengo prisa.","ar":"أنا لست مستعجلاً."},{"t":"Fuimos a Boston.","ar":"نحن ذاهبون إلى بوسطن."},{"t":"Nos fuimos en tren.","ar":"غادرنا بالقطار."},{"t":"Estamos sin azúcar.","ar":"لم يعد لدينا سكر."},{"t":"Tengo un ordenador.","ar":"عندي كمبيوتر."},{"t":"Ya no tienen azúcar.","ar":"الآن قد نَفِد السكر منهم."},{"t":"¿Te has vuelto loco?","ar":"هل أنت مجنونة؟"},{"t":"Escribe lo que sabes.","ar":"اُكْتُبْ ما تَعْرِفُهُ."},{"t":"¿Tienes un ordenador?","ar":"هل تمتلك كمبيوتر؟"},{"t":"Este es mi ordenador.","ar":"هٰذَا حَاسِبِيٌّ."},{"t":"Tom escribe una carta.","ar":"توم يكتب رسالة."},{"t":"El ordenador es nuevo.","ar":"الحاسوب جديد."},{"t":"Necesitamos más azúcar.","ar":"