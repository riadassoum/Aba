{"theory":{"blocks":[{"btype":"text","text":"الدرس 477. الكلمات الجديدة: negado، luto، aguarda، decí، dirían، horizontes، emparedado، pañal، sepultura، creerla، mueres."},{"btype":"example","text":"negado = نَفَى","note":"صيغة من negar (اسم المفعول (التصريف الثالث))؛ مثال: Ese hecho no puede ser negado. — لا يمكن إنكار الحقائق."},{"btype":"example","text":"luto = ثَوْبُ حِدَاد، حِدَاد","note":"مثال: Estamos de luto. — نحن في حداد."},{"btype":"example","text":"aguarda = اِنْتَظَرَ","note":"صيغة من aguardar (الغائب، المضارع)؛ مثال: Por favor, aguarda. — انتظر قليلاً."},{"btype":"example","text":"decí = أَخْبَرَ","note":"صيغة من decir (المخاطب، الأمر)؛ مثال: Decí la verdad. — قل الحقيقة"},{"btype":"example","text":"dirían = أَخْبَرَ","note":"صيغة من decir (الجمع، الغائب، الشرطي)؛ مثال: ¿Qué dirían ahora tus amigos si te vieran? — ماذا سيقول الآن أصدقاؤك إن رأوك؟"},{"btype":"example","text":"horizontes = أُفُق","note":"صيغة من horizonte (الجمع)"},{"btype":"example","text":"emparedado = سَانْدَوِيتْش","note":"مثال: ¿Qué tipo de emparedado quieres? — أي نوع من الشطائر تريد؟"},{"btype":"example","text":"pañal = حِفَاضة","note":"مثال: ¿Llevas pañal? — هل ترتدي حفاظة؟"},{"btype":"example","text":"sepultura = قَبْر","note":""},{"btype":"example","text":"creerla = صَدَّقَ، ظَنَّ","note":"صيغة من creer (المصدر)"},{"btype":"example","text":"mueres = مَاتَ","note":"صيغة من morir (المخاطب، المضارع)؛ مثال: Casi te mueres. — أنتَ تقريباً مت."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"¿Llevas pañal?","note":"هل ترتدي حفاظة؟"},{"btype":"example","text":"Decí la verdad.","note":"قل الحقيقة"},{"btype":"example","text":"Casi te mueres.","note":"أنتَ تقريباً مت."},{"btype":"example","text":"Estamos de luto.","note":"نحن في حداد."},{"btype":"example","text":"Por favor, aguarda.","note":"انتظر قليلاً."},{"btype":"example","text":"Ese hecho no puede ser negado.","note":"لا يمكن إنكار الحقائق."},{"btype":"example","text":"¿Qué tipo de emparedado quieres?","note":"أي نوع من الشطائر تريد؟"},{"btype":"example","text":"¿Qué dirían ahora tus amigos si te vieran?","note":"ماذا سيقول الآن أصدقاؤك إن رأوك؟"},{"btype":"example","text":"Nunca es demasiado tarde para empezar.","note":"ليس متأخراً جداً للبدء."},{"btype":"example","text":"Necesito saber por qué necesitas esto.","note":"يجب أن أعرف لماذا تحتاج هذا."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"¿Llevas pañal?","ar":"هل ترتدي حفاظة؟"},{"t":"Decí la verdad.","ar":"قل الحقيقة"},{"t":"Casi te mueres.","ar":"أنتَ تقريباً مت."},{"t":"Estamos de luto.","ar":"نحن في حداد."},{"t":"Por favor, aguarda.","ar":"انتظر قليلاً."},{"t":"Ese hecho no puede ser negado.","ar":"لا يمكن إنكار الحقائق."},{"t":"¿Qué tipo de emparedado quieres?","ar":"أي نوع من الشطائر تريد؟"},{"t":"¿Qué dirían ahora tus amigos si te vieran?","ar":"ماذا سيقول الآن أصدقاؤك إن رأوك؟"},{"t":"Nunca es demasiado tarde para empezar.","ar":"ليس متأخراً جداً للبدء."},{"t":"Necesito sa