{"theory":{"blocks":[{"btype":"text","text":"الدرس 489. الكلمات الجديدة: mismísimo، escondiste، prométeme، abres، estornudó، cacahuates، olvidarás، médicas، inesperadas، impreso."},{"btype":"example","text":"mismísimo = نَفْسُهُ","note":"صيغة من mismo (صيغة التفضيل العليا)؛ مثال: Este es el mismísimo libro que quería leer. — هذا هو الكتاب عينه الذي كنت أريد قراءته."},{"btype":"example","text":"escondiste = أَخْفَى","note":"صيغة من esconder (المخاطب، الماضي التامّ)؛ مثال: ¿Dónde los escondiste? — أين خبأتهم؟"},{"btype":"example","text":"prométeme = وَعَدَ","note":"صيغة من prometer (المخاطب، الأمر)"},{"btype":"example","text":"abres = فَتَحَ، اِنْفَتَحَ","note":"صيغة من abrir (المخاطب، المضارع)؛ مثال: ¿A qué hora abres? — في أي وقت تفتح المحل؟"},{"btype":"example","text":"estornudó = عَطَسَ","note":"صيغة من estornudar (الغائب، الماضي التامّ)؛ مثال: El mono estornudó. — عطس القرد."},{"btype":"example","text":"cacahuates = فُولٌ سُودَانِيٌّ","note":"صيغة من cacahuate (الجمع)"},{"btype":"example","text":"olvidarás = نَسِيَ","note":"صيغة من olvidar (المخاطب، المستقبل)؛ مثال: Me olvidarás algún día. — ستنسَني يوماً ما."},{"btype":"example","text":"médicas = طِبِّيّ","note":"صيغة من médico (الجمع، المؤنث)"},{"btype":"example","text":"inesperadas = مُفَاجِئ","note":"صيغة من inesperado (الجمع، المؤنث)؛ مثال: Teníamos visitas inesperadas. — أتانا زوّارٌ غيرُ متوقعين."},{"btype":"example","text":"impreso = طَبَعَ","note":"صيغة من imprimir (اسم المفعول (التصريف الثالث))؛ مثال: Este libro fue impreso en Inglaterra. — طبع هذا الكتاب في انجلترا."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"¿A qué hora abres?","note":"في أي وقت تفتح المحل؟"},{"btype":"example","text":"El mono estornudó.","note":"عطس القرد."},{"btype":"example","text":"¿Dónde los escondiste?","note":"أين خبأتهم؟"},{"btype":"example","text":"Me olvidarás algún día.","note":"ستنسَني يوماً ما."},{"btype":"example","text":"Tú al final me olvidarás.","note":"ستنساني في نهاية المطاف."},{"btype":"example","text":"Teníamos visitas inesperadas.","note":"أتانا زوّارٌ غيرُ متوقعين."},{"btype":"example","text":"Este libro fue impreso en Inglaterra.","note":"طبع هذا الكتاب في انجلترا."},{"btype":"example","text":"Este es el mismísimo libro que quería leer.","note":"هذا هو الكتاب عينه الذي كنت أريد قراءته."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"¿A qué hora abres?","ar":"في أي وقت تفتح المحل؟"},{"t":"El mono estornudó.","ar":"عطس القرد."},{"t":"¿Dónde los escondiste?","ar":"أين خبأتهم؟"},{"t":"Me olvidarás algún día.","ar":"ستنسَني يوماً ما."},{"t":"Tú al final me olvidarás.","ar":"ستنساني في نهاية المطاف."},{"t":"Teníamos visitas inesperadas.","ar":"أتانا زوّارٌ غيرُ متوقعين."},{"t":"Este libro fue impreso en Inglaterra.","ar":"طبع هذا الكتاب في انجلترا."},{"t":"Este es el mismísimo libro que quería leer.","ar":"هذا هو الكتاب عينه الذي كنت أريد قراءته."}],"focus":["mismísimo","escondiste","prométeme","abres","estornudó","cacahuates","olvidarás","médicas","inesperadas","impreso"],"words":[],"difficulty":3}}