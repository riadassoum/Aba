{"theory":{"blocks":[{"btype":"text","text":"الدرس 486. الكلمات الجديدة: llevarás، preferidos، aceptarlo، automática، acertijos، meñique، presione، felicito، enseñanzas، pilotos."},{"btype":"example","text":"llevarás = أَخَذَ","note":"صيغة من llevar (المخاطب، المستقبل)؛ مثال: ¿Me llevarás al hospital? — هلّا أوصلتني إلى المستشفى؟"},{"btype":"example","text":"preferidos = مُفَضَّل","note":"صيغة من preferido (الجمع، المذكّر)؛ مثال: Este es uno de los libros preferidos de Tomás. — هذا أحد كتب توم المفضلة."},{"btype":"example","text":"aceptarlo = قَبِلَ","note":"صيغة من aceptar (المصدر)"},{"btype":"example","text":"automática = تِلْقَائِيّ","note":"صيغة من automático (المؤنث)؛ مثال: Esta es una puerta automática. — هذا الباب أوتوماتيكي."},{"btype":"example","text":"acertijos = لُغْز","note":"صيغة من acertijo (الجمع)؛ مثال: Estaban hablando con acertijos. — كانوا يتكلّمون بالألغاز."},{"btype":"example","text":"meñique = دَقِيق","note":""},{"btype":"example","text":"presione = ضَغَطَ","note":"صيغة من presionar (الغائب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: Presione y espere la luz verde. — اضغط وانتظر اللون الأخضر."},{"btype":"example","text":"felicito = هَنَّأَ","note":"صيغة من felicitar (المتكلّم، المضارع)؛ مثال: Te felicito por tu éxito. — أهنّئك بمناسبة نجاحك."},{"btype":"example","text":"enseñanzas = تَعْلِيم","note":"صيغة من enseñanza (الجمع)"},{"btype":"example","text":"pilotos = طَيَّار","note":"صيغة من piloto (الجمع)؛ مثال: Ellos son pilotos. — انهم الطيارين."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ellos son pilotos.","note":"انهم الطيارين."},{"btype":"example","text":"¿Me llevarás al hospital?","note":"هلّا أوصلتني إلى المستشفى؟"},{"btype":"example","text":"Te felicito por tu éxito.","note":"أهنّئك بمناسبة نجاحك."},{"btype":"example","text":"Le felicito por su triunfo.","note":"أهنّئك بنجاحك."},{"btype":"example","text":"Esta es una puerta automática.","note":"هذا الباب أوتوماتيكي."},{"btype":"example","text":"Estaban hablando con acertijos.","note":"كانوا يتكلّمون بالألغاز."},{"btype":"example","text":"Presione y espere la luz verde.","note":"اضغط وانتظر اللون الأخضر."},{"btype":"example","text":"Este es uno de los libros preferidos de Tomás.","note":"هذا أحد كتب توم المفضلة."}]},"practice":{"blocks":[{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Ellos son pilotos.","ar":"انهم الطيارين."},{"t":"¿Me llevarás al hospital?","ar":"هلّا أوصلتني إلى المستشفى؟"},{"t":"Te felicito por tu éxito.","ar":"أهنّئك بمناسبة نجاحك."},{"t":"Le felicito por su triunfo.","ar":"أهنّئك بنجاحك."},{"t":"Esta es una puerta automática.","ar":"هذا الباب أوتوماتيكي."},{"t":"Estaban hablando con acertijos.","ar":"كانوا يتكلّمون بالألغاز."},{"t":"Presione y espere la luz verde.","ar":"اضغط وانتظر اللون الأخضر."},{"t":"Este es uno de los libros preferidos de Tomás.","ar":"هذا أحد كتب توم المفضلة."}],"focus":["llevarás","preferidos","aceptarlo","automática","acertijos","meñique","presione","felicito","enseñanzas","pilotos"],"words":[{"word":"meñique","topic":"L486","difficulty":3,"meaning":"دَقِيق"}],"difficulty":3}}