{"theory":{"blocks":[{"btype":"text","text":"الدرس 66. الكلمات الجديدة: asunto، último، abuela، acaba، malo، deberíamos، frente، según، terminar، cuerpo."},{"btype":"example","text":"asunto = أَمْر، قَضِيَّة","note":"مثال: Yo no tengo nada que ver con el asunto. — ليس لدي أيُ شأنٍ في هذا الأمر."},{"btype":"example","text":"último = آخِر، مَاضٍ","note":"مثال: El último tren ya se ha ido. — إن القطار قد غادر."},{"btype":"example","text":"abuela = جَدَّة","note":"مثال: Mi abuela vive por sí sola. — تعيش جدتي وحدها."},{"btype":"example","text":"acaba = اِنْتَهَى، أَنْهَى","note":"صيغة من acabar (الغائب، المضارع)؛ مثال: ¿Cuándo se acaba la escuela? — متى ينتهي الدوام المدرسيّ؟"},{"btype":"example","text":"malo = سَيِّئ، شَرِير","note":"مثال: Ziri es malo. — زيري سيء."},{"btype":"example","text":"deberíamos = يَنْبَغِي أَنْ","note":"صيغة من deber (الجمع، المتكلّم، الشرطي)؛ مثال: ¿Qué deberíamos decir? — ماذا يجب أن نقول؟"},{"btype":"example","text":"frente = أَمَام، جَبْهَة","note":"مثال: Alguien está en la puerta del frente. — أحدهم على الباب."},{"btype":"example","text":"según = عَمَلاً بِ","note":""},{"btype":"example","text":"terminar = أَنْهَى، اِنْتَهَى","note":""},{"btype":"example","text":"cuerpo = فَرْد","note":""},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Ziri es malo.","note":"زيري سيء."},{"btype":"example","text":"Ziri era malo.","note":"كان زيري سيئا."},{"btype":"example","text":"¿Qué deberíamos decir?","note":"ماذا يجب أن نقول؟"},{"btype":"example","text":"No es ni bueno ni malo.","note":"انها لا جيدة ولا سيئة."},{"btype":"example","text":"Mi abuela vive por sí sola.","note":"تعيش جدتي وحدها."},{"btype":"example","text":"El último tren ya se ha ido.","note":"إن القطار قد غادر."},{"btype":"example","text":"¿Cuándo se acaba la escuela?","note":"متى ينتهي الدوام المدرسيّ؟"},{"btype":"example","text":"El último tren ya ha partido.","note":"القطار الأخير غادر بالفعل"},{"btype":"example","text":"No se acaba el mundo por eso.","note":"ليست نهاية العالم."},{"btype":"example","text":"Todos nosotros deberíamos ir.","note":"علينا جميعا أن نذهب."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Ziri es malo.","ar":"زيري سيء."},{"t":"Ziri era malo.","ar":"كان زيري سيئا."},{"t":"¿Qué deberíamos decir?","ar":"ماذا يجب أن نقول؟"},{"t":"No es ni bueno ni malo.","ar":"انها لا جيدة ولا سيئة."},{"t":"Mi abuela vive por sí sola.","ar":"تعيش جدتي وحدها."},{"t":"El último tren ya se ha ido.","ar":"إن القطار قد غادر."},{"t":"¿Cuándo se acaba la escuela?","ar":"متى ينتهي الدوام المدرسيّ؟"},{"t":"El último tren ya ha partido.","ar":"القطار الأخير غادر بالفعل"},{"t":"No se acaba el mundo por eso.","ar":"ليست نهاية العالم."},{"t":"Todos nosotros deberíamos ir.","ar":"علينا جميعا أن نذهب."},{"t":"¿A qué hora se acaba tu clase?","ar":"في أي وقت ينتهي صفك؟"},{"t":"Mi hermana se parece a mi abuela.","ar":"أختي تشبه جدتي."},{"t":"¿Realmente puede ser así de malo?","ar":"هل بإمكانه أن يكون س