{"theory":{"blocks":[{"btype":"text","text":"الدرس 59. الكلمات الجديدة: futuro، huevos، papá، tenis، hablo، siendo، propia، hagas، otras، pude."},{"btype":"example","text":"futuro = مُسْتَقْبَل","note":"مثال: ¿Quién sabe lo que podría pasar en el futuro? — من يعلم ما قد يحصل مستقبلًا؟"},{"btype":"example","text":"huevos = بَيْض، بَيْضَة","note":"صيغة من huevo (الجمع)؛ مثال: ¿Cuántos huevos necesitamos? — كم من بيضة نحتاج؟"},{"btype":"example","text":"papá = أبي، بَابَا","note":"مثال: Tom es mi papá. — توم هو أبي"},{"btype":"example","text":"tenis = تَنِس","note":"مثال: Sé jugar al tenis. — أعرف كيف ألعب كرة المضرب."},{"btype":"example","text":"hablo = تَكَلَّمَ","note":"صيغة من hablar (المتكلّم، المضارع)؛ مثال: Hablo ido. — أتحدث لغة إيدو."},{"btype":"example","text":"siendo = كَانَ، كَانَ هُوَ","note":"صيغة من ser (صيغة المصدر الجاري)"},{"btype":"example","text":"propia = مِلْك","note":"صيغة من propio (المؤنث)؛ مثال: No puedo esperar a llegar a casa y dormir en mi propia cama. — لا يمكنني الانتظار للوصول الى المنزل والنوم في سريري."},{"btype":"example","text":"hagas = فَعَلَ","note":"صيغة من hacer (المخاطب، صيغة الالتماس (الشرطية)، المضارع)؛ مثال: ¡No lo hagas! — لا تفعل ذلك!"},{"btype":"example","text":"otras = آخَر","note":"صيغة من otro (الجمع، المؤنث)؛ مثال: A veces voy, otras veces no. — أذهب أحياناً ، وأحياناً أُخْرى لا أذهب."},{"btype":"example","text":"pude = قَدَرَ، اِسْتَطَاعَ","note":"صيغة من poder (المتكلّم، الماضي التامّ)؛ مثال: No pude dormir. — لم أستطع النوم."},{"btype":"text","text":"جمل الدرس:"},{"btype":"example","text":"Hablo ido.","note":"أتحدث لغة إيدو."},{"btype":"example","text":"¡No lo hagas!","note":"لا تفعل ذلك!"},{"btype":"example","text":"Tom es mi papá.","note":"توم هو أبي"},{"btype":"example","text":"No pude dormir.","note":"لم أستطع النوم."},{"btype":"example","text":"No hablo alemán.","note":"لا أتكلم الألمانية."},{"btype":"example","text":"No hablo inglés.","note":"أنا لا أتكلم الإنكليزية."},{"btype":"example","text":"No hablo japonés.","note":"أنا لا أتكلم اللغة اليابانية.‏‏"},{"btype":"example","text":"¿Con quién hablo?","note":"مع من أتكلم؟"},{"btype":"example","text":"Sé jugar al tenis.","note":"أعرف كيف ألعب كرة المضرب."},{"btype":"example","text":"Me gusta el tenis.","note":"أحب كرة المضرب."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Hablo ido.","ar":"أتحدث لغة إيدو."},{"t":"¡No lo hagas!","ar":"لا تفعل ذلك!"},{"t":"Tom es mi papá.","ar":"توم هو أبي"},{"t":"No pude dormir.","ar":"لم أستطع النوم."},{"t":"No hablo alemán.","ar":"لا أتكلم الألمانية."},{"t":"No hablo inglés.","ar":"أنا لا أتكلم الإنكليزية."},{"t":"No hablo japonés.","ar":"أنا لا أتكلم اللغة اليابانية.‏‏"},{"t":"¿Con quién hablo?","ar":"مع من أتكلم؟"},{"t":"Sé jugar al tenis.","ar":"أعرف كيف ألعب كرة المضرب."},{"t":"Me gusta el tenis.","ar":"أحب كرة المضرب."},{"t":"¿Cómo está tu papá?","ar":"كيف حال أبيك؟"},{"t":"¿Os gusta el tenis?","ar":"هل تحب كرة المضرب؟"},{"t":"¿Eres bueno al tenis?","ar":"هل أنت ماهر في لعب التنس؟"},{"t":"Mamá es mayor que papá.","ar":"أمي أكبر من أبي سناً."},{"t":"Me gusta mucho el tenis.","ar":"أحب النتس جدا."},{"t":"Papá me compró unos libros.","ar":"اشترى لي أبي بعض الكتب."},{"t":"Este es el auto de mi papá.","ar":"هذه سيارة أبي."},{"t":"Tom no sabe jugar al tenis.","ar":"توم لا يمكنه لعب التنس."},{"t":"¿Cuántos huevos necesitamos?","ar":"كم من بيضة نحتاج؟"},{"t":"Hablo inglés todos los días.","ar":"أتحدث الإنجليزية يومياً."},{"t":"A veces voy, otras veces no.","ar":"أذهب أحياناً ، وأحياناً أُخْرى لا أذهب."},{"t":"Juego al tenis todos los días.","ar":"ألعب التنس كل يوم."},{"t":"¿Cuándo compró Tom estos huevos?","ar":"متى اشترى توم هذه البيضات؟"},{"t":"Vamos a jugar tenis esta semana.","ar":"سنلعب التنس في عطلة نهاية الأسبوع."},{"t":"¿Cuántos huevos hay en la cocina?","ar":"كم من بيضة توجد في المطبخ؟"},{"t":"Será mejor que hagas lo que dicen.","ar":"من الأفضل أن تقوم بما يقولون."},{"t":"Por favor, ¿dónde están los huevos?","ar":"لو سمحت ، أين البيض؟"},{"t":"¿Por qué está mi papá en la cocina?","ar":"لماذا أبي في المطبخ؟"},{"t":"¿Quién sabe lo que podría pasar en el futuro?","ar":"من يعلم ما قد يحصل مستقبلًا؟"},{"t":"No puedo esperar a llegar a casa y dormir en mi propia cama.","ar":"لا يمكنني الانتظار للوصول الى المنزل والنوم في سريري."}],"focus":["futuro","huevos","papá","tenis","hablo","siendo","propia","hagas","otras","pude"],"words":[{"word":"futuro","topic":"L59","difficulty":1,"meaning":"مُسْتَقْبَل","example":"¿Quién sabe lo que podría pasar en el futuro?","translation":"من يعلم ما قد يحصل مستقبلًا؟"},{"word":"papá","topic":"L59","difficulty":1,"meaning":"أبي، بَابَا","example":"Tom es mi papá.","translation":"توم هو أبي"},{"word":"tenis","topic":"L59","difficulty":1,"meaning":"تَنِس","example":"Sé jugar al tenis.","translation":"أعرف كيف ألعب كرة المضرب."}],"difficulty":1}}