igo.","note":"هذا صديقي."},{"btype":"example","text":"No lo sabes.","note":"أنت لا تعرف."},{"btype":"example","text":"Soy un amigo.","note":"أنا صديق."},{"btype":"example","text":"Eres mi amigo.","note":"أنت صديقي."},{"btype":"example","text":"No es un niño.","note":"ليسَ طفلًا."},{"btype":"example","text":"Él es tu amigo.","note":"هو صديقك."}]},"practice":{"blocks":[{"btype":"generated","generator":"lang.translate","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.translate","count":5,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":4,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":3,"data":"@bundle"}]},"quiz":{"blocks":[{"btype":"generated","generator":"phr.translate","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.reverse","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.cloze","count":2,"data":"@bundle"},{"btype":"generated","generator":"phr.write","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.listen","count":2,"data":"@bundle"}]},"review":{"blocks":[{"btype":"generated","generator":"phr.dictation","count":3,"data":"@bundle"},{"btype":"generated","generator":"phr.build","count":2,"data":"@bundle"},{"btype":"generated","generator":"lang.truefalse","count":2,"data":"@bundle"}]},"data":{"lang":"es","lang_name":"الإسبانية","sentences":[{"t":"Casi.","ar":"بالكاد ."},{"t":"¿Sabes?","ar":"هل أنت تعلم؟"},{"t":"¡Así sea!","ar":"فلتكن كذلك !"},{"t":"Lo que sea.","ar":"على أية حال."},{"t":"Es mi amigo.","ar":"هذا صديقي."},{"t":"No lo sabes.","ar":"أنت لا تعرف."},{"t":"Soy un amigo.","ar":"أنا صديق."},{"t":"Eres mi amigo.","ar":"أنت صديقي."},{"t":"No es un niño.","ar":"ليسَ طفلًا."},{"t":"Él es tu amigo.","ar":"هو صديقك."},{"t":"¿Eres mi amigo?","ar":"هل أنتَ صديقي؟"},{"t":"Tengo un amigo.","ar":"أنا لدي صديق."},{"t":"Él es su amigo.","ar":"هو صديقها"},{"t":"Me gustaría ir.","ar":"أود 