يرة ،أليس كذلك ؟"},{"t":"Lo importante es trabajar.","ar":"المهم هو العمل."},{"t":"Esto no es palabra de Dios.","ar":"هذا ليس كلام الله."},{"t":"Ella no tiene que trabajar.","ar":"إنها لا تحتاج إلى أن تعمل."},{"t":"No eres lo bastante rápido.","ar":"لست سريعاً بما فيه الكفاية."},{"t":"Me gustaría ser joven otra vez.","ar":"أتمنى لو أني عدت إلى شبابي مرة أخرى."},{"t":"Deberías tener en cuenta que ya no eres joven.","ar":"يجدر بك أن تضع في حسبانك أنك لم تعد شابا."},{"t":"Ya me siento bien.","ar":"بدأت أشعر بتحسن."},{"t":"Ya nadie vive aquí.","ar":"لا أحد يعيش هنا بعد الآن."},{"t":"Nadie vive conmigo.","ar":"لا أحد يعيش معي."},{"t":"Él ya no vive aquí.","ar":"لم يعد يسكن هنا."},{"t":"Ella es mi hermana.","ar":"إنها أختي."},{"t":"¿Por qué sabes eso?","ar":"لماذا تعلم ذلك؟"}],"focus":["camino","ningún","hemos","Tierra","joven","estaban","palabra","hijos","trabajar","bastante"],"words":[{"word":"camino","topic":"L32","difficulty":1,"meaning":"طَرِيق","example":"Estás en mi camino.","translation":"أنت في طريقي."},{"word":"Tierra","topic":"L32","difficulty":1,"meaning":"تُرْبَة"},{"word":"joven","topic":"L32","difficulty":1,"meaning":"صَغِير","example":"Parece joven.","translation":"يبدو شاباً."},{"word":"palabra","topic":"L32","difficulty":1,"meaning":"كَلِمَة","example":"Esto no es palabra de Dios.","translation":"هذا ليس كلام الله."},{"word":"trabajar","topic":"L32","difficulty":1,"meaning":"عَمِلَ","example":"Me gusta trabajar.","translation":"إني أحب أن أعمل."},{"word":"bastante","topic":"L32","difficulty":1,"meaning":"كَافٍ","example":"Fue bastante rápido.","translation":"لقد كان حقاً سريعاً جداً."}],"difficulty":1}}