  {
   "btype": "text",
   "text": "المحيط طول حدود الشكل، والمساحة مقدار سطحه. لكل شكل قانونه. أمثلة محلولة:"
  },
  {
   "btype": "example",
   "text": "مستطيل طوله ٦ وعرضه ٤، مساحته؟",
   "note": "الطول × العرض = ٦×٤ = ٢٤."
  },
  {
   "btype": "example",
   "text": "المستطيل نفسه، محيطه؟",
   "note": "٢×(٦+٤) = ٢٠."
  },
  {
   "btype": "example",
   "text": "مثلث قاعدته ٨ وارتفاعه ٥، مساحته؟",
   "note": "(٨×٥)÷٢ = ٢٠."
  },
  {
   "btype": "text",
   "text": "انتقل إلى التمارين لتثبيت المهارة."
  }
 ]
}