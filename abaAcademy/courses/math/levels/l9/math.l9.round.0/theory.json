{
 "blocks": [
  {
   "btype": "text",
   "text": "التقريب يبسّط الأعداد. ننظر إلى الخانة التالية: إن كانت ٥ فأكثر نرفع، وإلا نُبقي. أمثلة محلولة:"
  },
  {
   "btype": "example",
   "text": "قرّب ٤٧ إلى أقرب عشرة",
   "note": "٧ أكبر من ٥، فنرفع إلى ٥٠."
  },
  {
   "btype": "example",
   "text": "قرّب ٦٢٠ إلى أقرب مئة",
   "note": "٢ أقل من ٥، فيبقى ٦٠٠."
  },
  {
   "btype": "example",
   "text": "قرّب ٨٥ إلى أقرب عشرة",
   "note": "٥ فأكثر، فنرفع إلى ٩٠."
  },
  {
   "btype": "text",
   "text": "انتقل إلى التمارين لتثبيت المهارة."
  }
 ]
}