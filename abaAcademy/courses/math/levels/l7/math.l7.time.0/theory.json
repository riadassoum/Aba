   "text": "نحوّل بين وحدات الزمن، ونحسب الوقت بعد مدّة معيّنة. أمثلة محلولة:"
  },
  {
   "btype": "example",
   "text": "كم دقيقة في ساعتين ونصف؟",
   "note": "٢×٦٠ + ٣٠ = ١٥٠ دقيقة."
  },
  {
   "btype": "example",
   "text": "الساعة ٣:٢٠، كم تكون بعد ٤٥ دقيقة؟",
   "note": "٣:٢٠ + ٤٥ = ٤:٠٥."
  },
  {
   "btype": "example",
   "text": "كم يوماً في ٣ أسابيع؟",
   "note": "٣ × ٧ = ٢١ يوماً."
  },
  {
   "btype": "text",
   "text": "انتقل إلى التمارين لتثبيت المهارة."
  }
 ]
